.env
.venv/

__pycache__/
__marimo__/
.marimo.toml
.mcp.json
.DS_Store
*.pyc
.playwright-mcp/

# Local agent scratch. .claude/skills/ IS tracked (symlinks into skills/) so the harness
# discovers the editor skills; everything else under .claude/ is per-machine.
.claude/*
!.claude/skills/

warehouse/catalog/pypi_downloads.csv
docs/superpowers/

# Notebooks: only the version-controlled release notebooks are tracked here.
# Other notebooks are published to and maintained on the OSO platform, or are
# work-in-progress, so they are not version-controlled in this repo.
notebooks/*.py
!notebooks/ai-stack-map.py
!notebooks/oss-ai-trends.py
!notebooks/pypi-geo-trends.py
!notebooks/long-tail-explorer.py

# Serialized registry: pushed to OSO by CI, never committed
build/registry/

# Serialized evaluation candidates: built by build/serialize_evaluation.py and uploaded to OSO
# by a maintainer (docs/operations/deploy-evaluation.md), never committed
build/evaluation/

# Source-runs snapshot: the per-run CSV is live data, never committed. The receipt
# (warehouse/audits/source_runs.json) IS committed -- it is the hygiene-clean, point-in-time
# attestation, validated offline by `snapshot_source_runs --check`.
build/observations/
