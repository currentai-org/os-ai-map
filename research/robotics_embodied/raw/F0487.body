":"Owner","user":"erikfrey"}]},"releases":{"0.0.10":[{"comment_text":"","core-metadata":{"sha256":"fd5b57a53bb5ac3dbec6eebc7d269e5ef14a0d788275aacd4446f8b390a0901d"},"digests":{"blake2b_256":"ba99d4089bdda018fbe698f077a5411f055b90744175df8ed2cd405e7312d590","md5":"456c8d2b9c281643f2fe14307dc5ab36","sha256":"5b588846342ed1fcb091fd4f2e6503331438b845e053d162028ecc23378fa928"},"downloads":-1,"filename":"brax-0.0.10-py3-none-any.whl","has_sig":false,"md5_digest":"456c8d2b9c281643f2fe14307dc5ab36","packagetype":"bdist_wheel","python_version":"py3","requires_python":null,"size":165771,"upload_time":"2021-12-13T06:19:22","upload_time_iso_8601":"2021-12-13T06:19:22.998926Z","url":"https://files.pythonhosted.org/packages/ba/99/d4089bdda018fbe698f077a5411f055b90744175df8ed2cd405e7312d590/brax-0.0.10-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":"","core-metadata":false,"digests":{"blake2b_256":"44222ce2a2e2bdea052caeca59d405a36051f3b8e55706c67bacd97ee9ddd6f7","md5":"f9615f4f5ebe95cebb1b28fd809543b1","sha256":"fc2330b66454ceebd179aa73fdd5a1d3e412e62ed70ec7650666569642de19f3"},"downloads":-1,"filename":"brax-0.0.10.tar.gz","has_sig":false,"md5_digest":"f9615f4f5ebe95cebb1b28fd809543b1","packagetype":"sdist","python_version":"source","requires_python":null,"size":104736,"upload_time":"2021-12-13T06:19:24","upload_time_iso_8601":"2021-12-13T06:19:24.700228Z","url":"https://files.pythonhosted.org/packages/44/22/2ce2a2e2bdea052caeca59d405a36051f3b8e55706c67bacd97ee9ddd6f7/brax-0.0.10.tar.gz","yanked":false,"yanked_reason":null}],"0.0.11":[{"comment_text":"","core-metadata":{"sha256":"5edeb3dc5bbd8c1753b7bb1eeb35348833c204b74c3940db250998c524ebf867"},"digests":{"blake2b_256":"03981827fca82a007e8cc50f78e868675e158654ae36f7b00edf38a7da43a190","md5":"5f55588924ba349185fc5d3389e05fa0","sha256":"fe10d16083ee591149d2166eb4d0eead960b7fa3148260b33aabaaaa870ddb04"},"downloads":-1,"filename":"brax-0.0.11-py3-none-any.whl","has_sig":false,"md5_digest":"5f55588924ba34918