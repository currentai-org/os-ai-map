kagetype":"sdist","python_version":"source","requires_python":">=3.10","size":5515457,"upload_time":"2025-01-19T02:07:37","upload_time_iso_8601":"2025-01-19T02:07:37.158910Z","url":"https://files.pythonhosted.org/packages/b9/37/2ffe5020c1f1c997a576e1d5b75ac5fb83e54e01a2003da35fe0ff4379cc/playground-0.0.3.tar.gz","yanked":false,"yanked_reason":null}],"0.0.4":[{"comment_text":null,"core-metadata":{"sha256":"769ebe2f243179705c4861de42e9b81b3c8aee6871bb97c0d3717e22b98578b9"},"digests":{"blake2b_256":"e65a9af6a7f0c0ac8ef732b7fece256c595d0b5c3ed23371ee4a512e9d5249f2","md5":"8015f06c1c35bb6f46cb1d92d166dd16","sha256":"4c13ff2912b1defb1474c4a039b4794a1b0122e99444828c9061ac41c464b0ee"},"downloads":-1,"filename":"playground-0.0.4-py3-none-any.whl","has_sig":false,"md5_digest":"8015f06c1c35bb6f46cb1d92d166dd16","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.10","size":14252268,"upload_time":"2025-03-07T19:11:52","upload_time_iso_8601":"2025-03-07T19:11:52.183339Z","url":"https://files.pythonhosted.org/packages/e6/5a/9af6a7f0c0ac8ef732b7fece256c595d0b5c3ed23371ee4a512e9d5249f2/playground-0.0.4-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"d696c02c4802de17c94ca252f547ec8498d6f2e9acfcfe8ebc6084d63743ef67","md5":"e8e637369499fba1f3119dcd4a629898","sha256":"0a2efd0c5c34da60f9574dbade63bbe4ad72375513d0e314b9301d1f51d105c0"},"downloads":-1,"filename":"playground-0.0.4.tar.gz","has_sig":false,"md5_digest":"e8e637369499fba1f3119dcd4a629898","packagetype":"sdist","python_version":"source","requires_python":">=3.10","size":7284721,"upload_time":"2025-03-07T19:11:49","upload_time_iso_8601":"2025-03-07T19:11:49.946941Z","url":"https://files.pythonhosted.org/packages/d6/96/c02c4802de17c94ca252f547ec8498d6f2e9acfcfe8ebc6084d63743ef67/playground-0.0.4.tar.gz","yanked":false,"yanked_reason":null}],"0.0.5":[{"comment_text":null,"core-metadata":{"sha256":"126c3b571bd839eb4fe585051d04faccdf843