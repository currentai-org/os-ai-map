or (sys_platform == \"darwin\" and platform_machine == \"arm64\")) and extra == \"dataset\"","torchcodec<0.12.0,>=0.7.0; sys_platform == \"win32\" and extra == \"dataset\"","torchcodec<0.12.0,>=0.11.0; (sys_platform == \"linux\" and (platform_machine == \"aarch64\" or platform_machine == \"arm64\")) and extra == \"dataset\"","jsonlines<5.0.0,>=4.0.0; extra == \"dataset\"","lerobot[dataset]; extra == \"training\"","wandb<0.28.0,>=0.24.0; extra == \"training\"","lerobot[accelerate-dep]; extra == \"training\"","lerobot[pynput-dep]; extra == \"hardware\"","lerobot[pyserial-dep]; extra == \"hardware\"","lerobot[deepdiff-dep]; extra == \"hardware\"","rerun-sdk<0.34.0,>=0.24.0; extra == \"viz\"","foxglove-sdk<0.26.0,>=0.25.1; extra == \"viz\"","lerobot[dataset]; extra == \"core-scripts\"","lerobot[hardware]; extra == \"core-scripts\"","lerobot[viz]; extra == \"core-scripts\"","lerobot[av-dep]; extra == \"evaluation\"","lerobot[dataset]; extra == \"dataset-viz\"","lerobot[viz]; extra == \"dataset-viz\"","av<16.0.0,>=15.0.0; extra == \"av-dep\"","pygame<2.7.0,>=2.5.1; extra == \"pygame-dep\"","placo<0.9.16,>=0.9.6; extra == \"placo-dep\"","cmeel-urdfdom<5,>=4; extra == \"placo-dep\"","cmeel-tinyxml2<11; extra == \"placo-dep\"","transformers<5.6.0,>=5.4.0; extra == \"transformers-dep\"","grpcio<2.0.0,>=1.73.1; extra == \"grpcio-dep\"","protobuf<8.0.0,>=6.31.1; extra == \"grpcio-dep\"","accelerate<2.0.0,>=1.14.0; extra == \"accelerate-dep\"","python-can<5.0.0,>=4.2.0; extra == \"can-dep\"","peft<1.0.0,>=0.18.0; extra == \"peft-dep\"","scipy<2.0.0,>=1.14.0; extra == \"scipy-dep\"","diffusers<0.40.0,>=0.38.0; extra == \"diffusers-dep\"","qwen-vl-utils<0.1.0,>=0.0.11; extra == \"qwen-vl-utils-dep\"","matplotlib<4.0.0,>=3.10.3; extra == \"matplotlib-dep\"","contourpy<2.0.0,>=1.3.0; extra == \"matplotlib-dep\"","pyserial<4.0,>=3.5; extra == \"pyserial-dep\"","deepdiff<9.0.0,>=7.0.1; extra == \"deepdiff-dep\"","pynput<1.9.0,>=1.7.8; extra == \"pynput-dep\"","pyzmq<28.0.0,>=26.2.1; e