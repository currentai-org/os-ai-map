/static/immutable/chunks/09cui6q2dhxjq.js\",\"/_next/static/immutable/chunks/2gc_qh4gnrn8e.js\",\"/_next/static/immutable/chunks/44x24r9z-dubx.js\",\"/_next/static/immutable/chunks/3m_p1s9u_dxei.js\"],\"\"]\n3b:T938,window.dataLayer = window.dataLayer || [];\nfunction gtag(){dataLayer.push(arguments);}\nwindow.gtag = window.gtag || gtag;\n// analytics_storage default. Cookiebot loads afterInteractive, so a blanket\n// 'denied' here left every page load with a dead window (until uc.js booted)\n// in which implied-consent visitors who bounced or clicked through to\n// app.runwayml.com produced zero analytics and no attribution cookie.\n// Resolve synchronously instead — mirrors hasSynchronousCategoryConsent() in\n// src/lib/cookiebotConsent.ts (vanilla JS duplicate: this runs before any\n// bundle loads):\n//   1. Cookiebot's own first-party CookieConsent cookie — a returning\n//      visitor's stored decision (accept OR decline) always wins.\n//   2. rw_consent_region, stamped by the proxy from x-vercel-ip-country:\n//      'implied' (US/ROW) grants; 'explicit' (EU/EEA/UK/CH) denies.\n//   3. No cookie at all (e.g. local dev): denied, wait for Cookiebot.\n// Ad keys stay denied for everyone until Cookiebot updates them, which also\n// preserves the old GPC posture (GPC only ever gated the ad stack).\nfunction rwReadCookie(name) {\n  var m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));\n  return m ? m[1] : null;\n}\nvar rwStoredStats = null;\nvar rwCbStored = rwReadCookie('CookieConsent');\nif (rwCbStored) {\n  try {\n    var rwCbMatch = decodeURIComponent(rwCbStored).match(/statistics:(true|false)/);\n    if (rwCbMatch) rwStoredStats = rwCbMatch[1] === 'true';\n  } catch (e) {}\n}\nvar rwRegion = rwReadCookie('rw_consent_region');\nvar rwAnalyticsDefault =\n  (rwStoredStats === null ? rwRegion === 'implied' : rwStoredStats)\n    ? 'granted'\n    : 'denied';\ngtag('consent', 'default', {\n  ad_storage: 'denied',\n  ad_user_data: 'denied',\n  ad_personalization: 'denied',\n  analytics_storage: rwAnalyticsDefault,\n  functionality_storage: 'granted',\n  security_storage: 'granted',\n  // Cookiebot loads afterInteractive (to avoid the banner's hydration\n  // mismatch) and issues its consent 'update' fairly late. 500ms expired\n  // before the grant arrived, so Consent Mode tags evaluated at 'denied' on\n  // the page_view trigger and never re-fired — 0 tags fired all session.\n  // 2000ms covers Cookiebot's grant latency so the tags wait for it.\n  wait_for_update: 2000,\n});\ngtag('set', 'ads_data_redaction', true);\ngtag('set', 'url_passthrough', true);4:[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"bg-white\",\"children\":[[\"$\",\"head\",null,{\"children\":[[\"$\",\"link\",null,{\"rel\":\"preconnect\",\"href\":\"https://image.mux.com\"}],[\"$\",\"link\",null,{\"rel\":\"preconnect\",\"href\":\"https://stream.mux.com\"}],[\"$\",\"link\",null,{\"rel\":\"preconnect\",\"href\":\"https://d3phaj0sisr2ct.cloudfront.net\"}],[[\"$\",\"$L3a\",null,{\"id\":\"consent-default\",\"strategy\":\"beforeInteractive\",\"children\":\"$3b\"}],[\"$\",\"$L3a\",null,{\"id\":\"Cookiebot\",\"src\":\"https://consent.cookiebot.com/uc.js\",\"data-cbid\":\"952a2171-cb67-4ece-985e-f84b62c46dbe\",\"data-blockingmode\":\"auto\",\"data-georegions\":\"{'region':'US-06','cbid':'ca1d9ff6-6d64-4c6e-b7ef-9e6ff90563f6'},{'region':'US-08','cbid':'ca1d9ff6-6d64-4c6e-b7ef-9e6ff90563f6'},{'region':'US-09','cbid':'ca1d9ff6-6d64-4c6e-b7ef-9e6ff90563f6'},{'region':'US-41','cbid':'ca1d9ff6-6d64-4c6e-b7ef-9e6ff90563f6'},{'region':'US-48','cbid':'ca1d9ff6-6d64-4c6e-b7ef-9e6ff90563f6'},{'region':'US-51','cbid':'ca1d9ff6-6d64-4c6e-b7ef-9e6ff90563f6'}\",\"strategy\":\"afterInteractive\",\"type\":\"text/javascript\"}],[\"$\",\"$L3a\",null,{\"id\":\"gtm-loader\",\"strategy\":\"afterInteractive\",\"children\":\"(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\\nj=d.cre