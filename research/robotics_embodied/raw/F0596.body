gline\":\"Foundational research on General World Models — systems that understand, perceive, generate, and act.\",\"videoModels\":\"Video Models\",\"gen45Desc\":\"Video generation\",\"aleph2Desc\":\"Video modification\",\"actTwoDesc\":\"Motion capture\",\"charactersModelDesc\":\"Realtime video agents\",\"worldSimulation\":\"World Simulation\",\"worldSimulationDesc\":\"Interactive worlds\",\"roboticsModelDesc\":\"Toolkit for robot learning\",\"solarisDesc\":\"Realtime interactive interfaces\",\"rubyDesc\":\"SDR-to-HDR color grading\",\"convertToHdr\":\"Convert to HDR\",\"convertToHdrDesc\":\"Grade SDR video into true HDR with Ruby\",\"stayCurrent\":\"Stay current\",\"blog\":\"Blog\",\"events\":\"Events\",\"aiSummit\":\"AI Summit\",\"primaryNavLabel\":\"Primary\",\"aiFestival\":\"AI Festival\"},\"privacyChoices\":{\"title\":\"Opt out of sale/share/targeted advertising\",\"body\":\"We may disclose information to our third-party advertising and analytics partners through technologies such as cookies and pixels. These disclosures may be considered a “sale” or “sharing” of personal information, or processing of personal information for targeted advertising purposes, under certain U.S. state privacy laws. If you would like to opt out of these disclosures, please click the opt-out button below. Please note that we use cookies to remember your preference and if you clear cookies in your browser (or your browser automatically does so for you), you will need to opt out again unless you have the Global Privacy Control (GPC) enabled. Your opt-out applies only to the browser that you are currently using. If you have the GPC enabled on your browser, we will treat you as having opted out. For more information about how we collect, use, and disclose your personal information, please see our \u003cpolicy\u003ePrivacy Policy\u003c/policy\u003e.\",\"webform\":\"Alternatively, you can fill out our \u003cform\u003eOpt-Out Form\u003c/form\u003e.\",\"gpcNotice\":\"Opt-out is automatically applied due to your browser’s Global Privacy Control (GPC) signal.\",\"optOut\":\"Opt out\",\"close\":\"Close\",\"optedOut\":\"Opt-out successful.\",\"unavailable\":\"We couldn’t record your choice because our consent tool isn’t available in this browser. Please use the Opt-Out Form instead.\"},\"footer\":{\"product\":\"Product\",\"useCases\":\"Use Cases\",\"initiatives\":\"Initiatives\",\"company\":\"Company\",\"getStarted\":\"Get Started\",\"connect\":\"Connect\",\"exploreExamples\":\"Explore Examples\",\"generalWorldModels\":\"General World Models\",\"roboticsSdk\":\"Robotics SDK\",\"robotics\":\"Robotics\",\"studios\":\"Studios\",\"aiFilmFestival\":\"AI Film Festival\",\"academy\":\"Academy\",\"telescopeMagazine\":\"Telescope Magazine\",\"creativePartnersProgram\":\"Creative Partners Program\",\"ourResearch\":\"Our Research\",\"publications\":\"Publications\",\"careers\":\"Careers\",\"aboutUs\":\"About Us\",\"customerStories\":\"Customer Stories\",\"news\":\"News\",\"store\":\"Store\",\"talentNetwork\":\"Talent Network\",\"forEnterprises\":\"For Enterprises\",\"forEducation\":\"For Education\",\"login\":\"Login\",\"pricing\":\"Pricing\",\"helpCenter\":\"Help Center\",\"dataSecurity\":\"Data Security\",\"changelog\":\"Changelog\",\"press\":\"Press\",\"partnerships\":\"Partnerships\",\"brandGuidelines\":\"Brand Guidelines\",\"meetups\":\"Meetups\",\"termsOfUse\":\"Terms of Use\",\"privacyPolicy\":\"Privacy Policy\",\"californiaNotices\":\"California Notices\",\"codeOfConduct\":\"Code of Conduct\",\"systemStatus\":\"System Status\",\"language\":\"Language\",\"chooseLanguage\":\"Choose your language\",\"cookieSettings\":\"Cookie Settings\",\"yourPrivacyChoices\":\"Your Privacy Choices\",\"creative\":\"Creative\",\"dev\":\"Dev\",\"enterprise\":\"Enterprise\",\"research\":\"Research\",\"resources\":\"Resources\",\"overview\":\"Overview\",\"androidApp\":\"Android app\",\"iosApp\":\"iOS app\",\"chatgptPlugin\":\"ChatGPT Plugin\",\"devPortal\":\"Platform\",\"models\":\"Models\",\"modelRouter\":\"Model Router\",\"workflows\":\"Workflows\",\"recipes\":\"Recipes\",\"characters\":\"Characters\",\"documentation\":\"Documentation\",\"policyModel\":\"Policy Model\",\"offlinePolicyEvaluation\":\"Offline Policy Evaluation\",\"dataAugmentation\":\"Data Augmentation\",\"videoModelLicensing\":\"Video Model Licensing\",\"getAccess\":\"Get Access\",\"contactSales\":\"Contact Sales\",\"researchHub\":\"Research Hub\",\"researchNews\":\"Research News\",\"worldSimulation\":\"World Simulation\",\"blog\":\"Blog\",\"resourceHub\":\"Resource Hub\",\"safety\":\"Safety\",\"verifyContentCredentials\":\"Verify Content Credentials\",\"eventsPrograms\":\"Events \u0026 Programs\",\"socialX\":\"X\",\"socialInstagram\":\"Instagram\",\"socialYoutube\":\"YouTube\",\"socialDiscord\":\"Discord\",\"aiFestival\":\"AI Festival\",\"affiliateProgram\":\"Affiliate Program\"},\"languageBanner\":{\"message\":\"This page is available in {language}\",\"switchLabel\":\"Switch\",\"dismiss\":\"Dismiss\",\"localeNames\":{\"en\":\"English\",\"es\":\"Spanish\",\"ja\":\"Japanese\",\"zh\":\"Chinese\",\"ko\":\"Korean\",\"fr\":\"French\",\"ru\":\"Russian\",\"pt-br\":\"Brazilian Portuguese\",\"tr\":\"Turkish\",\"it\":\"Italian\",\"de\":\"German\"}},\"appBanner\":{\"titleIos\":\"Runway app for iPhone\",\"titleAndroid\":\"Runway app for Android\",\"subtitle\":\"Create anything, anytime.\",\"cta\":\"Try app\",\"dismiss\":\"Dismiss banner\",\"logoAlt\":\"Runway app icon\"},\"homepage\":{\"pageTitle\":\"Runway | Building Real-World Intelligence\",\"pageDescription\":\"Runway is building foundational Real-World Intelligence that can understand, simulate and act in the world. We offer products and services built on-top of this intelligence to empower individuals and organizations to do more in the world.\",\"heroTitle\":\"Building AI to \u003cbr class='hidden lg:block'/\u003e Simulate the World\",\"heroVideoMediaEntertainment\":\"Media and Entertainment\",\"heroVideoRobotics\":\"Robotics and Autonomy\",\"heroVideoGwm\":\"General World Models\",\"heroVideoAgents\":\"Conversational Real-time Video Agents\",\"heroSocialProof\":\"Used by 60M+ users globally - try today and cancel anytime\",\"partnersLabel\":\"We partner with the world's leading organizations to advance their industries:\",\"runwayResearch\":\"Runway Research\",\"researchDescription\":\"We are building foundational General World Models that will be capable of simulating all possible worlds and experiences. The next frontier of intelligence will come from models that can understand, perceive, generate and act in the world.\",\"gwm1ResearchDesc\":\"A state-of-the-art General World Model built to interact with the real world. And a major step towards universal simulation.\",\"gen45ResearchDesc\":\"The world's best video model, featuring state-of-the-art motion quality, prompt adherence and visual fidelity.\",\"gwmResearchDesc\":\"Our long-term research effort to build AI systems that understand the visual world and its dynamics.\",\"latestResearchHeading\":\"Our latest Research and Products\",\"introducingGwm1\":\"Introducing GWM-1\",\"gwm1Paragraph1\":\"GWM-1: our state-of-the-art General World Model, built to simulate reality in real time. Interactive, controllable and general-purpose.\",\"gwm1Paragraph2\":\"GWM-1 comes in three variants: GWM Worlds for explorable environments, GWM Avatars for conversational characters, and GWM Robotics for robotic manipulation.\",\"gen45Headline\":\"Gen-4.5: A new frontier for video generation.\",\"gen45Description\":\"Runway Gen-4.5 is the world's top-rated video model, offering unprecedented visual fidelity and creative control. It produces cinematic and highly realistic outputs while providing limitless creative freedom and precise control over every aspect of generation.\",\"industriesHeading\":\"Runway is being used by the world's leading organizations across industries\",\"nvidiaTitle\":\"Runway and NVIDIA Partner to Advance Video Generation and World Models\",\"nvidiaDesc\":\"Runway and NVIDIA collaborated to accelerate Runway's video and world models with NVIDIA's Vera Rubin architecture.\",\"lionsgateTitle\":\"Runway Announces Partnership with Lionsgate\",\"lionsgateDesc\":\"Runway and Lionsgate are partnering to explore the use of AI in film production.\",\"uclaTitle\":\"UCLA's Department of Film, Television and Digital Media\",\"uclaDesc\":\"How UCLA's Film, Television and Digital Media program empowers students to experiment with AI in filmmaking.\",\"kpfTitle\":\"How KPF is incorporating AI into Architectural workflows\",\"kpfDesc\":\"How KPF is using Runway to streamline rendering workflows and empower creatives to animate architectural projects in-house.\",\"ctaBuildingAi\":\"We are building AI to simulate the world through merging art and science.\",\"ctaJoinTeam\":\"Join our global team of researchers, engineers, artists and designers.\",\"seeCareers\":\"See careers\",\"aiChangingHeading\":\"AI is changing how stories are told, how scientific progress is made and how the next frontiers of humanity are reached.\",\"gen45CardSubtitle\":\"A New Frontier for Video Generation\",\"gen45CardTitle\":\"Gen-4.5: A New Frontier for Generative Video\",\"gen45CardDesc\":\"Gen-4.5 is the world's best video model, featuring state-of-the-art motion quality, prompt adherence and visual fidelity.\",\"roboticsCardSubtitle\":\"Runway Robotics World Model SDK\",\"roboticsCardTitle\":\"GWM Robotics: General World Models for Robotics\",\"roboticsCardDesc\":\"Simulate physical interactions and robotic behaviors through learned world models. Learn and predict how actions unfold.\",\"worldsCardSubtitle\":\"Interactive World Simulation\",\"worldsCardTitle\":\"GWM Worlds: Interactive and Explorable World Models\",\"worldsCardDesc\":\"A new frontier for open-ended interactive world simulation. A way of building infinite explorable realities in real-time.\",\"avatarsCardSubtitle\":\"Autonomous Virtual Characters\",\"avatarsCardTitle\":\"GWM Avatars: Real-time Video Agents\",\"avatarsCardDesc\":\"Fully autonomous and real-time virtual video agents capable of natural conversation and contextual awareness.\",\"tryNow\":\"Try now\",\"exploreResearch\":\"Explore the Research\",\"thirdPartyTitle\":\"Every model you need to make anything you want.\",\"comingSoon\":\"Coming soon\",\"charactersTitle\":\"Runway Characters\",\"charactersParagraph1\":\"A real-time video agent API that lets you build fully custom conversational characters. These video agents can have any appearance and any visual style, with full control over voice, personality, knowledge and actions.\",\"charactersParagraph2\":\"Built on our recently launched world model, GWM-1, Characters lets you generate expressive digital personas from a single image, with zero fine-tuning required.\",\"rwiHeroTitle\":\"Building Real-World Intelligence\",\"rwiHeroDescription\":\"Runway is building foundational Real-World Intelligence that can understand, simulate and act in the world. We offer products and services built on-top of this intelligence to empower individuals and organizations to do more in the world.\",\"platformsHeading\":\"Three platforms built on-top of the same Real-World Intelligence models\",\"platformCreativeTagline\":\"Your complete Creative Suite with everything you need, to make anything you want.\",\"platformCreativeBody\":\"An all-in-one cloud-based creative platform that offers endless ways to generate and edit video, images and audio in one workspace. Built for individuals and teams of all sizes.\",\"platformCreativeFootnote\":\"Used by 60m+ creatives around the world. Try free, cancel anytime.\",\"platformDevTagline\":\"The AI media platform for developers to build with the best models from Runway and other labs.\",\"platformDevBody\":\"The API platform with Runway's expertise built in. Access the best models and the creative tooling to easily get production-ready output from them, at scale.\",\"platformRoboticsTagline\":\"A complete toolkit to run policy inference through photorealistic simulation.\",\"platformRoboticsBody\":\"From policy inference and evaluation to synthetic data generation, every component is powered by GWM-1, our state-of-the-art General World Model. Pick the surface you need — we'll work with you to fit it to your hardware.\",\"getApiKey\":\"Get API Key\",\"forEnterprise\":\"For Enterprise\",\"contactSales\":\"Contact Sales\",\"devTabWorkflows\":\"Workflows\",\"devTabRecipes\":\"Recipes\",\"devTabCharacters\":\"Characters\",\"devSectionDescription\":\"Create your own pipelines combining multiple models, modalities and tasks. Trigger Workflows via custom endpoints.\",\"devBullet1\":\"Automate repetitive tasks at scale\",\"devBullet2\":\"Get dedicated support from Runway's Technical Artists for Workflow builds\",\"enterpriseBadge\":\"Enterprise\",\"devSectionEyebrow\":\"Other ways to build\",\"devTabRecipesDesc\":\"Pre-built endpoints for specific use cases. Get professional-quality assets with one request.\",\"devTabCharactersDesc\":\"Build expressive characters with custom voices, knowledge and tools, ready for live interaction directly from your product.\",\"viewDocumentation\":\"View documentation\",\"badgeVideo\":\"Video\",\"badgeImage\":\"Image\",\"recipeProductAdDesc\":\"Generate ad videos from a product photo. Ready for social, ecommerce or paid placements.\",\"recipeProductUgcDesc\":\"Generate vertical user-generated content ads from a character photo, product photo, and creative brief.\",\"recipeProductSwapDesc\":\"Replace the product in an existing ad video with a new product while preserving camera motion and scene composition.\",\"recipeMultiShotVideoDesc\":\"Generate a multi-cut video from a story prompt or custom shot list with cohesive cinematic pacing.\",\"recipeMarketingStockImageDesc\":\"Generate polished, on-brand marketing stock imagery from a text brief and an optional reference image of brand assets.\",\"recipeProductCampaignImageDesc\":\"Generate four fashion campaign images from a product photo and creative brief.\",\"creativePanelItemHowUsed\":\"How Runway is Used\",\"creativePanelItemAgent\":\"Create with Agent\",\"creativePanelItemWorkflows\":\"Build your own Workflows\",\"creativePanelItemEnterprise\":\"Enterprise-grade\",\"creativePanelItemModels\":\"The World's Best Models\",\"latestFromRunwayHeading\":\"See the latest from Runway\",\"teamPlanTitle\":\"Introducing Team Plan\",\"teamPlanDesc\":\"Runway's collaboration plan for creative teams, with shared projects, pooled credits and Brand Kits for 2 to 9 seats.\",\"solarisTitle\":\"Introducing Solaris\",\"solarisDesc\":\"Our first Interface World Model: real-time AI that generates interactive interfaces frame by frame, with no code.\",\"enterpriseVideoTitle\":\"The Next Phase of Enterprise Video Generation\",\"enterpriseVideoDesc\":\"Five themes from hundreds of enterprise conversations, from data sovereignty and cost economics to autonomous execution and model ownership.\",\"gwmWorlds2Title\":\"Introducing GWM Worlds 2\",\"gwmWorlds2Desc\":\"GWM Worlds 2 generates interactive worlds in real time: continuous 720p video at 24 fps and audio at 48,000 Hz, responding to your inputs as you explore.\",\"tryRunwayFree\":\"Try Runway for free\"},\"discoverMore\":{\"heading\":\"Discover more\",\"mediaRouterTitle\":\"Introducing Runway Media Router\",\"chimeTitle\":\"How Chime Used Runway to Produce Their Latest National TV Spot\",\"aiMediaReportTitle\":\"The AI Media Report: Cost, Speed and What Comes Next\"},\"productFeatureRail\":{\"title\":\"Our latest models and tools\",\"tryNow\":\"Try now\",\"learnMore\":\"Learn more\",\"items\":[{\"title\":\"Runway Plugins\",\"description\":\"Generate, edit and extend footage inside Premiere Pro and After Effects.\"},{\"title\":\"Runway MCP\",\"description\":\"Connect Runway to your agent - Claude, ChatGPT etc.\"},{\"title\":\"Aleph 2.0 \u0026 Edit Studio\",\"description\":\"Edit a frame in a video, apply it to the rest of the video.\"},{\"title\":\"Runway Agent\",\"description\":\"Create end-to-end videos with simple conversations.\"},{\"title\":\"Characters: Real-time Video Agents\",\"description\":\"Real-time AI video agents with natural conversation\"},{\"title\":\"Seedance 2.5\",\"description\":\"Use text, image, video or audio to generate videos\"},{\"title\":\"Multi-Shot Video App\",\"description\":\"Write a simple prompt, get a multiple shots video\"},{\"title\":\"Gen-4.5: Frontier Video Generation\",\"description\":\"State-of-the-art motion quality and visual fidelity.\"}]},\"product\":{\"pageTitle\":\"Runway | AI Image and Video Generator\",\"pageDescription\":\"Generate images and video with AI. Text to video, image to video, plus more. Runway's AI image and video generation tools trusted by millions worldwide\",\"heroSocialProof\":\"Used by 60M+ users globally - try today and cancel anytime\",\"thirdPartyTitle\":\"Every model you need to make anything you want.\",\"thirdPartyDescription\":\"Bring your entire creative workflow together inside of Runway with access to the world's best image, video, audio, editing and language models.\",\"toolkitHeading\":\"A new kind of creative toolkit with everything you need to generate any video, image or piece of content you want.\",\"toolsHeading\":\"Dozens of tools. \u003cbr class='hidden lg:block' /\u003eEndless ways to create.\",\"appsTitle\":\"Apps for Everything\",\"appsDescription\":\"Apps are an ever-growing collection of use case specific tools designed to make it easier than ever to get to great outputs.\",\"workflowsHeading\":\"Build the Workflows \u003cbr class='hidden lg:block' /\u003e That Work for You.\",\"workflowsDescription\":\"Create your own custom node-based workflows that chain together multiple models, modalities and intermediary steps for even more control of your generations.\",\"workflowsCta\":\"Learn more about Workflows\",\"caseTransformVideoTitle\":\"Transform Video\",\"caseTransformVideoHeading\":\"Edit, Transform and Generate Video\",\"caseTransformVideoDesc\":\"Easily change the lighting of a scene, restyle a shot or subject, add or remove elements from a take and much more. All just by telling the model what you're looking for.\",\"caseTransformVideoChangeOutfit\":\"change outfit\",\"caseTransformVideoChangeArtDirection\":\"change art direction\",\"caseTransformVideoRemoveBackground\":\"remove background\",\"caseTransformVideoRemoveElements\":\"remove elements\",\"caseTransformVideoChangeObject\":\"change object\",\"caseMoodBoardsTitle\":\"Mood Boards\",\"caseMoodBoardsHeading\":\"Generate Bespoke Mood Boards\",\"caseMoodBoardsDesc\":\"Turn a single reference image into a full campaign mood board. Simply upload a reference image and instantly begin generating new images and videos in the same style, location and tone.\",\"caseMoodBoardsPrompt\":\"Create more images in the same style and location\",\"caseVirtualStagingTitle\":\"Virtual Staging\",\"caseVirtualStagingHeading\":\"Stage Any Space in Seconds\",\"caseVirtualStagingDesc\":\"Dress a space without any complex 3D workflows or compositing. Simply provide a reference image of your room alongside the items you'd like to see in it.\",\"caseVirtualStagingPrompt\":\"Stage the room with...\",\"caseVirtualStagingCouch\":\"a couch\",\"caseVirtualStagingCoffeeTable\":\"a coffee table\",\"caseVirtualStagingPlants\":\"plants\",\"caseCharacterPerfTitle\":\"Character Performance\",\"caseCharacterPerfHeading\":\"Motion Capture Anyone Can Use\",\"caseCharacterPerfDesc\":\"No rigging, animation or expensive mo-cap shoots. Simply record a driving performance using any camera you have, then transpose it directly to a reference character with Act-Two.\",\"caseCharacterPerfChar1\":\"Character One\",\"caseCharacterPerfChar2\":\"Character Two\",\"caseCharacterPerfChar3\":\"Character Three\",\"caseVirtualTryOnTitle\":\"Virtual Try-On\",\"caseVirtualTryOnHeading\":\"Try On Anything\",\"caseVirtualTryOnDesc\":\"With References you can restyle a subject in endless outfits. All you need is a single image of your talent and images of your outfits. No additional photoshoots or compositing required.\",\"caseVirtualTryOnPrompt\":\"Place the model in...\",\"caseVirtualTryOnOutfit1\":\"outfit one\",\"caseVirtualTryOnOutfit2\":\"outfit two\",\"caseVirtualTryOnOutfit3\":\"outfit three\",\"caseVirtualTryOnOutfit4\":\"outfit four\",\"caseDesignExploTitle\":\"Design Explorations\",\"caseDesignExploHeading\":\"Ideate with Images\",\"caseDesignExploDesc\":\"Find inspiration in found objects, textures and references to explore new concepts and directions for architecture, design and more.\",\"caseDesignExploPrompt\":\"Create a building inspired by...\",\"caseDesignExploDesign1\":\"design one\",\"caseDesignExploDesign2\":\"design two\",\"caseDesignExploDesign3\":\"design three\",\"caseStoryboardingTitle\":\"Storyboarding\",\"caseStoryboardingHeading\":\"Turn Text Prompts into Storyboards\",\"caseStoryboardingDesc\":\"Build out entire storyboards in minutes versus days using a single style reference and text prompts.\",\"caseStoryboardingPrompt\":\"Create a storyboard about an adventure in the mountains\",\"caseStoryboardingStatic\":\"Static\",\"caseAnimaticsTitle\":\"Animatics\",\"caseAnimaticsHeading\":\"Turn Storyboards into Animatics\",\"caseAnimaticsDesc\":\"Bring your static frames to life without the need for costly, time-consuming animation. With Image to Video, you can go from idea to high fidelity proof of concept in a fraction of the time.\",\"caseGenerateYourselfTitle\":\"Generate Yourself\",\"caseGenerateYourselfHeading\":\"Generate Yourself\",\"caseGenerateYourselfDesc\":\"Turn a single selfie into endless new images of you across different scenes, wardrobes and locations.\",\"caseGenerateYourselfPrompt\":\"Place the character...\",\"caseGenerateYourselfVineyard\":\"in a vineyard\",\"caseGenerateYourselfBoat\":\"on a boat\",\"caseGenerateYourselfCar\":\"driving a car\",\"caseGenerateYourselfStreets\":\"running through streets\",\"caseGenerateYourselfRestaurant\":\"sitting in restaurant\",\"caseGenerateYourselfNight\":\"portrait at night\",\"caseVisualEffectsTitle\":\"Visual Effects\",\"caseVisualEffectsHeading\":\"Visual Effects\",\"caseVisualEffectsDesc\":\"With Runway Aleph you can generate complex visual effects just by saying what you want to see.\",\"caseVisualEffectsPrompt\":\"Transform the video to...\",\"caseVisualEffectsChangeOutfit\":\"Change Outfit\",\"caseVisualEffectsChangeWorld\":\"Change World\",\"caseVisualEffectsSpecialEffects\":\"Special Effects\",\"caseVisualEffectsNovelConcepts\":\"Novel Concepts\",\"caseVisualEffectsChangeFurniture\":\"Change Furniture\",\"caseEndlessProductShotsTitle\":\"Generate Endless Product Shots\",\"caseEndlessProductShotsHeading\":\"Generate Product Shots\",\"caseEndlessProductShotsDesc\":\"Turn an existing product shot into infinite new images and videos for use across touch points. Simply upload your existing image then tell the model what you’re looking for.\",\"caseEndlessProductShotsPrompt\":\"Place the lamp...\",\"caseEndlessProductShotsInCave\":\"in a cave\",\"caseEndlessProductShotsInDesert\":\"in the desert\",\"caseEndlessProductShotsOnBeach\":\"on the beach\",\"caseEndlessProductShotsInWoods\":\"in the woods\",\"caseProductPlacementTitle\":\"Product Placement\",\"caseProductPlacementHeading\":\"Drop Your Product Into Any Scene\",\"caseProductPlacementDesc\":\"Combine a selfie or lifestyle shot with any product image to generate realistic UGC-inspired content. No shoots required.\",\"caseProductPlacementPrompt\":\"Place the product...\",\"caseProductPlacementMansHand\":\"in the man's hand\",\"caseProductPlacementWomansHand\":\"in the woman's hand\",\"caseProductPlacementOnTable\":\"on the table\",\"caseProductPlacementStudioShot\":\"studio shot\"},\"partners\":{\"lenny\":{\"pageTitle\":\"Runway | An Exclusive Deal for Lenny's Product Pass Insiders\",\"pageDescription\":\"Claim your free Runway Pro subscription — an exclusive deal for Lenny's Product Pass Insiders. Runway's AI image and video tools are used by 60M+ users globally.\",\"heroTitle\":\"An exclusive deal for Lenny's Product Pass Insiders\",\"ctaLabel\":\"Claim your free Runway Pro subscription\",\"heroSubtext\":\"Used by 60M+ users globally\"}},\"thirdPartySection\":{\"defaultTitle\":\"Every model you need to make anything you want.\",\"comingSoon\":\"Coming soon\"},\"heroCtaVideo\":{\"defaultTitle\":\"A new frontier for \u003cbr class='hidden lg:block' /\u003e video generation.\"},\"casesSelector\":{\"defaultTitle\":\"New creative tools \u003cbr class='hidden lg:block' /\u003efor every workflow.\",\"defaultDescription\":\"Whether you're an advertising agency putting together pitch decks or an architecture firm iterating on new building concepts, Runway's full-suite of creative and production AI tools allow you to efficiently and intuitively explore ideas and executions. All without needing to learn complex new interfaces or technical setups.\",\"commonUseCasesLabel\":\"Common Use Cases\",\"before\":\"Before\",\"after\":\"After\"},\"allAppsCarousel\":{\"defaultTitle\":\"Explore other apps\",\"viewAllApps\":\"View All Apps\",\"removeFromVideoName\":\"Remove from Video\",\"removeFromVideoDesc\":\"Remove anything from any video with a simple prompt.\",\"reshootProductName\":\"Reshoot Product\",\"reshootProductDesc\":\"Transform product shots without reshooting. Just upload and describe.\",\"upscaleVideoName\":\"Upscale Video\",\"upscaleVideoDesc\":\"Enhance any video to higher resolution with one click.\",\"addDialogueName\":\"Add Dialogue\",\"addDialogueDesc\":\"Bring characters to life by typing what they should say.\",\"changeImageStyleName\":\"Change Image Style\",\"changeImageStyleDesc\":\"Reimagine any image in different styles and artistic moods.\",\"addPerformanceName\":\"Add Performance\",\"addPerformanceDesc\":\"Map your voice and expressions onto any image or character.\",\"changeBackdropName\":\"Change Backdrop\",\"changeBackdropDesc\":\"Transform the background in any video.\",\"changeTimeOfDayName\":\"Change Time of Day\",\"changeTimeOfDayDesc\":\"Adjust the time of the day in any video.\",\"relightSceneName\":\"Relight Scene\",\"relightSceneDesc\":\"Change the lighting in any video instantly.\",\"varyImageName\":\"Vary Image\",\"varyImageDesc\":\"Change subject pose, backgrounds, attire, colors of clothing in your image.\",\"videoBackdropName\":\"Video Backdrop\",\"videoBackdropDesc\":\"Swap your video's background.\",\"referencesToVideoName\":\"References to Video\",\"referencesToVideoDesc\":\"Create video from reference images.\"},\"customersSection\":{\"defaultTitle\":\"How the world's leading organizations \u003cbr class='hidden lg:block' /\u003e and artists are using Runway.\",\"subheading\":\"Runway is helping change the way work gets made across all industries. Learn more below.\",\"customerStoriesLabel\":\"Customer Stories\",\"selectEnterprisePartners\":\"Select Enterprise Partners\",\"storyHouseOfDavidTitle\":\"How “House of David” Used Runway to Become Amazon’s Latest Hit Series\",\"storyEggplantTitle\":\"How Eggplant Picture \u0026 Sound transformed History Channel's \\\"Life After People\\\" with Runway\",\"storyUnderArmourTitle\":\"Behind the Scenes of an Under Armour TV Commercial, Powered by Runway\",\"storyGreatDictatorTitle\":\"Behind the Scenes of 'The Great Dictator' with Creator Gabo Arora\",\"storySmackTitle\":\"How SMACK Uses Runway to Build Animated Towers of Contemporary Allegory\"},\"newsSection\":{\"heading\":\"News\"},\"contentCard\":{\"readMore\":\"Read More\"},\"resources\":{\"discoverMore\":\"Discover more\"},\"changelog\":{\"pageTitle\":\"Product Updates \u0026 Changelog | Runway AI\",\"pageDescription\":\"View Runway's latest product updates and feature releases. Track changes, improvements and new AI video generation capabilities in our changelog.\",\"heading\":\"New updates and improvements to Runway.\",\"latestUpdates\":\"Latest updates\",\"unavailable\":\"Updates are temporarily unavailable. Please check back shortly.\"},\"enterprise\":{\"pageTitle\":\"Production-ready AI Made for Enterprise | Runway AI\",\"pageDescription\":\"Our full suite of creative AI tools can help your teams realize bigger ideas with smaller budgets and timelines.\",\"partnersHeading\":\"We partner with the world's leading \u003cbr class='hidden md:block' /\u003e organizations to advance their industries:\",\"inquiryEyebrow\":\"New creative tools for every workflow and industry.\",\"inquirySubcopy\":\"Fill out your information and a Runway expert will reach out. Need help right away? Check out these resources:\",\"closingTitle\":\"Let’s build what’s next together.\",\"closingBody\":\"Join the studios, agencies, and brands using Runway to compress timelines, expand creative output, and ship work that wasn’t possible before.\",\"closingCta\":\"Get in touch\",\"contactSupport\":\"Contact customer support\",\"exploreApiDocs\":\"Explore the Runway Dev docs\",\"visitHelpCenter\":\"Visit our help center\",\"appsTitle\":\"Apps for everything\",\"appsDescription\":\"Apps are an ever-growing collection of use case specific tools designed to make it easier than ever to get to great outputs.\",\"caseStudyHouseOfDavidTitle\":\"Case study: House of David\",\"caseStudyHouseOfDavidDesc\":\"How \\\"House of David\\\" used Runway to become Amazon's latest hit series.\"},\"pageHero\":{\"defaultTitle\":\"Production-ready AI \u003cbr class='hidden lg:block' /\u003e Made for Enterprise\",\"defaultDescription\":\"Our full suite of creative AI tools can help your teams realize bigger ideas with smaller budgets and timelines.\",\"contactSales\":\"Contact Sales\"},\"builtForEnterprise\":{\"heading\":\"Built for Enterprise\",\"scalableTitle\":\"Scalable and Secure\",\"scalableItem1\":\"We don't train on your data\",\"scalableItem2\":\"SOC 2 Type 2\",\"scalableItem3\":\"Customizable access \u0026 permissions\",\"scalableItem4\":\"Full ownership of your outputs\",\"scalableItem5\":\"Single Sign On (SSO)\",\"transformativeTitle\":\"Transformative and Impactful\",\"benefitUnlockTitle\":\"Unlock Bigger Possibilities\",\"benefitUnlockDesc\":\"Turn impossible ideas into realities\",\"benefitBudgetsTitle\":\"Smaller Budgets\",\"benefitBudgetsDesc\":\"10x your creative output at 10% the cost\",\"benefitControlTitle\":\"Creative Control\",\"benefitControlDesc\":\"Your brand, your style, your IP, own what you create\",\"workflowsTitle\":\"Workflows for Every Team and Industry\",\"workflowPlatformLabel\":\"Platform\",\"workflowPlatformDesc\":\"Allowing creatives to ideate and execute with state of the art AI models, tools and workflows.\",\"workflowApiLabel\":\"Runway Dev\",\"workflowApiDesc\":\"Runway's frontier models and the best from other labs, behind one key, with the routing and recipes to run them in production.\"},\"latestCustomersCarousel\":{\"viewAllCaseStudies\":\"View all case studies\"},\"customerQuotesCarousel\":{\"heading\":\"Why Enterprises Choose Runway\",\"getInTouch\":\"Get in touch\",\"underArmourTimelineSubtitle\":\"2 weeks\",\"underArmourTimelineQuote\":\"Saved on production timeline despite no access to on-camera talent\",\"eggplantQuote\":\"\\\"It would be hugely expensive and time-consuming to shoot on-location and use conventional VFX and editing methods. With Runway, we were able to do in a few hours what would previously have taken a month.\\\"\",\"houseOfDavidQuote\":\"\\\"Runway's tools allowed us to create these produced visuals and tell the story, but do it on budget and time frame that we could afford.\\\"\",\"underArmourCostSubtitle\":\"80%\",\"underArmourCostQuote\":\"Cost savings vs traditional VFX Pipeline\"},\"salesForm\":{\"intro\":\"Please fill out the form below to get started. Our Sales team will reach out to you.\",\"nameLabel\":\"Name\",\"namePlaceholder\":\"Your full name\",\"firstNameLabel\":\"First Name\",\"firstNamePlaceholder\":\"Type your first na