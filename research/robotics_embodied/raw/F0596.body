          max-height: 100%;
          min-width: 100%;
          min-height: 100%;
        }
        </style><!--$?--><template id="B:6"></template><!--/$--></div></div></div></div><div class=""><div class="aspect-video relative rounded-lg overflow-hidden"><div class="absolute inset-0"><div class="w-full h-full object-cover next-video-container"><style>
