+cE+d34yPB/Aycf7b2kv0coXMIscAH6xtk4NpfqFRXf2oSZY7+49+1Ue/O2z8AAAA\"},\"className\":\"w-full h-full object-cover\",\"autoPlay\":true,\"loop\":true,\"muted\":true,\"playsInline\":true}]}]}]}],[\"$\",\"div\",null,{\"className\":\"\",\"children\":[\"$\",\"div\",null,{\"className\":\"aspect-video relative rounded-lg overflow-hidden\",\"children\":[\"$\",\"div\",null,{\"className\":\"absolute inset-0\",\"children\":[\"$\",\"$L13\",null,{\"src\":{\"status\":\"ready\",\"originalFilePath\":\"videos/robotics-lego-clip-01.mp4\",\"provider\":\"mux\",\"providerMetadata\":{\"mux\":{\"uploadId\":\"015DLZlSmJWgGmbOgo3O8XeRCWNDiMOz5Da8v4CLMVSg\",\"assetId\":\"7C1xR3fYBiIpxQudbgtqxH27Ptct6uymgvllbZeFljk\",\"playbackId\":\"U9ihmVMdZkoRZBIvAm5WT00oYnJkU3RJN700EfrE00I4RI\"}},\"createdAt\":1765402085117,\"updatedAt\":1765402092151,\"size\":24985364,\"sources\":[{\"src\":\"https://stream.mux.com/U9ihmVMdZkoRZBIvAm5WT00oYnJkU3RJN700EfrE00I4RI.m3u8\",\"type\":\"application/x-mpegURL\"}],\"poster\":\"https://image.mux.com/U9ihmVMdZkoRZBIvAm5WT00oYnJkU3RJN700EfrE00I4RI/thumbnail.webp\",\"blurDataURL\":\"data:image/webp;base64,UklGRpIAAABXRUJQVlA4IIYAAAAwAgCdASoQAAkAAQAcJaACdAYsPm+9d66WQAD++TrQMRGb7sJfO9+VPv79nVPQX6n5LoSMZf//buzYfrG+uXozepA0cXH3/NfIr2aGl6jwPn6QgdWX2CsnbFhk33m9//yrRlQwOE1cpWc9drKr5C65X8FySl1Mv/r+JEdsN4fP52yHM92AAA==\"},\"className\":\"w-full h-full object-cover\",\"autoPlay\":true,\"loop\":true,\"muted\":true,\"playsInline\":true}]}]}]}]]}]}]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col lg:flex-row\",\"children\":[\"$\",\"article\",null,{\"className\":\"lg:w-12/16 w-full lg:pr-1/16 ml-auto\",\"children\":[\"$\",\"div\",null,{\"className\":\"text-neutral-950 leading-tight text-3xl\",\"children\":[\"Built on top of our frontier video generation model, GWM Robotics gives robot policy models a rich visual understanding of the physical world — enabling better generalization and greater sample efficiency out of the box.\",[\"$\",\"br\",null,{}],[\"$\",\"br\",null,{}],\"And as a simulator, the model predicts video rollouts conditioned on robot actions, and supports counterfactual generation — letting you explore alternative trajectories and outcomes without ever touching physical hardware.\"]}]}]}],\"$L26\",\"$L27\"]}]}]}]\n2a:T550,GWM Worlds is a world model for real-time environment simulation. You give the model a static scene, and it generates an immersive, infinite, explorable space as you move through it, with geometry, lighting, physics. All in real time. You can travel to any place, real or imagined. You can become any agent, a person walking through a city, a drone flying over a snowy mountain, a robot navigating a warehouse. What makes this work is consistency. When you explore an environment, you expect the world to stay coherent. Turn around, and what was behind you is still there. Walk forward and back, and you return to where you started. GWM Worlds maintains this spatial consistency across long sequences of movement. And because it's a simulation, the environment can react. You can define the physics of a world with your input prompt, and the world will respond accurately. If you prompt the agent to ride a bike, it stays on the ground; if you prompt for flight, it can freely navigate the sky. This is useful for interactive experiences, games, explorable worlds, immersive environments. But it's equally important for training agents. If you want to train an AI system to navigate and act in the physical world, you need a simulator in which to teach it. GWM Worlds can serve as that sandbox, an environment where agents can explore, make mistakes and learn.1c:[\"$\",\"section\",null,{\"id\":\"worlds-section\",\"children\":[\"$\",\"div\",null,{\"className\":\"rw-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"border-t-[0.50px] border-[#C6C6C6] lg:pt-16 lg:pb-24 pt-10 pb-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col lg:flex-row\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"lg:w-4/16 w-full mb-6 lg:mb-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-sm mb-2\",\"children\":\"GWM-1\"}],[\"$\",\"div\",null,{\"className\":\"text-3xl leading-none pr-10\",\"children\":\"For Real-time World Simulation and Exploration\"}]]}],[\"$\",\"article\",null,{\"className\":\"lg:w-12/16 w-full lg:pr-1/16 mb-10 lg:mb-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"text-neutral-950 leading-tight text-3xl\",\"children\":\"A new frontier for open-ended interactive world simulation. A way of building infinite explorable realities in real-time.\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"flex mb-20 lg:mb-0\",\"children\":[\"$\",\"article\",null,{\"className\":\"lg:w-12/16 w-full lg:ml-auto\",\"children\":[\"$\",\"div\",null,{\"className\":\"lg:mb-10\",\"children\":[[\"$\",\"$L28\",null,{\"src\":{\"status\":\"ready\",\"originalFilePath\":\"videos/world-sim-v1.1.mp4\",\"provider\":\"mux\",\"providerMetadata\":{\"mux\":{\"uploadId\":\"ymTK6WDs301O2tVhhOYe702mgo02mVpNa2hxDzrAtqWSsc\",\"assetId\":\"CrmzTNkse7NoTzXTc2009r003XpwS5vtjW5bNUPbQSWYk\",\"playbackId\":\"8jWWRIx63lpvEuHxB02ivsTL1LdveuF3fnXtOC01X81Lc\"}},\"createdAt\":1765415240767,\"updatedAt\":1765415254234,\"size\":101811786,\"sources\":[{\"src\":\"https://stream.mux.com/8jWWRIx63lpvEuHxB02ivsTL1LdveuF3fnXtOC01X81Lc.m3u8\",\"type\":\"application/x-mpegURL\"}],\"poster\":\"https://image.mux.com/8jWWRIx63lpvEuHxB02ivsTL1LdveuF3fnXtOC01X81Lc/thumbnail.webp\",\"blurDataURL\":\"data:image/webp;base64,UklGRpwAAABXRUJQVlA4IJAAAABwAgCdASoQAAkAAQAcJagCdBOJVWv8HuhbTxJ4AP7vnsVdrjzlgaIN79DTKQWf49rVCmAkS/z/bv87jTn+6GE9aQkcRdIRe2CSXYSnBD8ZmZVaI0G3blmketZO0dDtq/ML/hfk85/zW9kPt8z0Ts9v5Yz/+DqBU6umvj/F0JT1sJmrH+ys2/aP+DfQ3/BlQAA=\"},\"className\":\"overflow-hidden rounded-lg mb-10\",\"controls\":true,\"muted\":false,\"playsInline\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://d3phaj0sisr2ct.cloudfront.net/site/images/research/gwm/thumb-world-sim.png\",\"alt\":\"GWM-Worlds\",\"className\":\"w-full h-full object-cover scale-[1.02]\",\"slot\":\"poster\"}]}],[\"$\",\"$L29\",null,{\"content\":[{\"title\":\"Gaming\",\"description\":\"GWM Worlds enables players to move freely through coherent, reactive worlds without the need to manually design every space.\"},{\"title\":\"Education\",\"description\":\"Step into any environment. Walk through ancient Rome, explore the inside of a cell, or navigate the surface of Mars. Turning abstract concepts into immersive, first-person experiences.\"},{\"title\":\"Training Agents\",\"description\":\"A sandbox where AI agents can learn to navigate and act in physical environments. Exploring, making mistakes, and improving through trial and error, without the cost or risk of training in the real world.\"},{\"title\":\"VR and Immersive Experiences\",\"description\":\"GWM Worlds can power VR and immersive experiences by generating infinite, spatially consistent environments on the fly. Letting users explore any place, real or imagined, with the geometry, lighting, and physics that make a virtual world feel real.\"}]}]]}]}]}],[\"$\",\"div\",null,{\"className\":\"flex\",\"children\":[\"$\",\"article\",null,{\"className\":\"lg:w-5/16 w-full lg:ml-4/16\",\"children\":\"$2a\"}]}]]}]}]}]\n1d:[\"$\",\"section\",null,{\"id\":\"avatars-section\",\"children\":[\"$\",\"div\",null,{\"className\":\"rw-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"border-t-[0.50px] border-[#C6C6C6] lg:pt-16 lg:pb-24 pt-10 pb-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col lg:flex-row\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"lg:w-4/16 w-full mb-6 lg:mb-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-sm mb-2\",\"children\":\"GWM-1\"}],[\"$\",\"div\",null,{\"className\":\"text-3xl leading-none\",\"children\":\"Runway Characters\"}]]}],[\"$\",\"article\",null,{\"className\":\"lg:w-12/16 w-full lg:pr-1/16\",\"children\":[\"$\",\"div\",null,{\"className\":\"text-neutral-950 leading-tight text-3xl\",\"children\":\"Runway Characters is an audio-driven interactive video generation model that simulates natural human motion and expression for arbitrary photorealistic or stylized characters. The model renders realistic facial expressions, eye movements, lip-syncing and gestures during both speaking and listening, running for extended conversations without quality degradation.\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"flex\",\"children\":[\"$\",\"article\",null,{\"className\":\"lg:w-12/16 w-full lg:ml-auto\",\"children\":[[\"$\",\"div\",null,{\"className\":\"my-10\",\"children\":[[\"$\",\"$L28\",null,{\"src\":{\"status\":\"ready\",\"originalFilePath\":\"videos/TBL_RW_Livestream_AVATARS_v04.mp4\",\"provider\":\"mux\",\"providerMetadata\":{\"mux\":{\"uploadId\":\"y1oA1KBn57uFKSI3QEWnYGmg02SSO3YfArRGF3UfeTgI\",\"assetId\":\"01c6sS67VxJjzdv4ql8zUIJVt2F2HndQV2016ci3pOSWM\",\"playbackId\":\"z65HVDF6hgz1BhtAw6vcfuUEpT7ryGcM1dWRp8Rz41M\"}},\"createdAt\":1765420196619,\"updatedAt\":1765420205144,\"size\":57725117,\"sources\":[{\"src\":\"https://stream.mux.com/z65HVDF6hgz1BhtAw6vcfuUEpT7ryGcM1dWRp8Rz41M.m3u8\",\"type\":\"application/x-mpegURL\"}],\"poster\":\"https://image.mux.com/z65HVDF6hgz1BhtAw6vcfuUEpT7ryGcM1dWRp8Rz41M/thumbnail.webp\",\"blurDataURL\":\"data:image/webp;base64,UklGRooAAABXRUJQVlA4IH4AAAAwAgCdASoQAAkAAQAcJQBOgMU84PjdpKWdQAD+9d3/xP7rDxsyBPV+tkhni3dnm0cRGf20G+/jNa29IXft3aUUULa6dKglK01cFsTIfa5xOeD9pqzNRO3aigO8FuNRdwYb+cgOgk+qzQT5n9PC4ZGD/IFcOAktLB8MTrUAAAA=\"},\"className\":\"overflow-hidden rounded-lg\",\"controls\":true,\"muted\":false,\"playsInline\":true,\"children\":[\"$\",\"img\",null,{\"src\":\"https://d3phaj0sisr2ct.cloudfront.net/site/images/research/gwm/thumb-real-time-avatars.png\",\"alt\":\"GWM-Avatars\",\"className\":\"w-full h-full object-cover scale-[1.02]\",\"slot\":\"poster\"}]}],[\"$\",\"$L29\",null,{\"content\":[{\"title\":\"Real-time tutoring and education\",\"description\":\"Bring personalized tutors to life. Responsive characters that explain concepts, react to questions, and hold extended conversations with the natural expressions and gestures that make learning feel like a real dialogue.\"},{\"title\":\"Customer support and service\",\"description\":\"Transform customer support by putting a face to the interaction. A responsive, lifelike character that listens, reacts, and guides users through issues with the natural expressions and patience of a real human agent, at any hour, at any scale.\"},{\"title\":\"Training simulations\",\"description\":\"Practice difficult conversations, negotiations, or high-stakes scenarios with lifelike characters that respond naturally, maintain eye contact, and react in real time, building skills in a safe environment.\"},{\"title\":\"Interactive entertainment and gaming\",\"description\":\"Bring game characters and digital performers to life. Characters that listen and respond, hosts that react to your choices, companions that hold real conversations. Making interactive entertainment feel like a genuine exchange.\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col lg:flex-row justify-between mt-24 gap-10 lg:gap-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"lg:w-5/12 w-full\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl leading-tight\",\"children\":\"Runway Characters is now available via the Runway API and Runway web product.\"}],\"$L2b\"]}],\"$L2c\"]}]]}]}]]}]}]}]\n1e:[\"$\",\"section\",null,{\"id\":\"native-audio-section\",\"children\":[\"$\",\"div\",null,{\"className\":\"rw-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"border-t-[0.50px] border-[#C6C6C6] lg:pt-16 lg:pb-24 pt-10 pb-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col lg:flex-row\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"lg:w-4/16 w-full mb-6 lg:mb-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-sm mb-2\",\"children\":\"Gen-4.5 Updates\"}],[\"$\",\"div\",null,{\"className\":\"text-3xl leading-none lg:pr-32\",\"children\":\"Native audio generation, audio editing and multi-shot video editing.\"}]]}],[\"$\",\"article\",null,{\"className\":\"lg:w-12/16 w-full lg:pr-1/16\",\"children\":[\"$\",\"div\",null,{\"className\":\"text-neutral-950 leading-tight text-3xl\",\"children\":[[\"$\",\"$L14\",null,{\"href\":\"/research/introducing-runway-gen-4.5\",\"className\":\"underline\",\"children\":\"Gen-4.5\"}],\" now supports native audio generation and native audio editing. Not only will you be able to generate novel videos with audio, but you'll also be able to edit the audio of existing videos to suit your needs. Gen-4.5 also introduces multi-shot editing. With multi-shot editing, you can make a change in your initial scene and propagate that change throughout your entire video.\"]}]}]]}],[\"$\",\"div\",null,{\"className\":\"flex my-16\",\"children\":[\"$\",\"article\",null,{\"className\":\"lg:w-12/16 w-full lg:ml-auto\",\"children\":[\"$\",\"div\",null,{\"className\":\"\",\"children\":[\"$\",\"$L28\",null,{\"src\":{\"status\":\"ready\",\"originalFilePath\":\"videos/4.5-update-v03-2.mp4\",\"provider\":\"mux\",\"providerMetadata\":{\"mux\":{\"uploadId\":\"iqOGwzfMz7mqpBtfa93lq32sm01k01xdQRByXZ02aXC3AU\",\"assetId\":\"KAkF7zOVDlGtzxeM58ZR1WYR501MS4enGgLdaZV9LMIU\",\"playbackId\":\"bCBvgt12tlEWxT5BI4zioVshu02ODvqXdlmlXFCJmT2k\"}},\"createdAt\":1765427429200,\"updatedAt\":1765427440716,\"size\":67271644,\"sources\":[{\"src\":\"https://stream.mux.com/bCBvgt12tlEWxT5BI4zioVshu02ODvqXdlmlXFCJmT2k.m3u8\",\"type\":\"application/x-mpegURL\"}],\"poster\":\"https://image.mux.com/bCBvgt12tlEWxT5BI4zioVshu02ODvqXdlmlXFCJmT2k/thumbnail.webp\",\"blurDataURL\":\"data:image/webp;base64,UklGRooAAABXRUJQVlA4IH4AAABQAgCdASoQAAkAAQAcJaACdAYtLyJi5VTItgAA/vC2cfblp8V0+04O24kEsemC2j2VqpRl7r2l6tB//bwjynxFQrmRr/joYzrSKJIHA/1ifQ4lw3CHtP0zxZ3/3UVd6kXrAx8DH7i5uNUn8Nb92/OV+6n7w3bCPgVa+lfNwAA=\"},\"className\":\"overflow-hidden rounded-lg\",\"controls\":true,\"muted\":false,\"playsInline\":true,\"loop\":true,\"children\":[\"