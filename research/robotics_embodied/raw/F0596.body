\",\"div\",null,{\"className\":\"lg:w-4/16 w-full mb-6 lg:mb-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"text-sm tracking-tighter\",\"children\":\"INTRODUCTION\"}]}],[\"$\",\"div\",null,{\"className\":\"lg:w-12/16 w-full pr-1/16\",\"children\":[\"$\",\"div\",null,{\"className\":\"text-neutral-950 leading-tight text-3xl\",\"children\":\"GWM-1: our state-of-the-art General World Model, built to simulate reality in real time. Interactive, controllable and general-purpose.\"}]}]]}]}]}]\n18:[\"$\",\"section\",null,{\"className\":\"lg:mt-28 lg:mb-20 mt-16 mb-10\",\"children\":[\"$\",\"div\",null,{\"className\":\"rw-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"lg:w-16/16 mx-auto aspect-video\",\"children\":[\"$\",\"$L20\",null,{\"poster\":\"https://d3phaj0sisr2ct.cloudfront.net/site/images/research/gwm/gwm-stream-overlay-bg.png\",\"youtubeId\":\"2AyAlE99_-A\",\"className\":\"w-full h-full object-cover\",\"title\":\"Watch the Announcement\"}]}]}]}]\n19:[\"$\",\"section\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"rw-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col md:flex-row\",\"children\":[[\"$\",\"article\",null,{\"className\":\"lg:w-5/16 w-full lg:ml-4/16 mb-6 lg:mb-0\",\"children\":[\"Two years ago, we introduced a new research direction: General World Models. A world model is an AI system that builds an internal representation of an environment and uses it to simulate future events within that environment. The aim of general world models is to represent and simulate a wide range of situations and interactions—like those encountered in the real world.\",[\"$\",\"br\",null,{}],[\"$\",\"br\",null,{}],\"Today, we're announcing GWM-1—our first general world model family. GWM-1 is an autoregressive model built on top of Gen-4.5. It generates frame by frame, runs in real time, and can be controlled interactively with actions—camera pose, robot commands, audio.\",[\"$\",\"br\",null,{}],[\"$\",\"br\",null,{}],\"GWM-1 comes in three variants: GWM Worlds for explorable environments, GWM Avatars for conversational characters, and GWM Robotics for robotic manipulation. Today, these are separate post-trained models. We're working toward unifying many different domains and action spaces under a single base world model.\",[\"$\",\"br\",null,{}],[\"$\",\"br\",null,{}],\"We believe that world models are at the frontier of progress in artificial intelligence. Language models alone won't solve the world’s hardest problems – robotics, disease, scientific discovery. Real progress requires models that experience the world and learn from their mistakes, the same way that humans do. And this kind of trial and error can be massively accelerated when done in simulation, rather than in the real world. World models offer the most clear path to general-purpose simulation.\"]}],[\"$\",\"aside\",null,{\"className\":\"lg:w-5/16 w-full ml-auto\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-1/2\",\"children\":[\"$\",\"div\",null,{\"className\":\"text-neutral-950/75 text-sm md:ml-4 lg:ml-0\",\"children\":\"Key Features\"}]}],[\"$\",\"div\",null,{\"className\":\"inline-flex flex-col justify-start items-start w-64\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6 items-start justify-start self-stretch\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-2 items-start justify-start self-stretch\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-lg\",\"children\":\"Action-Conditioning\"}],[\"$\",\"div\",null,{\"className\":\"text-sm text-neutral-950/50 font-normal leading-4\",\"children\":[\"Camera \",[\"$\",\"br\",null,{}],\"Events \",[\"$\",\"br\",null,{}],\"Robot Pose \",[\"$\",\"br\",null,{}],\"Speech\"]}]]}],[\"$\",\"div\",null,{\"className\":\"h-0 self-stretch outline outline-[0.5px] outline-stone-300\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6 items-start justify-start self-stretch\",\"children\":[[\"$\",\"div\",null,{\"className\":\"h-0 self-stretch outline outline-[0.5px] outline-stone-300\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-2 items-start justify-start self-stretch\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6 items-start justify-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-2 items-start justify-start\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-lg\",\"children\":\"Customizable Model\"}],[\"$\",\"div\",null,{\"className\":\"text-sm text-neutral-950/50 font-normal leading-4\",\"children\":[\"World Models for Custom Actions + \",[\"$\",\"br\",null,{}],\" Domains\"]}]]}],[\"$\",\"div\",null,{\"className\":\"inline-flex items-center gap-2 justify-start\",\"children\":[\"$\",\"div\",null,{\"className\":\"text-xs text-neutral-950/75 font-normal leading-4 justify-start\",\"children\":[\"$\",\"$L14\",null,{\"href\":\"https://dev.runwayml.com\",\"className\":\"text-neutral-950/75 font-normal leading-4 justify-start hover:underline\",\"children\":\"For access to fine-tuning, visit the developer portal\"}]}]}]]}]}],\"$L21\"]}],\"$L22\",\"$L23\"]}]]}]}]]}]}]}]\n1a:[\"$\",\"section\",null,{\"className\":\"my-16\",\"children\":[\"$\",\"div\",null,{\"className\":\"rw-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col lg:flex-row\",\"children\":[\"$\",\"article\",null,{\"className\":\"lg:w-12/16 w-full lg:ml-auto\",\"children\":[\"$\",\"div\",null,{\"className\":\"aspect-video relative rounded-lg overflow-hidden\",\"children\":[\"$\",\"div\",null,{\"className\":\"absolute inset-0\",\"children\":[\"$\",\"$L13\",null,{\"src\":{\"status\":\"ready\",\"originalFilePath\":\"videos/12_BROLL_Autoregressive.mp4\",\"provider\":\"mux\",\"providerMetadata\":{\"mux\":{\"uploadId\":\"WOx5v6eBr8EAWE6CjAnTQYdHDiH91H012qDlQgLTvkX4\",\"assetId\":\"9pU00JdKSEr1d4JdxPp214R6nNziYFB015O02Z8u9E00Etg\",\"playbackId\":\"uAKfm0202k32CyjHKenfVgZTny