xt/static/immutable/chunks/07ucy92m6bjvs.js\",\"/_next/static/immutable/chunks/18hu_p7ua4cwz.js\",\"/_next/static/immutable/chunks/1q4-fupqk0_j8.js\",\"/_next/static/immutable/chunks/081uibm0ltqh5.js\",\"/_next/static/immutable/chunks/2rf7i7q6cynxw.js\",\"/_next/static/immutable/chunks/09cui6q2dhxjq.js\",\"/_next/static/immutable/chunks/2gc_qh4gnrn8e.js\",\"/_next/static/immutable/chunks/44x24r9z-dubx.js\",\"/_next/static/immutable/chunks/3m_p1s9u_dxei.js\"],\"default\"]\n43:I[775849,[\"/_next/static/immutable/chunks/0x-9rc1bm-510.js\",\"/_next/static/immutable/chunks/07ucy92m6bjvs.js\",\"/_next/static/immutable/chunks/18hu_p7ua4cwz.js\",\"/_next/static/immutable/chunks/1q4-fupqk0_j8.js\",\"/_next/static/immutable/chunks/081uibm0ltqh5.js\",\"/_next/static/immutable/chunks/2rf7i7q6cynxw.js\",\"/_next/static/immutable/chunks/09cui6q2dhxjq.js\",\"/_next/static/immutable/chunks/2gc_qh4gnrn8e.js\",\"/_next/static/immutable/chunks/44x24r9z-dubx.js\",\"/_next/static/immutable/chunks/3m_p1s9u_dxei.js\"],\"default\"]\n3c:[\"$\",\"$L3e\",null,{}]\n3f:[\"$\",\"iframe\",null,{\"src\":\"https://www.googletagmanager.com/ns.html?id=GTM-MV6ZPBC\",\"height\":\"0\",\"width\":\"0\",\"style\":{\"display\":\"none\",\"visibility\":\"hidden\"}}]\n3d:[\"$\",\"body\",null,{\"className\":\"abcnormal_d55cd778-module__KOiC8a__variable timesnow_bd5a815e-module__7PsZNG__variable font-sans flex min-h-screen flex-col\",\"id\":\"layout\",\"children\":[[\"$\",\"noscript\",null,{\"children\":\"$3f\"}],[\"$\",\"$L40\",null,{}],[\"$\",\"$L41\",null,{}],[\"$\",\"$L42\",null,{}],[\"$\",\"$L43\",null,{}],\"$L44\"]}]\n"])</script><script>self.__next_f.push([1,"45:I[175696,[\"/_next/static/immutable/chunks/0x-9rc1bm-510.js\",\"/_next/static/immutable/chunks/07ucy92m6bjvs.js\",\"/_next/static/immutable/chunks/18hu_p7ua4cwz.js\",\"/_next/static/immutable/chunks/1q4-fupqk0_j8.js\",\"/_next/static/immutable/chunks/081uibm0ltqh5.js\",\"/_next/static/immutable/chunks/2rf7i7q6cynxw.js\",\"/_next/static/immutable/chunks/09cui6q2dhxjq.js\",\"/_next/static/immutable/chunks/2gc_qh4gnrn8e.js\",\"/_next/static/immutable/chunks/44x24r9z-dubx.js\",\"/_next/static/immutable/chunks/3m_p1s9u_dxei.js\"],\"default\"]\n46:Ta08,Cinematic magical realism 5-shot sequence. A MERIDIAN coffee cup on a sunlit café table, real miniature clouds floating above it from the steam. The magical realism: the clouds are a living transport system — they carry the camera from the café to the high-altitude coffee farms of Colombia, floating over misty Andean slopes covered in coffee plants, before scooping up the essence of the place and drifting back to deposit it into the cup. A journey there and back, told through clouds.\n\nSHOT 1 [0–2s]: Wide café — the MERIDIAN cup on the table, two small perfect clouds hovering above it, rotating slowly. One cloud begins to grow, darkening slightly, purposeful. It drifts toward the café window and presses through the glass. Sound: café ambient, the cloud humming with intent, a shift in pressure.\n\nSHOT 2 [2–5s]: The cloud is now outside and rising rapidly — above the city, above the ocean, accelerating south. The camera rides with it. Below, green coastlines give way to the Andes rising from the earth, mist-covered peaks, and then — the Colombian coffee region: impossibly steep green hillsides terraced with rows of coffee plants in deep emerald and red, small farms dotted across the slopes, mist hanging in the valleys, golden morning light breaking over the ridgeline. Sound: wind and altitude, the world below, the coffee farms breathing.\n\nSHOT 3 [5–8s]: The cloud descends slowly over the coffee farm — drifting between rows of coffee plants heavy with bright red cherries, the plants reaching up into the mist, a farmer moving between the rows in the early light. The cloud absorbs the red cherry colour, the soil smell, the mountain air, the morning — visibly deepening in colour, warming from white to the faintest amber-brown. Sound: farm birds, coffee cherries in the breeze, the mist, soil and altitude and rain all at once.\n\nSHOT 4 [8–11s]: The amber-tinged cloud rises again, now full and heavy with the essence of the farm, and begins its journey back — rushing north over ocean and city, shrinking as it travels, carrying everything it collected.\n\nSHOT 5 [11–15s]: Back in the café — the cloud descends into the MERIDIAN cup, dissolving into the coffee, releasing everything it carried: the altitude, the cherry, the mist, the soil, the morning. The coffee glows faintly richer. A pair of hands lifts the cup. One sip. Their eyes close. Sound: the cloud dissolving, the coffee deepening, the sip, and then — very faintly — the sound of the Colombian hillside, just for a moment, then the café returning.47:T13c9,Image 1 is a three-panel character sheet for MAN A, the man in plaid: a slim young man in his twenties, warm brown skin, close-cropped bleached-blond hair, grey-and-black buffalo-check flannel shirt worn buttoned, black tapered trousers, black high-top canvas sneakers. Use it for his face, hair, build, and wardrobe.\nImage 2 is a three-panel character sheet for MAN B, the man in glasses: a young Black man in his twenties, short natural hair, round black-framed glasses, thin moustache, small gold hoop earring, olive-green nylon coach jacket unzipped over a black crew tee, stone-beige cargo pants, cream chunky sneakers. Use it for his face, glasses, build, and wardrobe.\nImage 3 is the location, lighting, lens character, and color grade: the open top deck of a weathered concrete parking garage, painted stall lines, scattered light poles, a low mechanical housing at the right, steel pipe railings, a hazy city skyline on the horizon, low sun flaring above the frame, warm haze, gentle anamorphic-style flare, long hard shadows on the concrete.\nImage 4 is the blocking and framing reference for the profile two-shot: both men facing each other in clean side profile, separated by a body's width, skyline soft behind them.\nImage 5 is the framing reference for the over-the-shoulder favoring MAN A.\nImage 6 is the framing reference for the over-the-shoulder favoring MAN B.\n\nTwo friends square off on an empty rooftop parking deck at golden hour and snap each other into enormous chicken mascot costumes, played completely straight as live-action comedy, covered in clean cinematic coverage with a hazy backlit skyline behind them.\n\n0–3s [Medium profile two-shot, tripod-locked, matching Image 4] The two men stand facing each other on the empty deck, weight settled, holding eye contact like an unspoken challenge. MAN A slowly lifts his right arm straight out to shoulder height, hand open, fingers relaxed, deliberate and theatrical. Wind moves across open concrete, distant city traffic hum, the faint scuff of a sneaker.\n\n3–5s [Same locked profile two-shot, no camera move] MAN A brings thumb and middle finger together and snaps once, sharp and loud. On the exact frame of the snap, MAN B is instantly replaced in place by a comically oversized chicken mascot costume — huge round yellow feathered body, floppy red comb and wattle, stubby orange felt legs, enormous padded wing-mitts, an absurdly large chicken head. His real face, glasses and all, stays visible inside the open oval beneath the beak. No dissolve, no morph, no particles: a single-frame swap, as if the costume was always there. His stance and position are unchanged. A crisp finger snap, a soft whump of foam and fabric settling.\n\n5–8s [Over-the-shoulder favoring MAN A, matching Image 5, slight handheld drift] MAN A breaks first, laughing hard, head tipping back, one hand rising to his chest, delighted with himself. The giant chicken stands motionless in the soft foreground, feathers riffling in the wind. Genuine open laughter, wind, the light rustle of costume fabric.\n\n8–11s [Over-the-shoulder favoring MAN B, matching Image 6, slow push in] The chicken raises one oversized wing-mitt to shoulder height, unimpressed, and snaps. On the frame of that snap, MAN A is instantly replaced in his exact position by a matching oversized chicken mascot costume in the same build and design, his own face still visible beneath the beak, laughter cut short into a stunned blink. Again a hard single-frame swap with no transition effect. An exaggerated snap, a heavy foam thud.\n\n11–15s [Wide shot from the far side of the deck, matching the framing and horizon of Image 3, static] Two enormous chicken mascots stand squared off in the middle of the vast empty parking deck, long shadows stretched across the concrete, skyline hazy behind them. The chicken with MAN A's face lifts his chin and says, evenly, with dry amusement: \"Okay, I see you. Game on.\" He raises one wing-mitt and snaps a third time. Cut to black on the snap. Wind, distant traffic, the final snap ringing out, then silence.\n\nOverall requirements: both faces must remain consistent throughout and must stay clearly visible inside the mascot head openings at all times — no face changes, no identity drift, no mask covering either performer's face. Wardrobe under and around the costumes matches Images 1 and 2 wherever visible. Both chicken costumes are the same design and comically oversized relative to the men, so the proportions read as a joke played straight. Every costume change is an instantaneous in-place swap on the frame of the snap, never a fade, morph, glow, or particle effect; camera framing, lighting, and body position stay identical across the swap frame. Keep the location, low golden-hour backlight, warm haze, long shadows, filmic contrast, and lens character consistent with Image 3 in every shot. Performances are deadpan and grounded; no mugging at camera. Environmental audio only — wind across open concrete, distant city hum, fabric rustle, and the three snaps. No subtitles.44:[\"$\",\"$L45\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"common\":{\"learnMore\":\"Learn more\",\"runwayHome\":\"Runway home\",\"getStarted\":\"Get