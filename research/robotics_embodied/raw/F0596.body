/15 active:bg-[#F7F7F7]/25 shrink-0" role="link" target="_blank" href="https://summit.runway.com/?utm_source=marketing-site&amp;utm_medium=banner&amp;utm_campaign=sf-summit-tickets">Buy tickets<span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></span></a></div></div></div><div class="flex-1"><main><script type="application/ld+json">[{"@context":"https://schema.org","@type":"TechArticle","headline":"Introducing Runway GWM-1","description":"GWM-1: our state-of-the-art General World Model, built to simulate reality in real time. Interactive, controllable and general-purpose.","url":"https://runway.com/research/introducing-runway-gwm-1","datePublished":"2025-12-11T16:22:35.195Z","dateModified":"2025-12-11T16:22:35.195Z","author":{"@id":"https://runway.com/#organization"},"publisher":{"@id":"https://runway.com/#organization"},"image":"https://d3phaj0sisr2ct.cloudfront.net/site/images/research/gwm/gwm-card-01.png"},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://runway.com","name":"Home"}},{"@type":"ListItem","position":2,"item":{"@id":"https://runway.com/research","name":"Research"}},{"@type":"ListItem","position":3,"item":{"name":"Introducing Runway GWM-1"}}]}]</script><div class="bg-white pb-10 lg:pb-20"><main><section data-header-color="light" class="flex lg:aspect-[20/9] flex-col justify-start text-white relative h-[550px] xl:h-auto lg:max-h-[900px] max-w-[1600px] w-full mx-auto min-[1600px]:mt-16 min-[1600px]:rounded-[3px] overflow-hidden"><div class="absolute inset-0 z-0"><div class="object-cover w-full h-full next-video-container"><style>
