ed\":\"Thanks — we’ll email your copy shortly.\",\"expired\":\"Your download link has expired. Complete the form again to get the report.\",\"error\":\"Something went wrong. Please try again.\",\"unavailable\":\"This resource is not available for download yet.\"},\"pricing\":{\"pageTitle\":\"AI Image and Video Pricing from $12/month | Runway AI\",\"pageDescription\":\"Compare Runway pricing plans for AI video generation. Choose from Free, Standard, Pro and Max plans with flexible credits and features.\",\"headerTitle\":\"Choose the Right Plan for You\",\"trustedByLabel\":\"Trusted by 60M+ creators and leading enterprises\",\"monthlyLabel\":\"Monthly\",\"yearlyLabel\":\"Yearly\",\"yearlyDiscount\":\"-20% off\",\"compareTitle\":\"Compare models across plans\",\"compareGenerationsPerMonth\":\"Generations per month\",\"compareGenerationsPerYear\":\"Generations per year\",\"compareCreditsPerMonth\":\"{credits} credits/mo\",\"compareCreditsPerYear\":\"{credits} credits/year\",\"compareGetPlan\":\"Get {plan}\",\"compareCostPerSeconds\":\"{credits} credits/{seconds}s\",\"compareCostPerUnit\":\"{credits} credits/{unit}\",\"compareCostPerCharacters\":\"{credits} credit/{characters} chars\",\"compareCostUnitImage\":\"image\",\"compareCostUnitSong\":\"song\",\"compareCostUnitMin\":\"min\",\"compareCostUnitSecond\":\"s\",\"compareSectionVideo\":\"AI video\",\"compareSectionImage\":\"AI image\",\"compareSectionAudio\":\"AI audio\",\"compareCountVideos\":\"{count, plural, one {# video} other {# videos}}\",\"compareCountImages\":\"{count, plural, one {# image} other {# images}}\",\"compareCountGenerations\":\"{count, plural, one {# generation} other {# generations}}\",\"compareCountCharacters\":\"{count, plural, one {# character} other {# characters}}\",\"compareCountSongs\":\"{count, plural, one {# song} other {# songs}}\",\"compareCountMinutes\":\"{count, plural, one {# minute} other {# minutes}}\",\"compareCountSeconds\":\"{count, plural, one {# second} other {# seconds}}\",\"compareViewMore\":\"View more\",\"compareViewLess\":\"View less\",\"contactUs\":\"Contact Us\",\"contactUsForTeams\":\"for teams and custom solutions.\",\"contactUsCtaLabel\":\"Contact us\",\"contactUsFooter\":\"\u003clink\u003eContact us\u003c/link\u003e for teams and custom solutions.\",\"perUserPerMonth\":\"per user per month\",\"billedMonthly\":\"billed monthly\",\"billedAnnually\":\"billed annually as\",\"freeForever\":\"Free forever.\",\"perEditorPerMonth\":\"per editor per month\",\"scalableForLargeOrganizations\":\"Scalable for large organizations\",\"signUp\":\"Start Free\",\"subscribeNow\":\"Subscribe Now\",\"upgradeToStandard\":\"Get Standard\",\"upgradeToPro\":\"Get Pro\",\"upgradeToMax\":\"Get Max\",\"contactSales\":\"Contact Sales\",\"scheduleDemo\":\"Schedule a Demo\",\"billedAnnuallySave\":\"Billed annually. Save {amount}/year.\",\"creditRollover\":\"Credits roll over 1 mo.\",\"popularLabel\":\"Popular\",\"bestValueLabel\":\"Best value\",\"andMore\":\"and more\",\"unlimited\":\"Unlimited\",\"freeDescription\":\"For people looking to explore Runway's AI Tools\",\"standardDescription\":\"For curious creators trying AI video. Access to all models.\",\"standardDescriptionLaunch\":\"For curious creators trying AI video\",\"proDescription\":\"For creators leveling up their craft. Access to all models and audio tools.\",\"proDescriptionLaunch\":\"For creators leveling up their craft\",\"maxDescription\":\"Best value for heavy usage.\",\"maxDescriptionLaunch\":\"Best value for heavy solo usage\",\"everythingInPro\":\"Everything in Pro\",\"creditsRollover1Month\":\"Unused credits roll over 1 month\",\"firstAccessNewestModels\":\"First access to newest models\",\"highestGenerationVolume\":\"Highest generation volume\",\"studioGradeFormats\":\"Studio-grade formats (ProRes, image sequences)\",\"hdrGenerations\":\"HDR generations (Up to 16 bit)\",\"enterpriseDescription\":\"For teams scaling AI video production.\",\"maxUsersPerWorkspace\":\"Max. {maxSeats} users per workspace.\",\"includesAllProFeatures\":\"Includes all Pro Plan features\",\"includesAllProFeaturesPlus\":\"Includes all Pro Plan features, plus:\",\"sso\":\"Single sign-on\",\"customCredits\":\"Custom credit amounts\",\"configurableSpaces\":\"Configurable organization and team spaces to organize users and assets\",\"advancedSecurity\":\"Advanced security and compliance\",\"enterpriseOnboarding\":\"Enterprise-wide onboarding\",\"successProgram\":\"Ongoing success program\",\"prioritySupport\":\"Priority support\",\"internalToolsIntegration\":\"Integration with internal tools\",\"workspaceAnalytics\":\"Workspace Analytics\",\"includesCreditsMonthly\":\"Includes {credits} credits monthly\",\"includesCreditsOneTime\":\"Includes {credits} credits (one time)\",\"freeCreditsHint\":\"125 credits = 25s of Gen-4 Turbo, or 25 image generations.\",\"standardCreditsHint\":\"625 credits = 52s of Gen-4.5, 52s of Gen-4, 125s of Gen-4 Turbo, 78 Gen-4 Images (1080p), or 31 Nano Banana Pro images (2K).\",\"proCreditsHint\":\"2250 credits = 187s of Gen-4.5, 187s of Gen-4, 450s of Gen-4 Turbo, 281 Gen-4 Images (1080p), or 112 Nano Banana Pro images (2K).\",\"maxCreditsHint\":\"9500 credits = 791s of Gen-4.5, 791s of Gen-4, 1900s of Gen-4 Turbo, 1187 Gen-4 Images (1080p), or 475 Nano Banana Pro images (2K).\",\"everythingInFreeAnd\":\"Everything in Free and...\",\"everythingInStandardAnd\":\"Everything in Standard and...\",\"everythingInProAnd\":\"Everything in Pro and...\",\"accessToAllApps\":\"Access to all Apps\",\"abilityToRunWorkflows\":\"Ability to run Workflows\",\"generativeVideo\":\"Generative Video\",\"generativeImage\":\"Generative Image\",\"generativeAudio\":\"Generative Audio\",\"selectionOfGenerativeModels\":\"A selection of generative creative models to test concepts\",\"alephVideoEditing\":\"Aleph (Video Editing)\",\"gen45TextToVideo\":\"Gen-4.5 (Text to Video)\",\"gen4ImageToVideo\":\"Gen-4 (Image to Video)\",\"gen4TurboImageToVideo\":\"Gen-4 Turbo (Image to Video)\",\"actTwoPerformanceCapture\":\"Act-Two (Performance Capture)\",\"veo31\":\"Veo 3.1\",\"veo3\":\"Veo 3\",\"videoApps\":\"Video Apps\",\"gen4TextToImageRefs\":\"Gen-4 (Text to Image, References)\",\"gemini3Pro\":\"Gemini 3 Pro\",\"gemini25\":\"Gemini 2.5\",\"imageApps\":\"Image Apps\",\"textToSpeech\":\"Text to Speech\",\"audioApps\":\"Audio Apps\",\"upscaleResolution\":\"Upscale resolution\",\"allVideoModels\":\"All video models\",\"removeWatermarks\":\"Remove watermarks\",\"creditsRefreshMonthly\":\"Credits refresh monthly\",\"noRateRestrictions\":\"No rate restrictions\",\"buyMoreCredits\":\"Buy more credits\",\"storageAmount\":\"{amount}GB asset storage\",\"unlimitedVideoEditorProjects\":\"Unlimited video editor projects\",\"videoEditorProjects\":\"{count} video editor projects\",\"technicalSupport\":\"Technical support via Runway dashboard\",\"createCustomVoices\":\"Create Custom Voices for Lip Sync and Text to Speech\",\"exploreMode\":\"Explore Mode\",\"exploreModeDescription\":\"Unlimited generations of all image and video generation models, in Explore mode at relaxed rate\",\"accessThirdPartyVideoModels\":\"Access to all third party video models (Seedance 2.0, Kling 3.0 Pro, and more)\",\"accessThirdPartyImageModels\":\"Access to all third party image models (BFL FLUX.2 [max], Seedream 5.0, and more)\",\"configurableTeamspaces\":\"Configurable teamspaces to segment and organize assets\",\"customCreditAllowance\":\"Custom credit allowance\",\"noExploreMode\":\"No Explore mode\",\"perMonth\":\"/month\",\"perMonthShort\":\"/mo\",\"creditsAmount\":\"{amount} credits\",\"creditsMonthly\":\"{credits} credits monthly\",\"customCreditsLabel\":\"Custom credits\",\"allImageVideoModels\":\"All AI images and video models (Gen-4.5, Nano Banana Pro, Aleph, Veo 3.1, and more)\",\"upscaling4k\":\"4K Upscaling\",\"noWatermarks\":\"No watermarks\",\"everythingInStandard\":\"Everything in Standard\",\"everythingInMax\":\"Everything in Max\",\"accessBestModels\":\"Access to best models\",\"rollOverUnusedCredits\":\"Roll over unused credits for 1 month\",\"configurableTeamspacesShort\":\"Configurable teamspaces\",\"customTeamSizes\":\"Custom team sizes\",\"freeCreditsHintStatic\":\"125 one-time credits to explore Runway's AI tools.\",\"standardCreditsHintStatic\":\"625 credits monthly = 52s of Gen-4.5, 104s of Gen-4 Turbo, or 78 Gen-4 Images (1080p).\",\"proCreditsHintStatic\":\"2250 credits monthly = 187s of Gen-4.5, 375s of Gen-4 Turbo, or 281 Gen-4 Images (1080p).\",\"enterpriseCreditsHint\":\"Custom credit packages tailored to your team's usage needs.\",\"faqItems\":[{\"question\":\"Can I change my plan after subscribing?\",\"answer\":\"Yes. You can upgrade at any time and the change takes effect immediately — upgrades are prorated, so you only pay the time-adjusted difference and receive the additional credits right away. If you downgrade, the unused balance is applied as a credit toward your next billing cycle and your current plan stays active until then.\"},{\"question\":\"How do credits work?\",\"answer\":\"Credits are the unit you spend to generate images, video, and audio on Runway. Each model uses a set number of credits per generation depending on the model, duration, and resolution — for example, Gen-4.5 uses 12 credits per second of generated video. Paid plans include a monthly credit allotment, and the Free plan includes a one-time deposit of 125 credits that doesn't expire.\"},{\"question\":\"What if I need more credits?\",\"answer\":\"If you need more credits, you can purchase additional credits from the Plans \u0026 Billing page in your dashboard. The minimum purchase is 1,000 credits.\"},{\"question\":\"Do my credits roll over or expire?\",\"answer\":\"On the Standard and Pro plans, monthly credits don't roll over — they reset within 24 hours of your billing date each cycle. On the Max plan, up to one month of unused credits rolls over to the following month. Any additional credits you purchase never expire.\"}],\"creativeTabLabel\":\"Runway Creative\",\"devTabLabel\":\"Runway Dev\",\"devTabsAriaLabel\":\"Pricing categories\",\"devFreeName\":\"Pay as you go\",\"devFreeDescription\":\"Everything you need to build and scale AI media\",\"devFreeCta\":\"Get started free\",\"devFreeFeatures\":[\"Access to all the best AI media models from Runway and other labs\",\"Cost efficiency and optimization tools\",\"Complete ownership of your outputs\",\"Single vendor, unified billing across every model\",\"Recipes that return a production-ready asset in one request\",\"Model Router, selecting the best model according to your rules\",\"Workflows for production workloads at scale\",\"Characters for interactive, agentic avatars\",\"Get started free, no credit card required\"],\"devEnterpriseName\":\"Enterprise\",\"devEnterpriseDescription\":\"Best for companies deploying AI media at scale\",\"devEnterpriseCta\":\"Contact Sales\",\"devEnterpriseEverythingInFree\":\"Everything in Pay as you go, plus:\",\"devEnterpriseFeatures\":[\"Enterprise terms \u0026 MSA\",\"Support for zero-data retention\",\"Uncapped IP indemnification\",\"Forward deployed creative and engineering support\",\"Advanced governance and security\",\"Support and uptime SLAs\"],\"devModelPricingTitle\":\"Pay only for the models you use\",\"devModelPricingDescription\":\"Transparent, usage-based pricing across every model. All under one invoice.\",\"devModelPricingRows\":[{\"label\":\"Video\",\"value\":\"From $0.05 / sec\"},{\"label\":\"Image\",\"value\":\"From $0.01 / image\"},{\"label\":\"Audio\",\"value\":\"From $0.0025 / sec\"}],\"devModelPricingCta\":\"See full model pricing\",\"individualTabLabel\":\"Individual\",\"teamTabLabel\":\"Team \u0026 Enterprise\",\"apiTabLabel\":\"API\",\"accessAllVideoImageModels\":\"Access to all AI video \u0026 image models\",\"agenticCreativeCollaborator\":\"Agentic creative collaborator\",\"parallelGenerations\":\"Parallel generations: {count} videos \u0026 images\",\"musicVoiceSfxGeneration\":\"Music, voice \u0026 sound effects generation\",\"upToProjects\":\"Up to {count} projects\",\"upscaling4kSentence\":\"4K upscaling\",\"storageAmountShort\":\"{amount}GB storage\",\"oneBrandKit\":\"1 Brand Kit\",\"upToThreeBrandKits\":\"Up to 3 Brand Kits\",\"oneCustomVoiceClone\":\"1 custom voice clone\",\"upToThreeCustomVoiceClones\":\"Up to 3 custom voice clones\",\"topUpCreditsAnytime\":\"Top-up credits anytime\",\"runwayMcp\":\"Runway MCP\",\"unlimited4kUpscaling\":\"Unlimited 4K video upscaling\",\"earlyAccessNewModels\":\"Early access to new models\",\"studioGradeQualityGenerations\":\"Studio-grade quality generations: HDR, ProRes, image sequences\",\"annualSavingsBadge\":\"20% off\",\"annualLabel\":\"Annual\",\"annualBillingAriaLabel\":\"Annual billing\",\"teamPlanName\":\"Team\",\"teamNewBadge\":\"New\",\"teamPlanDescription\":\"Best for fast-moving teams with high production needs\",\"teamPlanCta\":\"Get Team\",\"teamPerSeatPerMonth\":\"/seat/month\",\"teamBilledAnnuallyShort\":\"billed annually\",\"teamBilledMonthlyShort\":\"billed monthly\",\"teamCreditsAmount\":\"{credits} credits/year\",\"teamCreditsAmountMonthly\":\"{credits} credits/month\",\"teamCreditsForTeam\":\"total for the team\",\"teamSeatCount\":\"{count, plural, one {# user} other {# users}}\",\"teamSeatDecreaseAriaLabel\":\"Decrease number of users\",\"teamSeatIncreaseAriaLabel\":\"Increase number of users\",\"teamFeatureSections\":[{\"category\":\"Team \u0026 collaboration\",\"items\":[{\"label\":\"2 to 9 members in one workspace\",\"included\":true},{\"label\":\"Up to 100 shared projects\",\"included\":true},{\"label\":\"Frame-accurate commenting, including @mentioning your teammates\",\"included\":true},{\"label\":\"Asset lineage\",\"included\":false}]},{\"category\":\"Creative capabilities\",\"items\":[{\"label\":\"Access to all models \u0026 apps\",\"included\":true},{\"label\":\"Parallel generations: 24 video \u0026 images\",\"included\":true},{\"label\":\"Studio-grade formats (ProRes, image sequences)\",\"included\":true},{\"label\":\"HDR generations (Up to 16-bit)\",\"included\":true},{\"label\":\"Up to 100 Brand Kits to keep your team's output consistent\",\"included\":true},{\"label\":\"Create and share custom agent skills\",\"included\":true}]},{\"category\":\"Scale \u0026 usage\",\"items\":[{\"label\":\"Shared credit pool\",\"included\":true},{\"label\":\"Top up credits anytime\",\"included\":true},{\"label\":\"API access with credit-based usage\",\"included\":true},{\"label\":\"Usage reporting\",\"included\":true},{\"label\":\"1TB storage\",\"included\":true},{\"label\":\"Workspace tags for cost centers\",\"included\":false},{\"label\":\"Advanced usage reporting\",\"included\":false}]},{\"category\":\"Admin, security \u0026 compliance\",\"items\":[{\"label\":\"User roles \u0026 permissions\",\"included\":false},{\"label\":\"Sharing policies\",\"included\":false},{\"label\":\"Custom SSO\",\"included\":false},{\"label\":\"3P model configuration\",\"included\":false},{\"label\":\"Tiered-admin management\",\"included\":false},{\"label\":\"Enterprise-grade security\",\"included\":false},{\"label\":\"Legal indemnification\",\"included\":false}]},{\"category\":\"Support \u0026 services\",\"items\":[{\"label\":\"Priority support\",\"included\":true},{\"label\":\"Dedicated support including training and live Q\u0026A\",\"included\":false},{\"label\":\"Onboarding services with forward deployed creatives\",\"included\":false}]}],\"teamEnterpriseName\":\"Enterprise\",\"teamEnterpriseDescription\":\"Built for organizations: security, privacy, admin controls and dedicated support\",\"teamEnterprisePriceLabel\":\"Let's talk\",\"teamEnterpriseCreditsAmount\":\"Custom credits/year\",\"teamEnterpriseCreditsNote\":\"Pay as you scale your usage\",\"teamEnterpriseCta\":\"Contact sales\",\"teamEnterpriseLearnMoreCta\":\"Learn more\",\"teamEnterpriseFeatureSections\":[{\"category\":\"Team \u0026 collaboration\",\"items\":[{\"label\":\"Unlimited members \u0026 workspaces\",\"included\":true},{\"label\":\"Unlimited shared projects\",\"included\":true},{\"label\":\"Frame-accurate commenting, including @mentioning your teammates\",\"included\":true},{\"label\":\"Asset lineage\",\"included\":true}]},{\"category\":\"Creative capabilities\",\"items\":[{\"label\":\"Access to all models \u0026 apps\",\"included\":true},{\"label\":\"Parallel generations: 30 video \u0026 images\",\"included\":true},{\"label\":\"Studio-grade formats (ProRes, image sequences)\",\"included\":true},{\"label\":\"HDR generations (Up to 16-bit)\",\"included\":true},{\"label\":\"Unlimited Brand Kits\",\"included\":true},{\"label\":\"Unlimited custom agent skills\",\"included\":true}]},{\"category\":\"Scale \u0026 usage\",\"items\":[{\"label\":\"Shared credit pool\",\"included\":true},{\"label\":\"Top up credits anytime\",\"included\":true},{\"label\":\"API access with credit-based usage\",\"included\":true},{\"label\":\"Usage reporting\",\"included\":true},{\"label\":\"Custom storage\",\"included\":true},{\"label\":\"Workspace tags for cost centers\",\"included\":true},{\"label\":\"Advanced usage reporting\",\"included\":true}]},{\"category\":\"Admin, security \u0026 compliance\",\"items\":[{\"label\":\"User roles \u0026 permissions\",\"included\":true},{\"label\":\"Sharing policies\",\"included\":true},{\"label\":\"Custom SSO\",\"included\":true},{\"label\":\"3P model configuration\",\"included\":true},{\"label\":\"Tiered-admin management\",\"included\":true},{\"label\":\"Enterprise-grade security: SOC 2 \u0026 ISO/IEC 27001 compliant\",\"included\":true},{\"label\":\"Enterprise legal indemnification\",\"included\":true},{\"label\":\"No training on your data\",\"included\":true}]},{\"category\":\"Support \u0026 services\",\"items\":[{\"label\":\"Priority support\",\"included\":true},{\"label\":\"Dedicated support including training and live Q\u0026A\",\"included\":true},{\"label\":\"Onboarding services with forward deployed creatives\",\"included\":true}]}]},\"sales\":{\"triageLabel\":\"How can we help you?\",\"triageDefaultOption\":\"Select an option\",\"triageBillingOption\":\"I need help with billing and support\",\"triageSalesOption\":\"I'm interested in an enterprise subscription\"},\"about\":{\"pageTitle\":\"About Runway AI Video Platform | Runway AI\",\"pageDescription\":\"Learn about Runway's mission to make AI video generation accessible to creators. Discover our team, values and vision for the future of content.\",\"heroTitle\":\"We are building AI to simulate the world \u003cbr class='hidden lg:block'/\u003e through merging art and science.\",\"viewCareers\":\"View Careers\",\"worldModelsParagraph\":\"We believe that world models are at the frontier of progress in artificial intelligence. Language models alone won't solve the world's hardest problems – robotics, disease, scientific discovery. Real progress requires models that experience the world and learn from their mistakes, the same way that humans do. And this kind of trial and error can be massively accelerated when done in simulation, rather than in the real world. World models offer the most clear path to general-purpose simulation.\",\"officesHeading\":\"\u003cline\u003eWe have offices in New York, San Francisco, Seattle, London, Paris, Tel Aviv and Tokyo.\u003c/line\u003e\u003cline\u003eWith team members working remotely from all over the world.\u003c/line\u003e\",\"openRolesHeading\":\"Open Roles\",\"viewAllOpenings\":\"View all openings\"},\"researchSection\":{\"eyebrow\":\"Our Research\",\"headline\":\"We are pioneering general-purpose multimodal simulators of the world.\"},\"openRolesTable\":{\"loading\":\"Loading...\",\"apply\":\"Apply\",\"remote\":\"Remote\"},\"codeTerms30Runway\":{\"pageTitle\":\"Code Terms | Runway\",\"pageDescription\":\"Runway promotional code terms and conditions\",\"heading\":\"Promotional Code Terms\",\"body\":\"By entering the code 30RUNWAY at checkout, qualifying users will receive 30% off the purchase of any paid plan. Discount applies to either the first three months for monthly subscriptions or to the one-time purchase of a yearly plan. To redeem, upgrade your Runway account. Discount and promotion only valid for redemption on runway.com and not on any products or services offered by third party resellers. Offer limited to one use per subscriber and does not apply to existing Standard, Pro, Max, Unlimited, or Enterprise accounts. Discount will be applied to your subtotal before tax. Offer expires on June 30th, 2026 at 11:59:59 PM ET. This offer may not be combined with cash or other discounts or promotions. Offer and participation are subject to the Runway Terms of Use, available at \u003clink\u003ehttps://runway.com/terms-of-use\u003c/link\u003e. Runway reserves the right to modify or amend this promotion and discount at any time.\"},\"useCasePages\":{\"common\":{\"tryNow\":\"Try now\",\"breadcrumbHome\":\"Home\",\"breadcrumbUseCases\":\"Use cases\",\"relatedTitle\":\"More ways to use Runway\",\"relatedDescription\":\"Runway turns photos, footage and plain-language descriptions into professional video and imagery: one workspace whether you are marketing a business, telling a story or teaching something.\",\"relatedReadMore\":\"Explore the use case\"},\"hub\":{\"pageTitle\":\"AI Video Use Cases: Business, Music, Film and Education | Runway\",\"pageDescription\":\"Explore how people use Runway to make video: UGC and product ads, real estate and restaurant promos, music videos, vertical drama, explainers and training.\",\"heroEyebrow\":\"Use cases\",\"heroTitle\":\"AI video for whatever you make\",\"heroDescription\":\"Runway turns photos, footage and plain-language descriptions into professional video and imagery. Find the work you do and see how people like you use it.\",\"gridTitle\":\"Find your use case\",\"endCtaTitle\":\"Start making videos today\",\"endCtaDescription\":\"Try Runway for free. No filming, no editing suite, no learning curve.\"},\"ugcAds\":{\"pageTitle\":\"AI UGC Video Generator: UGC-Style Ads in Minutes | Runway\",\"pageDescription\":\"Make UGC-style video ads with AI on Runway. Turn product photos into authentic 9:16 TikTok and Reels ads in minutes, no filming, no editing.\",\"heroEyebrow\":\"Runway for UGC ads\",\"heroTitle\":\"Make UGC ads with AI\",\"heroDescription\":\"Generate authentic, phone-shot-style UGC video for TikTok Shop, Reels and Shorts from a product photo and a description. Test new hooks every day, as many variations as you need.\",\"cardTitle\":\"UGC ads\",\"cardDescription\":\"Authentic 9:16 UGC-style video for TikTok and Reels, straight from your product photos.\",\"stepsTitle\":\"How to make UGC ads on Runway\",\"steps\":[{\"title\":\"Start from your product\",\"description\":\"Upload photos of your product as references so it stays exactly right (packaging, colors and logo) in every generation.\"},{\"title\":\"Describe the scene\",\"description\":\"Write it like a shot brief in plain language: a handheld unboxing in a home kitchen, a 15-second vertical clip, real-phone look with natural lighting.\"},{\"title\":\"Generate variations and post\",\"description\":\"Create multiple takes with different hooks, pick the winners and download vertical video ready for TikTok, Reels and Shorts.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Native vertical output\",\"description\":\"Generate in 9:16 from the start. No cropping a widescreen shot into a phone format after the fact.\"},{\"title\":\"Your product, exactly\",\"description\":\"Reference images lock the product's packaging, colors and logo so every variation stays on-model.\"},{\"title\":\"Handheld realism\",\"description\":\"Prompt for the phone-shot look that performs in-feed: slight camera shake, natural light, real rooms instead of studio sets.\"},{\"title\":\"Hooks at test volume\",\"description\":\"Generate a batch of openings for the same product and let the ad platform tell you which one converts.\"},{\"title\":\"Any market, any language\",\"description\":\"Prompt in your own language and set the scene for the market you sell into: a US bathroom, a Mexico City living room, a São Paulo kitchen.\"}],\"midCtaTitle\":\"Ship your next UGC ad today.\",\"faq\":[{\"question\":\"What is an AI UGC video generator?\",\"answer\":\"A tool that creates user-generated-content-style video (the casual, phone-shot format that performs on TikTok and Reels) with AI instead of a camera. On Runway you generate it from your product photos and a plain-language description of the scene.\"},{\"question\":\"How fast can I test new ad creative?\",\"answer\":\"Describe the presenter, the setting and the action, and generate the video directly. You can produce fresh creative daily and test a new hook, angle or format for every campaign.\"},{\"question\":\"Does this work for TikTok Shop products?\",\"answer\":\"Yes. Short vertical product demos are one of the most common things sellers make on Runway. Upload your product photos as references, describe a 15-second 9:16 scene, and generate ad-ready clips.\"},{\"question\":\"How do I keep my product looking exactly right?\",\"answer\":\"Upload clear photos of your product as reference images and tell the model to keep it identical. Our models preserve packaging, labels, colors and proportions from your references.\"},{\"question\":\"Can I make UGC ads in Spanish, Portuguese or other languages?\",\"answer\":\"Yes. Prompt in your language and stage the scene for your market. Sellers use Runway to localize the same product ad for the US, Mexico, Brazil and beyond, and the model will generate speech in that language.\"},{\"question\":\"What formats can I export for TikTok and Reels?\",\"answer\":\"Vertical 9:16 for TikTok, Reels and Shorts, plus square and widescreen. Clips are built for short-form and can be sequenced into longer cuts.\"},{\"question\":\"Can I run the videos as paid ads on TikTok and Meta?\",\"answer\":\"Yes. You own full commercial rights to the video you create with Runway and can run it as paid media on TikTok, Meta, YouTube and anywhere else you advertise.\"},{\"question\":\"Can I generate UGC ads from ChatGPT or Claude?\",\"answer\":\"Yes. Runway's MCP integration lets you generate video and images directly inside ChatGPT and Claude. Describe the ad in your chat and Runway makes it. Set it up at runwayml.com/mcp.\"},{\"question\":\"What else can Runway make besides UGC ads?\",\"answer\":\"Polished product commercials, fashion and beauty spots, restaurant promos, real-estate videos and more. The same workspace covers every format your marketing needs.\"}],\"endCtaTitle\":\"Your next hundred ad creatives are a prompt away\",\"endCtaDescription\":\"Start free and generate your first UGC-style ad today.\"},\"realEstate\":{\"pageTitle\":\"AI Real Estate Video Generator for Listings | Runway\",\"pageDescription\":\"Turn listing photos into cinematic property videos with AI. Interior walkthroughs, aerial-style exteriors and social-ready listing clips in minutes.\",\"heroEyebrow\":\"Runway for real estate\",\"heroTitle\":\"AI video for real estate\",\"heroDescription\":\"Turn listing photos into cinematic property video: smooth interior camera moves, aerial-style exteriors and social-ready clips that make every listing look its best.\",\"cardTitle\":\"Real estate\",\"cardDescription\":\"Listing photos become cinematic walkthroughs and aerial-style exteriors.\",\"stepsTitle\":\"How to make listing videos on Runway\",\"steps\":[{\"title\":\"Upload your listing photos\",\"description\":\"Start from the photos you already have: interiors, exteriors, details. Runway preserves the rooms, finishes and layout in your images.\"},{\"title\":\"Choose the camera move\",\"description\":\"Describe the shot in plain language: a slow push through the kitchen, an orbit around the facade, a drone-style rise over the roofline at golden hour.\"},{\"title\":\"Generate and share\",\"description\":\"Create clips for the MLS, YouTube and Instagram (vertical for Reels, widescreen for the listing page) and post the same day the listing goes live.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Interior camera moves\",\"description\":\"Push-ins, pans and continuous moves through the home, generated from still photos. No gimbal, no reshoot.\"},{\"title\":\"Aerial-style exteriors\",\"description\":\"Drone-look flyovers and rises from ground-level exterior shots — no drone required.\"},{\"title\":\"Golden hour on demand\",\"description\":\"Take a midday exterior to dusk with warm windows and a sunset sky for the hero shot every listing wants.\"},{\"title\":\"Every listing format\",\"description\":\"Vertical clips for Reels and TikTok, widescreen for YouTube and the MLS, square for feeds, all from the same photos.\"}],\"midCtaTitle\":\"Make your next listing impossible to scroll past.\",\"faq\":[{\"question\":\"Can AI make a video from my listing photos?\",\"answer\":\"Yes. Upload your listing photos and describe the camera move you want. Runway generates smooth video from stills while preserving the rooms, finishes and layout in your images.\"},{\"question\":\"Do I need a drone for aerial shots?\",\"answer\":\"No. Generate drone-style flyovers and rises from a ground-level exterior photo. You get the aerial look without the pilot, the permit or the weather window.\"},{\"question\":\"Can I change the time of day or sky?\",\"answer\":\"Yes. Turn a midday exterior into a golden-hour or twilight shot. Cosmetic look changes are your call; check your local listing rules on edited imagery before publishing.\"},{\"question\":\"Will the video stay true to the property?\",\"answer\":\"Our models preserve the spaces in your reference photos. You control the prompt, so you decide what is enhanced (lighting, sky, camera motion) and what stays untouched.\"},{\"question\":\"Can I use this for virtual staging?\",\"answer\":\"Yes. Runway's image models can restyle and furnish rooms from a photo, and you can then animate the staged image into video.\"},{\"question\":\"How fast can I turn a video around?\",\"answer\":\"Minutes. Most agents generate the clips the same day the photographer delivers stills, so video goes up with the listing instead of a week later.\"},{\"question\":\"Can I use the videos commercially in my listings?\",\"answer\":\"Yes. You own full commercial rights to what you create with Runway. Use it on the MLS, your site, social media and paid ads.\"},{\"question\":\"Can I create listing videos from ChatGPT or Claude?\",\"answer\":\"Yes. Connect Runway to ChatGPT or Claude with the Runway MCP integration and generate listing videos without leaving your chat. Setup takes a minute at runwayml.com/mcp.\"},{\"question\":\"What else can Runway make for my real estate business?\",\"answer\":\"Beyond listings: neighborhood promos, agent-brand videos, renovation before-and-afters and ads for every local business you work with.\"}],\"endCtaTitle\":\"Every listing deserves a film\",\"endCtaDescription\":\"Start free and turn your current listing's photos into video today.\"},\"homeServices\":{\"pageTitle\":\"AI Video Ads for Contractors \u0026 Home Services | Runway\",\"pageDescription\":\"Marketing videos for roofers, painters, remodelers and landscapers. Turn job-site photos into before-and-after videos and local ads with AI.\",\"heroEyebrow\":\"Runway for home services\",\"heroTitle\":\"AI video for contractors and home services\",\"heroDescription\":\"Turn job-site photos into professional marketing video: before-and-after transformations, drone-style roof shots and local ads that win the next job, with no filming required.\",\"cardTitle\":\"Home services\",\"cardDescription\":\"Job-site photos become before-and-after reveals and local video ads.\",\"stepsTitle\":\"How to make home-services videos on Runway\",\"steps\":[{\"title\":\"Start from job photos\",\"description\":\"Use the photos your crew already takes: the roof, the paint job, the finished remodel. No new equipment, no staged shoot.\"},{\"title\":\"Describe the shot\",\"description\":\"A before-and-after reveal of the renovated kitchen, a slow aerial-style pass over the finished roof, B-roll of a crew at work. Write it in plain language.\"},{\"title\":\"Generate and run it\",\"description\":\"Download clips sized for Facebook, Instagram, YouTube and your website, and put your best work in front of the neighborhood.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Before-and-after reveals\",\"description\":\"Turn a before photo and an after photo into one continuous transformation — the single most convincing ad a contractor can run.\"},{\"title\":\"Drone-style roof and exterior shots\",\"description\":\"Cinematic passes over rooflines, siding and full properties, generated from ground-level photos.\"},{\"title\":\"Job-site B-roll\",\"description\":\"Professional crew-at-work footage (framing going up, paint going on) generated to match your trade.\"},{\"title\":\"Seasonal promos on demand\",\"description\":\"Storm-season roof checks, spring exterior painting, fall cleanups. New creative for every season without a new shoot.\"}],\"midCtaTitle\":\"Turn your last job into your next ad.\",\"faq\":[{\"question\":\"How do contractors use AI video?\",\"answer\":\"Mostly three ways: before-and-after transformation videos of finished jobs, drone-style exterior shots of completed work, and local social ads. All of it can be generated from ordinary job-site photos.\"},{\"question\":\"Can I make a before-and-after video from two photos?\",\"answer\":\"Yes. With models that support start and end frames, upload the before photo as the first frame and the after photo as the last, and Runway generates the transformation between them. You direct the transition in the prompt: a construction timelapse, a paint-roller wipe across the frame, a stop-motion style rebuild, a walkthrough where the renovation completes as the camera moves, or a simple cinematic crossfade.\"},{\"question\":\"Do I need footage of my actual crew?\",\"answer\":\"No. You can generate professional crew-at-work B-roll to match your trade, or animate photos of your real crew and real jobs. Both work.\"},{\"question\":\"Does this work for roofing companies?\",\"answer\":\"Yes. Roof inspections and replacements are a natural fit: aerial-style passes over the finished roof, storm-damage before-and-afters and seasonal promo ads, all from photos.\"},{\"question\":\"What about painters and remodelers?\",\"answer\":\"The same workflow: photograph the job, generate the reveal. Painters animate exterior repaints; remodelers turn kitchen and bath transformations into continuous camera moves.\"},{\"question\":\"Do I need video-production experience?\",\"answer\":\"No. You describe the shot in everyday language and Runway handles the cinematography. If you can write a text message, you can make the ad.\"},{\"question\":\"Can I run the videos as ads for my business?\",\"answer\":\"Yes. You own full commercial rights. Run the videos on Facebook, Instagram, YouTube, your website and anywhere else you advertise.\"},{\"question\":\"Does Runway work inside ChatGPT or Claude?\",\"answer\":\"Yes. If you already plan your marketing in ChatGPT or Claude, connect Runway's MCP integration and generate your videos right there in the conversation. Details at runwayml.com/mcp.\"},{\"question\":\"What else can Runway make for my home services company?\",\"answer\":\"Real-estate style property videos, customer-testimonial-style spots, UGC-format ads and imagery for your website. One workspace for all of it.\"}],\"endCtaTitle\":\"Your work sells itself — show it moving\",\"endCtaDescription\":\"Start free and turn a finished job into a video ad today.\"},\"productVideoAds\":{\"pageTitle\":\"Turn Product Photos into Video Ads | Runway AI\",\"pageDescription\":\"Make polished product commercials from a single photo with AI. 360 spins, cinematic reveals and lifestyle scenes, and your product stays pixel-exact.\",\"heroEyebrow\":\"Runway for product marketing\",\"heroTitle\":\"Turn product photos into video ads\",\"heroDescription\":\"One product photo becomes a polished commercial: 360 spins, cinematic reveals, lifestyle scenes, with the product staying exactly as it looks on your shelf.\",\"cardTitle\":\"Product video ads\",\"cardDescription\":\"A single product photo becomes a polished, pixel-exact commercial.\",\"stepsTitle\":\"How to make product videos on Runway\",\"steps\":[{\"title\":\"Upload your product photo\",\"description\":\"A clean, well-lit shot is all you need. Runway locks onto the product's shape, label and colors as the reference.\"},{\"title\":\"Pick the treatment\",\"description\":\"A slow rotation on black marble, a macro pass over the label, the product in a sunlit kitchen. Describe the commercial you have in mind.\"},{\"title\":\"Generate, iterate, export\",\"description\":\"Create multiple takes, refine the one you like, and export in every aspect ratio your channels need.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Your product, pixel-exact\",\"description\":\"Reference images preserve labels, logos, text and proportions, so the product in the ad is the product in the box.\"},{\"title\":\"360 spins and turntables\",\"description\":\"Show every side of the product from a single photo: rotations, orbits and tabletop turntable shots.\"},{\"title\":\"Cinematic reveals\",\"description\":\"Studio lighting, slow push-ins, macro detail passes and dramatic product-hero moments that read as a high-end commercial.\"},{\"title\":\"Lifestyle context\",\"description\":\"Place the product in the scene where it's used (a kitchen counter, a gym bag, a beach at golden hour) without a location shoot.\"},{\"title\":\"Multi-scene commercials\",\"description\":\"Sequence generated shots into a full spot: hook, feature close-ups, lifestyle beauty shot, end card.\"}],\"midCtaTitle\":\"Your catalog is a video campaign waiting to happen.\",\"faq\":[{\"question\":\"How do I turn a product photo into a video ad?\",\"answer\":\"Upload the photo, describe the shot (a rotation, a reveal, a lifestyle scene) and generate. Runway animates the product while keeping it identical to your reference.\"},{\"question\":\"Will my label and logo stay accurate?\",\"answer\":\"Yes. Our models preserve packaging details, text, logos and colors from your reference photos. For best results start with a sharp, well-lit product shot and instruct the model to keep the product identical.\"},{\"question\":\"Can I show the product from angles I didn't photograph?\",\"answer\":\"Yes. Generate rotations and new viewpoints from a single reference image, or supply multiple angles for even tighter fidelity.\"},{\"question\":\"Can I make a full commercial, not just one clip?\",\"answer\":\"Yes. Generate each scene (hook, detail shots, lifestyle beauty shot) and sequence them into a complete spot. Multi-shot models can produce several beats in one generation, or ask our agent for a full commercial and it will plan and generate the whole thing.\"},{\"question\":\"What formats can I export?\",\"answer\":\"Vertical for TikTok and Reels, square for feeds, widescreen for YouTube and your product pages. Generate natively in each rather than cropping one master. Download as MP4, or as a GIF for product pages and emails.\"},{\"question\":\"Do I need a studio setup?\",\"answer\":\"No. The photo you already have is the shoot. Lighting, camera motion and set design happen in the prompt.\"},{\"question\":\"Can I use the videos commercially?\",\"answer\":\"Yes. You own full commercial rights to everything you create. Use it in paid ads, marketplaces, your store and social channels.\"},{\"question\":\"Can I generate product videos from ChatGPT or Claude?\",\"answer\":\"Yes. The Runway MCP integration adds video and image generation to ChatGPT and Claude, so you can go from ad concept to finished clip in one chat. Connect it at runwayml.com/mcp.\"},{\"question\":\"What else can Runway make besides product ads?\",\"answer\":\"UGC-style ads, fashion and beauty campaigns, restaurant promos and product photography. The whole content stack from one workspace.\"}],\"endCtaTitle\":\"Every product photo is a commercial in waiting\",\"endCtaDescription\":\"Start free and turn your best-seller's photo into a video ad today.\"},\"restaurants\":{\"pageTitle\":\"AI Restaurant Video Maker \u0026 Food Video Ads | Runway\",\"pageDescription\":\"Appetizing food videos from photos of your real dishes. Steam, texture and dining-room ambience for menus, social media and local ads, made with AI.\",\"heroEyebrow\":\"Runway for restaurants\",\"heroTitle\":\"AI video for restaurants\",\"heroDescription\":\"Turn photos of your dishes into food video that sells: steam rising, macro texture, golden-hour dining room ambience, without closing the kitchen for a shoot.\",\"cardTitle\":\"Restaurants\",\"cardDescription\":\"Dish photos become appetizing food video and dining-room ambience.\",\"stepsTitle\":\"How to make restaurant videos on Runway\",\"steps\":[{\"title\":\"Photograph the dish\",\"description\":\"Use the plates you're already serving. A clear photo in good light is enough to start generating.\"},{\"title\":\"Describe the motion\",\"description\":\"Steam rising off the mandi, cheese pulling on the slice, a slow macro push across the dessert — appetite lives in motion, and you direct it in a sentence.\"},{\"title\":\"Post it everywhere\",\"description\":\"Vertical clips for Reels and TikTok, square for the feed, widescreen for your site and delivery-app listings.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Food that looks fresh off the pass\",\"description\":\"Steam, sizzle, glaze and pull: generated motion that makes a still dish read as just-served.\"},{\"title\":\"Macro texture shots\",\"description\":\"Close-up passes across crumb, char and cream that turn a menu item into a craving.\"},{\"title\":\"Your dining room, cinematic\",\"description\":\"A slow dolly through your actual space at golden hour, generated from photos of the room.\"},{\"title\":\"Specials on a same-day turnaround\",\"description\":\"New dish at 3pm, video ad by 4pm — seasonal menus and daily specials, straight from a photo.\"}],\"midCtaTitle\":\"Make tonight's special impossible to resist.\",\"faq\":[{\"question\":\"Can AI make my food look appetizing?\",\"answer\":\"Yes. Runway works from photos of your real dishes and adds the motion that sells: rising steam, a slow push-in, a syrup pour. The food is yours; the cinematography is generated.\"},{\"question\":\"Do I need professional photos to start?\",\"answer\":\"No. A clear photo of the plate in good light is the whole shoot. Lighting, camera moves and slow motion happen in the prompt.\"},{\"question\":\"Can I show my actual restaurant?\",\"answer\":\"Yes. Upload photos of your dining room and generate cinematic moves through the space. Runway preserves your real interior, tables and lighting.\"},{\"question\":\"How fast can I promote a new menu item?\",\"answer\":\"Same day. Photograph the dish at lunch, generate the clip in minutes, and have it on Instagram before dinner service.\"},{\"question\":\"What formats work for delivery apps and social?\",\"answer\":\"Generate vertical 9:16 for Reels and TikTok, square for feed posts, and widescreen for your website and listings, each natively, from the same dish photo.\"},{\"question\":\"Can I run the videos as local ads?\",\"answer\":\"Yes. You own full commercial rights. Run them as local ads on Instagram, Facebook, TikTok and Google.\"},{\"question\":\"Can I make these videos from ChatGPT?\",\"answer\":\"Yes. Connect the Runway MCP integration to ChatGPT or Claude and ask for your promo right in the chat, no separate tool to learn. See runwayml.com/mcp.\"},{\"question\":\"What else can Runway make for my restaurant?\",\"answer\":\"Chef and staff introduction videos, event promos, seasonal campaign imagery and UGC-style clips. Everything your restaurant's marketing calendar needs.\"}],\"endCtaTitle\":\"Your menu, in motion\",\"endCtaDescription\":\"Start free and turn tonight's best dish into a video.\"},\"carDealerships\":{\"pageTitle\":\"AI Video for Car Dealerships \u0026 Auto Ads | Runway\",\"pageDescription\":\"Turn inventory photos into cinematic vehicle videos with AI. Dealership ads, walkaround-style clips and social content. Same day, no shoot required.\",\"heroEyebrow\":\"Runway for dealerships\",\"heroTitle\":\"AI video for car dealerships\",\"heroDescription\":\"Turn lot photos into cinematic vehicle video: walkaround-style motion, dramatic backdrops and social-ready ads for every unit on the lot, the day it arrives.\",\"cardTitle\":\"Car dealerships\",\"cardDescription\":\"Inventory photos become cinematic vehicle videos and dealership ads.\",\"stepsTitle\":\"How to make dealership videos on Runway\",\"steps\":[{\"title\":\"Shoot the vehicle once\",\"description\":\"The lot photos you already take are the input. Runway preserves the exact trim, wheels, paint and badging.\"},{\"title\":\"Choose the shot\",\"description\":\"A slow orbit in a dark studio, a tracking shot on a coastal road, rain beading on the hood. Describe the commercial look you want.\"},{\"title\":\"Publish with the listing\",\"description\":\"Export widescreen for the vehicle page and vertical for social, and post the video the same day the unit hits the lot.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Cinematic inventory video\",\"description\":\"Every unit gets a hero-quality clip generated from lot photos, not just your flagship trade-ins.\"},{\"title\":\"Walkaround-style motion\",\"description\":\"Orbits, side-profile tracking shots and detail passes that show the vehicle the way a buyer walks around it.\"},{\"title\":\"Any backdrop, exact vehicle\",\"description\":\"Move the car from the lot to a mountain road or a night city street while the trim, wheels and paint stay identical.\"},{\"title\":\"Service and detailing promos\",\"description\":\"Water beading on fresh ceramic coat, before-and-after detail reveals, seasonal service-department ads.\"}],\"midCtaTitle\":\"Every unit on the lot deserves a commercial.\",\"faq\":[{\"question\":\"Can AI make vehicle videos from my inventory photos?\",\"answer\":\"Yes. Upload the photos you already take for listings and describe the shot. Runway generates cinematic motion while preserving the exact vehicle.\"},{\"question\":\"Will the car stay accurate (trim, wheels, paint)?\",\"answer\":\"Yes. Reference photos lock the specific unit's trim, wheels, badging and color. Tell the model to keep the vehicle identical and it stays showroom-exact.\"},{\"question\":\"Can I get walkaround videos without filming?\",\"answer\":\"Yes. Generate orbit and tracking shots from stills, so every listing gets walkaround-style video without anyone picking up a camera.\"},{\"question\":\"Does this work for service and detailing departments?\",\"answer\":\"Yes. Detailing before-and-afters, coating and tint demos, and seasonal service promos are all generated the same way, from photos of the work.\"},{\"question\":\"How fast can I get video for new inventory?\",\"answer\":\"Same day. Photograph the unit at intake, generate clips in minutes, and the listing goes live with video instead of waiting on a production schedule.\"},{\"question\":\"Can I use the videos in dealership ads and listings?\",\"answer\":\"Yes. You own full commercial rights. Run them on Facebook, Instagram, YouTube, marketplace listings and your own site.\"},{\"question\":\"Can I generate inventory videos from ChatGPT or Claude?\",\"answer\":\"Yes. Runway's MCP integration works inside ChatGPT and Claude, so you can describe the vehicle and get the video back in your chat. Setup at runwayml.com/mcp.\"},{\"question\":\"What else can Runway make for my dealership?\",\"answer\":\"Dealership brand spots, promotion and event ads, and refreshed inventory photography. Runway generates images as well as video.\"}],\"endCtaTitle\":\"From lot photo to commercial in minutes\",\"endCtaDescription\":\"Start free and give today's arrival its own video.\"},\"medicalClinics\":{\"pageTitle\":\"AI Video Marketing for Clinics \u0026 Dental | Runway\",\"pageDescription\":\"Marketing videos for dental practices, med spas and clinics. Welcoming office tours, patient explainers and local ads, generated with AI from photos.\",\"heroEyebrow\":\"Runway for clinics\",\"heroTitle\":\"AI video for clinics and dental practices\",\"heroDescription\":\"Welcoming office tours, calm patient-journey explainers and polished local ads, generated from photos of your practice, with no patients on camera and no filming in the office.\",\"cardTitle\":\"Clinics \u0026 dental\",\"cardDescription\":\"Office tours, patient explainers and local ads for practices and med spas.\",\"stepsTitle\":\"How to make clinic videos on Runway\",\"steps\":[{\"title\":\"Photograph your practice\",\"description\":\"Reception, treatment rooms, the details that make your office feel calm and modern. Runway preserves your real space.\"},{\"title\":\"Describe the experience\",\"description\":\"A gentle camera drift through reception, a warm welcome sequence, a step-by-step visit explainer. Script the feeling patients should expect.\"},{\"title\":\"Generate and publish\",\"description\":\"Clips for your website, Google Business Profile, waiting-room screens and local social ads, all from the same photos.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Office tours from photos\",\"description\":\"Smooth camera moves through your actual reception and treatment rooms, the tour prospective patients want before they book.\"},{\"title\":\"Patient-journey explainers\",\"description\":\"Calm, step-by-step visit walkthroughs (check-in to chair) that ease first-appointment anxiety.\"},{\"title\":\"No patients on camera\",\"description\":\"Generated people stand in for real patients, so marketing never touches privacy. No releases, no filming in the office.\"},{\"title\":\"Premium practice aesthetic\",\"description\":\"The soft-lit, high-end clinic look of a national brand campaign, for a single-location practice.\"}],\"midCtaTitle\":\"Show patients the visit before they book it.\",\"faq\":[{\"question\":\"How do clinics and dental practices use AI video?\",\"answer\":\"Three main ways: office tours generated from photos of the practice, patient-journey explainers that walk through a visit, and polished local ads, all without filming in the office.\"},{\"question\":\"Can I show my actual office?\",\"answer\":\"Yes. Upload photos of your reception and treatment rooms, and Runway generates camera moves through your real space while preserving it accurately.\"},{\"question\":\"Do I need patients to appear in the videos?\",\"answer\":\"No — and that's the point. Generated people stand in for patients, so you get warm, human marketing without consent forms, releases or anyone on camera.\"},{\"question\":\"Does this work for med spas and aesthetic clinics?\",\"answer\":\"Yes. The premium clinic aesthetic (soft light, calm interiors, luxury detail shots) is one of the most common looks generated on Runway.\"},{\"question\":\"Can I make explainer videos for treatments?\",\"answer\":\"Yes. Step-by-step visit walkthroughs and what-to-expect sequences work well. You're responsible for keeping claims consistent with your local healthcare advertising rules.\"},{\"question\":\"Can I use the videos in ads for my practice?\",\"answer\":\"Yes. You own full commercial rights. Run them on Google, Instagram, Facebook and your own site.\"},{\"question\":\"Does Runway integrate with ChatGPT or Claude?\",\"answer\":\"Yes. With the Runway MCP integration you can generate practice videos and imagery directly from a ChatGPT or Claude conversation. Connect it at runwayml.com/mcp.\"},{\"question\":\"What else can Runway make for my clinic?\",\"answer\":\"Staff introduction videos, waiting-room content, social posts and refreshed imagery for your website. One workspace for the whole practice.\"}],\"endCtaTitle\":\"A calmer first impression, on every screen\",\"endCtaDescription\":\"Start free and turn photos of your practice into a welcome video.\"},\"fitnessStudios\":{\"pageTitle\":\"AI Gym \u0026 Fitness Studio Video Maker | Runway\",\"pageDescription\":\"Promo videos for gyms, pilates and yoga studios. Turn photos of your space into cinematic tours, class promos and member ads with AI.\",\"heroEyebrow\":\"Runway for fitness\",\"heroTitle\":\"AI video for gyms and fitness studios\",\"heroDescription\":\"Turn photos of your space into cinematic studio tours, class promos and member-drive ads. The premium fitness-brand look without a production budget.\",\"cardTitle\":\"Fitness studios\",\"cardDescription\":\"Studio photos become cinematic tours, class promos and member ads.\",\"stepsTitle\":\"How to make fitness videos on Runway\",\"steps\":[{\"title\":\"Photograph your space\",\"description\":\"The floor, the equipment, the light. Runway preserves your actual studio. Members will recognize it.\"},{\"title\":\"Direct the energy\",\"description\":\"A floating camera through the pilates studio at dawn, a high-energy montage for the new class block, a calm slow drift for the yoga room.\"},{\"title\":\"Generate and post\",\"description\":\"Vertical clips for Reels and TikTok, widescreen for your site. New-member promos, class launches and seasonal offers on demand.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Cinematic studio tours\",\"description\":\"Floating camera moves through your actual space, the premium walkthrough that sells memberships before a visit.\"},{\"title\":\"Class and program promos\",\"description\":\"Launch videos for new classes, challenges and training blocks, in your studio's look.\"},{\"title\":\"Member-drive ads\",\"description\":\"New year, new season, new location: offer-led local ads generated as fast as you can plan the promotion.\"},{\"title\":\"Athletes in motion\",\"description\":\"Generated training footage (lifting, flowing, running) for spots where you need people without scheduling a shoot.\"}],\"midCtaTitle\":\"Your studio looks incredible. Show it.\",\"faq\":[{\"question\":\"How do gyms and studios use AI video?\",\"answer\":\"Studio tours generated from photos of the space, class-launch promos, and member-drive ads for local social: the three videos every fitness business needs.\"},{\"question\":\"Can I show my actual studio?\",\"answer\":\"Yes. Upload photos and Runway generates smooth camera moves through your real space, preserving your equipment, layout and light.\"},{\"question\":\"Can I make videos with people working out?\",\"answer\":\"Yes. Generate athletes and members in motion, or animate photos from your own classes. Generated people mean no releases and no scheduling.\"},{\"question\":\"Does this work for pilates, yoga and boutique studios?\",\"answer\":\"Yes. Calm, premium interior films (soft light, slow floating cameras) are among the most common fitness videos generated on Runway.\"},{\"question\":\"How often can I refresh creative?\",\"answer\":\"As often as you run promotions. New class block, holiday challenge, January push: each gets its own video in minutes, from the photos you already have.\"},{\"question\":\"Can I run the videos as paid ads for my studio?\",\"answer\":\"Yes. You own full commercial rights. Run them on Instagram, TikTok, Facebook and Google.\"},{\"question\":\"Can I create studio content from ChatGPT or Claude?\",\"answer\":\"Yes. Connect Runway's MCP integration and generate class promos and social clips inside ChatGPT or Claude. Instructions at runwayml.com/mcp.\"},{\"question\":\"What else can Runway make for my studio?\",\"answer\":\"Apparel and merch product videos, trainer introductions, wellness content and refreshed website imagery, all from the same workspace.\"}],\"endCtaTitle\":\"Fill the next class with one clip\",\"endCtaDescription\":\"Start free and turn your studio photos into a cinematic tour.\"},\"fashionBrands\":{\"pageTitle\":\"AI Fashion Video Generator for Brands | Runway\",\"pageDescription\":\"Editorial fashion films and product videos from lookbook photos. On-model motion, campaign scenes and e-commerce clips, generated with AI.\",\"heroEyebrow\":\"Runway for fashion\",\"heroTitle\":\"AI video for fashion brands\",\"heroDescription\":\"Turn lookbook stills into editorial motion: models that move, fabric that flows, campaign scenes that would otherwise need a location and a week of production.\",\"cardTitle\":\"Fashion brands\",\"cardDescription\":\"Lookbook stills become editorial films and e-commerce video.\",\"stepsTitle\":\"How to make fashion videos on Runway\",\"steps\":[{\"title\":\"Start from your lookbook\",\"description\":\"Upload the stills from your last shoot, or generate the model and the look from scratch. The garment's design stays exact.\"},{\"title\":\"Direct the motion\",\"description\":\"Subtle, elegant movement: a slow turn, hair in a breeze, fabric catching light. Or a full editorial scene: golden hour, tropical jungle, city night.\"},{\"title\":\"Generate for every channel\",\"description\":\"Vertical for Reels and TikTok, widescreen for campaign films, clean loops for product pages.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"On-model motion from stills\",\"description\":\"Bring lookbook photography to life with subtle, controlled movement: the model breathes, the fabric moves, the design stays exact.\"},{\"title\":\"Garment accuracy\",\"description\":\"Reference images preserve the cut, print, texture and details of the piece across every generated shot.\"},{\"title\":\"Campaign-grade scenes\",\"description\":\"Editorial settings (jungle, desert, studio, city) without location scouting, permits or travel.\"},{\"title\":\"The same model, every shot\",\"description\":\"Keep one consistent model across scenes and outfits using references, so a whole campaign reads as one shoot.\"},{\"title\":\"E-commerce angles\",\"description\":\"Show the piece from every side (turns, details, drape) from a single flat or on-model photo.\"}],\"midCtaTitle\":\"Your lookbook wants to move.\",\"faq\":[{\"question\":\"Can AI make fashion videos from photos?\",\"answer\":\"Yes. Upload lookbook or product stills and direct the motion: a slow turn, flowing fabric, an editorial camera move. Runway animates the shot while preserving the garment.\"},{\"question\":\"Will the garment stay accurate?\",\"answer\":\"Yes. Reference images lock the cut, print, color and details. Tell the model to keep the piece identical and it carries through every generation.\"},{\"question\":\"Can I keep the same model across a campaign?\",\"answer\":\"Yes. Use reference images to keep one consistent model across scenes, outfits and formats, so the campaign reads as a single shoot.\"},{\"question\":\"Can I create virtual try-on style videos?\",\"answer\":\"Yes. Show a garment on a generated model in motion, including swapping pieces on the same model, which brands use for e-commerce and social.\"},{\"question\":\"Does this replace a campaign shoot?\",\"answer\":\"For many brands it covers social, e-commerce and in-season content, and extends hero campaign imagery into video. Shoot once, then generate the season's motion from it.\"},{\"question\":\"Can I use the videos and images commercially?\",\"answer\":\"Yes. You own full commercial rights. Use them in paid ads, on product pages and across social.\"},{\"question\":\"Can I generate fashion content from ChatGPT or Claude?\",\"answer\":\"Yes. The Runway MCP integration brings video and image generation into ChatGPT and Claude, so campaign ideation and production happen in the same chat. Set up at runwayml.com/mcp.\"},{\"question\":\"What else can Runway make for my fashion brand?\",\"answer\":\"Product videos for accessories, UGC-style ads, beauty campaign content and refreshed e-commerce photography, all in one workspace.\"}],\"endCtaTitle\":\"From still to editorial in one prompt\",\"endCtaDescription\":\"Start free and put your latest look in motion.\"},\"beauty\":{\"pageTitle\":\"AI Beauty \u0026 Skincare Video Ads | Runway\",\"pageDescription\":\"Luxury beauty commercials from product photos. Perfume reveals, skincare macro shots and campaign films, generated with AI on Runway.\",\"heroEyebrow\":\"Runway for beauty\",\"heroTitle\":\"AI video for beauty brands\",\"heroDescription\":\"Perfume bottles turning in golden mist, cream textures in macro, campaign faces in perfect light. Luxury beauty film generated from your product photos.\",\"cardTitle\":\"Beauty \u0026 skincare\",\"cardDescription\":\"Product photos become luxury beauty commercials and campaign films.\",\"stepsTitle\":\"How to make beauty videos on Runway\",\"steps\":[{\"title\":\"Upload your product\",\"description\":\"A clean shot of the bottle, jar or compact. Runway preserves the packaging, label and cap exactly.\"},{\"title\":\"Set the scene\",\"description\":\"Rotating on black marble, rising from golden mist, Mediterranean light drifting across the lineup. Describe the campaign's world.\"},{\"title\":\"Generate the campaign\",\"description\":\"Hero spots, macro texture clips and vertical social cuts: a full launch package from one product photo.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Luxury product reveals\",\"description\":\"Slow orbits, mist, light caustics and water: the high-end fragrance-commercial vocabulary, on demand.\"},{\"title\":\"Macro texture\",\"description\":\"Cream swatches, serum drops and powder breaks in extreme close-up: the shots that sell texture.\"},{\"title\":\"Campaign faces\",\"description\":\"Beauty close-ups with natural skin texture in studio-perfect light, generated to match your brand's look.\"},{\"title\":\"Launch-ready formats\",\"description\":\"Hero film, product-page loops and 9:16 social cuts generated as a set, consistent across the campaign.\"}],\"midCtaTitle\":\"Give your next launch a campaign film.\",\"faq\":[{\"question\":\"Can AI make luxury beauty commercials?\",\"answer\":\"Yes. Slow product reveals, macro textures and campaign-grade beauty shots are among the most common things generated on Runway. Your product photo is the reference; the cinematography is generated.\"},{\"question\":\"Will my packaging stay exact?\",\"answer\":\"Yes. Reference images preserve the bottle shape, label, typography and cap. Instruct the model to keep the product identical and it stays true across every shot.\"},{\"question\":\"Can I generate models and beauty close-ups?\",\"answer\":\"Yes. Campaign faces with natural skin texture, in the lighting and mood you describe, ready to use in minutes.\"},{\"question\":\"Does this work for skincare textures?\",\"answer\":\"Yes. Macro cream swatches, serum drips and texture pulls generate beautifully and are staples of skincare social content.\"},{\"question\":\"Can I match my brand's visual identity?\",\"answer\":\"Yes. Direct the palette, lighting and set in the prompt, and reuse reference frames to keep every asset in the same world.\"},{\"question\":\"Can I use the videos in paid beauty ads?\",\"answer\":\"Yes. You own full commercial rights. Run them across Meta, TikTok, YouTube and retail media.\"},{\"question\":\"Can I make beauty content inside ChatGPT or Claude?\",\"answer\":\"Yes. Connect the Runway MCP integration and generate swatch videos, ads and imagery directly from your ChatGPT or Claude conversation. See runwayml.com/mcp.\"},{\"question\":\"What else can Runway make for my beauty brand?\",\"answer\":\"UGC-style review ads, fashion content, product photography and full multi-scene commercials. One workspace for the whole brand.\"}],\"endCtaTitle\":\"Your product deserves the fragrance-ad treatment\",\"endCtaDescription\":\"Start free and generate your first beauty film today.\"},\"pets\":{\"pageTitle\":\"AI Pet Video Generator for Pet Brands | Runway\",\"pageDescription\":\"Videos for pet brands, groomers and vets. Turn product and pet photos into charming ads, consistent pet characters and social clips with AI.\",\"heroEyebrow\":\"Runway for pet brands\",\"heroTitle\":\"AI video for pet brands\",\"heroDescription\":\"Charming, share-ready pet video: product ads with the same golden retriever in every scene, grooming transformations and clips that stop the scroll.\",\"cardTitle\":\"Pet brands\",\"cardDescription\":\"Pet and product photos become charming ads with consistent pet characters.\",\"stepsTitle\":\"How to make pet videos on Runway\",\"steps\":[{\"title\":\"Start from your product or pet\",\"description\":\"Upload photos of the product (and, if you like, a pet to star in the spot). References keep both consistent.\"},{\"title\":\"Write the moment\",\"description\":\"A fluffy cat discovering the new toy, a golden retriever waiting at the door, a before-and-after grooming reveal. Pet content is storytelling.\"},{\"title\":\"Generate and share\",\"description\":\"Vertical clips for TikTok and Reels, product-page loops and ad cuts, generated in minutes.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"A consistent pet character\",\"description\":\"Keep the same dog or cat across every scene and episode using reference images: a brand mascot without a trained animal.\"},{\"title\":\"Product ads that charm\",\"description\":\"Toys, food, accessories and gadgets shown in use by generated pets, with the product staying exact.\"},{\"title\":\"Grooming and vet promos\",\"description\":\"Before-and-after grooming reveals, calm clinic tours and caring-hands close-ups for local pet businesses.\"},{\"title\":\"UGC-style pet content\",\"description\":\"The phone-shot rescue-story and reaction formats that dominate pet TikTok, generated on demand.\"}],\"midCtaTitle\":\"The internet runs on pet video. Make yours.\",\"faq\":[{\"question\":\"Can AI generate realistic pet videos?\",\"answer\":\"Yes. Cats, dogs and everything else, in styles from cinematic commercial to phone-shot UGC. Pet content is one of the most popular categories on Runway.\"},{\"question\":\"Can I use the same pet across multiple videos?\",\"answer\":\"Yes. Reference images keep the same animal (coat, markings, face) consistent across scenes, so your brand can have a recurring star.\"},{\"question\":\"Will my product stay accurate in the videos?\",\"answer\":\"Yes. Upload product photos as references and the packaging, colors and design stay exact while the generated pet interacts with it.\"},{\"question\":\"Does this work for groomers and vet clinics?\",\"answer\":\"Yes. Before-and-after grooming reveals, welcoming clinic tours and gentle-care close-ups all generate well from photos of your space and work.\"},{\"question\":\"Can I make TikTok-style pet content?\",\"answer\":\"Yes. Vertical, handheld-style pet moments (reactions, rescues, unboxings) are a staple format, and you can generate daily variations.\"},{\"question\":\"Can I use what I make commercially?\",\"answer\":\"Yes. You own full commercial rights. Run them as ads and post them across every channel.\"},{\"question\":\"Can I generate videos from ChatGPT or Claude?\",\"answer\":\"Yes. Runway's MCP integration lets ChatGPT and Claude generate Runway video and images for you. Describe the spot and it comes back in the chat. Connect at runwayml.com/mcp.\"},{\"question\":\"What else can Runway make for my pet brand?\",\"answer\":\"Product commercials, UGC ads, brand films and refreshed product photography. The full content stack in one workspace.\"}],\"endCtaTitle\":\"Your brand's next star has four legs\",\"endCtaDescription\":\"Start free and generate your first pet video today.\"},\"hotels\":{\"pageTitle\":\"AI Hotel \u0026 Travel Video Maker | Runway\",\"pageDescription\":\"Cinematic hotel promos from property photos. Room reveals, destination films and booking-ready social clips, generated with AI on Runway.\",\"heroEyebrow\":\"Runway for hospitality\",\"heroTitle\":\"AI video for hotels and travel\",\"heroDescription\":\"Turn property photos into the film your hotel deserves: suite reveals, golden-hour exteriors and destination moments that make people book the trip.\",\"cardTitle\":\"Hotels \u0026 travel\",\"cardDescription\":\"Property photos become suite reveals and cinematic destination films.\",\"stepsTitle\":\"How to make hotel videos on Runway\",\"steps\":[{\"title\":\"Upload property photos\",\"description\":\"Rooms, lobby, pool, views: the photography you already have. Runway preserves your actual property.\"},{\"title\":\"Direct the sequence\",\"description\":\"Morning light moving across the suite, a slow drift through the lobby, an aerial-style approach to the property at dusk.\"},{\"title\":\"Generate and publish\",\"description\":\"Clips for your booking pages, OTA listings, Instagram and paid campaigns, all from the same photo set.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Suite and room reveals\",\"description\":\"Slow, luxurious camera moves through your actual rooms, generated from the photos on your booking page.\"},{\"title\":\"Aerial-style property shots\",\"description\":\"Drone-look approaches and rises over the resort. No pilot, no permits, no weather delays.\"},{\"title\":\"Golden hour everywhere\",\"description\":\"Shift any exterior to sunrise or dusk, when every property looks its best.\"},{\"title\":\"Destination storytelling\",\"description\":\"The journey around the stay (coastlines, old towns, safari airstrips) generated to match your location.\"}],\"midCtaTitle\":\"Sell the stay before they arrive.\",\"faq\":[{\"question\":\"Can AI make a hotel video from photos?\",\"answer\":\"Yes. Upload your property photography and describe the camera moves. Runway generates cinematic video while preserving your actual rooms and spaces.\"},{\"question\":\"Do I need a drone for property flyovers?\",\"answer\":\"No. Generate aerial-style approaches and rises from ground-level exterior photos — the drone look without the drone.\"},{\"question\":\"Can I show the destination, not just the hotel?\",\"answer\":\"Yes. Generate the beach at sunrise, the old-town streets, the mountain road in. Destination film is often what convinces a guest to book.\"},{\"question\":\"Will the rooms look like the real rooms?\",\"answer\":\"Yes. Runway preserves the interiors in your reference photos, so what guests see in the video is what they check into.\"},{\"question\":\"What formats do OTAs and social need?\",\"answer\":\"Vertical 9:16 for Reels and TikTok, widescreen for booking pages and YouTube. Generate each natively from the same photo set.\"},{\"question\":\"Can I use the videos commercially on OTAs and my site?\",\"answer\":\"Yes. You own full commercial rights. Use them on OTAs, your site, social channels and paid campaigns.\"},{\"question\":\"Does Runway work with ChatGPT or Claude?\",\"answer\":\"Yes. With the Runway MCP integration you can generate property films and campaign imagery from inside ChatGPT or Claude. Setup takes a minute at runwayml.com/mcp.\"},{\"question\":\"What else can Runway make for my hotel?\",\"answer\":\"Restaurant and spa promos, event-space tours, seasonal campaign films and refreshed photography. The whole property, one workspace.\"}],\"endCtaTitle\":\"The film your property has been waiting for\",\"endCtaDescription\":\"Start free and turn your best room photos into video today.\"},\"agriculture\":{\"pageTitle\":\"AI Video for Agriculture \u0026 Farm Equipment | Runway\",\"pageDescription\":\"Turn equipment photos into cinematic field video with AI. Ads for dealers, farm brands and co-ops: aerial passes, working machinery, golden hour.\",\"heroEyebrow\":\"Runway for agriculture\",\"heroTitle\":\"Your equipment, working the field\",\"heroDescription\":\"Turn photos of machinery into cinematic equipment-in-action video: aerial passes over working fields, golden-hour brand spots and dealer ads, with the exact equipment and branding preserved.\",\"cardTitle\":\"Agriculture\",\"cardDescription\":\"Equipment-in-action video for dealers, farm brands and co-ops, from the photos you already have.\",\"stepsTitle\":\"How it works\",\"steps\":[{\"title\":\"Upload equipment photos\",\"description\":\"Lot shots, brochure photography or a phone photo of the machine. Runway preserves the model, decals and colors exactly.\"},{\"title\":\"Describe the field day\",\"description\":\"A drone pass over the combine working a golden wheat field, dust in the evening light, a slow orbit at the dealership. Plain language works.\"},{\"title\":\"Post everywhere you sell\",\"description\":\"Widescreen for YouTube and your site, vertical for Reels, clips for the listing and the show-booth screen.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Equipment in action\",\"description\":\"Machinery working real terrain, generated from stills of the unit: tillage, harvest, loading, hauling.\"},{\"title\":\"Aerial field passes\",\"description\":\"Drone-style flyovers of fields and lots, no drone or weather window required.\"},{\"title\":\"Dealer and listing videos\",\"description\":\"Every unit on the lot gets a hero clip for its listing, not just the new arrivals.\"},{\"title\":\"Seasonal campaign spots\",\"description\":\"Planting, harvest, end-of-year clearance: a fresh spot for each season from the same photo library.\"}],\"midCtaTitle\":\"Put your equipment on film\",\"faq\":[{\"question\":\"How do farm and equipment brands use AI video?\",\"answer\":\"Equipment-in-action spots, dealership inventory videos, aerial farm footage and seasonal campaign ads, all generated from photos. Describe the scene and the machine gets to work.\"},{\"question\":\"Will the equipment look exactly like our unit?\",\"answer\":\"Yes. Upload clear photos as references and tell the model to keep the unit identical. Our models preserve the paint, decals, attachments and proportions from your photos.\"},{\"question\":\"Can I get aerial footage of fields and lots?\",\"answer\":\"Yes. Generate drone-style approaches, orbits and rises from ground-level photos, with no drone or weather window required.\"},{\"question\":\"Does this work for dealerships with rotating inventory?\",\"answer\":\"Yes. Generate a walkaround-style clip for each unit from listing photos the day it arrives, and refresh creative when the floor plan changes.\"},{\"question\":\"Can I make videos for the farm brand itself, not just equipment?\",\"answer\":\"Yes. Farm-story films, harvest highlights, co-op member spots and product videos for what you grow all generate well from the photos you already take.\"},{\"question\":\"Can I run these as ads?\",\"answer\":\"Yes. You own full commercial rights. Run them on Facebook, YouTube, local placements and marketplace listings.\"},{\"question\":\"Can I generate equipment videos from ChatGPT or Claude?\",\"answer\":\"Yes. Connect the Runway MCP integration and describe the spot in your chat; the video comes back without switching tools. Setup at runwayml.com/mcp.\"},{\"question\":\"What else can Runway make for an equipment business?\",\"answer\":\"Refreshed inventory photography, service-department promos, event and auction spots and imagery for your site. One workspace covers the calendar.\"}],\"endCtaTitle\":\"From the lot to the field in minutes\",\"endCtaDescription\":\"Upload a photo of the machine and generate the spot your customers picture themselves in.\"},\"weddings\":{\"pageTitle\":\"AI Wedding Video: Venues, Planners \u0026 Studios | Runway\",\"pageDescription\":\"Cinematic wedding video with AI on Runway. Venue tour films, styled-shoot motion and photo-to-film keepsakes for the pros who make weddings happen.\",\"heroEyebrow\":\"Runway for weddings\",\"heroTitle\":\"Wedding films from the photos you already love\",\"heroDescription\":\"For venues, planners and photographers: turn venue photos into cinematic tours, bring styled shoots to life and offer photo-to-film keepsakes as a new line on the package.\",\"cardTitle\":\"Weddings\",\"cardDescription\":\"Venue tours, styled-shoot films and photo keepsakes in motion for wedding professionals.\",\"stepsTitle\":\"How it works\",\"steps\":[{\"title\":\"Start from your gallery\",\"description\":\"Venue photos, styled shoots or a couple's favorites. Runway preserves the people, the dress and the light.\"},{\"title\":\"Direct the film\",\"description\":\"A slow glide down the aisle at golden hour, petals drifting, string lights warming as dusk falls. Write it the way you'd describe it to the couple.\"},{\"title\":\"Deliver and promote\",\"description\":\"Vertical clips for the venue's Instagram, tour films for the booking page and keepsake edits for the gallery delivery.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Venue tour films\",\"description\":\"Floating camera moves through ceremony spaces, ballrooms and grounds, generated from the photos on your site.\"},{\"title\":\"Styled shoots in motion\",\"description\":\"The tablescape, the arch, the gown detail: editorial motion from the stills your team already produced.\"},{\"title\":\"Photo keepsakes in motion\",\"description\":\"A favorite portrait becomes a living moment. A gallery add-on couples don't expect.\"},{\"title\":\"Seasonal booking campaigns\",\"description\":\"Spring garden, fall foliage, winter candlelight: booking-season ads from one photo library.\"}],\"midCtaTitle\":\"Bring the big day to life\",\"faq\":[{\"question\":\"How do wedding businesses use AI video?\",\"answer\":\"Venues generate cinematic tour films from their photos, planners animate styled shoots for social, and photographers offer photo-to-film keepsakes alongside the album. All of it starts from stills.\"},{\"question\":\"Will the couple and the dress stay true to the photo?\",\"answer\":\"Yes. Upload the photo as the reference and direct subtle motion. Our models preserve faces, the gown and the setting; the movement is gentle by design.\"},{\"question\":\"Can a venue make tour videos from existing photography?\",\"answer\":\"Yes. Upload the photos from your site and describe the walkthrough: the ceremony lawn at golden hour, the ballroom set for a reception, the suite at first light.\"},{\"question\":\"Is this something photo studios can sell as an add-on?\",\"answer\":\"Yes. Studios deliver a few signature shots in motion as a premium gallery line item. It sits alongside the photo and film package rather than replacing anything in it.\"},{\"question\":\"Can I make ads for booking season?\",\"answer\":\"Yes. Seasonal campaign clips for Instagram and Pinterest generate in minutes from last season's galleries, with full commercial rights to run as paid ads.\"},{\"question\":\"What formats do wedding clips export in?\",\"answer\":\"Vertical for Reels and TikTok, square for feeds and widescreen for your site and booking pages. Download as MP4 or GIF.\"},{\"question\":\"Can I use Runway from ChatGPT or Claude for this?\",\"answer\":\"Yes. The Runway MCP integration generates video and imagery inside ChatGPT and Claude, so a venue tour is one chat away. Connect at runwayml.com/mcp.\"},{\"question\":\"What else can Runway make for a wedding business?\",\"answer\":\"Vendor brand spots, engagement-session films, save-the-date clips and refreshed imagery for your site. One workspace for the whole season.\"}],\"endCtaTitle\":\"The venue, at golden hour, every day\",\"endCtaDescription\":\"Start from the photos you already have and give every couple the cinematic first look.\"},\"beverages\":{\"pageTitle\":\"AI Beverage Commercials from Product Photos | Runway\",\"pageDescription\":\"Make beverage ads with AI: slow-motion pours, condensation macro and lifestyle scenes from one product photo. Video for drink brands on Runway.\",\"heroEyebrow\":\"Runway for beverage brands\",\"heroTitle\":\"Make your drink the main character\",\"heroDescription\":\"One product photo becomes the pour, the splash and the lifestyle scene: commercial-grade motion with your can or bottle staying exactly as it ships.\",\"cardTitle\":\"Beverages\",\"cardDescription\":\"Pours, splashes and lifestyle scenes from a single product photo.\",\"stepsTitle\":\"How it works\",\"steps\":[{\"title\":\"Upload the product shot\",\"description\":\"A clean photo of the can or bottle. Runway keeps the label, colors and shape exact in every scene.\"},{\"title\":\"Describe the craving\",\"description\":\"A slow-motion pour over ice, condensation rolling down the glass, the can opening at a summer cookout. Appetite lives in the physics.\"},{\"title\":\"Ship the campaign\",\"description\":\"Vertical for TikTok and Reels, square for feeds, widescreen for retail screens and your site.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Slow-motion pours and splashes\",\"description\":\"Liquid physics that sell: pours, fizz, ice drops and crown splashes in commercial-grade slow motion.\"},{\"title\":\"Condensation and texture macro\",\"description\":\"Droplets rolling down cold glass, frost on the can, citrus mist: the close-ups that make a drink read ice-cold.\"},{\"title\":\"Lifestyle scenes\",\"description\":\"The beach cooler, the trailhead thermos, the café counter: place the product where it gets enjoyed, without a location shoot.\"},{\"title\":\"Seasonal flavor launches\",\"description\":\"Every limited run and seasonal flavor gets its own spot from one product photo.\"}],\"midCtaTitle\":\"Make the pour they can taste\",\"faq\":[{\"question\":\"How do drink brands use AI video?\",\"answer\":\"Slow-motion pours, splash reveals, condensation macros and lifestyle scenes, generated from product photos. The classic beverage-commercial vocabulary, on demand.\"},{\"question\":\"Will the can or bottle stay exactly right?\",\"answer\":\"Yes. Upload clear product photos as references and instruct the model to keep the packaging identical. Our models preserve labels, colors and proportions.\"},{\"question\":\"Can I get realistic liquid motion?\",\"answer\":\"Yes. Pours, fizz, splashes and ice drops generate convincingly on Runway. Describe the motion and the physics follow.\"},{\"question\":\"Does this work for cans, bottles and cartons alike?\",\"answer\":\"Yes. Any packaging format works: cans, glass, cartons and pouches. Multiple reference angles tighten fidelity further.\"},{\"question\":\"Can I use these in paid social ads?\",\"answer\":\"Yes. You own full commercial rights. Regulated drink categories still carry their own ad-platform rules, so check your category's policies before promoting.\"},{\"question\":\"How fast can I turn a new flavor into a campaign?\",\"answer\":\"Same day. One product photo yields the hero spot, the macro texture clips and the vertical cuts for launch.\"},{\"question\":\"Can I make beverage ads inside ChatGPT or Claude?\",\"answer\":\"Yes. Connect the Runway MCP integration and generate the pour right in the conversation. See runwayml.com/mcp.\"},{\"question\":\"What else can Runway make for a drink brand?\",\"answer\":\"Product photography refreshes, UGC-style taste-test ads, brand films and menu screens. The full launch kit in one workspace.\"}],\"endCtaTitle\":\"From shelf shot to hero spot\",\"endCtaDescription\":\"Upload the product photo and generate the commercial before the ice melts.\"},\"jewelry\":{\"pageTitle\":\"AI Jewelry \u0026 Watch Video from Product Photos | Runway\",\"pageDescription\":\"Luxury jewelry and watch films with AI: macro sparkle, turntable rotations and on-model shots from product photos. Campaign-grade video on Runway.\",\"heroEyebrow\":\"Runway for jewelry and watches\",\"heroTitle\":\"Make light move through every stone\",\"heroDescription\":\"Turn product photos into luxury film: sparkle sweeping across the pavé, a watch dial catching golden light, on-model motion that sells the piece before the visit.\",\"cardTitle\":\"Jewelry \u0026 watches\",\"cardDescription\":\"Macro sparkle, rotations and on-model motion from your product photography.\",\"stepsTitle\":\"How it works\",\"steps\":[{\"title\":\"Upload the piece\",\"description\":\"Product photography or a clean phone shot on a neutral background. Runway preserves the setting, stones and metalwork.\"},{\"title\":\"Direct the light\",\"description\":\"A beam sweeping across the diamonds, a slow turn on black velvet, the second hand ticking in macro. Luxury lives in the light.\"},{\"title\":\"Sell everywhere\",\"description\":\"Product-page loops, vertical social cuts and campaign films for launches and holidays.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Macro sparkle films\",\"description\":\"Light caustics, fire and brilliance in extreme close-up: the shots that make stones read precious.\"},{\"title\":\"Turntable rotations\",\"description\":\"Show every angle of the piece from a single photo: ring turns, bracelet drapes, case-back reveals.\"},{\"title\":\"On-model motion\",\"description\":\"A wrist turning in sunlight, an earring catching a glance. Generated models, or your own campaign photography brought to life.\"},{\"title\":\"Holiday campaign spots\",\"description\":\"Valentine's, Mother's Day, December: each moment gets a film from the same product library.\"}],\"midCtaTitle\":\"Give every piece its close-up\",\"faq\":[{\"question\":\"How do jewelers use AI video?\",\"answer\":\"Macro sparkle clips for product pages, rotating showcase videos for listings, on-model motion for social and holiday campaign films, all from product photos.\"},{\"question\":\"Will the piece stay accurate, stones and all?\",\"answer\":\"Yes. Upload sharp photos as references and instruct the model to keep the piece identical. Our models preserve settings, stones, engraving and metal color.\"},{\"question\":\"Can I show jewelry on a model from a product photo?\",\"answer\":\"Yes. Generate on-model wrist, neckline and ear shots from a product photo, or animate your own campaign photography.\"},{\"question\":\"Does it work for watches specifically?\",\"answer\":\"Yes. Dial close-ups, hand sweeps, crown and clasp details and lifestyle wrist shots all generate from stills of the watch.\"},{\"question\":\"Can I use these on product pages and in ads?\",\"answer\":\"Yes. You own full commercial rights. Run them on your store, marketplaces, social and paid placements.\"},{\"question\":\"What formats can I download for jewelry clips?\",\"answer\":\"Vertical for Reels and TikTok, square for feeds, widescreen for the site. MP4, or GIF for product pages and emails.\"},{\"question\":\"Can I generate jewelry films from ChatGPT or Claude?\",\"answer\":\"Yes. The Runway MCP integration brings generation into ChatGPT and Claude; describe the piece and the light and it comes back in chat. Connect at runwayml.com/mcp.\"},{\"question\":\"What else can Runway make for a jewelry brand?\",\"answer\":\"Refreshed product photography, UGC-style try-on ads, brand films and holiday imagery. One workspace for the whole counter.\"}],\"endCtaTitle\":\"Luxury film, counter to campaign\",\"endCtaDescription\":\"Upload the piece and generate the sparkle your product pages have been missing.\"},\"musicVideos\":{\"pageTitle\":\"AI Music Video Generator | Runway\",\"pageDescription\":\"Create AI music videos shot by shot: performance footage, narrative cuts and animated worlds built from your own photos and references. Try Runway's AI music video generator free.\",\"heroEyebrow\":\"Runway for music\",\"heroTitle\":\"AI music video generator\",\"heroDescription\":\"Build music videos shot by shot with AI, from concept to final cut. The same artist, the same world, every shot.\",\"cardTitle\":\"Music videos\",\"cardDescription\":\"Performance footage, narrative cuts and cover art from photos of your artist.\",\"stepsTitle\":\"How to create AI music videos with Runway\",\"steps\":[{\"title\":\"Set the artistic direction\",\"description\":\"Describe the idea, then add references that establish the characters, the style and the world you want carried across the video.\"},{\"title\":\"Build your video shot by shot\",\"description\":\"Generate a first shot and build outward from it, holding the same visual direction while the framing, the movement or the setting changes from one moment to the next.\"},{\"title\":\"Shape the final sequence\",\"description\":\"Keep the clips that work and extend any moment that needs more time. Upscale the finished shots, then export them for the final cut.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Shots you could never have filmed\",\"description\":\"Put a performance somewhere a camera could not go. Build whole scenes around the artist without producing every setup in the real world.\"},{\"title\":\"One artist, every shot\",\"description\":\"References carry the same face, hair and wardrobe from cut to cut, even as the setting and the composition change underneath them.\"},{\"title\":\"Performance, narrative or fully animated\",\"description\":\"Concert close-ups, a story running alongside the song, or anime and flat 2D worlds no camera could shoot. Use the right model for each shot, ours or a third-party one.\"}],\"featureRows\":[{\"title\":\"Edit music video footage without starting over\",\"description\":\"Reshape footage you already have while keeping the parts of the shot that work. Change the environment, the lighting or a single element so everything fits the visual direction of the video.\",\"linkLabel\":\"Explore AI video editing\"},{\"title\":\"Animate images with voice and lip sync\",\"description\":\"Give a character a voice and bring the performance to life with synced delivery. Add speech to footage you generated or footage you shot, then lip sync it so every line reads as part of the scene.\"}],\"audiencesTitle\":\"Create every visual for your next release\",\"audiences\":[{\"label\":\"Music marketers and labels\",\"description\":\"Build a distinct visual identity for every release. Generate concert-crowd drone shots, performance close-ups, animated album or tour announcements, and more.\"},{\"label\":\"Content creators and social teams\",\"description\":\"Build vertical visuals around a track for TikTok, Reels and Shorts. Generate new concepts quickly so the content can keep changing while the song stays recognizable.\"},{\"label\":\"Independent musicians and artists\",\"description\":\"Make a music video without scaling the idea down to fit your budget. Create performance-led shots or entirely generated worlds, then shape the strongest moments into a video that feels like your release.\"}],\"midCtaTitle\":\"Your song already has a sound. Give it a vision.\",\"faq\":[{\"question\":\"What is an AI music video generator?\",\"answer\":\"An AI music video generator turns prompts and references into visuals for a song. In Runway you generate shots from text, images or existing clips, use audio as a reference on supported models, then edit and extend those shots into a longer sequence.\"},{\"question\":\"How do I create an AI music video with Runway?\",\"answer\":\"Define the visual direction and generate a first shot from a prompt or a reference. Use that output to develop the shots that follow, refine the ones you want to keep, then export the finished shots for your cut.\"},{\"question\":\"Can I use my own song?\",\"answer\":\"Yes. Supported multimodal models accept audio references alongside text, images and video, so your track can guide the generation. You can also score the AI made music video afterward in your editor.\"},{\"question\":\"Will the artist look like the same person in every shot?\",\"answer\":\"Yes. Attach the artist's photos as references and reuse them on each shot. Our models carry the face, hair, wardrobe and styling through the whole sequence.\"},{\"question\":\"Can I turn footage I already shot into a music video?\",\"answer\":\"Yes. Upload it and change what is inside the shot without starting over: the setting, the lighting or a single element, while the parts of the performance you want are preserved.\"},{\"question\":\"How long can an AI generated music video be?\",\"answer\":\"Length depends on the model. Individual generations are short takes, and Extend carries a take further, so a full video is a run of extended takes assembled into one edit.\"},{\"question\":\"What if I want something animated rather than live action?\",\"answer\":\"Describe the style. Anime, hand-drawn 2D, painterly, stop-motion and 3D all generate from the same prompts, and your artist can be stylized to match.\"},{\"question\":\"Can I generate music video shots from ChatGPT or Claude?\",\"answer\":\"Yes. The Runway MCP integration puts generation inside ChatGPT and Claude, so you can describe a shot in chat and get it back there. Connect at runwayml.com/mcp.\"},{\"question\":\"Can I release the video on Spotify and YouTube?\",\"answer\":\"Yes. You own full commercial rights to what you generate, including release on streaming platforms, socials and paid promotion. Make sure you also hold the rights to any music or footage you bring in.\"},{\"question\":\"Is the AI music video maker free to try?\",\"answer\":\"Runway has a free plan and no credit card is needed to start. Sign up and generate your first shot today.\"}],\"endCtaTitle\":\"Make your next music video on Runway\",\"endCtaDescription\":\"Go from the first visual idea to finished shots with AI generation and editing.\"},\"microdramas\":{\"pageTitle\":\"AI Microdrama Maker: Vertical Short Drama Series | Runway\",\"pageDescription\":\"Make vertical microdramas with AI. Episode-length scenes, a recurring cast that stays consistent and a hook on every ending, generated from stills and a script.\",\"heroEyebrow\":\"Runway for microdramas\",\"heroTitle\":\"Shoot a series that never leaves the phone\",\"heroDescription\":\"Vertical episodes with a recurring cast, locations that stay put and a hook every sixty seconds. Cast the show once, then generate the season.\",\"cardTitle\":\"Microdramas\",\"cardDescription\":\"Vertical episodic drama with a recurring cast and locations that hold across shots.\",\"stepsTitle\":\"How it works\",\"steps\":[{\"title\":\"Cast the series\",\"description\":\"Generate your leads or bring photos of real actors, then lock each one as a reference. That reference is your cast for the whole season.\"},{\"title\":\"Build the episode\",\"description\":\"Write the scene and generate it shot by shot, continuing each take from the frame before it so the room, the light and the wardrobe stay where you left them.\"},{\"title\":\"End on the hook\",\"description\":\"Cut to vertical, stack the episodes and publish to the short-drama apps, TikTok, Reels and YouTube Shorts.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"A cast that recurs\",\"description\":\"The same lead across ninety episodes, in the same apartment, through three changes of wardrobe. References keep the identity fixed.\"},{\"title\":\"Scenes that stay continuous\",\"description\":\"Continue from the last frame so a conversation plays across cuts without the room rearranging itself between shots.\"},{\"title\":\"Every genre the format runs on\",\"description\":\"Boardroom revenge, small-town romance, courtroom, supernatural. Built for a phone screen and a fifteen-second attention span.\"},{\"title\":\"Episode packaging\",\"description\":\"Title cards, cold opens, cliffhanger stingers and the vertical cover art the platforms ask for.\"}],\"midCtaTitle\":\"Season one starts with a single shot\",\"faq\":[{\"question\":\"What counts as a microdrama?\",\"answer\":\"A vertical, phone-first drama told in very short episodes, usually one to two minutes each, every one ending on a hook. A season often runs to sixty episodes or more.\"},{\"question\":\"How does the same actor turn up in every episode?\",\"answer\":\"Lock each character as a reference image and attach it to every shot they appear in. Our models hold the face, hair and wardrobe steady from episode to episode.\"},{\"question\":\"Can I use real actors instead of generated ones?\",\"answer\":\"Yes. Photos of your cast work as references exactly the way generated characters do, so a real performer can carry the series.\"},{\"question\":\"How do I stop the set changing between shots?\",\"answer\":\"Continue each shot from the previous frame and attach a locked reference of the location. The room, the light and the props carry forward.\"},{\"question\":\"What length and shape should an episode be?\",\"answer\":\"Vertical 9:16, built from short takes into a run of sixty to ninety seconds. Generate the takes, then assemble the episode in your editor.\"},{\"question\":\"Does dialogue work?\",\"answer\":\"Several of our models generate speech along with the shot, and Act-Two drives a character's delivery from a video of someone performing the line.\"},{\"question\":\"Can I plan and shoot a series from Claude or ChatGPT?\",\"answer\":\"Yes. With the Runway MCP integration you can outline the episode in chat and generate the shots without leaving it. Connect at runwayml.com/mcp.\"},{\"question\":\"Which languages does the format work in?\",\"answer\":\"Writers and studios build vertical drama on Runway in Mandarin, Korean, Japanese, Arabic, Spanish and English. Prompt in the language you write in.\"}],\"endCtaTitle\":\"Cast it, shoot it, post it\",\"endCtaDescription\":\"Bring your leads and the opening scene, and generate the first shot of episode one.\"},\"educationVideos\":{\"pageTitle\":\"AI Educational Video Maker: Explainers, Training and Courses | Runway\",\"pageDescription\":\"Turn documents, decks and lesson plans into educational video with AI. Explainer animation, corporate training, safety walkthroughs and course content on Runway.\",\"heroEyebrow\":\"Runway for education and training\",\"heroTitle\":\"Hand it the document, get back the video\",\"heroDescription\":\"Attach the SOP, the deck or the lesson plan. Agent reads it, drafts a storyboard and generates the explainer, so the video says what your source material actually says.\",\"cardTitle\":\"Education and training\",\"cardDescription\":\"Explainers, course content and training video, built from documents you already have.\",\"stepsTitle\":\"How it works\",\"steps\":[{\"title\":\"Bring the source material\",\"description\":\"Attach a PDF, a deck or a script. On paid plans you can connect Google Drive, Notion, Dropbox, Slack or Figma and point Agent at the file where it already lives.\"},{\"title\":\"Let Agent draft it\",\"description\":\"Agent reads the document, pulls out the sequence a learner needs and comes back with a storyboard you can argue with before anything renders.\"},{\"title\":\"Generate, then keep it current\",\"description\":\"Render the scenes. When the policy, the price or the procedure changes, regenerate the scenes that moved and leave the rest alone.\"}],\"capabilitiesTitle\":\"What you can make\",\"capabilities\":[{\"title\":\"Explainer animation\",\"description\":\"Flat 2D vector, hand-drawn whiteboard, isometric 3D, motion graphics. The house styles that carry a concept.\"},{\"title\":\"Training and compliance\",\"description\":\"Onboarding, safety walkthroughs, security awareness and standard operating procedures, in a plain register people will actually watch.\"},{\"title\":\"Course and lesson content\",\"description\":\"Module intros, worked examples and demonstrations for a classroom, a cohort or a paid course.\"},{\"title\":\"Technical and medical visuals\",\"description\":\"Cutaways, mechanisms and processes: what happens inside the gut, inside the switch, inside the engine.\"}],\"midCtaTitle\":\"The lesson is already written. Film it.\",\"faq\":[{\"question\":\"Can Runway build a video out of a document I already have?\",\"answer\":\"Yes. Attach a PDF to Agent, up to 10 MB, and it reads the document before it storyboards. The video follows your source instead of a generic script.\"},{\"question\":\"Can it pull the file straight from Google Drive or Notion?\",\"answer\":\"On paid plans, yes. Connect Google Drive, Notion, Dropbox, Slack or Figma, and Agent can search those tools from chat and bring the brief, doc or design in as a reference.\"},{\"question\":\"Which explainer styles can it produce?\",\"answer\":\"Flat 2D vector, hand-drawn whiteboard, isometric 3D, motion graphics and live action. Describe the house style, or attach a frame from an existing video and match to it.\"},{\"question\":\"What about narration?\",\"answer\":\"Several of our models generate speech along with the shot, and text-to-speech covers narration you would rather write and control line by line.\"},{\"question\":\"How do I keep a whole series of modules looking alike?\",\"answer\":\"Attach an approved frame as a reference on every scene and reuse the same style description. Modules generated weeks apart still match.\"},{\"question\":\"What happens when the content changes?\",\"answer\":\"Regenerate only the affected scenes against the same references. The rest of the module stays exactly as it was, so an update is not a rebuild.\"},{\"question\":\"Can I do all of this from Claude or ChatGPT?\",\"answer\":\"Yes. The Runway MCP integration lets you work from the document in chat and generate the scenes there. Connect at runwayml.com/mcp.\"},{\"question\":\"Is it appropriate for compliance and safety training?\",\"answer\":\"Runway generates the video; sign-off on accuracy stays with you. Because the storyboard is built from the document you attached, checking it against the source is straightforward.\"}],\"endCtaTitle\":\"Turn what you know into something watchable\",\"endCtaDescription\":\"Attach the document you would have made slides from, and look at the storyboard.\"}},\"modelPages\":{\"common\":{\"tryNow\":\"Try now\",\"useTheApi\":\"Use the API\",\"breadcrumbHome\":\"Home\",\"breadcrumbProduct\":\"Product\",\"relatedTitle\":\"More models on Runway\",\"relatedDescription\":\"Runway gives you access to the world's leading video, image and audio models — Runway's own frontier models plus the best from Google, OpenAI, Kling, ByteDance and more — all in one workspace.\",\"relatedReadMore\":\"Explore the model\"},\"seedance\":{\"cardTitle\":\"Seedance 2.0\",\"cardDescription\":\"Multi-modal video generation with sound from text, images, video or audio.\"},\"aleph2\":{\"cardTitle\":\"Aleph 2.0\",\"cardDescription\":\"Runway's flagship in-context video editing model — change only what you ask for.\"},\"ruby\":{\"cardTitle\":\"Runway Ruby\",\"cardDescription\":\"Runway's SDR-to-HDR grading model: true HDR masters from any video.\"},\"nanoBanana\":{\"pageTitle\":\"Nano Banana on Runway | Fast AI Image Generation and Editing\",\"pageDescription\":\"Use Google's Nano Banana on Runway to generate, edit and composite images in seconds. Fast 1K outputs, 3 reference images, ratios from 21:9 to 9:16.\",\"heroEyebrow\":\"Now on Runway\",\"heroTitle\":\"Nano Banana\",\"heroDescription\":\"Google's fast image generation and editing model, on Runway. Generate, edit and composite images with a text prompt and up to 3 reference images — built for speed and high-volume work.\",\"cardTitle\":\"Nano Banana\",\"cardDescription\":\"Fast, budget-friendly image generation and editing at 1K.\",\"stepsTitle\":\"How to use Nano Banana on Runway\",\"steps\":[{\"title\":\"Add your prompt and references\",\"description\":\"Describe the image you want in full sentences — Nano Banana is built on Gemini's language understanding, so narrative prompts outperform keyword lists. Add up to 3 reference images to guide the output.\"},{\"title\":\"Pick your aspect ratio\",\"description\":\"Choose from 21:9, 16:9, 4:3, 1:1, 3:4 or 9:16 to match wherever the image will live, from cinematic banners to vertical social posts.\"},{\"title\":\"Generate and iterate\",\"description\":\"Generate fast 1K outputs, then refine with follow-up edits — swap backgrounds, restyle a subject or composite elements from your references.\"}],\"capabilitiesTitle\":\"What you can do with Nano Banana\",\"capabilities\":[{\"title\":\"Generate at speed\",\"description\":\"Optimized for fast, high-volume image generation — the right choice when you need lots of on-brief images quickly.\"},{\"title\":\"Edit with words\",\"description\":\"Change backgrounds, restyle subjects or adjust details in an existing image with a plain-language instruction.\"},{\"title\":\"Composite from references\",\"description\":\"Combine up to 3 reference images into one output — keep a product, face or logo consistent while changing everything around it.\"}],\"midCtaTitle\":\"Generate your first image with Nano Banana on Runway.\",\"faq\":[{\"question\":\"What is Nano Banana?\",\"answer\":\"Nano Banana is the name for Gemini's native image generation capabilities, available inside Runway. Using a text prompt and optional reference images, it can generate, edit and composite images with a high degree of creative control.\"},{\"question\":\"What's the difference between Nano Banana, Nano Banana Pro and Nano Banana Pro 2?\",\"answer\":\"Nano Banana is optimized for speed and high-volume tasks: it generates at 1K resolution and supports up to 3 reference images. Nano Banana Pro is built for professional asset production, with up to 4K resolution, up to 14 reference images and stronger in-image text rendering. Nano Banana Pro 2 (also called Nano Banana 2) is the recommended starting point for most workflows — the best balance of quality, speed and intelligence, with the same 4K ceiling and 14-image support as Pro. Nano Banana Pro 2 Lite is a faster, more budget-friendly variant for exploration and high-volume drafts.\"},{\"question\":\"What inputs does Nano Banana support?\",\"answer\":\"A text prompt (required) and up to 3 optional reference images. References can guide style, edit an existing image or composite multiple source assets into one output.\"},{\"question\":\"What aspect ratios can Nano Banana generate?\",\"answer\":\"21:9, 16:9, 4:3, 1:1, 3:4 and 9:16 — covering cinematic, landscape, square and vertical formats.\"},{\"question\":\"How do I write good prompts for Nano Banana?\",\"answer\":\"Describe the full scene in sentences rather than keyword lists, include context and intent, and use photographic language — shot type, lens, lighting — to control composition. If you include reference images, describe how each one should be used.\"},{\"question\":\"What plan do I need to use Nano Banana on Runway?\",\"answer\":\"Nano Banana is available on all paid and Enterprise plans. Free plan users can upgrade to get access.\"},{\"question\":\"What other models are available on Runway?\",\"answer\":\"Runway gives you access to the world's leading image, video and audio models in one place — Runway models like Gen-4.5 and Aleph 2.0, plus third-party models like Nano Banana Pro 2, GPT Image 2, Kling 3.0, Kling O3, Veo 3.1, Seedance 2.5 and more.\"}],\"endCtaTitle\":\"Try Nano Banana on Runway today.\",\"endCtaDescription\":\"Generate, edit and composite images in seconds — alongside every other leading AI model, in one workspace.\"},\"nanoBananaPro\":{\"pageTitle\":\"Nano Banana Pro on Runway | 4K AI Image Generation\",\"pageDescription\":\"Google's Nano Banana Pro on Runway: production-grade image generation with up to 4K, 14 reference images and precise text rendering for signage and ads.\",\"heroEyebrow\":\"Now on Runway\",\"heroTitle\":\"Nano Banana Pro\",\"heroDescription\":\"Google's professional image generation and editing model, on Runway. Up to 4K resolution and 14 reference images, with the text rendering and precision that production assets demand.\",\"cardTitle\":\"Nano Banana Pro\",\"cardDescription\":\"Production-grade image generation and editing at up to 4K.\",\"stepsTitle\":\"How to use Nano Banana Pro on Runway\",\"steps\":[{\"title\":\"Load up your references\",\"description\":\"Add up to 14 reference images — products, characters, style frames, logos — and describe in your prompt how each one should be used.\"},{\"title\":\"Write a detailed prompt\",\"description\":\"Nano Banana Pro handles complex, multi-step instructions. Specify exact copy, font style and layout for in-image text, and layer instructions from background to foreground.\"},{\"title\":\"Generate up to 4K\",\"description\":\"Choose 1K, 2K or 4K output and generate. Iterate with follow-up edits while keeping faces, products and logos consistent.\"}],\"capabilitiesTitle\":\"What you can do with Nano Banana Pro\",\"capabilities\":[{\"title\":\"Render text accurately\",\"description\":\"Built for detailed text rendering — signage, packaging, posters and mockups with the exact copy you specify.\"},{\"title\":\"Direct complex scenes\",\"description\":\"Follows multi-step instructions and precise compositions, so intricate briefs come back the way you described them.\"},{\"title\":\"Keep every asset consistent\",\"description\":\"Up to 14 reference images let you lock character identity, product fidelity and brand elements across an entire campaign.\"}],\"midCtaTitle\":\"Create production-ready images with Nano Banana Pro.\",\"faq\":[{\"question\":\"What is Nano Banana Pro?\",\"answer\":\"Nano Banana Pro is Google's professional-grade image generation model, available inside Runway. It's built for production asset work: up to 4K resolution, up to 14 reference images and strong in-image text rendering for complex, multi-step instructions.\"},{\"question\":\"What's the difference between Nano Banana, Nano Banana Pro and Nano Banana Pro 2?\",\"answer\":\"Nano Banana is optimized for speed and high-volume tasks: it generates at 1K resolution and supports up to 3 reference images. Nano Banana Pro is built for professional asset production, with up to 4K resolution, up to 14 reference images and stronger in-image text rendering. Nano Banana Pro 2 (also called Nano Banana 2) is the recommended starting point for most workflows — the best balance of quality, speed and intelligence, with the same 4K ceiling and 14-image support as Pro. Nano Banana Pro 2 Lite is a faster, more budget-friendly variant for exploration and high-volume drafts.\"},{\"question\":\"When should I choose Nano Banana Pro over Nano Banana Pro 2?\",\"answer\":\"Choose Nano Banana Pro when detailed text rendering and precise composition are the priority — packaging, signage and layout-heavy work. Choose Nano Banana Pro 2 when you want the best overall balance of quality, speed and intelligence.\"},{\"question\":\"What resolutions does Nano Banana Pro support?\",\"answer\":\"1K, 2K and 4K output, across aspect ratios from 21:9 to 9:16.\"},{\"question\":\"How many reference images can I use?\",\"answer\":\"Up to 14 reference images per generation — enough to hold characters, products and brand elements consistent across a whole campaign.\"},{\"question\":\"What plan do I need to use Nano Banana Pro on Runway?\",\"answer\":\"Nano Banana Pro is available on all paid and Enterprise plans. Free plan users can upgrade to get access.\"},{\"question\":\"What other models are available on Runway?\",\"answer\":\"Runway gives you access to the world's leading image, video and audio models in one place — Runway models like Gen-4.5 and Aleph 2.0, plus third-party models like Nano Banana Pro 2, GPT Image 2, Kling 3.0, Kling O3, Veo 3.1, Seedance 2.5 and more.\"}],\"endCtaTitle\":\"Try Nano Banana Pro on Runway today.\",\"endCtaDescription\":\"Production-grade images with accurate text and consistent assets — in the same workspace as every other leading model.\"},\"nanoBananaPro2\":{\"pageTitle\":\"Nano Banana Pro 2 on Runway | Google's Latest AI Image Model\",\"pageDescription\":\"Nano Banana Pro 2 (Nano Banana 2) on Runway: Google's latest image model balancing quality, speed and intelligence. Up to 4K and 14 reference images.\",\"heroEyebrow\":\"Now on Runway\",\"heroTitle\":\"Nano Banana Pro 2\",\"heroDescription\":\"The recommended starting point for image work on Runway — Google's latest Nano Banana model balances quality, speed and intelligence, with up to 4K output and 14 reference images.\",\"cardTitle\":\"Nano Banana Pro 2\",\"cardDescription\":\"Google's latest image model — the best balance of quality, speed and intelligence.\",\"stepsTitle\":\"How to use Nano Banana Pro 2 on Runway\",\"steps\":[{\"title\":\"Describe what you want\",\"description\":\"Write your prompt in full sentences — Nano Banana Pro 2 is built on Gemini's language understanding, so context and intent produce better results than keyword lists.\"},{\"title\":\"Add references if you have them\",\"description\":\"Guide the output with up to 14 reference images: keep a character consistent, preserve a product or combine elements from multiple sources.\"},{\"title\":\"Generate at up to 4K\",\"description\":\"Pick 1K, 2K or 4K and your aspect ratio, then generate. Refine with plain-language follow-up edits until it's right.\"}],\"capabilitiesTitle\":\"What you can do with Nano Banana Pro 2\",\"capabilities\":[{\"title\":\"Start here for most work\",\"description\":\"The best balance of quality, speed and intelligence in the Nano Banana family — the recommended default for most image workflows.\"},{\"title\":\"Generate, edit and composite\",\"description\":\"Create new images, edit existing ones or composite multiple references into a single output, all with plain-language control.\"},{\"title\":\"Scale to 4K\",\"description\":\"Same 4K ceiling and 14-reference support as Nano Banana Pro, with faster, more efficient generations.\"}],\"midCtaTitle\":\"Start creating with Nano Banana Pro 2 on Runway.\",\"faq\":[{\"question\":\"What is Nano Banana Pro 2?\",\"answer\":\"Nano Banana Pro 2 is Google's latest Nano Banana image generation model, available inside Runway. It offers the best balance of quality, speed and intelligence in the family, with up to 4K resolution and support for up to 14 reference images.\"},{\"question\":\"Is Nano Banana Pro 2 the same as Nano Banana 2?\",\"answer\":\"Yes — Google's latest Nano Banana model is referred to as both Nano Banana 2 and Nano Banana Pro 2. It's the same model on Runway.\"},{\"question\":\"What's the difference between Nano Banana, Nano Banana Pro and Nano Banana Pro 2?\",\"answer\":\"Nano Banana is optimized for speed and high-volume tasks: it generates at 1K resolution and supports up to 3 reference images. Nano Banana Pro is built for professional asset production, with up to 4K resolution, up to 14 reference images and stronger in-image text rendering. Nano Banana Pro 2 (also called Nano Banana 2) is the recommended starting point for most workflows — the best balance of quality, speed and intelligence, with the same 4K ceiling and 14-image support as Pro. Nano Banana Pro 2 Lite is a faster, more budget-friendly variant for exploration and high-volume drafts.\"},{\"question\":\"What is Nano Banana Pro 2 Lite?\",\"answer\":\"Nano Banana Pro 2 Lite is a faster, more budget-friendly variant of Nano Banana Pro 2, ideal for exploration and high-volume drafts. It's also available on Runway.\"},{\"question\":\"What resolutions and inputs does Nano Banana Pro 2 support?\",\"answer\":\"1K, 2K and 4K output, aspect ratios from 21:9 to 9:16, and up to 14 reference images alongside your text prompt.\"},{\"question\":\"What plan do I need to use Nano Banana Pro 2 on Runway?\",\"answer\":\"Nano Banana Pro 2 is available on all paid and Enterprise plans. Free plan users can upgrade to get access.\"},{\"question\":\"What other models are available on Runway?\",\"answer\":\"Runway gives you access to the world's leading image, video and audio models in one place — Runway models like Gen-4.5 and Aleph 2.0, plus third-party models like Nano Banana Pro 2, GPT Image 2, Kling 3.0, Kling O3, Veo 3.1, Seedance 2.5 and more.\"}],\"endCtaTitle\":\"Try Nano Banana Pro 2 on Runway today.\",\"endCtaDescription\":\"Google's latest image model, alongside every other leading AI model — in one workspace.\"},\"kling30\":{\"pageTitle\":\"Kling 3.0 on Runway | AI Video Generation with Audio\",\"pageDescription\":\"Use Kling 3.0 on Runway to generate video with native audio and speech from text or images. Start/end frames, multi-shot and Standard, Pro and Turbo tiers.\",\"heroEyebrow\":\"Now on Runway\",\"heroTitle\":\"Kling 3.0\",\"heroDescription\":\"Kling's most advanced video generation, on Runway. Turn text prompts and images into video with native audio and speech — with start/end frame control and multi-shot sequences.\",\"cardTitle\":\"Kling 3.0\",\"cardDescription\":\"Video generation with native audio and speech, from text or images.\",\"stepsTitle\":\"How to use Kling 3.0 on Runway\",\"steps\":[{\"title\":\"Start from text or an image\",\"description\":\"Write a prompt to generate from scratch, or upload an image to animate. Pin the first and last frames with images to control exactly where the motion starts and ends.\"},{\"title\":\"Choose your tier and settings\",\"description\":\"Pick Kling 3.0 Standard for budget-friendly generations, Pro for the most advanced output with audio and speech, or Turbo when speed matters most.\"},{\"title\":\"Generate with sound\",\"description\":\"Hit Generate and your video comes back with audio built in — dialogue, ambience and effects — ready to download and share.\"}],\"capabilitiesTitle\":\"What you can do with Kling 3.0\",\"capabilities\":[{\"title\":\"Native audio and speech\",\"description\":\"Generate dialogue, ambient sound and effects together with your visuals — no separate audio pass needed.\"},{\"title\":\"Start and end frame control\",\"description\":\"Pin the first and last frames with images and let Kling 3.0 fill in the motion between them.\"},{\"title\":\"Multi-shot sequences\",\"description\":\"Direct multi-shot videos that hold characters and style consistent across cuts.\"}],\"midCtaTitle\":\"Generate your first Kling 3.0 video on Runway.\",\"faq\":[{\"question\":\"What is Kling 3.0?\",\"answer\":\"Kling 3.0 is Kling's most advanced video generation model family, available inside Runway. It generates video with native audio and speech from text prompts or images, with start/end frame control and multi-shot support.\"},{\"question\":\"What's the difference between Kling 3.0 Standard, Pro and Turbo?\",\"answer\":\"Standard is the budget-friendly tier for everyday generations. Pro is the most advanced tier, with audio, speech and multi-shot support. Turbo is built for speed and exploration when fast iteration matters most.\"},{\"question\":\"Does Kling 3.0 generate audio?\",\"answer\":\"Yes. Kling 3.0 can generate video with or without audio — including speech and ambient sound — depending on the setting you choose.\"},{\"question\":\"What is Kling 3.0 Motion Control?\",\"answer\":\"Kling 3.0 Motion Control is a companion model that animates a still character image using the motion from a performance video — transferring full-body movement, hand gestures and facial expressions while preserving the character's visual identity. It's also available on Runway.\"},{\"question\":\"How is Kling 3.0 different from Kling O3?\",\"answer\":\"Kling O3 is Kling's multi-modal generation with timed keyframe guidance and output at up to 4K. Kling 3.0 offers Standard, Pro and Turbo tiers with start/end frame control and speech-led generation. Both are available on Runway, so you can pick per project.\"},{\"question\":\"What plan do I need to use Kling 3.0 on Runway?\",\"answer\":\"Kling 3.0 is available on all paid and Enterprise plans. Free plan users can upgrade to get access.\"},{\"question\":\"What other models are available on Runway?\",\"answer\":\"Runway gives you access to the world's leading image, video and audio models in one place — Runway models like Gen-4.5 and Aleph 2.0, plus third-party models like Nano Banana Pro 2, GPT Image 2, Kling 3.0, Kling O3, Veo 3.1, Seedance 2.5 and more.\"}],\"endCtaTitle\":\"Try Kling 3.0 on Runway today.\",\"endCtaDescription\":\"Video with native audio and speech, alongside every other leading AI model — in one workspace.\"},\"klingO3\":{\"pageTitle\":\"Kling O3 on Runway | Multi-Modal AI Video up to 4K\",\"pageDescription\":\"Kling O3 on Runway: multi-modal video generation with audio. Text to video, image to video, timed keyframes and multi-shot output at up to 4K.\",\"heroEyebrow\":\"Now on Runway\",\"heroTitle\":\"Kling O3\",\"heroDescription\":\"Kling's multi-modal video model, on Runway. Generate from text or images, guide motion with keyframes, and produce multi-shot sequences with audio at up to 4K.\",\"cardTitle\":\"Kling O3\",\"cardDescription\":\"Multi-modal video with audio, keyframes and up to 4K output.\",\"stepsTitle\":\"How to use Kling O3 on Runway\",\"steps\":[{\"title\":\"Bring text, images or both\",\"description\":\"Start from a prompt, an image, or a combination — Kling O3 is multi-modal, so you can mix inputs to describe exactly what you want.\"},{\"title\":\"Guide the motion with keyframes\",\"description\":\"Place timed keyframe images along your video to steer composition and action at specific moments, instead of leaving the in-between to chance.\"},{\"title\":\"Generate up to 4K\",\"description\":\"Choose Standard, Pro or 4K output and generate multi-shot video with audio, ready to download and share.\"}],\"capabilitiesTitle\":\"What you can do with Kling O3\",\"capabilities\":[{\"title\":\"Keyframe-guided motion\",\"description\":\"Timed keyframes let you direct what happens at specific points in the clip — a control most video models don't offer.\"},{\"title\":\"Up to 4K output\",\"description\":\"Generate at Standard or Pro quality for iteration, then step up to 4K for delivery-ready footage.\"},{\"title\":\"Multi-shot with audio\",\"description\":\"Produce multi-shot sequences with generated audio in a single pass.\"}],\"midCtaTitle\":\"Direct your first Kling O3 video on Runway.\",\"faq\":[{\"question\":\"What is Kling O3?\",\"answer\":\"Kling O3 is Kling's multi-modal video generation model, available inside Runway. It supports text to video, image to video, timed keyframe guidance and multi-shot output with audio at up to 4K.\"},{\"question\":\"How is Kling O3 different from Kling 3.0?\",\"answer\":\"Kling O3 adds timed keyframe guidance and 4K output on top of multi-modal generation. Kling 3.0 offers Standard, Pro and Turbo tiers with start/end frame control. Both are on Runway, so you can choose per project.\"},{\"question\":\"What are keyframes in Kling O3?\",\"answer\":\"Keyframes are guidance images placed at chosen moments in your video. The model uses them to steer composition and action at those points while generating the motion in between.\"},{\"question\":\"What quality tiers does Kling O3 offer?\",\"answer\":\"Standard and Pro tiers for everyday work, plus a 4K tier for maximum-resolution output.\"},{\"question\":\"Does Kling O3 generate audio?\",\"answer\":\"Yes — Kling O3 generates video with audio as part of its multi-modal output.\"},{\"question\":\"What plan do I need to use Kling O3 on Runway?\",\"answer\":\"Kling O3 is available on all paid and Enterprise plans. Free plan users can upgrade to get access.\"},{\"question\":\"What other models are available on Runway?\",\"answer\":\"Runway gives you access to the world's leading image, video and audio models in one place — Runway models like Gen-4.5 and Aleph 2.0, plus third-party models like Nano Banana Pro 2, GPT Image 2, Kling 3.0, Kling O3, Veo 3.1, Seedance 2.5 and more.\"}],\"endCtaTitle\":\"Try Kling O3 on Runway today.\",\"endCtaDescription\":\"Keyframe-directed, multi-modal video at up to 4K — in the same workspace as every other leading model.\"},\"veo31\":{\"pageTitle\":\"Veo 3.1 on Runway | Google AI Video with Native Audio\",\"pageDescription\":\"Use Google's Veo 3.1 on Runway: video with native audio and speech from text or images, with start/end frames. No Google subscription needed.\",\"heroEyebrow\":\"Now on Runway\",\"heroTitle\":\"Veo 3.1\",\"heroDescription\":\"Google's most advanced video generation model, on Runway. Cinematic video with native audio and speech from a text prompt or image — with start and end frame control.\",\"cardTitle\":\"Veo 3.1\",\"cardDescription\":\"Google's cinematic video generation with native audio and speech.\",\"stepsTitle\":\"How to use Veo 3.1 on Runway\",\"steps\":[{\"title\":\"Start from text or an image\",\"description\":\"Describe the shot you want, or upload an image to bring to life. Add start and end frames to control exactly how the shot opens and closes.\"},{\"title\":\"Choose audio on or off\",\"description\":\"Generate with native audio — dialogue, ambience and effects — or without it when you're scoring the edit yourself.\"},{\"title\":\"Generate and download\",\"description\":\"Hit Generate and your clip comes back ready to download, share or drop into a timeline.\"}],\"capabilitiesTitle\":\"What you can do with Veo 3.1\",\"capabilities\":[{\"title\":\"Cinematic motion and light\",\"description\":\"Veo 3.1 is known for photoreal detail, natural physics and cinematic camera behavior straight from a prompt.\"},{\"title\":\"Native audio and speech\",\"description\":\"Dialogue, ambient sound and effects generated together with the visuals — no separate audio pass.\"},{\"title\":\"Start and end frame control\",\"description\":\"Pin the opening and closing frames with images and let Veo 3.1 generate the shot between them.\"}],\"midCtaTitle\":\"Create your first Veo 3.1 video on Runway.\",\"faq\":[{\"question\":\"What is Veo 3.1?\",\"answer\":\"Veo 3.1 is Google's most advanced video generation model, available inside Runway. It creates video with native audio and speech from text prompts or images, with start/end frame control.\"},{\"question\":\"Do I need a Google or Gemini subscription to use Veo 3.1?\",\"answer\":\"No. Veo 3.1 is built into Runway — you use it with your Runway plan alongside every other model, with no separate Google account or subscription required.\"},{\"question\":\"Does Veo 3.1 generate audio?\",\"answer\":\"Yes. Veo 3.1 generates video with native audio and speech, and you can also choose to generate without audio.\"},{\"question\":\"What inputs does Veo 3.1 support?\",\"answer\":\"Text prompts, images for image-to-video, and start/end frame images to control how a shot opens and closes.\"},{\"question\":\"Is Veo 3 also available on Runway?\",\"answer\":\"Yes — the previous-generation Veo 3 is also available on Runway if you want to match earlier work or compare generations.\"},{\"question\":\"What plan do I need to use Veo 3.1 on Runway?\",\"answer\":\"Veo 3.1 is available on all paid and Enterprise plans. Free plan users can upgrade to get access.\"},{\"question\":\"What other models are available on Runway?\",\"answer\":\"Runway gives you access to the world's leading image, video and audio models in one place — Runway models like Gen-4.5 and Aleph 2.0, plus third-party models like Nano Banana Pro 2, GPT Image 2, Kling 3.0, Kling O3, Veo 3.1, Seedance 2.5 and more.\"}],\"endCtaTitle\":\"Try Veo 3.1 on Runway today.\",\"endCtaDescription\":\"Google's cinematic video model, alongside every other leading AI model — in one workspace.\"},\"gptImage2\":{\"pageTitle\":\"GPT Image 2 on Runway | AI Images with Accurate Text\",\"pageDescription\":\"OpenAI's GPT Image 2 on Runway: images with exceptional text rendering — posters, mockups, ads, signage. Up to 4K, 16 references and scene sketching.\",\"heroEyebrow\":\"Now on Runway\",\"heroTitle\":\"GPT Image 2\",\"heroDescription\":\"OpenAI's image model with exceptional text rendering, on Runway. Generate posters, mockups, ads and signage with accurate, legible in-image text — guided by up to 16 references or a scene sketch.\",\"cardTitle\":\"GPT Image 2\",\"cardDescription\":\"OpenAI's image model with exceptional in-image text rendering.\",\"stepsTitle\":\"How to use GPT Image 2 on Runway\",\"steps\":[{\"title\":\"Write your copy into the prompt\",\"description\":\"Include the exact headlines, taglines or labels you want to appear in the image — GPT Image 2's text rendering keeps them accurate and legible. Be direct about layout and content.\"},{\"title\":\"Guide with references or a sketch\",\"description\":\"Upload up to 16 reference images, or sketch a rough composition directly on the canvas to control placement, scale and layout.\"},{\"title\":\"Pick resolution and quality\",\"description\":\"Choose 1K, 2K or 4K output and a Low, Medium or High quality level, then generate multiple variations at once.\"}],\"capabilitiesTitle\":\"What you can do with GPT Image 2\",\"capabilities\":[{\"title\":\"Typography that reads\",\"description\":\"The strongest choice when in-image text needs to be accurate and legible — posters, packaging, ad concepts, signage and social graphics.\"},{\"title\":\"Sketch to control composition\",\"description\":\"Draw a rough layout on the canvas — or directly on a reference image — to guide placement, scale and edits visually.\"},{\"title\":\"Ten aspect ratios\",\"description\":\"From 21:9 cinematic banners through square to 9:16 vertical, GPT Image 2 covers every placement you're designing for.\"}],\"midCtaTitle\":\"Design your first asset with GPT Image 2 on Runway.\",\"faq\":[{\"question\":\"What is GPT Image 2?\",\"answer\":\"GPT Image 2 is OpenAI's image generation model, available inside Runway. It's known for exceptional text rendering, making it the strongest choice for outputs where in-image text needs to be accurate and legible — mockups, posters, ad concepts, signage and social graphics.\"},{\"question\":\"What inputs does GPT Image 2 support?\",\"answer\":\"A text prompt, up to 16 optional reference images, and an optional scene sketch drawn directly on the canvas (or on a reference image) to guide composition and placement.\"},{\"question\":\"What resolutions and quality levels are available?\",\"answer\":\"1K, 2K and 4K resolution, each with Low, Medium or High quality — quality controls the level of detail rendered within your chosen resolution.\"},{\"question\":\"What aspect ratios does GPT Image 2 support?\",\"answer\":\"Ten ratios: 21:9, 16:9, 3:2, 4:3, 5:4, 1:1, 4:5, 3:4, 2:3 and 9:16.\"},{\"question\":\"How do I get accurate text in my images?\",\"answer\":\"Put the exact copy you want directly in your prompt — headlines, taglines, labels — and be direct about layout. GPT Image 2 interprets detailed prompts well and renders the specified text accurately.\"},{\"question\":\"What plan do I need to use GPT Image 2 on Runway?\",\"answer\":\"GPT Image 2 is available on all paid and Enterprise plans. Free plan users can upgrade to get access.\"},{\"question\":\"What other models are available on Runway?\",\"answer\":\"Runway gives you access to the world's leading image, video and audio models in one place — Runway models like Gen-4.5 and Aleph 2.0, plus third-party models like Nano Banana Pro 2, GPT Image 2, Kling 3.0, Kling O3, Veo 3.1, Seedance 2.5 and more.\"}],\"endCtaTitle\":\"Try GPT Image 2 on Runway today.\",\"endCtaDescription\":\"Accurate in-image text and sketch-guided composition — in the same workspace as every other leading model.\"},\"geminiOmni\":{\"pageTitle\":\"Gemini Omni Flash on Runway | AI Video Generation and Editing\",\"pageDescription\":\"Gemini Omni Flash on Runway: generate new videos from text and images, or edit footage with a prompt. 3–10 second clips with up to 10 reference images.\",\"heroEyebrow\":\"New on Runway\",\"heroTitle\":\"Gemini Omni Flash\",\"heroDescription\":\"Google's newest video model, on Runway. Generate 3–10 second clips from a prompt, a first frame and up to 10 reference images — or edit existing footage with plain-language instructions.\",\"cardTitle\":\"Gemini Omni Flash\",\"cardDescription\":\"Google's newest video model — generate new clips or edit existing footage.\",\"stepsTitle\":\"How to use Gemini Omni Flash on Runway\",\"steps\":[{\"title\":\"Choose Frame or Edit mode\",\"description\":\"Frame mode generates a new video from a prompt and optional images. Edit mode changes existing footage — upload a clip and describe the adjustment you want.\"},{\"title\":\"Add your prompt and references\",\"description\":\"Set the duration between 3 and 10 seconds, optionally pin a first frame, and add up to 10 reference images to guide the look and feel.\"},{\"title\":\"Generate and share\",\"description\":\"Gemini Omni Flash picks 16:9 or 9:16 automatically from your inputs — or ask for a format directly in your prompt — and returns a clip ready to post.\"}],\"capabilitiesTitle\":\"What you can do with Gemini Omni Flash\",\"capabilities\":[{\"title\":\"Two modes in one model\",\"description\":\"Generate brand-new clips from text and images, or upload existing footage and edit it with a plain-language instruction.\"},{\"title\":\"Reference-guided looks\",\"description\":\"A first frame becomes the literal opening of your video, while reference images guide style and feel without appearing verbatim — combine them however you like.\"},{\"title\":\"Prompt-controlled framing\",\"description\":\"The model chooses 16:9 or 9:16 automatically based on your inputs; steer it by asking for a widescreen or vertical clip in the prompt.\"}],\"midCtaTitle\":\"Be first to create with Gemini Omni Flash on Runway.\",\"faq\":[{\"question\":\"What is Gemini Omni Flash?\",\"answer\":\"Gemini Omni Flash is Google's video generation model, available inside Runway. It generates new videos from a text prompt and optional images, or edits existing footage using a text prompt and optional reference images.\"},{\"question\":\"What's the difference between a first frame and reference images?\",\"answer\":\"The first frame becomes the literal opening frame of your generated video. Reference images guide the look and feel of the output without appearing as an exact frame. You can combine a first frame with references, or use either alone.\"},{\"question\":\"How long can Gemini Omni Flash videos be?\",\"answer\":\"You choose a duration between 3 and 10 seconds. All videos are output at 720p, in 16:9 or 9:16.\"},{\"question\":\"Can Gemini Omni Flash edit existing footage?\",\"answer\":\"Yes. In Edit mode, upload a video under 100 MB and up to 10 seconds long, then describe the change you want — optionally adding a reference image to guide the edit.\"},{\"question\":\"How do I control the aspect ratio?\",\"answer\":\"Gemini Omni Flash sets the aspect ratio automatically from your prompt and inputs, outputting 16:9 or 9:16. To influence it, ask directly in your prompt — for example, 'generate a 16:9 video of…' or 'create a vertical clip of…'.\"},{\"question\":\"What plan do I need to use Gemini Omni Flash on Runway?\",\"answer\":\"Gemini Omni Flash is available to users on a Standard plan or higher.\"},{\"question\":\"What other models are available on Runway?\",\"answer\":\"Runway gives you access to the world's leading image, video and audio models in one place — Runway models like Gen-4.5 and Aleph 2.0, plus third-party models like Nano Banana Pro 2, GPT Image 2, Kling 3.0, Kling O3, Veo 3.1, Seedance 2.5 and more.\"}],\"endCtaTitle\":\"Try Gemini Omni Flash on Runway today.\",\"endCtaDescription\":\"Google's newest video model, alongside every other leading AI model — in one workspace.\"},\"minimaxH3\":{\"pageTitle\":\"MiniMax H3 (Hailuo 3) on Runway | AI Video up to 2K\",\"pageDescription\":\"MiniMax H3 on Runway: multimodal AI video from text, image, video and audio references. Clips of 5 to 15 seconds at 768p or 2K, plus keyframe control.\",\"heroEyebrow\":\"Now on Runway\",\"heroTitle\":\"MiniMax H3\",\"heroDescription\":\"MiniMax's Hailuo 3 video model, on Runway. Work from a prompt on its own, guide the shot with image, video and audio references, or set a first and last frame and let H3 generate the motion between them.\",\"cardTitle\":\"MiniMax H3\",\"cardDescription\":\"MiniMax's Hailuo 3: multimodal references, keyframes and 2K output.\",\"stepsTitle\":\"How to use MiniMax H3 on Runway\",\"steps\":[{\"title\":\"Describe the shot\",\"description\":\"Every H3 generation starts with text, up to 6,000 characters of it, so this is where the shot gets defined even when you plan to attach references as well.\"},{\"title\":\"Add references, or set keyframes\",\"description\":\"Bring up to 9 images, 3 clips and 3 audio takes as references, 12 files at most. Or switch to keyframes instead: a first frame, optionally a last frame, and H3 fills in the movement.\"},{\"title\":\"Set length and resolution\",\"description\":\"Pick any length from 5 to 15 seconds, then 768p while you are still iterating or 2K when you want the finished version. Six aspect ratios are available, from 21:9 through to 9:16.\"}],\"capabilitiesTitle\":\"What you can do with MiniMax H3\",\"capabilities\":[{\"title\":\"References across four media types\",\"description\":\"Text, images, video and audio all act as guidance in the same request, up to 12 reference files together. Reference clips can run from 2 to 15 seconds.\"},{\"title\":\"First and last frame control\",\"description\":\"Give H3 the frame a shot opens on and the frame it lands on, and it generates the movement between them. The output follows your frames, so the aspect ratio is set for you.\"},{\"title\":\"768p or 2K from the same model\",\"description\":\"Work at 768p while a shot is still changing, then re-run the version you want at 2K. No switching models between the rough pass and the final one.\"}],\"midCtaTitle\":\"Build your first MiniMax H3 shot on Runway.\",\"faq\":[{\"question\":\"What is MiniMax H3?\",\"answer\":\"MiniMax H3 is MiniMax's Hailuo 3 video generation model, available inside Runway. It generates from text, image, video and audio references, supports first and last frame keyframes, and returns 5 to 15 second clips at 768p or 2K.\"},{\"question\":\"Where can I create with MiniMax H3?\",\"answer\":\"In two places: Runway Creative, where you generate and edit in one workspace, and Runway Dev, where you call MiniMax H3 through the API. The API names it hailuo3.\"},{\"question\":\"Is MiniMax H3 the same model as Hailuo 3?\",\"answer\":\"Yes. Hailuo 3 is MiniMax's name for the model and H3 is how it appears in Runway's video model picker, so if you came looking for Hailuo 3 you are in the right place.\"},{\"question\":\"What can I attach as a reference?\",\"answer\":\"Up to 9 images, 3 video clips and 3 audio clips, to a maximum of 12 files in one generation. Reference clips need to be between 2 and 15 seconds. Audio references require at least one image or video reference alongside them.\"},{\"question\":\"How do the first and last frame keyframes work?\",\"answer\":\"Attach an image as the first frame and, if you want one, a second image as the last frame. H3 generates the motion between them and matches the output to those frames, so you do not choose an aspect ratio. Keyframes are their own mode and cannot be combined with reference images, video or audio in the same generation.\"},{\"question\":\"How long can an H3 clip be, and at what resolution?\",\"answer\":\"Any whole number of seconds from 5 to 15, at either 768p or 2K. Six aspect ratios are available: 21:9, 16:9, 4:3, 1:1, 3:4 and 9:16.\"},{\"question\":\"Which Runway Creative plans include MiniMax H3?\",\"answer\":\"MiniMax H3 is available on all paid and Enterprise plans. If you are on the Free plan, upgrading unlocks it.\"},{\"question\":\"Which other video models can I use on Runway?\",\"answer\":\"Alongside our own Gen-4.5 and Aleph 2.0, Runway carries Kling 3.0, Kling O3, Veo 3.1, Seedance 2.5 and Gemini Omni Flash, so you can pick the right model per shot without leaving the workspace.\"}],\"endCtaTitle\":\"Try MiniMax H3 on Runway today.\",\"endCtaDescription\":\"Multimodal references, keyframe control and 2K output, in the same workspace as every other model we carry.\"},\"wan30\":{\"cardTitle\":\"Wan 3.0\",\"cardDescription\":\"Alibaba video generation with native audio, 2 to 30 seconds, up to 1080p.\"}},\"robotics\":{\"platformEyebrow\":\"Platform\",\"toolkitHeading\":\"A complete toolkit for robot learning.\",\"toolkitIntro\":\"From policy inference and evaluation to synthetic data generation, every component is powered by GWM-1, our state-of-the-art General World Model. Pick the surface you need — we'll work with you to fit it to your hardware.\",\"policyModelTitle\":\"Policy Model\",\"policyModelDesc\":\"Control your robot with Runway's General World Model. GWM-1 predicts actions from live observations — custom fine-tuned for your specific hardware, environment, and tasks.\",\"videoLicensingTitle\":\"Video Model Licensing\",\"videoLicensingDesc\":\"License GWM-1 as the diffusion backbone for training custom policy models. Deploy on your own infrastructure with full control over fine-tuning.\",\"policyEvalTitle\":\"Offline Policy Evaluation\",\"policyEvalDesc\":\"Submit action sequences and camera observations to simulate policy rollouts in GWM-1. Surface failure modes before deploying to hardware.\",\"dataAugTitle\":\"Data Augmentation\",\"dataAugDesc\":\"Transform existing trajectories into new environments, lighting conditions, and object configurations. Expand your training distribution without collecting more data.\"},\"gwmWorlds2\":{\"tabs\":{\"navigation\":\"Navigation\",\"actions\":\"Actions\",\"speech\":\"Speech\",\"ariaLabel\":\"Capabilities\"},\"agentic\":{\"ariaLabel\":\"Agentic control examples\",\"castle\":\"Castle\",\"jetski\":\"Jet ski\",\"redflag\":\"Goal: Move to red flag\",\"blueflag\":\"Goal: Move to blue flag\",\"bothflags\":\"Goal: Move to red, then blue\"},\"teacher\":{\"ariaLabel\":\"More WorldPrompt results\",\"lakeside\":\"Lakeside chat\",\"castletour\":\"Cartoon castle\"},\"prefill\":{\"ariaLabel\":\"Video-prefill examples\",\"rat\":\"Alley rat\",\"warzone\":\"Urban war zone\"},\"player\":{\"play\":\"Play\",\"pause\":\"Pause\",\"seek\":\"Seek\",\"mute\":\"Toggle sound\",\"inputsToggle\":\"Inputs\",\"inputsToggleAria\":\"Toggle conditioning inputs overlay\",\"cameraLabel\":\"Camera\",\"inputVideo\":\"Input video · {seconds}s\",\"livePlay\":\"Live play\"},\"worldPrompt\":{\"firstFrameAlt\":\"First frame of the example session: a street sweeper on the left and a woman in a green trench coat walking away down a wet pavement.\",\"timelineAria\":\"Caption timeline — click or drag to seek the video\",\"previewHint\":\"Move over or focus a timeline bar to see its full prompt.\"},\"inquiry\":{\"heading\":\"Fill out this form to get in touch about GWM Worlds 2\",\"fullNameLabel\":\"Full name\",\"fullNamePlaceholder\":\"Type your full name\",\"fullNameRequired\":\"Full name is required\",\"emailLabel\":\"Business email\",\"emailPlaceholder\":\"Type your business email\",\"emailRequired\":\"Email is required\",\"companyNameLabel\":\"Company name\",\"companyNamePlaceholder\":\"Type your company name\",\"companyNameRequired\":\"Company name is required\",\"companySizeLabel\":\"Company size\",\"companySizeRequired\":\"Company size is required\",\"additionalDetailsLabel\":\"Additional details\",\"additionalDetailsPlaceholder\":\"Tell us about your use case\",\"submit\":\"Submit\",\"submitting\":\"Submitting...\",\"successTitle\":\"Thank you for your interest.\",\"successBody\":\"We'll be in touch shortly to discuss your request.\",\"successReturn\":\"Return\",\"error\":\"There was an error sending your request. Please try again later.\"},\"diagrams\":{\"methods\":{\"legendActions\":\"actions\",\"legendGeneration\":\"generation\",\"aheadTitle\":\"ahead of time\",\"aheadSub\":\"author all actions first\",\"turnTitle\":\"turn-based\",\"turnSub\":\"generation waits for you\",\"turnNote\":\"the user authors an action\",\"realtimeTitle\":\"real-time\",\"realtimeSub\":\"no waiting, low latency\",\"realtimeNote\":\"actions take effect immediately, while generation keeps running\",\"time\":\"time\"},\"architecture\":{\"videoDecoder\":\"video decoder\",\"audioDecoder\":\"audio decoder\",\"transformer\":\"autoregressive transformer\",\"kvCache\":\"KV cache\",\"currentNoiseFrame\":\"current noise frame\",\"camera\":\"camera\",\"firstFrame\":\"first frame\",\"genesisPrompt\":\"genesis prompt\",\"genesisLine1\":\"wet urban pavement, brick buildings…\",\"genesisLine2\":\"the street sweeper · the woman in coat…\",\"genesisLine3\":\"camera follows her\",\"chipSweeps\":\"sweeps leaves\",\"chipHeadStraight\":\"“Just head straight…”\",\"chipThankYou\":\"“Thank you…”\",\"chipCurrent\":\"moves forward\"},\"architectureAria\":\"Architecture diagram: a wide autoregressive transformer sits in the middle. Below it, three inputs feed upward: the global context (the example's first frame and a genesis prompt snippet), a KV cache of three past frames each stacked over its text action and camera input, and the current noise frame with its caption (moves forward) and camera input. Above the transformer, video and audio decoders output a clean video frame and an audio waveform.\",\"attentionAria\":\"Attention pattern matrix: every token attends to the global tokens (first frame and genesis prompt), and each frame's video, text and audio tokens causally attend to themselves and past frames in a sliding KV-cache window; older frames are evicted. Global tokens attend only to themselves.\",\"methodsAria\":\"Timeline comparison of the three methods. Ahead of time: all actions are authored first, then one long generation runs. Turn-based: generation runs in segments, pausing at each decision point for the user to author an action. Real-time: one continuous generation with actions landing on it while it runs.\"}},\"wan30\":{\"pageTitle\":\"Wan 3.0 | Alibaba's Video Model on Runway\",\"pageDescription\":\"Wan 3.0 is available on Runway. Generate video with native audio, from 2 to 30 seconds at up to 1080p, guided by image, video and audio references.\",\"heroEyebrow\":\"Now on Runway\",\"heroTitle\":\"Wan 3.0\",\"heroDescription\":\"Alibaba's flagship video generation model. Create state-of-the-art video with native audio, guided by image, video and audio references.\",\"joinLabel\":\"Try Wan 3.0\",\"capabilitiesTitle\":\"Video and audio, generated together\",\"capabilities\":[{\"category\":\"Length\",\"title\":\"Up to 30 seconds in a single pass\",\"description\":\"Pick any duration from 2 to 30 seconds and get one continuous generation. Shot changes and pacing shifts arrive already assembled, with nothing to stitch.\"},{\"category\":\"Inputs\",\"title\":\"Reference anything\",\"description\":\"Guide a generation with up to 10 images, 5 video clips and 5 audio tracks alongside your prompt, and the output follows them.\"},{\"category\":\"Audio\",\"title\":\"Native sound\",\"description\":\"Dialogue, ambience and effects are generated in the same pass as the picture, synchronized from the first frame.\"},{\"category\":\"Motion\",\"title\":\"Motion that holds up\",\"description\":\"Improved rendering of real-world movement and physics, so water, fabric and fast action read the way a camera would catch them.\"}],\"stepsTitle\":\"How to use Wan 3.0 on Runway\",\"steps\":[{\"title\":\"Pick your starting point\",\"description\":\"Begin with a prompt on its own, an image to animate, or a set of references across image, video and audio.\"},{\"title\":\"Set the output\",\"description\":\"Choose an aspect ratio, a resolution up to 1080p and any duration between 2 and 30 seconds, with audio on or off.\"},{\"title\":\"Generate\",\"description\":\"Your clip comes back with picture and sound together, ready to download or drop into a workflow.\"}],\"modesTitle\":\"Three ways to create with Wan 3.0\",\"modes\":[{\"eyebrow\":\"Text to Video\",\"title\":\"Start from a sentence\",\"description\":\"Describe the scene, the camera and even the soundtrack, and Wan 3.0 builds the shot from words alone.\"},{\"eyebrow\":\"Image to Video\",\"title\":\"Set the exact first frame\",\"description\":\"Give Wan 3.0 a still and a prompt and it takes the shot from there. You can pin a last frame too, so the clip lands exactly where you want it.\"},{\"eyebrow\":\"Reference to Video\",\"title\":\"Keep every shot consistent\",\"description\":\"Attach images, clips and audio of your character, product or style, and they stay recognizable across new scenes and angles.\"}],\"example\":{\"inputLabel\":\"Input image\",\"inputAlt\":\"Reference still of a person silhouetted mid-air against a dusk sky\",\"promptLabel\":\"Prompt\",\"promptText\":\"A woman ascends and floats in mid-air, camera arcs around her and slowly pushes in to close up, fluid camera motion\",\"outputLabel\":\"Output\"},\"devEyebrow\":\"Runway Dev\",\"devTitle\":\"Build with the Wan 3.0 API\",\"devDescription\":\"Ship Wan 3.0 inside your own product through Runway Dev. The text to video and image to video endpoints carry the full reference budget, durations and resolutions.\",\"midCtaTitle\":\"Make your first Wan 3.0 video\",\"midCtaDescription\":\"Describe the clip you want, attach your references and generate.\",\"faq\":[{\"question\":\"What is Wan 3.0?\",\"answer\":\"Wan 3.0 is Alibaba's flagship video generation model, available on Runway. It produces video with native audio from 2 to 30 seconds in one pass, working from a text prompt, a starting image or a set of image, video and audio references.\"},{\"question\":\"Where can I create with Wan 3.0?\",\"answer\":\"In two places: the Runway app, where Wan 3.0 runs in tool mode and workflows, and Runway Dev, where the API serves it under the model id wan3 for text to video and image to video.\"},{\"question\":\"What can I attach as a reference?\",\"answer\":\"Up to 10 images, 5 video clips and 5 audio tracks in one request. A single image can instead be pinned as the exact first frame, with an optional last frame. Keyframes and references are separate modes, so pass unpositioned reference images when you want to mix stills with clips or audio.\"},{\"question\":\"Does Wan 3.0 generate audio too?\",\"answer\":\"Yes. Sound is generated natively alongside the picture in the same pass, so speech, ambience and effects arrive synchronized. You can also switch audio off before generating.\"},{\"question\":\"What resolutions and lengths does it support?\",\"answer\":\"Any duration from 2 to 30 seconds, at 480p, 720p or 1080p. Longer clips and higher resolutions use more credits.\"},{\"question\":\"Which Runway plans can use Wan 3.0?\",\"answer\":\"Wan 3.0 has rolled out to all Runway users in tool mode and workflows, with generations billed in credits based on resolution and length.\"},{\"question\":\"Which other video models does Runway offer?\",\"answer\":\"Runway brings the leading video, image and audio models into one workspace, including our own Gen-4.5 and Aleph 2.0 alongside Seedance 2.5, Kling 3.0, Veo 3.1 and more. Browse the full model list for what's live today.\"}],\"faqModelsLinkText\":\"full model list\",\"endCtaTitle\":\"Wan 3.0 is live on Runway\"},\"ruby\":{\"pageTitle\":\"Runway Ruby | SDR to HDR Video Conversion\",\"pageDescription\":\"Runway Ruby converts SDR video into true HDR, keeping the source pixels and audio intact. Deliver HDR10, HLG, ProRes or EXR masters in Runway or via the API.\",\"heroEyebrow\":\"SDR-to-HDR color grading model\",\"heroTitle\":\"Runway Ruby\",\"heroDescription\":\"Convert any SDR video into true HDR. Ruby extends brightness and color while keeping your source pixels and audio intact, and delivers HDR10, HLG, ProRes or EXR masters.\",\"joinLabel\":\"Try Ruby\",\"capabilitiesTitle\":\"True HDR from any SDR video\",\"capabilities\":[{\"category\":\"Input\",\"title\":\"Any source, any model\",\"description\":\"Runway generations, third-party model output or your own footage: any SDR video up to 30 seconds and up to 4K.\"},{\"category\":\"Fidelity\",\"title\":\"Nothing is re-rendered\",\"description\":\"Keeps the source pixels and audio, and extends luma and color into the HDR range.\"},{\"category\":\"Delivery\",\"title\":\"Formats a pipeline expects\",\"description\":\"HDR10 and HLG as 10-bit HEVC, BT.2020 PQ ProRes in 422, 422 HQ or 4444, and OpenEXR sequences in linear BT.2020 or scene-referred ACEScg.\"},{\"category\":\"VFX\",\"title\":\"ACES-ready EXR\",\"description\":\"Scene-referred ACEScg sequences for ACES 1.3 and 2.0, with VFX frame naming, colorimetry and provenance sidecars, and the source audio as a WAV.\"},{\"category\":\"Transparency\",\"title\":\"Alpha stays put\",\"description\":\"Alpha channels pass through untouched, as the A channel in EXR or an alpha plane in ProRes 4444.\"},{\"category\":\"Bit depth\",\"title\":\"Deep color end to end\",\"description\":\"10-bit HEVC and ProRes 422, 12-bit ProRes 4444, 16-bit EXR sequences.\"}],\"stepsTitle\":\"How to use Ruby on Runway\",\"steps\":[{\"title\":\"Pick a video\",\"description\":\"Select Ruby in Tool Mode and upload a clip, or convert a finished generation in your Session. SDR only, up to 30 seconds.\"},{\"title\":\"Choose a delivery format\",\"description\":\"HDR10 for general playback, HLG for broadcast, ProRes for editorial or an EXR sequence for compositing.\"},{\"title\":\"Download the master\",\"description\":\"Your HDR file comes back at the source resolution, ready to download.\"}],\"videoTitle\":\"Getting started with Runway Ruby\",\"formatsTitle\":\"Pick the master your pipeline needs\",\"formatsDescription\":\"HDR10 and HLG for playback and broadcast, ProRes for editorial, EXR for compositing and ACES pipelines.\",\"formats\":[{\"label\":\"HDR10\",\"description\":\"10-bit HEVC, BT.2020 + PQ. The default, for general delivery.\"},{\"label\":\"HLG\",\"description\":\"10-bit HEVC, BT.2020 + HLG, for broadcast-style delivery.\"},{\"label\":\"ProRes\",\"description\":\"BT.2020 + PQ .mov mezzanine: 422 and 422 HQ at 10-bit, or 4444 at 12-bit with alpha.\"},{\"label\":\"EXR sequence\",\"description\":\"16-bit half-float OpenEXR frames as linear BT.2020 light, with colorimetry and provenance sidecars and the source audio as audio.wav.\"},{\"label\":\"ACEScg EXR\",\"description\":\"16-bit scene-referred ACEScg sequences for ACES 1.3 or ACES 2.0, read with the stock ACES - ACEScg input transform.\"}],\"surfacesTitle\":\"Where you can use Ruby\",\"surfacesDescription\":\"In Sessions and Workflows in the Creative app, through the Runway Dev API and MCP, and inside the Adobe plugins.\",\"surfaces\":[{\"title\":\"Tool Mode\",\"description\":\"Pick Ruby in the model picker to grade a clip you bring in, or choose HDR before or after generating with any video model in a Session.\",\"linkLabel\":\"Open Tool Mode\"},{\"title\":\"Workflows\",\"description\":\"Add an HDR conversion step to any workflow.\",\"linkLabel\":\"Open Workflows\"},{\"title\":\"Runway Dev\",\"description\":\"One call to the video_to_hdr endpoint with model ruby, available to every API account.\",\"linkLabel\":\"View the endpoint\"},{\"title\":\"Runway MCP\",\"description\":\"Convert a video to HDR from the agent you already work in, through the Runway MCP.\",\"linkLabel\":\"About Runway MCP\"},{\"title\":\"Adobe plugins\",\"description\":\"Convert a timeline clip to HDR from inside Premiere Pro or After Effects with the Runway plugins.\",\"linkLabel\":\"Get the plugins\"},{\"title\":\"Native HDR with Gen-4.5\",\"description\":\"Gen-4.5 can generate in HDR from the start, including ACEScg EXR, so Ruby is for footage that already exists.\",\"linkLabel\":\"About Gen-4.5\"}],\"devTitle\":\"Build HDR delivery into your product\",\"devDescription\":\"Send a video to POST /v1/video_to_hdr with model set to ruby and get back an HDR master at the source resolution, in any delivery profile from HDR10 to ACEScg EXR.\",\"devTabs\":{\"node\":\"Node SDK\",\"python\":\"Python SDK\"},\"devCaption\":\"Full request and response schema in the Runway Dev API reference.\",\"devImageAlt\":\"Ruby wordmark on a deep red gradient\",\"midCtaTitle\":\"Convert your first video to HDR.\",\"midCtaDescription\":\"Upload a clip or pick a generation, choose a delivery format and download true HDR.\",\"faq\":[{\"question\":\"What is Runway Ruby?\",\"answer\":\"Runway Ruby is our SDR-to-HDR color grading model. It converts standard dynamic range video into true HDR, extending brightness and color into the HDR range while keeping the source pixels and audio intact. Built for film and VFX pipelines that need HDR deliverables from generated and captured footage.\"},{\"question\":\"Where can I use Ruby?\",\"answer\":\"In Runway Creative, Ruby runs in Sessions, both as its own model in Tool Mode and as the HDR option before or after generating with any video model, in Workflows, and in the Runway plugins for Premiere Pro and After Effects. In Runway Dev, the API serves it as model ruby on the video_to_hdr endpoint, and the Runway MCP exposes it to agents.\"},{\"question\":\"What inputs does Ruby accept?\",\"answer\":\"SDR video up to 30 seconds and under 4096 pixels on each side, whether it is a Runway generation, third-party model output or footage you upload. Video that is already HDR is rejected, and output dimensions may be cropped to a multiple of 16.\"},{\"question\":\"Which output formats can Ruby deliver?\",\"answer\":\"HDR10 (the default) or HLG as 10-bit HEVC, BT.2020 PQ ProRes .mov in 422 and 422 HQ at 10-bit or 4444 at 12-bit, 16-bit half-float OpenEXR sequences as linear BT.2020 light, and scene-referred ACEScg EXR sequences for ACES 1.3 or ACES 2.0. EXR deliveries arrive as a zip with colorimetry and provenance sidecars and, when the source has sound, an audio.wav.\"},{\"question\":\"Does Ruby change my footage?\",\"answer\":\"No. Nothing is re-rendered or re-synthesized. Pixels and audio pass through as received and luma and color are extended into HDR headroom. Sources with an alpha channel keep it in the EXR and ProRes 4444 deliveries; HDR10 and HLG cannot carry alpha.\"},{\"question\":\"Which Runway Creative plans include Ruby?\",\"answer\":\"Ruby is included on Max and higher plans in Runway Creative, including Enterprise. On Runway Dev, every API account can call it.\"},{\"question\":\"Where is the full documentation?\",\"answer\":\"The Help Center article Creating HDR videos with Runway Ruby covers formats, plan availability and how to view HDR output. The Runway Dev docs cover the video_to_hdr endpoint, pricing and code samples.\"}],\"faqHelpLinkText\":\"Creating HDR videos with Runway Ruby\",\"endCtaTitle\":\"Deliver true HDR with Runway Ruby\"},\"seedance25\":{\"pageTitle\":\"Seedance 2.5 | Available on Runway\",\"pageDescription\":\"Seedance 2.5 is available on Runway. Generate multi-shot video up to 30 seconds from up to 50 references across text, image, video and audio.\",\"heroEyebrow\":\"Available on Runway\",\"heroTitle\":\"Seedance 2.5\",\"heroDescription\":\"Bring up to 50 references across text, image, video and audio and generate high-quality, multi-shot video up to 30 seconds.\",\"joinLabel\":\"Try Seedance 2.5\",\"capabilitiesTitle\":\"State-of-the-art video generation\",\"capabilities\":[{\"category\":\"Length\",\"title\":\"Up to 30 seconds in one generation\",\"description\":\"Native 30-second output, with high-quality extension for longer clips. Room for a full ad or scene, not just a snippet.\"},{\"category\":\"Inputs\",\"title\":\"Up to 50 references\",\"description\":\"Combine up to 50 inputs — product shots, a style guide, a voiceover, clips — into one coherent video.\"},{\"category\":\"Editing\",\"title\":\"Localized editing\",\"description\":\"Prompt a change to an existing video and everything you didn't ask to change stays consistent with the original.\"},{\"category\":\"Direction\",\"title\":\"Complex shots in one pass\",\"description\":\"Multiple scenes, camera angles and pacing shifts come out of one generation, with no separate clips to stitch together.\"}],\"stepsTitle\":\"From idea to finished video in minutes\",\"steps\":[{\"title\":\"Add your references\",\"description\":\"Bring up to 50 references across images, video clips and audio — a product photo, a color palette, a camera style, a voiceover. Whatever helps tell your story.\"},{\"title\":\"Describe what you want\",\"description\":\"Write a prompt, then choose your aspect ratio, resolution and duration, up to 30 seconds per video.\"},{\"title\":\"Generate and download\",\"description\":\"Generate, and your video comes back with visuals and sound, ready to download and share.\"}],\"audiencesTitle\":\"Create with Seedance 2.5\",\"audiences\":[{\"eyebrow\":\"For marketers\",\"title\":\"Finished ads the same day\",\"description\":\"Go from idea to a finished ad without a shoot to book. Up to 30 seconds gives you room for a full spot: drop in product images, add a script and generate a version for every channel.\"},{\"eyebrow\":\"For filmmakers\",\"title\":\"From concept to finished footage\",\"description\":\"Take projects from early concepts to finished footage. Direct with reference clips, images and audio for consistent characters, intentional camera work and synchronized sound.\"},{\"eyebrow\":\"For creators\",\"title\":\"Content ready to post\",\"description\":\"Combine reference images, voice and a prompt to make polished, on-brand content that's ready to post.\"}],\"midCtaTitle\":\"Start creating with Seedance 2.5\",\"midCtaDescription\":\"Describe the video you want and Runway builds it, references and all.\",\"faq\":[{\"question\":\"What is Seedance 2.5?\",\"answer\":\"Seedance 2.5 is a multimodal video generation model available on Runway. Use text, images, video clips and audio as inputs to produce multi-shot video up to 30 seconds, with multiple scenes, camera angles and pacing shifts in a single generation, plus built-in sound design.\"},{\"question\":\"How do I start using Seedance 2.5?\",\"answer\":\"Open Runway, describe the video you want, and Seedance 2.5 generates it. You can attach your references in the same prompt.\"},{\"question\":\"What plan do I need to use Seedance 2.5?\",\"answer\":\"Seedance 2.5 is available on all paid plans. Free plan users can upgrade to get access.\"},{\"question\":\"What inputs does Seedance 2.5 support?\",\"answer\":\"Combine up to 50 references across text, images, video and audio (a brand kit, a voiceover, a style reference) and Seedance 2.5 works them into one coherent video.\"},{\"question\":\"How long can generated videos be?\",\"answer\":\"Seedance 2.5 outputs up to 30 seconds natively, with high-quality extension for longer clips. Choose your duration, aspect ratio and resolution before generating. Output is available at 480p, 720p and 1080p.\"},{\"question\":\"What other models are available on Runway?\",\"answer\":\"Runway gives you access to the world's leading image, video and audio models, all in one place. This includes our own models like Gen-4.5 and Aleph, plus third-party models like Kling 3.0, Veo 3.1, WAN2.2 and more. See the full list of available models.\"}],\"faqModelsLinkText\":\"full list of available models\",\"endCtaTitle\":\"Seedance 2.5 is on Runway\"},\"wildestIdeas\":{\"pageTitle\":\"You've Never Seen Anything Like This | Runway\",\"pageDescription\":\"Generate your wildest ideas as cinematic videos, all on Runway. Watch the film, grab the references and the exact prompt behind one shot, then generate your own.\",\"heroTitle\":\"You've never seen anything like this.\",\"heroDescription\":\"Generate your wildest ideas as cinematic videos. All on Runway.\",\"heroCtaLabel\":\"Start generating\",\"recipeTitle\":\"One generation, fully exposed\",\"recipeDescription\":\"Everything in the film starts from the same pieces: two character sheets, one location and a written prompt. Here is a real generation, input to output.\",\"downloadLabel\":\"Download\",\"references\":[{\"name\":\"Manny\",\"caption\":\"Character sheet. He calls the shots.\",\"alt\":\"Character turnaround sheet of Manny in a Dominican Republic jersey\"},{\"name\":\"Malik\",\"caption\":\"Character sheet. He suffers the consequences.\",\"alt\":\"Character turnaround sheet of Malik in a yellow t-shirt and glasses\"},{\"name\":\"The court\",\"caption\":\"Location reference. Every scene starts here.\",\"alt\":\"Basketball court surrounded by brick apartment towers\"}],\"promptLabel\":\"The prompt\",\"promptCopyLabel\":\"Copy prompt\",\"promptCopiedLabel\":\"Copied\",\"promptText\":\"SHOT 1 — Click.\\n\\nStart on a shot of the man (Manny) in the Dominican jersey, who lifts his arm and snaps his fingers on one hand.\\n\\nSHOT 2 — Payoff.\\n\\nCut to a shot of the other man (Malik) in the yellow top and glasses, whose outfit instantly turns into a suit made out of raw steaks. He looks to his left and there's a Bengal tiger approaching him. He begins sprinting away yelling \\\"Not cool, bro!\\\"\",\"outputCaption\":\"The output: one generation from the references and prompt above, sound included.\",\"outputThreadLinkLabel\":\"See the original post on X\",\"recipeCtaLabel\":\"Run this prompt yourself\",\"stepsTitle\":\"Make your own\",\"steps\":[{\"title\":\"Grab the references\",\"description\":\"Download Manny, Malik and the court above, or bring your own characters. Reference images are what keep a character consistent from shot to shot.\"},{\"title\":\"Write your shots\",\"description\":\"Set up the click, then the payoff. Two shots is all a scene needs, and one generation gives you up to 30 seconds with sound.\"},{\"title\":\"Generate your video\",\"description\":\"Open the video tool on Runway, add the references, paste your prompt and generate. Post the result and tag @runwayml so we see it.\"}],\"stepsMediaCaption\":\"Manny and Malik, waiting to see what you make.\",\"stepsCtaLabel\":\"Generate yours\",\"roundsTitle\":\"More generations from the court\",\"roundsDescription\":\"Same characters, same location, different prompts.\",\"bottomCtaTitle\":\"Show us something we've never seen.\",\"bottomCtaLabel\":\"Generate on Runway\",\"filmThreadLinkLabel\":\"Watch the full film on X\"},\"aleph2\":{\"pageTitle\":\"Aleph 2.0 | Runway\",\"pageDescription\":\"Get the video you need. From the video you already have. Describe any change in plain language, preview each edit before you commit, then generate the final video with everything applied at once.\",\"heroEyebrow\":\"Introducing\",\"heroTitle\":\"Aleph 2.0\",\"heroSubtitle\":\"Get the video you need. From the video you already have.\",\"heroDescription\":\"Go from a single asset to every version you need in minutes. Change only what you want, keep everything else. No reshoots, no retouching or waiting weeks on edits.\",\"heroCta\":\"Try Now\",\"modelEyebrow\":\"The model\",\"modelTitle\":\"A new way to modify video\",\"modelDescription\":\"Aleph 2.0 is an upgrade to Runway's flagship in-context video editing model. Edit one frame and Aleph 2.0 modifies the rest of your video to match — preserving everything you didn't ask to change. Now with support for longer clips and multi-shot sequences.\",\"features\":[{\"title\":\"Edit one frame to update your whole video.\",\"description\":\"Edit a frame the way you want. Aleph 2.0 carries that look through your video, so what you see is what you get.\"},{\"title\":\"Change a specific element, preserve the rest.\",\"description\":\"Describe what you want to change — a product color, a hairstyle, a piece of clothing — and Aleph 2.0 changes only that. The background, lighting and other details stay just as they were.\"},{\"title\":\"Make changes across multiple shots.\",\"description\":\"In videos with multiple cuts or scene changes, Aleph 2.0 can apply your edit across relevant shots.\"},{\"title\":\"Work with up to 30s of video.\",\"description\":\"You can now edit clips up to 30 seconds long at 1080p. Long enough for ads, social posts and short-form content.\"}],\"oneVideoTitle\":\"Turn any asset into every option you need.\",\"changeKeepTitle\":\"Change what you want. Keep what you need.\",\"changeKeepDescription\":\"Most AI video editing models change more than you asked — new cuts get added in, objects are modified, the scene action isn’t the same. Aleph 2.0 only changes what you asked for and keeps everything else just as it was.\",\"originalCaption\":\"Original video\",\"editedCaption\":\"Edited using Aleph 2.0\",\"editStudioEyebrow\":\"Edit Studio\",\"editStudioTitle\":\"See what you'll get before you generate.\",\"editStudioDescription\":\"Preview your edit as an image so you can shape the look before you commit to generating. Try different versions, refine your approach and cut down on the number of iterations needed.\",\"steps\":[{\"title\":\"Type it.\",\"description\":\"Describe the change in plain language.\"},{\"title\":\"See it.\",\"description\":\"Preview your edit as an image before you generate.\"},{\"title\":\"Ship it.\",\"description\":\"Generate once. Your edit applies where it’s relevant.\"}],\"galleryTitle\":\"If you can describe it,\u003cbreak\u003e\u003c/break\u003e you can change it\",\"tiles\":[{\"label\":\"Same video, new product\",\"prompt\":\"“Make the sneakers red”\"},{\"label\":\"New background, no reshoot\",\"prompt\":\"“Add graffiti on the wall behind him”\"},{\"label\":\"Make it disappear\",\"prompt\":\"“Remove the items on the wall behind her”\"},{\"label\":\"Restyle without restarting\",\"prompt\":\"“Make it dark anime style”\"},{\"label\":\"Get the close-up\",\"prompt\":\"“Tighter shot on the product, same moment”\"},{\"label\":\"Seasonal versions of your ad\",\"prompt\":\"“Change the season to winter”\"}],\"endCtaTitle\":\"Get the video you need\u003cbreak\u003e\u003c/break\u003e from the video you already have.\",\"endCtaButton\":\"Try Aleph 2.0 in Edit Studio\"},\"educators\":{\"heroTitle\":\"25% off for every \u003cbreak\u003e\u003c/break\u003estudent \u0026 educator\"},\"marketers\":{\"workflowTitle\":\"Built for every marketing workflow\",\"workflowDescription\":\"Whether you're running brand campaigns, scaling performance ads or feeding social channels daily, Runway gives your entire marketing team everything they need to get brand content into the world.\",\"carouselTitle\":\"How agencies and brands are using Runway\"},\"industryPages\":{\"relatedLinksTitle\":\"Explore more\",\"cardCta\":\"AI for {industry}\",\"defaults\":{\"appsTitle\":\"Apps for everything\",\"appsDescription\":\"Apps are an ever-growing collection of use case specific tools designed to make it easier than ever to get to great outputs.\",\"workflowsTitle\":\"Build the Workflows \u003cbreak\u003e\u003c/break\u003e That Work for You.\",\"workflowsDescription\":\"Create your own custom node-based workflows that chain together multiple models, modalities and intermediary steps for even more control of your generations.\"},\"mediaEntertainment\":{\"title\":\"Media and Entertainment\",\"heroTitle\":\"Power your creative vision from concept to screen\",\"heroSubtitle\":\"AI-powered tools for film, TV, and content production that help you visualize concepts, create impossible shots, and bring stories to life faster than ever.\"},\"marketingAdvertising\":{\"title\":\"Marketing and Advertising\",\"heroTitle\":\"Create more, test faster, and scale your campaigns\",\"heroSubtitle\":\"Generate concept mockups, produce campaign variations, and create compelling content at the speed of your ideas. Scale your creative output without scaling your team.\"},\"productDesign\":{\"title\":\"Product and Design\",\"heroTitle\":\"AI Product Design: Visualize Concepts, Iterate Faster and Go to Market Sooner\",\"heroSubtitle\":\"Runway's AI product design tools let you visualize product concepts, iterate on designs and generate compelling product videos before physical prototyping. Compress weeks of the product development lifecycle and bring your ideas to life in hours instead of months.\",\"pageTitle\":\"Runway for Product Design | AI-Powered Product Visualization and Development\",\"metaDescription\":\"Generate AI product concept visuals, product shots and design iterations without a studio or prototype. Built for product designers, brands and e-commerce teams.\",\"appsTitle\":\"AI Apps for Product Design\",\"appsDescription\":\"Runway's apps are purpose-built tools for specific product design workflows: vary product images, swap video backgrounds and generate video from reference images.\",\"workflowsTitle\":\"Custom AI Workflows for Product Design\",\"workflowsDescription\":\"Build node-based workflows that chain AI models together for repeatable product design processes: from concept generation to final product video, automated and consistent every time.\",\"useCases\":{\"productShots\":{\"heading\":\"AI Product Shot Generator\",\"description\":\"Turn any existing product image into new photos, videos and variations for every channel and touchpoint. Upload your product image, describe what you need and generate campaign-ready product visuals instantly.\"}},\"relatedLinks\":{\"reshootProduct\":{\"title\":\"Reshoot Product: AI Product Photography\",\"description\":\"Generate unlimited product shots and variations from a single image. Change backgrounds, environments, lighting and styling without a studio.\",\"cta\":\"Try Reshoot Product\"},\"ideationConcepting\":{\"title\":\"Ideation \u0026 Concepting\",\"description\":\"AI tools for visualizing product directions and aligning stakeholders before committing to design or production resources.\",\"cta\":\"Explore ideation and concepting\"}}},\"professionalServices\":{\"title\":\"Professional Services and Agencies\",\"heroTitle\":\"AI for Professional Services: Win More Business with Compelling Client Deliverables\",\"heroSubtitle\":\"Create compelling presentations, visualize client proposals, and produce high-quality content that sets you apart. Deliver more value in less time.\",\"pageTitle\":\"AI for Professional Services | Client Proposals and Presentations | Runway\",\"metaDescription\":\"Create AI-generated client presentations, mood boards and proposal visuals that set your firm apart. Runway's tools help professional services teams deliver more value in less time.\",\"appsTitle\":\"AI Apps for Professional Services\",\"appsDescription\":\"Purpose-built tools for client deliverables: vary images for different proposal styles, swap video backgrounds for presentation polish and generate video from reference images for pitch decks and mood boards.\",\"workflowsTitle\":\"Custom AI Workflows for Client Deliverables\",\"workflowsDescription\":\"Build repeatable workflows for proposal generation, mood board creation and presentation visuals so your team can consistently produce high-quality client content at speed.\"},\"gamingInteractive\":{\"title\":\"Gaming and Interactive\",\"heroTitle\":\"Build your next world from concept to cutscene\",\"heroSubtitle\":\"Runway gives game teams creative freedom at every stage - no mocap studio, no outsourced pipeline, just ideas made playable.\"},\"education\":{\"title\":\"Education\",\"heroTitle\":\"Empower students and educators to create with AI\",\"heroSubtitle\":\"Give students hands-on experience with cutting-edge AI tools. Create engaging educational content and bring concepts to life in ways traditional methods cannot.\"},\"architectureDesign\":{\"title\":\"Architecture and Design\",\"heroTitle\":\"Where Great Spaces Begin\",\"heroSubtitle\":\"From concept to client-ready, Runway gives architecture and design teams the tools to animate renders, visualize spaces, and win pitches - in hours, not weeks.\"},\"fashion\":{\"title\":\"Fashion\",\"heroTitle\":\"Dress the world in your vision\",\"heroSubtitle\":\"From moodboards to campaign-ready content, Runway gives fashion teams the tools to visualize collections, create virtual try-ons, and produce editorial content at the speed of the season.\"}},\"solutionsUseCases\":{\"ideationConcepting\":{\"title\":\"AI for Brainstorming and Ideation\",\"description\":\"Use AI for brainstorming and ideation before committing to production. Test concepts, explore directions and align stakeholders faster than any traditional concepting process.\",\"pageTitle\":\"AI for Brainstorming and Ideation | Runway\",\"pageDescription\":\"Use Runway's AI brainstorming and ideation tools to visualize concepts before committing to production. Test cinematic treatments, character directions and visual styles from a text prompt.\",\"intro\":\"Runway's AI brainstorming and ideation tools give creative teams in \u003cproductDesign\u003eproduct design\u003c/productDesign\u003e and \u003cmediaEntertainment\u003emedia and entertainment\u003c/mediaEntertainment\u003e a way to visualize concepts before committing to production. Generate cinematic scenes, character treatments, stylized environments and location options from a text prompt. Test directions, explore aesthetics and align stakeholders with visual proof before a single dollar goes into production, then take the direction you land on into \u003ccontentCreation\u003econtent creation\u003c/contentCreation\u003e.\",\"categories\":{\"cinematic-and-dramatic\":\"Test dramatic treatments and cinematic directions before committing to a production approach. Generate multiple treatments of the same scene to find the right tone before production begins.\",\"non-photorealistic\":\"Concept in any visual style. Test whether a stop motion, illustrated or animated aesthetic works for your project before investing in production.\",\"expressive-characters\":\"Explore how a character should look and feel before casting or costume decisions. Generate and compare treatments to align your team on the right direction.\",\"landscape-flythroughs\":\"Get a feel for different location and environment options before a location scout. Generate aerial footage of any landscape to test how a setting reads before committing to travel or permits.\",\"automotive\":\"Visualize various automotive campaign directions before a production shoot. Test different treatments, angles and environments to align on creative direction.\"}},\"contentCreation\":{\"title\":\"AI for Content Creation\",\"description\":\"Generate production-ready assets from scratch. Create video content for YouTube, TikTok, Instagram and marketing campaigns that would be expensive or impossible to shoot.\",\"pageTitle\":\"AI for Content Creation | Runway\",\"pageDescription\":\"Use Runway's AI tools for content creation to generate production-ready video for YouTube, TikTok, Instagram and marketing campaigns. No camera, no set, no studio.\",\"intro\":\"Runway's AI tools for content creation give creators, \u003cmediaEntertainment\u003emedia and entertainment\u003c/mediaEntertainment\u003e teams and marketing agencies a way to produce professional video without a camera, a set or a studio. Generate photorealistic footage, B-roll, product visuals, green screen content and character video from a text prompt, then publish across YouTube, TikTok, Instagram and any \u003cmarketingAdvertising\u003emarketing channel\u003c/marketingAdvertising\u003e.\",\"categories\":{\"repurpose-footage\":\"Turn existing footage into new content for different platforms, audiences and campaigns. Adapt one piece of content into many without going back to production.\",\"rotating-3d-model-visualizations\":\"Product shots that look like they were photographed in a studio. Useful for e-commerce content, product launches and social media advertising.\",\"expressive-characters\":\"Consistent characters with natural expressions for narrative content, branded series and any format that needs a recognizable face.\",\"landscape-flythroughs\":\"Generate cinematic aerial footage for travel content, title sequences and any video that needs a sense of scale or place. No drone, no location and no permit required.\",\"b-roll\":\"Generate atmospheric B-roll for YouTube videos, social content and branded campaigns. Fill any gap in an edit without scheduling a separate shoot.\",\"green-screen\":\"Studio-quality green screen for any talking-head or presenter format. No studio, no lighting rig and no post-production keying required.\",\"photorealism\":\"Production-quality footage without a production budget. Lifelike characters, environments and lighting for any content format.\"}},\"enhancementEditing\":{\"title\":\"Enhancement \u0026 Editing\",\"description\":\"Transform and elevate your existing content. Add effects, extend footage, and polish your visuals.\",\"pageTitle\":\"Enhancement \u0026 Editing | Use Cases | Runway AI\",\"pageDescription\":\"Transform and elevate your existing content. Add effects, extend footage, and polish your visuals.\"},\"marketingDistribution\":{\"title\":\"AI Marketing Video Generator\",\"description\":\"Scale marketing campaigns and adapt video content for every channel. Generate more variations, repurpose existing footage and produce AI marketing content in a fraction of the time.\",\"pageTitle\":\"AI Marketing Video Generator | Campaign Videos, Product Shots and B-Roll | Runway\",\"pageDescription\":\"Generate AI marketing video at scale: product shots, campaign variations, B-roll and ad creative. Built for marketing teams and agencies producing content across multiple channels.\",\"intro\":\"Marketing teams produce more content across more channels than ever. Runway's AI marketing video generator gives \u003cmarketingAdvertising\u003emarketing teams and agencies\u003c/marketingAdvertising\u003e a way to produce campaign-ready content at scale. Generate video assets, repurpose existing footage for new audiences and create variations for every channel, without a new shoot or a new production budget.\",\"categories\":{\"automotive\":\"Cinematic vehicle footage for automotive marketing campaigns, product launches and performance ads. No shoot location, no permits and no vehicle on set.\",\"rotating-3d-model-visualizations\":\"360-degree product shots with studio lighting for e-commerce listings, performance ads and social campaigns. No product shoot, no studio and no lighting setup.\",\"b-roll\":\"Atmospheric cutaway footage and filler video for ads, social campaigns and branded content. Generated from a text prompt and ready to drop into any edit.\",\"repurpose-footage\":\"Extend the life of existing marketing assets. Restyle, reformat or adapt campaign footage for new channels, seasonal campaigns or different audience segments.\",\"green-screen\":\"Generate clean green screen footage for any presenter or spokesperson format. Useful for performance marketing, explainer ads and branded content that needs a controlled background.\",\"photorealism\":\"Campaign-ready footage with lifelike characters, environments and lighting. For brand films, social ads and any marketing format where production quality drives performance.\"}}},\"hundredFilmFundSubmit\":{\"pageTitle\":\"Hundred Film Fund | Runway Studios\",\"pageDescription\":\"The Hundred Film Fund is an open call to professional filmmakers who have AI-augmented film projects in need of funding. Grants range from $5k to $500k.\",\"heroTitle\":\"Submitting to The \u003cbr /\u003e Hundred Film Fund\",\"heroSubtitle\":\"Before beginning the application process, please be sure to read through all frequently asked questions as well as submission guidelines to ensure eligibility of your project.\",\"faqCta\":\"FAQ\",\"guidelinesCta\":\"Submission Guidelines\",\"submitCta\":\"Submit Application\",\"backToOverview\":\"Back to overview\",\"faqHeading\":\"Frequently Asked Questions\",\"faq\":{\"inspiration\":{\"title\":\"What inspired The Hundred Film Fund?\",\"content\":\"The rapid advancement of AI tools for film production has opened up unprecendented possibilities for creative expression. The Hundred Film Fund is an effort to support and accelerate this wave of creativity, fostering innovation in both film production and distribution models. Ensuring that the future of storytelling is artist-led.\"},\"usage\":{\"title\":\"What can funding grants be used for?\",\"content\":\"The Hundred Film Fund grants must be used in order to expedite or otherwise make possible an AI-powered film project. Beyond that, the grant-recipient has complete discretion over the creative project.\"},\"criteria\":{\"title\":\"What criteria will applications be judged on?\",\"content\":\"Projects that showcase innovative uses of AI in film, have the potential for broad impact and can be completed within a reasonable timeframe. The prominent use of Runway is required.\"},\"timing\":{\"title\":\"When can I apply?\",\"content\":\"Applications for The Hundred Film Fund grants are open on a rolling basis.\"},\"conditions\":{\"title\":\"What conditions apply?\",\"content\":\"You must use the grant to work on AI-powered films (leveraging Runway prominently within the project).\u003cbreak\u003e\u003c/break\u003e\u003cbreak\u003e\u003c/break\u003eFor the duration of production, grant recipients must send updates every two weeks, summarizing progress. These updates can be as simple as a single-paragraph email.\u003cbreak\u003e\u003c/break\u003e\u003cbreak\u003e\u003c/break\u003eRecipients agree to showcase your work through our distribution channels, including our international AI Film Festival and partner networks.\"},\"ipRights\":{\"title\":\"How do IP rights work?\",\"content\":\"Grant recipients retain full IP rights to their creations, with the condition that they allow Runway full rights to showcase the work for promotional purposes in perpetuity.\"},\"administrators\":{\"title\":\"Who administers The Hundred Film Fund grants?\",\"content\":\"Funding grants are administered by Runway and \u003cstudiosLink\u003eRunway Studios\u003c/studiosLink\u003e.\"},\"otherInitiatives\":{\"title\":\"What other initiatives are part of this program?\",\"content\":\"Alongside grants, we will also offer up to five Director Residency positions for top talent in the space looking to better understand and adopt Runway's tools to tell stories.\"},\"recipientIdentities\":{\"title\":\"Will the identities of grant recipients be made public?\",\"content\":\"While we are excited to amplify the work of the artists we collaborate with, this shall be at the recipient's discretion. We will provide broader updates on projects and initiatives related to the fund as they are available.\"}},\"guidelinesHeading\":\"Submission Guidelines\",\"guidelines\":{\"noPurchase\":\"No purchase or payment of any kind is necessary to enter or participate.\",\"scope\":\"Scope of Projects: This grant is open to supporting original nonfiction and fiction projects: documentaries, animations, scripted fiction, innovative experimentations in film, both short and long form. Projects may blend real-life footage with generative media, leverage traditional techniques or be entirely generated.\",\"stage\":\"Project Stage: Projects can be in the late development stage or early production phase. Completed projects will NOT be accepted.\",\"originality\":\"Originality \u0026 Ownership: Projects must be original and must not be encumbered by third-party rights. The authorship should be wholly recognized by the applicant.\",\"technical\":\"Technical Requirements: Projects submitted must, to some degree, employ generative media technology developed by Runway. Films may be in any language but they must provide an English-subtitled version of the finished film.\",\"duration\":\"Duration: All lengths of projects will be considered.\",\"productionTime\":\"Production Time: The production timeline cannot exceed 12 months from the moment the grant is received.\",\"eligibility\":\"Eligibility: This call is open to filmmakers and creative professionals from all backgrounds. Participants must be at least 18 years old at the time of entry, or the local age of majority in their jurisdiction if it's higher than 18. We warmly welcome creators worldwide, where participation is allowed by US and local law.\",\"brandedContent\":\"We do not provide funding for branded content.\",\"submissionLimit\":\"Submission Limit: Projects can only be submitted once to this call. If rejected, they can only be resubmitted if approved by the committee. An applicant who has been selected once within the annual rolling basis cannot apply again with another project.\",\"language\":\"Language of Application: Application forms must be submitted in English.\",\"process\":\"Application Process: Applications should be made exclusively via the provided form.\"},\"submitHeading\":\"Submit Application\",\"submitBody\":\"We recommend fully reading all frequently asked questions and submission guidelines prior to submitting your application to avoid any errors or omissions. Be aware that this application form does not save as you go and must be completed in a single session. We recommend you first fill out your application by \u003ctemplateLink\u003ecopying this information\u003c/templateLink\u003e to your own doc to prepare your information in a place where you can save along the way.\"},\"paidAds\":{\"heroPromptDisclaimer\":\"No credit card required. 500 free credits to start.\"},\"safetyVerify\":{\"pageTitle\":\"Verify Content Credentials | Runway\",\"pageDescription\":\"Inspect Content Credentials (C2PA manifests) in images, videos, and audio. Verification runs in your browser, so files never leave your device.\",\"breadcrumbSafety\":\"Safety\",\"breadcrumbCurrent\":\"Verify Content Credentials\",\"lockupProduct\":\"C2PA Verifier\",\"heading\":\"Verify your content credentials\",\"subheading\":\"Inspect C2PA manifests embedded in images, videos, and audio.\",\"dropzonePrompt\":\"Drop an image, video, or audio file here, or click to browse\",\"dropzoneLimit\":\"Up to 512MB.\",\"selectFile\":\"Select file\",\"consent\":\"By clicking \\\"Select file\\\", you agree to our \u003cterms\u003eTerms of Use\u003c/terms\u003e and acknowledge our \u003cprivacy\u003ePrivacy Policy\u003c/privacy\u003e. Files are not retained and are not used as training data.\",\"readingTitle\":\"Reading manifest\",\"errorTitle\":\"That file couldn’t be read\",\"errorGeneric\":\"Something went wrong reading {source}.\",\"errorTooLarge\":\"{source} is larger than the 512MB limit.\",\"errorUnsupportedType\":\"{source} is not a supported format. Try JPEG, PNG, MP4, MOV, WAV or MP3.\",\"noCredentialsTitle\":\"No Content Credentials found\",\"noCredentialsBody\":\"{source} has no embedded C2PA manifest.\",\"trustedTitle\":\"Content Credentials verified\",\"trustedMeta\":\"Signer on the C2PA trust list\",\"validTitle\":\"Content Credentials found\",\"validMeta\":\"Signer is not on the C2PA trust list\",\"runwayMeta\":\"This C2PA manifest originated from Runway\",\"validTrustUnavailableMeta\":\"Trust lists unavailable, signer not checked\",\"failedTitle\":\"Content Credentials could not be validated\",\"failedMeta\":\"Validation state: {state}\",\"failuresTitle\":\"Validation failures\",\"rawManifestJson\":\"Raw manifest store JSON\",\"fieldGeneratedBy\":\"Generated by\",\"fieldSignedBy\":\"Signed by\",\"fieldSignedAt\":\"Signed at\",\"fieldAssertions\":\"Assertions\",\"fieldIngredients\":\"Ingredients\",\"unknownGenerator\":\"Unknown\",\"untitledIngredient\":\"Untitled\"},\"mcp\":{\"pageTitle\":\"Runway MCP | Generate video in ChatGPT, Claude and Cursor\",\"pageDescription\":\"Generate high-quality images and videos right from where you're already working. Add Runway to ChatGPT, Claude, Cursor and other MCP-compatible agents. No API key required.\",\"previewImageAlt\":\"Runway MCP generated video preview\",\"articleHeadline\":\"Runway MCP: generate videos in any agent\",\"softwareName\":\"Runway MCP server\",\"breadcrumbMcp\":\"Runway MCP\",\"breadcrumbChatgpt\":\"ChatGPT\",\"breadcrumbGrokBot\":\"Grok Bot\",\"breadcrumbGptAstra\":\"GPT-6 Astra\",\"hero\":{\"eyebrow\":\"Now in the ChatGPT app directory\",\"title\":\"Runway MCP\",\"description\":\"Generate high-quality images and videos right from where you're already working. Use Runway in ChatGPT, Claude, Grok Bot, Cursor and other compatible agents.\",\"ctaChatgpt\":\"Add Runway to ChatGPT\",\"ctaOtherAgents\":\"Other agents\"},\"connect\":{\"tablistLabel\":\"Agents\",\"title\":\"Connect Runway in seconds\",\"description\":\"Setting up Runway MCP is simple and takes just a few moments.\",\"setupGuide\":\"View setup guide\",\"copy\":\"Copy\",\"copied\":\"Copied\",\"copyUrlLabel\":\"Copy Runway MCP URL\",\"tabs\":{\"chatgpt\":\"ChatGPT\",\"claude\":\"Claude\",\"grok-bot\":\"Grok Bot\",\"muse\":\"Muse\",\"cursor\":\"Cursor\",\"replit\":\"Replit\"},\"chatgpt\":{\"cta\":\"Add Runway to ChatGPT\",\"step1Title\":\"Open Plugins in ChatGPT\",\"step1Body\":\"Go to \u003cplugins\u003echatgpt.com/plugins\u003c/plugins\u003e and search for Runway.\",\"step2Title\":\"Install and sign in\",\"step2Body\":\"Click \u003cstrong\u003eInstall Plugin\u003c/strong\u003e, then \u003cstrong\u003eSign in with Runway\u003c/strong\u003e.\",\"step3Title\":\"Start creating\",\"step3Body\":\"Mention \u003cstrong\u003e{mention}\u003c/strong\u003e in any chat and describe what you want.\"},\"claude\":{\"step1Title\":\"Go to Claude → Customize\",\"step1Body\":\"In Claude desktop or claude.ai, go to \u003cstrong\u003eCustomize → Connectors\u003c/strong\u003e.\",\"step2Title\":\"Add custom connector\",\"step2Body\":\"Name it \u003cstrong\u003eRunway\u003c/strong\u003e and paste the link: \u003curl\u003e\u003c/url\u003e\",\"step3Title\":\"Connect and sign in\",\"step3Body\":\"Click \u003cstrong\u003eAdd → Connect\u003c/strong\u003e, sign in with your Runway account. Then ask Claude to make an ad video.\"},\"muse\":{\"status\":\"Coming soon\",\"title\":\"Runway is coming to Muse.\",\"description\":\"Tell Muse what you want to make. It'll work with Runway to make the video.\"},\"grok-bot\":{\"cta\":\"Add Runway to Grok Bot\",\"step1Title\":\"Install Grok Bot\",\"step1Body\":\"Download and install \u003cgrokDownload\u003eGrok Bot\u003c/grokDownload\u003e from x.ai if you don't have it yet.\",\"step2Title\":\"Add the Runway plugin\",\"step2Body\":\"Open \u003cgrokAdd\u003eRunway for Grok Bot\u003c/grokAdd\u003e and click \u003cstrong\u003eAdd to Grok Bot\u003c/strong\u003e, or search for Runway in Grok Bot's plugin marketplace.\",\"step3Title\":\"Sign in and start creating\",\"step3Body\":\"Click \u003cstrong\u003eAuthenticate\u003c/strong\u003e and sign in with your Runway account. Then ask Grok Bot for an image or video.\"},\"cursor\":{\"cta\":\"Add Runway to Cursor\",\"step1Title\":\"Open the Cursor Marketplace\",\"step1Body\":\"Open \u003ccursorMarketplace\u003eRunway on the Cursor Marketplace\u003c/cursorMarketplace\u003e, or in Cursor go to \u003cstrong\u003eCustomize\u003c/strong\u003e and search for Runway.\",\"step2Title\":\"Add the plugin\",\"step2Body\":\"Click \u003cstrong\u003eAdd to Cursor\u003c/strong\u003e, then \u003cstrong\u003eAdd Plugin\u003c/strong\u003e. Or type \u003ccode\u003e{command}\u003c/code\u003e in any Cursor chat.\",\"step3Title\":\"Connect once\",\"step3Body\":\"Click \u003cstrong\u003eConnect\u003c/strong\u003e next to the Runway MCP server and sign in with your Runway account. Then type \u003ccode\u003e/runway\u003c/code\u003e or just ask for a video.\"},\"replit\":{\"step1Title\":\"Open Replit tools\",\"step1Body\":\"On replit.com, go to \u003cstrong\u003eIntegrations\u003c/strong\u003e and click on \u003cstrong\u003e+ Add MCP server\u003c/strong\u003e.\",\"step2Title\":\"Add Runway\",\"step2Body\":\"Name it \u003cstrong\u003eRunway\u003c/strong\u003e and paste the link: \u003curl\u003e\u003c/url\u003e\",\"step3Title\":\"Authorize once\",\"step3Body\":\"Click on \u003cstrong\u003eTrust and save\u003c/strong\u003e, then click on \u003cstrong\u003eAuthorize server\u003c/strong\u003e to sign in with your Runway account.\"}},\"cases\":{\"title\":\"Just tell your agent what you need. Runway handles the rest.\",\"filterLabel\":\"Filter examples by type\",\"tryInChatgpt\":\"Try in ChatGPT\",\"copy\":\"Copy prompt\",\"copyPrompt\":\"Copy prompt for {label}\",\"copied\":\"Copied\",\"showFullPrompt\":\"Show full prompt\",\"showLess\":\"Show less\",\"referenceAlt\":\"{label} product reference\",\"categories\":{\"all\":\"All\",\"productAds\":\"Product ads\",\"story\":\"Animated stories\",\"ugc\":\"UGC\",\"fromLink\":\"From a link\"},\"items\":[{\"label\":\"Product shot to finished commercial\",\"prompt\":\"Make one complete stovetop coffee commercial for this moka pot: onto the blue flame, water in, grounds in, the cat watching it brew, the coffee climbing into the glass dome, then the pour and the cup in morning light. One kitchen, every shot in the same light.\"},{\"label\":\"Five-shot brand film from one cup\",\"prompt\":\"$46\"},{\"label\":\"Animated story with consistent characters\",\"prompt\":\"Turn this tomato soldier into a 20-second animated war-movie parody: he storms the beach with his veggie squad to get the ketchup to the fries. Keep the characters consistent in every shot, no text on screen.\"},{\"label\":\"UGC-style product video\",\"prompt\":\"Make a 15-second TikTok Shop style UGC ad for this chair: a guy films himself in his apartment, flops into it, hard cuts, handheld, real reactions.\"},{\"label\":\"Product page to tech commercial\",\"prompt\":\"Here's the product page for these headphones: https://shop.example.com/wireless-headphones. Make a 30-second photoreal tech commercial built on sound: a loud commute, a busy street, then a forest that falls silent the moment he puts them on.\"},{\"label\":\"Product sheet to brand spot\",\"prompt\":\"Make a 30-second cereal ad from these three boxes: photoreal, a kid's imagination turns the cereal rings into giant hoops rolling across a beach at sunset, then back to the breakfast table.\"},{\"label\":\"Animated comedy scene\",\"prompt\":\"In the style of Pixar comedy animation, an undercover escape scene: the chicken looks both ways, then quickly runs over to a sleeping dog, looks around, then hits him with its beak.\"},{\"label\":\"UGC unboxing video\",\"prompt\":\"Make a 15-second YouTube-style unboxing for this blind box: cold-open hook, she shows the box to camera, tears open the pouch and reveals the glow-in-the-dark figure. Handheld, natural light, real reactions.\"},{\"label\":\"Product page to luxury sequence\",\"prompt\":\"Take the watch from this product page, https://shop.example.com/chronograph-watch, and make a five-shot magical realism sequence: shattering glass frozen mid-air, a single beam of light, the watch untouched at the center of it all.\"},{\"label\":\"Comedy product ad\",\"prompt\":\"Make a deadpan comedy ad for this supplement bottle: a guy wakes up hungover as a hairy one-eyed monster, his roommate doesn't flinch, and Primer fixes it. 16:9, photoreal.\"},{\"label\":\"Animated dialogue scene\",\"prompt\":\"Cinematic scene from a comedy: low angle, ground POV looking straight up, two tough-guy pigeons leaned over with their heads in frame, looking directly into the camera, curious. One is chubby with large eyes and a bit dim, the other thin. Mature Pixar animation style, sky above them.\"},{\"label\":\"UGC demo video\",\"prompt\":\"Make a 15-second UGC clip for this hose-end lawn sprayer: a real person filming himself in his own front yard at golden hour, hooking it up to the hose, spraying the lawn and talking to camera. Handheld, unpolished.\"},{\"label\":\"Product page to cinematic spot\",\"prompt\":\"Make a 15-second ultra-premium cinematic commercial from this product page, https://shop.example.com/running-shoe: macro details of the shoe, a slow orbit, dramatic red and black lighting, ending on the full silhouette.\"},{\"label\":\"Character sheet to animated short\",\"prompt\":\"Use this character and prop sheet to make a 25-second stop-motion style war movie: the corn platoon pinned down on the beach, then the popcorn finale. Keep every soldier consistent across shots, no text on screen.\"},{\"label\":\"Product page to comedy spot\",\"prompt\":\"Here's the product page for this hazelnut caramel bar: https://shop.example.com/hazelnut-caramel-bar. Make a 30-second 16:9 photoreal deadpan comedy commercial, played completely straight: a teenager against a school vending machine that won't give up the last bar.\"},{\"label\":\"Creative product ad\",\"prompt\":\"Can you make a claymation style product ad featuring two crabs fighting over a can of Fizz. One crab says \\\"don't be so shellfish.\\\"\"},{\"label\":\"Image to product ad\",\"prompt\":\"Use Runway to make a product ad for this necklace, featuring a chameleon in a jewelry store with this necklace image.\"},{\"label\":\"Product image to dialogue ad\",\"prompt\":\"Make a product ad for this bread. The dialogue is \\\"Fill your table for less with 365 brand.\\\"\"},{\"label\":\"Product URL to marketing video\",\"prompt\":\"Use this product URL to create a polished marketing video for launch: https://mygameconsole.com\"}]},\"models\":{\"title\":\"Access to the latest state-of-the-art models\"},\"studio\":{\"title\":\"A complete generation studio, inside your agent.\",\"assistantName\":\"Runway\",\"features\":[{\"eyebrow\":\"Product ads\",\"title\":\"Turn one product shot into a finished commercial\",\"body\":\"Drop in a photo, describe the spot and Runway shoots every scene in the same kitchen and the same light. One prompt, one finished commercial.\",\"prompt\":\"Make one complete stovetop coffee commercial for this moka pot: onto the blue flame, water in, grounds in, the cat watching it brew, the coffee climbing into the glass dome, then the pour and the cup in morning light. One kitchen, every shot in the same light.\",\"generatedLabel\":\"generated commercial\",\"referenceAlt\":\"Moka pot product photo\"},{\"eyebrow\":\"Image and video\",\"title\":\"Generate images and videos\",\"body\":\"Explore ideas, restyle product shots and turn early concepts into images or videos without leaving the conversation.\",\"prompt\":\"Generate 2 product images for this chocolate.\",\"generatedLabel\":\"generated images\",\"referenceAlt\":\"Chocolate bar product photo\",\"outputAlt\":\"Generated product image of the chocolate bar\"},{\"eyebrow\":\"Product marketing\",\"title\":\"Create marketing content from a link\",\"body\":\"Send your agent a link to your product and ask Runway to create a polished marketing video.\",\"prompt\":\"Use this product URL to create a polished marketing video for launch: https://mygameconsole.com\",\"generatedLabel\":\"generated video\"},{\"eyebrow\":\"Multi-shot storytelling\",\"title\":\"Make dialogue-driven ads\",\"body\":\"Write the line, set the scene and let Runway build a character-led product ad.\",\"prompt\":\"Make a playful dialogue-driven product spot with two crabs and a can of Fizz. One crab says \\\"don't be so shellfish.\\\"\",\"generatedLabel\":\"generated ad\",\"referenceAlt\":\"Fizz can product photo\"},{\"eyebrow\":\"Product sites\",\"title\":\"Add stunning product imagery to your site\",\"body\":\"Give your agent an image of your product and ask Runway to create the images and videos you need for your marketing site.\",\"prompt\":\"Can you use Runway to generate a hero video for these jewelry products, and make a shopping website?\",\"generatedLabel\":\"generated video\"}]},\"faq\":{\"title\":\"Frequently asked questions\",\"items\":{\"agents\":{\"question\":\"What agents can connect to Runway MCP?\",\"answer\":\"You can use Runway MCP in \u003cchatgpt\u003eChatGPT\u003c/chatgpt\u003e, \u003cclaudeAi\u003eClaude.ai\u003c/claudeAi\u003e, \u003cclaudeDesktop\u003eClaude Desktop\u003c/claudeDesktop\u003e, \u003cgrokBot\u003eGrok Bot\u003c/grokBot\u003e, \u003ccursor\u003eCursor\u003c/cursor\u003e, \u003creplit\u003eReplit\u003c/replit\u003e and other apps that support MCP (Model Context Protocol).\"},\"chatgptSetup\":{\"question\":\"How do I add Runway to ChatGPT?\",\"answer\":\"Open \u003cchatgptDirectory\u003eRunway in the ChatGPT plugin directory\u003c/chatgptDirectory\u003e and click Add, then sign in with your Runway account when ChatGPT asks you to connect. You can also find Runway inside ChatGPT under \u003cchatgpt\u003ePlugins\u003c/chatgpt\u003e. Once connected, mention {mention} in any chat to use it.\"},\"chatgptVideo\":{\"question\":\"Can ChatGPT generate video?\",\"answer\":\"Not on its own. ChatGPT writes text and generates still images, and OpenAI discontinued Sora in 2026, so there's no built-in way to make video in a chat. Add Runway to ChatGPT and you can: mention {mention}, describe the shot and the finished clip comes back in the same conversation, using models like Gen-4.5, Seedance 2.5, Kling 3.0 and Veo 3.1.\"},\"astraVideo\":{\"question\":\"Can GPT-6 Astra generate video?\",\"answer\":\"No. Astra is OpenAI's flagship for reasoning, computer use and professional work, and no ChatGPT model renders video: ChatGPT writes text and generates still images, and OpenAI discontinued Sora in 2026. With the free Runway plugin installed, Astra runs the brief and Runway generates the video, which lands in the same conversation. Models include Seedance 2.5, Kling 3.0, Veo 3.1 and Gen-4.5.\"},\"astraPlugin\":{\"question\":\"Does the Runway plugin work with GPT-6 Astra?\",\"answer\":\"Yes. Install the Runway plugin from the \u003cchatgptDirectory\u003eChatGPT plugins directory\u003c/chatgptDirectory\u003e, choose GPT-6 Astra as your model and mention {mention} in the chat. Astra takes the brief, reads your product link or reference and manages the back and forth. Runway generates the images and video with our models.\"},\"astraPlans\":{\"question\":\"Which ChatGPT plans include GPT-6 Astra?\",\"answer\":\"OpenAI is rolling GPT-6 Astra out to ChatGPT Plus, Pro, Business and Enterprise. The Runway plugin is free to install on any of them. Generations use your Runway credits, so you also need a \u003crunwayApp\u003eRunway account\u003c/runwayApp\u003e.\"},\"chatgptAccount\":{\"question\":\"Do I need a Runway account to use Runway in ChatGPT?\",\"answer\":\"Yes. Generations run on your Runway credits, so ChatGPT asks you to sign in with a Runway account when you connect the app. If you don't have one yet, you can create a free account in the \u003crunwayApp\u003eRunway app\u003c/runwayApp\u003e and connect it right after.\"},\"grokBotSetup\":{\"question\":\"How do I add Runway to Grok Bot?\",\"answer\":\"Install \u003cgrokBotDownload\u003eGrok Bot\u003c/grokBotDownload\u003e, then open \u003cgrokBot\u003eRunway for Grok Bot\u003c/grokBot\u003e and click Add to Grok Bot. You can also search for Runway in Grok Bot's plugin marketplace. Click Authenticate and sign in with your Runway account, then ask Grok Bot for an image or video.\"},\"grokBotAccount\":{\"question\":\"Do I need a Runway account to use Runway in Grok Bot?\",\"answer\":\"Yes. Generations run on your Runway credits, so Grok Bot asks you to sign in with a Runway account when you add the plugin. If you don't have one yet, you can create a free account in the \u003crunwayApp\u003eRunway app\u003c/runwayApp\u003e and connect it right after.\"},\"models\":{\"question\":\"Which models can agents use?\",\"answer\":\"Your agent can use models like Seedance 2.5, Kling, Gen-4.5, Veo, GPT Image 2, Nano Banana Pro and more based on your Runway account plan. It can pick a model for you, or you can ask for a specific one.\"},\"billing\":{\"question\":\"How are MCP generations billed?\",\"answer\":\"MCP uses your Runway credits, just like the \u003crunwayApp\u003eRunway app\u003c/runwayApp\u003e. The cost depends on the model, resolution and other settings. You can manage everything from your \u003crunwayAccount\u003eRunway account\u003c/runwayAccount\u003e.\"},\"apiKey\":{\"question\":\"Is an API key required?\",\"answer\":\"No. In ChatGPT, Grok Bot and Cursor, add the Runway plugin and sign in. In other agents, add the Runway MCP URL to your agent settings, then sign in with your \u003crunwayApp\u003eRunway app\u003c/runwayApp\u003e account.\"},\"teams\":{\"question\":\"Can teams use this for production work?\",\"answer\":\"Yes. Runway MCP uses the same systems as the Runway app. Your generations are saved in your Runway library with the rest of your work.\"}}},\"bottomCta\":{\"title\":\"Get high-quality images and videos right from where you're already working.\",\"ctaChatgpt\":\"Add Runway to ChatGPT\",\"ctaConnect\":\"Connect\"},\"chatgpt\":{\"pageTitle\":\"Runway for ChatGPT | Generate images and videos in ChatGPT\",\"pageDescription\":\"Add Runway to ChatGPT and generate images and videos with Seedance 2.5, Kling, Veo, GPT Image 2 and more without leaving the chat. No API key required, just sign in with your Runway account.\",\"hero\":{\"eyebrow\":\"Runway for ChatGPT\",\"title\":\"Generate images and videos inside ChatGPT\",\"description\":\"Add the Runway plugin to ChatGPT and ask for a product video, a restyled photo or a full ad in plain language. Runway makes it with the latest models and drops the result in the chat. No API key required.\",\"ctaAdd\":\"Add Runway to ChatGPT\",\"ctaHowItWorks\":\"See how it works\"},\"steps\":{\"title\":\"Set up in under a minute\",\"description\":\"Three clicks in ChatGPT, then you're generating.\",\"cta\":\"Add Runway to ChatGPT\",\"caption\":\"Finding Runway under Plugins in ChatGPT, signing in and running a first prompt.\",\"step1Title\":\"Open Plugins in ChatGPT\",\"step1Description\":\"Go to \u003cplugins\u003echatgpt.com/plugins\u003c/plugins\u003e and search for Runway.\",\"step2Title\":\"Install and sign in\",\"step2Description\":\"Click \u003cstrong\u003eInstall Plugin\u003c/strong\u003e, then \u003cstrong\u003eSign in with Runway\u003c/strong\u003e. Generations use your Runway credits.\",\"step3Title\":\"Mention {mention} in any chat\",\"step3Description\":\"Describe the image or video you want and attach a reference if you have one.\"},\"otherAgentsDescription\":\"Runway MCP also works in Claude, Grok Bot, Cursor, Replit and any other MCP-compatible agent.\",\"otherAgentsCta\":\"See all agents\"},\"grokBot\":{\"pageTitle\":\"Runway for Grok Bot | Generate images and videos in Grok Bot\",\"pageDescription\":\"Add the Runway plugin to Grok Bot and generate images and videos with Gen-4.5, Seedance 2.5, Kling, Veo, GPT Image 2 and more without leaving the chat. No API key required, just sign in with your Runway account.\",\"hero\":{\"eyebrow\":\"Runway for Grok Bot\",\"title\":\"Generate images and videos inside Grok Bot\",\"description\":\"Add the Runway plugin to Grok Bot and ask for a product video, a restyled photo or a full ad in plain language. Runway makes it with the latest models and drops the result in the chat. No API key required.\",\"ctaAdd\":\"Add Runway to Grok Bot\",\"ctaHowItWorks\":\"See how it works\"},\"steps\":{\"title\":\"Set up in under a minute\",\"description\":\"Install Grok Bot, add the plugin, sign in. Then you're generating.\",\"cta\":\"Add Runway to Grok Bot\",\"ctaDownload\":\"Download Grok Bot\",\"caption\":\"Finding Runway in Grok Bot's Marketplace, signing in and confirming the connection.\",\"step1Title\":\"Install Grok Bot\",\"step1Description\":\"Download \u003cgrokDownload\u003eGrok Bot from x.ai\u003c/grokDownload\u003e if you don't have it yet, then sign in.\",\"step2Title\":\"Add the Runway plugin\",\"step2Description\":\"Open \u003cgrokAdd\u003eRunway in Grok Bot's marketplace\u003c/grokAdd\u003e and click \u003cstrong\u003eAdd\u003c/strong\u003e, or search for Runway under \u003cstrong\u003eMarketplace\u003c/strong\u003e in the app.\",\"step3Title\":\"Sign in and start creating\",\"step3Description\":\"Click \u003cstrong\u003eAuthenticate\u003c/strong\u003e and sign in with your Runway account. Generations use your Runway credits. Then describe the image or video you want.\"},\"otherAgentsDescription\":\"Runway MCP also works in ChatGPT, Claude, Cursor, Replit and any other MCP-compatible agent.\",\"otherAgentsCta\":\"See all agents\"},\"gptAstra\":{\"pageTitle\":\"Runway for GPT-6 Astra | Generate videos and ads in ChatGPT\",\"pageDescription\":\"Discover what you can create with Runway and GPT-6 Astra. Install the Runway plugin in ChatGPT and turn a product shot, a link or a character sheet into finished video ads, animated stories and UGC clips with Seedance 2.5, Kling, Veo and more.\",\"hero\":{\"eyebrow\":\"Runway plugin for ChatGPT\",\"title\":\"Discover what you can create with Runway and GPT-6 Astra.\",\"description\":\"Ask GPT-6 Astra for a product ad, an animated story or a UGC clip. With the Runway plugin installed it briefs our models for you, and the finished video lands in the chat.\",\"ctaInstall\":\"Install Runway plugin\",\"ctaExamples\":\"Browse the presets\"},\"studioTitle\":\"GPT-6 Astra runs the brief. Runway makes the video.\",\"casesTitle\":\"Presets for GPT-6 Astra. Pick one, then Try in ChatGPT.\",\"steps\":{\"title\":\"Runway in GPT-6 Astra, in under a minute\",\"description\":\"Install once. Every ChatGPT conversation can call Runway after that.\",\"cta\":\"Install Runway plugin\",\"caption\":\"Finding Runway under Plugins in ChatGPT, signing in and running a first prompt.\",\"step1Title\":\"Open Plugins in ChatGPT\",\"step1Description\":\"Go to \u003cplugins\u003echatgpt.com/plugins\u003c/plugins\u003e and search for Runway.\",\"step2Title\":\"Install and sign in\",\"step2Description\":\"Click \u003cstrong\u003eInstall Plugin\u003c/strong\u003e, then \u003cstrong\u003eSign in with Runway\u003c/strong\u003e. Generations use your Runway credits.\",\"step3Title\":\"Pick GPT-6 Astra and mention {mention}\",\"step3Description\":\"Choose GPT-6 Astra in the model picker, describe the video you want and attach a product shot or paste a link. Astra handles the back and forth; Runway generates.\"},\"faqTitle\":\"GPT-6 Astra and Runway, answered\",\"bottomCta\":{\"title\":\"Give GPT-6 Astra a video model.\",\"description\":\"Install the Runway plugin once and every ChatGPT conversation can generate with Seedance 2.5, Kling, Veo, GPT Image 2 and more.\",\"ctaInstall\":\"Install Runway plugin\",\"ctaChatgpt\":\"Runway for ChatGPT\"}}},\"cab\":{\"pageTitle\":\"Runway Customer Advisory Board\",\"pageDescription\":\"By invitation. Runway's Customer Advisory Board brings together executives from forward-thinking enterprises to co-design the future of generative media. New York City, December 7–8, 2026.\",\"masthead\":{\"logoAlt\":\"Runway\",\"eyebrow\":\"By invitation\",\"title\":\"You’re invited.\",\"subtitle\":\"Runway Customer Advisory Board\",\"dateLine\":\"New York City · December 7–8, 2026\"},\"letter\":[\"Every company is reimagining their workflows with AI: from what to build, to how to build, to shifts in company organization and operations.\",\"The companies furthest along this journey have so much to learn from each other. Runway's Customer Advisory Board brings together executives from forward-thinking enterprises to co-design the future of generative media.\",\"Once a year, we assemble a group of innovative leaders in New York to meet with Runway's founders and research team. You'll get a sneak peek into Runway's product and research efforts, learn about themes we've observed across hundreds of enterprise deployments, and touch on industry trends — from falling production costs to sovereign AI and model ownership.\"],\"agenda\":{\"title\":\"The two days\",\"description\":\"A tentative agenda — an evening to arrive, and a working day together.\",\"days\":[{\"title\":\"Monday, December 7\",\"caption\":\"Arrivals and dinner\",\"slots\":[{\"time\":\"3:00 pm\",\"title\":\"Arrivals and hotel check-in\"},{\"time\":\"6:00 pm\",\"title\":\"Welcome reception and private dinner in SoHo\"}]},{\"title\":\"Tuesday, December 8\",\"caption\":\"The working day\",\"slots\":[{\"time\":\"8:30 am\",\"title\":\"Welcome and introductions\"},{\"time\":\"8:45 am\",\"title\":\"Where generative media is going\"},{\"time\":\"9:30 am\",\"title\":\"Fireside with Runway founders\"},{\"time\":\"10:20 am\",\"title\":\"Client feedback: what we get right, what we get wrong\"},{\"time\":\"11:35 am\",\"title\":\"Product vision and the road ahead\"},{\"time\":\"12:15 pm\",\"title\":\"Lunch\"},{\"time\":\"1:30 pm\",\"title\":\"Hands-on session with Runway technical artists\"},{\"time\":\"2:45 pm\",\"title\":\"Showcase presentations\"},{\"time\":\"3:25 pm\",\"title\":\"Evolving how we open up client value\"},{\"time\":\"4:00 pm\",\"title\":\"Priorities, commitments, close\"},{\"time\":\"4:30 pm\",\"title\":\"Adjourn\"}]}]},\"why\":{\"title\":\"What the days give you\",\"items\":[\"A confidential setting with industry peers facing similar challenges\",\"Direct time with Runway's founders and research team\",\"Product and research direction, ahead of public launches\",\"Exclusive access to industry and client adoption data\",\"Insight into emerging industry trends\"]},\"dinner\":{\"imageAlt\":\"Chef Leah Cohen\",\"label\":\"Monday evening · SoHo\",\"title\":\"A private dinner with Chef Leah Cohen\",\"bio\":[\"Chef Leah Cohen has trained in Michelin-starred kitchens, competed on Bravo’s “Top Chef,” and spent a year cooking her way through Hong Kong, Thailand, Cambodia, and the Philippines.\",\"That journey became Pig \u0026 Khao — the Southeast Asian restaurant she opened in New York in 2012 and built into a city staple. Her cooking is unmistakably her own: the Filipino heritage she was raised in, authentic Southeast Asian flavors, and classical Western technique underneath it all.\",\"Since then she’s become a familiar face across Food Network — “Beat Bobby Flay,” “Guy’s Grocery Games,” and “Tournament of Champions” — a judge on “The Great American Recipe,” and the author of the cookbook Lemongrass \u0026 Lime.\"]},\"rsvp\":{\"title\":\"Will you join us?\",\"description\":\"Flights and hotels are on us. We look forward to hosting you in New York.\",\"ctaYes\":\"Yes, I’ll be there\",\"ctaTentative\":\"Tentative\",\"ctaRegrets\":\"I can’t make it\",\"finePrint\":\"Please note: your invitation is personal and not transferable to others within your company.\"},\"footerLine\":\"© 2026 Runway AI, Inc. · Customer Advisory Board · New York City\",\"backLink\":\"← Back to your invitation\",\"form\":{\"title\":\"Wonderful.\",\"description\":\"A few details and we’ll take care of the rest — it takes about a minute.\",\"firstNameLabel\":\"First name\",\"lastNameLabel\":\"Last name\",\"emailLabel\":\"Email\",\"emailPlaceholder\":\"you@company.com\",\"titleLabel\":\"Title\",\"companyLabel\":\"Company\",\"submit\":\"Confirm my attendance\",\"dinnerCheckboxLabel\":\"I can join for dinner on Monday, December 7\",\"dietaryRestrictionsLabel\":\"Dietary restrictions (optional)\",\"followUp\":\"We’ll follow up with travel and dinner details after you confirm.\",\"errorFirstName\":\"Please add your first name.\",\"errorLastName\":\"Please add your last name.\",\"errorEmail\":\"Please add your work email.\",\"errorTitle\":\"Please add your title.\",\"errorCompany\":\"Please add your company.\",\"errorSubmit\":\"Something went wrong. Please try again.\"},\"confirmed\":{\"title\":\"See you in New York.\",\"description\":\"You’re confirmed for the Customer Advisory Board. Here’s what we have.\",\"rows\":[{\"label\":\"Dates\",\"value\":\"Monday, December 7 – Tuesday, December 8, 2026\"},{\"label\":\"Dinner\",\"value\":\"Monday, 6:00 pm — with Chef Leah Cohen, SoHo\"},{\"label\":\"Hotel\",\"value\":\"Monday and Tuesday nights, booked by us\"},{\"label\":\"Flights\",\"value\":\"Booked by us, our team will reach out to you directly\"}],\"addToCalendar\":\"Add to calendar\",\"contact\":\"Questions or changes? Write to \u003clink\u003e{email}\u003c/link\u003e.\"},\"tentative\":{\"title\":\"No rush.\",\"description\":\"We’ll hold your seat while you sort out the calendar.\",\"whenLabel\":\"When do you expect to know?\",\"whenOptions\":[\"Early October\",\"Late October\",\"Early November\",\"Late November\"],\"noteLabel\":\"Anything we can help untangle? (optional)\",\"submit\":\"Hold my seat\",\"finePrint\":\"We’ll check back in around then — no reminders before that.\",\"errorWhen\":\"Please pick when you expect to know.\",\"errorSubmit\":\"Something went wrong. Please try again.\",\"confirmedTitle\":\"Your seat is waiting.\",\"confirmedDescription\":\"We’ve set it aside and will check in around early November. If your plans settle sooner, your invitation link will be right where you left it.\",\"returnLink\":\"Return to the invitation\"},\"regrets\":{\"title\":\"We’ll miss you.\",\"description\":\"Thank you for letting us know — truly. The door stays open.\",\"noteLabel\":\"A note for the team (optional)\",\"checkboxLabel\":\"Keep me in mind for next year’s board\",\"submit\":\"Send\",\"errorSubmit\":\"Something went wrong. Please try again.\",\"confirmedTitle\":\"Until next time.\",\"confirmedDescription\":\"Your note is on its way to the team. We’ll save you a seat at next year’s table.\"}},\"prompts\":{\"common\":{\"eyebrow\":\"Runway Prompts\",\"breadcrumbHome\":\"Home\",\"contents\":\"Contents\",\"stepLabel\":\"Step {number}\",\"moreTitle\":\"More prompts\",\"moreDescription\":\"Other scenes, broken down prompt by prompt.\",\"moreReadMore\":\"Open the breakdown\"},\"aGameOfHorse\":{\"pageTitle\":\"A Game of HORSE prompts for Seedance 2.5 | Runway\",\"pageDescription\":\"Every prompt behind A Game of HORSE: the empty location, two character sheets, scene coverage and the enhanced Seedance 2.5 prompt, ready to copy or open in Runway.\",\"title\":\"A Game of HORSE\",\"lede\":\"Two friends square off on a rooftop parking deck and trade finger snaps that turn each other into whatever the other one imagines: a game of HORSE. Here is every prompt behind the chicken round, from the empty location to the enhanced Seedance 2.5 prompt, ready to copy or open in Runway.\",\"heroVideoDescription\":\"A Game of HORSE: two friends on a rooftop parking deck trade finger snaps that swap each other into costumes and scenes, made with Seedance 2.5 from the prompts on this page.\",\"tools\":[\"Seedance 2.5\",\"Nano Banana 2 Lite\",\"Runway Agent skills\",\"5 prompts\"],\"intro\":{\"title\":\"Before you start\",\"body\":[\"The idea is to lock everything down before generating the final video: the location, the two characters, the blocking and the coverage. Each step produces a reference the next step uses, and the last prompt binds all of them into one 15-second scene.\",\"Every prompt runs in Runway Agent. Two steps use Agent skills: a character sheet skill, and the runway-sd-enhancer skill that turns a rough description into a production-ready Seedance 2.5 prompt. The skill file is available to download in step 4. Copy any prompt as is, or open it in Runway with the composer prefilled.\"]},\"steps\":[{\"title\":\"Generate the empty location\",\"body\":[\"Start with the stage. This prompt asks for ten wide, empty outdoor locations around New York with no people or cars, so every later shot has a clean plate to build on. The rooftop parking deck below is the one we kept: open concrete, light poles, a hazy skyline and a low sun.\",\"The location image becomes the reference for lighting, lens character and color grade in the final prompt, so pick the frame you want the whole scene to inherit.\"],\"prompts\":[{\"promptLabel\":\"Location prompt\",\"promptTag\":\"Nano Banana 2 Lite\",\"prompt\":\"I need images of various empty locations around New York. All of them should be outdoors, with relatively wide open space. No people or cars present, only the empty locations. Please generate 10 different location images, all of them different. Use Nano Banana 2 Lite.\",\"assetsLabel\":\"Output\",\"assets\":[{\"alt\":\"The open top deck of an empty concrete parking garage, light poles and a hazy New York skyline behind it\"}]}]},{\"title\":\"Build the character sheets\",\"body\":[\"Each performer gets a three-panel character sheet: front, back and a close-up. Seedance 2.5 reads these as identity references, so faces, hair and wardrobe hold from shot to shot.\",\"The prompt is one line because the work is done by a Runway Agent skill. Attach an image of your character and run it. The third sheet below is the same skill on a different character, to show how consistent the format stays.\"],\"prompts\":[{\"promptLabel\":\"Character sheet prompt\",\"promptTag\":\"Runway Agent skill\",\"prompt\":\"Generate a character sheet for this character\",\"assetsLabel\":\"Output\",\"assets\":[{\"alt\":\"Character sheet for the man in plaid: front view, back view and close-up\"},{\"alt\":\"Character sheet for the man in glasses: front view, back view and close-up\"},{\"alt\":\"Character sheet for a third character with rainbow curls and a red plaid shirt, made with the same skill\"}]}]},{\"title\":\"Block the scene with coverage shots\",\"body\":[\"Before writing the final prompt, the scene is frozen and covered from every angle: mediums of each man, a wide and a close two-shot, over-the-shoulders, a low angle, a high angle and detail inserts. The prompt points at an annotated blocking diagram as @image4, so both men land in the same positions in every frame.\",\"The result is a shot list to pull framing references from. The clip below is this step’s output, and the stills are frames from it.\"],\"prompts\":[{\"promptLabel\":\"Scene coverage prompt\",\"promptTag\":\"Seedance 2.5\",\"prompt\":\"Create 20 different scene coverage shots that depict the following:\\n\\nBoth men are standing across from each other, staring directly at each other, on top of an empty parking garage in New York.\\n\\nThe scene is completely frozen in time. Use the annotated blocking diagram in @image4 for blocking reference.\\n\\nEach shot should be a different focal length and framing, focusing mainly on the 2 hero subjects squaring off against each other.\\n\\nShots should include:\\n- A front angle medium shot of man 1\\n- A front angle medium shot of man 2\\n- A wide 2-shot of the men\\n- A medium 2-shot of the men\\n- A close-up 2-shot of the men\\n- Over the shoulder focusing on man 1\\n- Over the shoulder focusing on man 2\\n- A low angle shot looking up\\n- A high angle shot looking down\\n- An overhead top-down angle looking straight down at the ground\\n- A ground-level shot looking straight up into the air\\n- Close-up detail inserts of eyes, hands, and facial expressions\",\"assetsLabel\":\"Output\",\"assets\":[{\"alt\":\"Front angle medium shot of the man in plaid on the parking deck\"},{\"alt\":\"Front angle medium shot of the man in glasses on the parking deck\"},{\"alt\":\"Profile two-shot of the two men facing each other against the skyline\"},{\"alt\":\"Over-the-shoulder shot favoring the man in glasses\"},{\"alt\":\"Low angle shot looking up at the two men squaring off\"}]}]},{\"title\":\"Write the rough prompt, then enhance it\",\"body\":[\"The scene starts as a plain paragraph: who stands where, what happens, the one line of dialogue. Nothing about cameras, timing or audio yet.\",\"That paragraph goes to the runway-sd-enhancer skill. It binds each attached reference to a role, lays the action out on a timestamped timeline, adds camera and audio direction, and writes the consistency rules Seedance 2.5 needs to keep faces, wardrobe and lighting stable across the whole clip.\"],\"prompts\":[{\"promptLabel\":\"Rough prompt\",\"promptTag\":\"Runway Agent skill\",\"prompt\":\"/runway-sd-enhancer\\nThe two men are squaring off in a parking lot. The man in the plaid lifts a single arm to shoulder height, then snaps his fingers once. The man in the glasses suddenly appears in an oversized chicken mascot costume, which is comically large. The man in plaid laughs, then the chicken man snaps his fingers and the man in plaid suddenly appears in a similar chicken mascot costume. The man in plaid then says \\\"okay, i see you. game on\\\" then snaps his fingers again.\",\"downloadLabel\":\"Download the enhancer skill\"}]},{\"title\":\"Generate with the enhanced prompt\",\"body\":[\"This is the enhanced prompt the skill returned, ready to run in Seedance 2.5. It opens by binding six references in upload order: the two character sheets, the location, the profile two-shot and the two over-the-shoulder frames from the coverage step. Attach them in that order before you generate. The chicken round in the film at the top of the page came from this prompt.\"],\"prompts\":[{\"promptLabel\":\"Enhanced prompt\",\"promptTag\":\"Seedance 2.5\",\"prompt\":\"$47\"}]}],\"ctaTitle\":\"Snap your own scene into place.\",\"ctaDescription\":\"Copy the prompts, swap in your own characters and location, and run them in Runway.\",\"cardTitle\":\"A Game of HORSE\",\"cardDescription\":\"Two friends snap each other into chicken costumes on a rooftop parking deck.\"},\"castingToCampaign\":{\"pageTitle\":\"Casting to campaign: 21 fashion prompts | Runway\",\"pageDescription\":\"Every prompt behind a five-model fashion campaign: casting, hair, makeup, the clothes and the editorial shoot. All 21 prompts, to copy or open in Runway.\",\"title\":\"Casting to campaign\",\"lede\":\"A five-model fashion campaign built entirely from prompts: the cast, their hair and makeup, a line of clothes designed from scratch, and the editorial shoot they end up in. Here is every prompt in the order it ran, ready to copy or open in Runway.\",\"heroVideoDescription\":\"The campaign's fifteen-second high-fashion social cut: quick cuts and zooms across the five models in their finished looks, in front of the painted mountainside backdrop, made from the prompts on this page.\",\"tools\":[\"Runway Agent\",\"Character sheets\",\"5 phases\",\"21 prompts\"],\"intro\":{\"title\":\"Before you start\",\"body\":[\"The campaign is built in five passes, and each one hands its output to the next: a cast, then their hair, then their makeup and character sheets, then a line of clothes, then the shoot. Nothing is generated in isolation, which is what keeps five faces and nine garments consistent from the first lineup to the last frame.\",\"Every prompt runs in Runway Agent. The @ names point at images attached to the conversation, so @ Model4 or @ MakeupDirection means whatever you dropped in; the reference boards on this page are the ones this campaign used, and they are the part you should swap for your own. Copy any prompt as is, or open it in Runway with the composer prefilled.\"]},\"steps\":[{\"title\":\"Cast the models\",\"body\":[\"The campaign starts with faces. The first prompt asks for a lineup of five models against a white studio wall, shot straight on, with a brief that pushes back on the too-perfect look: natural skin texture, nothing hyper symmetrical. Asking for six lineups at once gives you a pool to cast from instead of one take to accept or reject.\",\"Once a lineup works, the rest of the pass is editing. Split it so each model has her own generation to build on, adjust a single detail, then take everyone full body in a neutral base outfit. The last prompt widens the range of bodies in the cast.\"],\"prompts\":[{\"promptLabel\":\"First round of casting\",\"promptTag\":\"Attach your casting board\",\"prompt\":\"Reference the attached @ Casting Direction to create a line up of headshots of 5 net new female models that range in race, in their 20’s and for a fashion campaign. They are beautiful but not in an artificial way. Their skin has natural texture, nothing is too perfect or hyper symmetrical. The headshots should be side by side, shot directly on and in a white studio. Natural lighting on their face. Generate 6 lineups.\",\"assetsLabel\":\"Output\",\"assets\":[{\"alt\":\"A lineup of five model headshots side by side in a white studio, varied in race and hair, all in their twenties\"}]},{\"promptLabel\":\"Separate into individual headshots\",\"prompt\":\"Separate each model to give them their own generation.\"},{\"promptLabel\":\"Subtle hair change\",\"prompt\":\"Add baby bangs\"},{\"promptLabel\":\"Full body looks\",\"prompt\":\"Generate full body looks for these models. White tank top, blue jeans, black ballet flats.\"},{\"promptLabel\":\"Add body diversity\",\"promptTag\":\"Attach the models\",\"prompt\":\"Change @ Model to size 12-14 and change @ Model to size 1-12\"}]},{\"title\":\"Design the hair\",\"body\":[\"Hair is its own pass, run against a reference board. The brief is athleisure: active braids, high ponytails, wet looks. Four options per model, all shot on white, and every model gets different styles so the cast does not read as one look repeated five times. The prompt also asks for the styles to be culturally and racially sensitive, which is worth stating explicitly when you are generating hair across a mixed cast.\",\"Everything after that is revision: strip a detail you did not ask for, get more options for the two models whose first round missed, bring in a new reference for one specific style, then assemble the results into a lineup and swap a model inside it.\"],\"prompts\":[{\"promptLabel\":\"First round of hair\",\"promptTag\":\"Attach your hair board\",\"prompt\":\"Create new hairstyles for an athlesiure fashion campaign. Think active braids, high ponytails and wet looks. Reference this @ Hair for inspiration. Create 4 options per model shot on white. Hairstyles should all be different from model to model. Ensure hairstyles are culturally and racially sensitive.\",\"assetsLabel\":\"Reference\",\"assets\":[{\"alt\":\"A board of seven hairstyle references: long braids with ribbon, high buns, slicked-back plaits and wet looks\"}]},{\"promptLabel\":\"Edit the hair, remove the bows\",\"prompt\":\"Remove the little bows in the front\"},{\"promptLabel\":\"More options for two models\",\"promptTag\":\"Attach the models\",\"prompt\":\"More hair options for @ Model4 and @ Model5\"},{\"promptLabel\":\"Add a reference for a new style\",\"promptTag\":\"Attach your reference\",\"prompt\":\"Do a similar hairstyle to @ Headband on @ Model4 but make her headband white\"},{\"promptLabel\":\"Generate a lineup\",\"promptTag\":\"Attach every image you need\",\"prompt\":\"Generate a lineup\"},{\"promptLabel\":\"Change a model in the lineup\",\"promptTag\":\"Attach the lineup and the new model\",\"prompt\":\"Replace the model in the far right of @ Reference Image with this Model @ Model5\"}]},{\"title\":\"Set the makeup and build character sheets\",\"body\":[\"Makeup works the same way: a direction board, then one prompt per model so the look can be described in her own terms. This one asks for dewiness and a subtle flush rather than a finished beauty look, because the campaign wants skin that still reads as skin.\",\"The pass then turns each model into a character sheet: full body front, full body back, headshot front, headshot back, in a fixed base outfit. Those sheets are the identity references every later prompt attaches, and they are what holds five faces steady through styling and the shoot.\"],\"prompts\":[{\"promptLabel\":\"First round of makeup\",\"promptTag\":\"Attach your makeup board and a model\",\"prompt\":\"Using @ MakeupDirection as your guide, create a makeup look for @ Model1 that reflects some dewiness and subtle flush of her cheeks.\",\"assetsLabel\":\"Reference\",\"assets\":[{\"alt\":\"A board of six beauty references, all dewy skin and wet-look hair across a mixed cast\"}]},{\"promptLabel\":\"Character sheets\",\"promptTag\":\"Attach the models\",\"prompt\":\"Create a character sheet of this model. Full body front, full body back, headshot front, headshot back. White tank, blue jeans, black pointed booties (kitten heel)\"},{\"promptLabel\":\"Character sheets for body diversity\",\"promptTag\":\"Attach the models\",\"prompt\":\"Generate 4 character sheets for @ Model and she is a size 14-16.\"}]},{\"title\":\"Design the clothes and style the cast\",\"body\":[\"The clothes are designed before anyone wears them. The first prompt hands over a board of reference tops and asks for a six-piece line that shares their vocabulary: layering and faux layering, ruching, sheer panels, draping, lettuce edges, color blocking, all in the same palette and shot like product photography on white.\",\"From there the line is expanded to twenty pieces, narrowed to the nine that work, given matching bottoms, and finally put on the cast. The styling prompt is the longest one in the campaign and the most specific: show-fitting proportion play, half-fastened pieces, sweaters tied around the body, a deliberately hurried quality that still has to read cohesive and editorial.\",\"The lineup below is what that last prompt returned.\"],\"prompts\":[{\"promptLabel\":\"First round of styling\",\"promptTag\":\"Attach your tops board\",\"prompt\":\"See how all of these tops have special details like cool layering or faux layering techniques, interesting shapes, ruching, super light sheer techniques, draping, lettuce edges, color blocking, etc. I want to create my own line of tops that incorporates the same vibe. Equally assess these references and what I described here to create a line of 6 tops within this same color palette. All shot like a product photo on white.\",\"assetsLabel\":\"Reference\",\"assets\":[{\"alt\":\"A board of six reference tops: color-blocked knits, sheer panelled tees and a cropped polo\"}]},{\"promptLabel\":\"Generate more tops\",\"prompt\":\"These are cool, let’s add 20 more to the collection.\"},{\"promptLabel\":\"Show specific tops\",\"prompt\":\"Generate a lineup of the following tops: 1, 5, 7, 9, 10, 11, 14, 15, 17\",\"assetsLabel\":\"Output\",\"assets\":[{\"alt\":\"Nine generated tops laid out as product shots on white, numbered 1, 5, 7, 9, 10, 11, 14, 15 and 17\"}]},{\"promptLabel\":\"Corresponding bottoms\",\"prompt\":\"Add a corresponding pant (capri’s, wide leg, subtle flare), skirt (range of styles and lengths) or shorts (range of styles and lengths) to each of these tops and keep the tops in place. Think preppy-sporty activewear with a retro, ballet-and-tennis-inspires aesthetic - fitted knits, refined tailoring, and an elevated, minimal-luxury feel.\",\"assetsLabel\":\"Output\",\"assets\":[{\"alt\":\"Eight generated bottoms on white: pleated tennis skirts, track pants with side stripes and a long jersey skirt\"}]},{\"promptLabel\":\"Style the models\",\"promptTag\":\"Attach the tops, bottoms and character sheets\",\"prompt\":\"Style these models in these outfits with runway/show-fitting styling and a retro, minimal-luxury sporty-prep aesthetic. Layered, proportion-play looks: cropped polos, sporty bralettes under shrunken knits, two-tone windbreakers, mico pleated skirts, knee socks and loaders. Purposely haphazard, mismatched styling like sweaters tied around the body and pieces left half-fastened, with a “getting dressed in a hurry quality that reads urgent and slightly strange but cohesive and editorial. Luxury product. Modest by cool.\",\"assetsLabel\":\"Output\",\"assets\":[{\"alt\":\"The five-model cast in the finished campaign styling, shot as a full-body lineup in a white studio\"}]}]},{\"title\":\"Shoot the editorial\",\"body\":[\"With the cast styled, the shoot is two prompts. The first puts the models in front of a fabric backdrop painted like a summer mountainside and asks for a cinematic, slightly absurdist luxury campaign look. It comes back as a contact sheet per model, which is closer to what a campaign actually needs than a single hero frame: several usable angles of one look.\",\"The second prompt turns those stills into a fifteen-second social cut, with the pacing, grain and lighting spelled out so the video matches the stills rather than reinterpreting them. Its output is the clip at the top of this page.\"],\"prompts\":[{\"promptLabel\":\"Sets\",\"promptTag\":\"Attach your styled cast\",\"prompt\":\"Create an editorial fashion campaign image of these models posed in front of a fabric backdrop resembling a summer mountainside. Cinematic, slightly absurdist luxury campaign aesthetic.\",\"assetsLabel\":\"Output\",\"assets\":[{\"alt\":\"Contact sheet of the model in a cream and blue raglan tee and navy track pants against a painted mountainside backdrop\"},{\"alt\":\"Contact sheet of the model in a black polo and sage pleated overlay over black track pants, on a pale mountainside backdrop\"},{\"alt\":\"Contact sheet of the model in a grey shirt jacket and navy scalloped tennis skirt, with blue knee socks and loafers\"},{\"alt\":\"Contact sheet of the model in a pale blue ruched long-sleeve top and navy side-stripe trousers, a burgundy layer tied at her waist\"},{\"alt\":\"Contact sheet of the model in a two-tone windbreaker over a sage bralette and navy shorts, with a white headband and knee socks\"}]},{\"promptLabel\":\"Video\",\"promptTag\":\"Attach every on-set image\",\"prompt\":\"Create a 15-second high-fashion social video with lots of quick cuts and zooms, models smiling at the camera, mixing analog home-video footage with professional camera shots. Behind-the-scenes energy, these models in these outfits in this editorial location: in front of a fabric backdrop resembling a summer mountainside. Cinematic, slightly absurdist luxury campaign aesthetic with elevated sporty prep styling, retro athletic influence, and playful surreal art direction with a quiet-luxury polish. Dreamy hazy film lighting, soft grain and halation, warm-cool color washer. Playful, flirty, high-energy mood.\"}]}],\"ctaTitle\":\"Cast your own campaign.\",\"ctaDescription\":\"Copy the prompts, bring your own reference boards, and run the whole thing in Runway.\",\"cardTitle\":\"Casting to campaign\",\"cardDescription\":\"Twenty-one prompts that build a five-model fashion campaign, from the first casting lineup to the editorial shoot.\"}}},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":[\"$L48\",\"$L49\",\"$L4a\",\"$L4b\",\"$L4c\",\"$L4d\",\"$L4e\"]}]\n"])</script><script>self.__next_f.push([1,"4f:I[352462,[\"/_next/static/immutable/chunks/0x-9rc1bm-510.js\",\"/_next/static/immutable/chunks/07ucy92m6bjvs.js\",\"/_next/static/immutable/chunks/18hu_p7ua4cwz.js\",\"/_next/static/immutable/chunks/1q4-fupqk0_j8.js\",\"/_next/static/immutable/chunks/081uibm0ltqh5.js\",\"/_next/static/immutable/chunks/2rf7i7q6cynxw.js\",\"/_next/static/immutable/chunks/09cui6q2dhxjq.js\",\"/_next/static/immutable/chunks/2gc_qh4gnrn8e.js\",\"/_next/static/immutable/chunks/44x24r9z-dubx.js\",\"/_next/static/immutable/chunks/3m_p1s9u_dxei.js\"],\"default\"]\n50:I[400854,[\"/_next/static/immutable/chunks/0x-9rc1bm-510.js\",\"/_next/static/immutable/chunks/07ucy92m6bjvs.js\",\"/_next/static/immutable/chunks/18hu_p7ua4cwz.js\",\"/_next/static/immutable/chunks/1q4-fupqk0_j8.js\",\"/_next/static/immutable/chunks/081uibm0ltqh5.js\",\"/_next/static/immutable/chunks/2rf7i7q6cynxw.js\",\"/_next/static/immutable/chunks/09cui6q2dhxjq.js\",\"/_next/static/immutable/chunks/2gc_qh4gnrn8e.js\",\"/_next/static/immutable/chunks/44x24r9z-dubx.js\",\"/_next/static/immutable/chunks/3m_p1s9u_dxei.js\"],\"default\"]\n51:I[739354,[\"/_next/static/immutable/chunks/0x-9rc1bm-510.js\",\"/_next/static/immutable/chunks/07ucy92m6bjvs.js\",\"/_next/static/immutable/chunks/18hu_p7ua4cwz.js\",\"/_next/static/immutable/chunks/1q4-fupqk0_j8.js\",\"/_next/static/immutable/chunks/081uibm0ltqh5.js\",\"/_next/static/immutable/chunks/2rf7i7q6cynxw.js\",\"/_next/static/immutable/chunks/09cui6q2dhxjq.js\",\"/_next/static/immutable/chunks/2gc_qh4gnrn8e.js\",\"/_next/static/immutable/chunks/44x24r9z-dubx.js\",\"/_next/static/immutable/chunks/3m_p1s9u_dxei.js\"],\"default\"]\n52:I[946827,[\"/_next/static/immutable/chunks/0x-9rc1bm-510.js\",\"/_next/static/immutable/chunks/07ucy92m6bjvs.js\",\"/_next/static/immutable/chunks/18hu_p7ua4cwz.js\",\"/_next/static/immutable/chunks/1q4-fupqk0_j8.js\",\"/_next/static/immutable/chunks/081uibm0ltqh5.js\",\"/_next/static/immutable/chunks/2rf7i7q6cynxw.js\",\"/_next/static/immutable/chunks/09cui6q2dhxjq.js\",\"/_next/static/immutable/chunks/2gc_qh4gnrn8e.js\",\"/_next/static/immutable/chunks/44x24r9z-dubx.js\",\"/_next/static/immutable/chunks/3m_p1s9u_dxei.js\"],\"default\"]\n53:I[290918,[\"/_next/static/immutable/chunks/0x-9rc1bm-510.js\",\"/_next/static/immutable/chunks/07ucy92m6bjvs.js\",\"/_next/static/immutable/chunks/18hu_p7ua4cwz.js\",\"/_next/static/immutable/chunks/1q4-fupqk0_j8.js\",\"/_next/static/immutable/chunks/081uibm0ltqh5.js\",\"/_next/static/immutable/chunks/2rf7i7q6cynxw.js\",\"/_next/static/immutable/chunks/09cui6q2dhxjq.js\",\"/_next/static/immutable/chunks/2gc_qh4gnrn8e.js\",\"/_next/static/immutable/chunks/44x24r9z-dubx.js\",\"/_next/static/immutable/chunks/3m_p1s9u_dxei.js\"],\"AppBannerProvider\"]\n54:I[493749,[\"/_next/static/immutable/chunks/0x-9rc1bm-510.js\",\"/_next/static/immutable/chunks/07ucy92m6bjvs.js\",\"/_next/static/immutable/chunks/18hu_p7ua4cwz.js\",\"/_next/static/immutable/chunks/1q4-fupqk0_j8.js\",\"/_next/static/immutable/chunks/081uibm0ltqh5.js\",\"/_next/static/immutable/chunks/2rf7i7q6cynxw.js\",\"/_next/static/immutable/chunks/09cui6q2dhxjq.js\",\"/_next/static/immutable/chunks/2gc_qh4gnrn8e.js\",\"/_next/static/immutable/chunks/44x24r9z-dubx.js\",\"/_next/static/immutable/chunks/3m_p1s9u_dxei.js\"],\"default\"]\n55:I[976705,[\"/_next/static/immutable/chunks/0x-9rc1bm-510.js\",\"/_next/static/immutable/chunks/07ucy92m6bjvs.js\",\"/_next/static/immutable/chunks/18hu_p7ua4cwz.js\",\"/_next/static/immutable/chunks/1q4-fupqk0_j8.js\",\"/_next/static/immutable/chunks/081uibm0ltqh5.js\",\"/_next/static/immutable/chunks/2rf7i7q6cynxw.js\",\"/_next/static/immutable/chunks/09cui6q2dhxjq.js\",\"/_next/static/immutable/chunks/2gc_qh4gnrn8e.js\",\"/_next/static/immutable/chunks/44x24r9z-dubx.js\",\"/_next/static/immutable/chunks/3m_p1s9u_dxei.js\",\"/_next/static/immutable/chunks/3u6d0q7w8bcz4.js\",\"/_next/static/immutable/chunks/0-zx62m671qas.js\",\"/_next/static/immutable/chunks/1rqvb31vx1hvd.js\",\"/_next/static/immutable/chunks/2oeosizrjdogx.js\",\"/_next/static/immutable/chunks/0jla--1-ybwt0.js\",\"/_next/static/immutable/chunks/3966cahh5133t.js\",\"/_next/static/immutable/chunks/0i-6nj50pq431.js\",\"/_next/static/immutable/chunks/1dfz_acmswbg4.js\",\"/_next/static/immutable/chunks/427dpr05v2h4s.js\"],\"default\"]\n56:I[188677,[\"/_next/static/immutable/chunks/0x-9rc1bm-510.js\",\"/_next/static/immutable/chunks/07ucy92m6bjvs.js\",\"/_next/static/immutable/chunks/18hu_p7ua4cwz.js\",\"/_next/static/immutable/chunks/1q4-fupqk0_j8.js\",\"/_next/static/immutable/chunks/081uibm0ltqh5.js\",\"/_next/static/immutable/chunks/2rf7i7q6cynxw.js\",\"/_next/static/immutable/chunks/09cui6q2dhxjq.js\",\"/_next/static/immutable/chunks/2gc_qh4gnrn8e.js\",\"/_next/static/immutable/chunks/44x24r9z-dubx.js\",\"/_next/static/immutable/chunks/3m_p1s9u_dxei.js\"],\"default\"]\n57:I[585458,[\"/_next/static/immutable/chunks/0x-9rc1bm-510.js\",\"/_next/static/immutable/chunks/07ucy92m6bjvs.js\",\"/_next/static/immutable/chunks/18hu_p7ua4cwz.js\",\"/_next/static/immutable/chunks/1q4-fupqk0_j8.js\",\"/_next/static/immutable/chunks/081uibm0ltqh5.js\",\"/_next/static/immutable/chunks/2rf7i7q6cynxw.js\",\"/_next/static/immutable/chunks/09cui6q2dhxjq.js\",\"/_next/static/immutable/chunks/2gc_qh4gnrn8e.js\",\"/_next/static/immutable/chunks/44x24r9z-dubx.js\",\"/_next/static/immutable/chunks/3m_p1s9u_dxei.js\"],\"default\"]\n48:[\"$\",\"$L4f\",null,{}]\n49:[\"$\",\"$L50\",null,{}]\n4a:[\"$\",\"$L51\",null,{}]\n4b:[\"$\",\"$L52\",null,{}]\n4c:[\"$\",\"$L53\",null,{\"children\":[[\"$\",\"$L54\",null,{}],[\"$\",\"div\",null,{\"className\":\"flex-1\",\"children\":[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$\",\"div\",null,{\"className\":\"w-full min-h-screen aspect-video flex items-center justify-center\",\"children\":[[\"$\",\"$L55\",null,{\"webmVideo\":\"https://runway-static-assets.s3.amazonaws.com/site/videos/404_003.webm\",\"mp4Video\":\"https://runway-static-assets.s3.amazonaws.com/site/videos/404_003.mp4\",\"poster\":\"https://runway-static-assets.s3.amazonaws.com/site/videos/404_003.jpg\",\"additionalClasses\":\"w-full h-full object-cover absolute inset-0 z-0\"}],[\"$\",\"div\",null,{\"className\":\"absolute inset-0 bg-black bg-opacity-30\"}],[\"$\",\"div\",null,{\"className\":\"relative text-white text-center\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"rw-h2\",\"children\":\"This page doesn’t exist.\"}],[\"$\",\"$L14\",null,{\"href\":\"/\",\"className\":\"rw-cta-text px-4 pt-[10px] pb-[11px] rounded-full inline-flex transition-all duration-200 items-center justify-center whitespace-nowrap text-white border border-white hover:bg-white hover:text-offBlack mt-8\",\"target\":\"_self\",\"onClick\":\"$undefined\",\"download\":\"$undefined\",\"children\":[\"Take me home\",false]}]]}]]}],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}]]}]\n4d:[\"$\",\"$L56\",null,{\"groups\":[{\"title\":\"Creative\",\"items\":[{\"title\":\"Overview\",\"link\":\"/product\",\"external\":false},{\"title\":\"Agent\",\"link\":\"/product/agent\",\"external\":false},{\"title\":\"Android app\",\"link\":\"https://play.google.com/store/apps/details?id=com.runwayml.prod\",\"external\":true},{\"title\":\"iOS app\",\"link\":\"https://apps.apple.com/us/app/runwayml/id1665024375\",\"external\":true},{\"title\":\"ChatGPT Plugin\",\"link\":\"/mcp/chatgpt\",\"external\":false},{\"title\":\"MCP\",\"link\":\"/mcp\",\"external\":false},{\"title\":\"Use Cases\",\"link\":\"/use-cases\",\"external\":false},{\"title\":\"Pricing\",\"link\":\"/pricing\",\"external\":false},{\"title\":\"Team Plan\",\"link\":\"/team-plan\",\"external\":false},{\"title\":\"Login\",\"link\":\"https://app.runwayml.com/login\",\"external\":false}]},{\"title\":\"Dev\",\"items\":[{\"title\":\"Platform\",\"link\":\"https://dev.runwayml.com/\",\"external\":true},{\"title\":\"Models\",\"link\":\"https://dev.runwayml.com/models\",\"external\":true},{\"title\":\"Model Router\",\"link\":\"https://docs.dev.runwayml.com/model-routers/\",\"external\":true},{\"title\":\"Workflows\",\"link\":\"/workflows\",\"external\":false},{\"title\":\"Recipes\",\"link\":\"https://dev.runwayml.com/recipes/product_ad\",\"external\":true},{\"title\":\"Characters\",\"link\":\"/product/characters\",\"external\":false},{\"title\":\"Documentation\",\"link\":\"https://docs.dev.runwayml.com/\",\"external\":true},{\"title\":\"Pricing\",\"link\":\"/pricing?tab=dev\",\"external\":false}]},{\"title\":\"Robotics\",\"items\":[{\"title\":\"Overview\",\"link\":\"/product/robotics\",\"external\":false},{\"title\":\"Policy Model\",\"link\":\"/product/robotics/policy-model\",\"external\":false},{\"title\":\"Offline Policy Evaluation\",\"link\":\"/product/robotics/policy-evaluation\",\"external\":false},{\"title\":\"Data Augmentation\",\"link\":\"/product/robotics/data-augmentation\",\"external\":false},{\"title\":\"Video Model Licensing\",\"link\":\"/model-licensing\",\"external\":false},{\"title\":\"Get Access\",\"link\":\"/product/robotics/contact\",\"external\":false}]},{\"title\":\"Enterprise\",\"items\":[{\"title\":\"Overview\",\"link\":\"/enterprise\",\"external\":false},{\"title\":\"Data Security\",\"link\":\"/data-security\",\"external\":false},{\"title\":\"Customer Stories\",\"link\":\"/news/customers\",\"external\":false},{\"title\":\"For Education\",\"link\":\"/educators\",\"external\":false},{\"title\":\"Contact Sales\",\"link\":\"/enterprise-contact\",\"external\":false}]},{\"title\":\"Research\",\"items\":[{\"title\":\"Research Hub\",\"link\":\"/research\",\"external\":false},{\"title\":\"Research News\",\"link\":\"/news/research\",\"external\":false},{\"title\":\"Publications\",\"link\":\"/research/publications\",\"external\":false},{\"title\":\"Gen-4.5\",\"link\":\"/research/introducing-runway-gen-4.5\",\"external\":false},{\"title\":\"Aleph 2.0\",\"link\":\"/product/aleph-2\",\"external\":false},{\"title\":\"Ruby\",\"link\":\"/product/ruby\",\"external\":false},{\"title\":\"Act-Two\",\"link\":\"/research/introducing-act-one\",\"external\":false},{\"title\":\"Solaris\",\"link\":\"/news/research/introducing-solaris\",\"external\":false},{\"title\":\"Robotics\",\"link\":\"/product/robotics\",\"external\":false},{\"title\":\"World Simulation\",\"link\":\"/research/introducing-gwm-worlds-2\",\"external\":false}]},{\"title\":\"Resources\",\"items\":[{\"title\":\"Academy\",\"link\":\"https://academy.runwayml.com/\",\"external\":true},{\"title\":\"Help Center\",\"link\":\"https://help.runwayml.com/hc/en-us\",\"external\":true},{\"title\":\"Resource Hub\",\"link\":\"/resources\",\"external\":false},{\"title\":\"News\",\"link\":\"/news\",\"external\":false},{\"title\":\"Changelog\",\"link\":\"/changelog\",\"external\":false},{\"title\":\"Meetups\",\"link\":\"https://academy.runwayml.com/meetups\",\"external\":true}]},{\"title\":\"Events \u0026 Programs\",\"items\":[{\"title\":\"AI Festival\",\"link\":\"https://aif.runwayml.com/\",\"external\":true},{\"title\":\"AI Summit 2026\",\"link\":\"https://summit.runwayml.com/\",\"external\":true},{\"title\":\"Gen:48\",\"link\":\"https://gen48.runwayml.com/\",\"external\":false},{\"title\":\"Studios\",\"link\":\"/studios\",\"external\":false},{\"title\":\"Creative Partners Program\",\"link\":\"/creative-partners-program\",\"external\":false},{\"title\":\"Runway Builders\",\"link\":\"/product/builders\",\"external\":false},{\"title\":\"Affiliate Program\",\"link\":\"/affiliate-program\",\"external\":false},{\"title\":\"Talent Network\",\"link\":\"https://talent.runwayml.com/\",\"external\":true}]},{\"title\":\"Company\",\"items\":[{\"title\":\"About Us\",\"link\":\"/about\",\"external\":false},{\"title\":\"Careers\",\"link\":\"/careers\",\"external\":false},{\"title\":\"Safety\",\"link\":\"/safety\",\"external\":false},{\"title\":\"Verify Content Credentials\",\"link\":\"/safety/verify\",\"external\":false},{\"title\":\"Brand Guidelines\",\"link\":\"/brand-guidelines\",\"external\":false},{\"title\":\"Press\",\"link\":\"mailto:press@runwayml.com\",\"external\":false},{\"title\":\"Partnerships\",\"link\":\"mailto:partnerships@runwayml.com\",\"external\":false}]}]}]\n4e:[\"$\",\"$L57\",null,{}]\n"])</script></body></html>