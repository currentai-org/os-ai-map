{"id":41356352,"uuid":"460615268","full_name":"dora-rs/dora","owner":"dora-rs","description":"DORA (Dataflow-Oriented Robotic Architecture) is middleware designed to streamline and simplify the creation of AI-based robotic applications. It offers low latency, composable, and distributed dataflow capabilities. Applications are modeled as directed graphs, also referred to as pipelines.","archived":false,"fork":false,"pushed_at":"2026-09-21T11:06:53.000Z","size":28224,"stargazers_count":3974,"open_issues_count":72,"forks_count":444,"subscribers_count":45,"default_branch":"main","last_synced_at":"2026-09-21T11:25:23.489Z","etag":null,"topics":["dataflow","embodied-ai","low-latency","robotics","rust"],"latest_commit_sha":null,"homepage":"https://dora-rs.ai","language":"Rust","has_issues":true,"has_wiki":null,"has_pages":null,"mirror_url":null,"source_name":null,"license":"apache-2.0","status":null,"scm":"git","pull_requests_enabled":true,"icon_url":"https://github.com/dora-rs.png","metadata":{"files":{"readme":"README.md","changelog":"Changelog.md","contributing":"CONTRIBUTING.md","funding":null,"license":"LICENSE","code_of_conduct":null,"threat_model":null,"audit":null,"citation":null,"codeowners":null,"security":null,"support":null,"governance":null,"roadmap":"docs/roadmap-v0.2.md","authors":null,"dei":null,"publiccode":null,"codemeta":null,"zenodo":null,"notice":"NOTICE.md","maintainers":null,"copyright":null,"agents":"AGENTS.md","claude":"CLAUDE.md","gemini":null,"cursor":null,"copilot":null,"dco":null,"cla":null,"disclosure":null}},"created_at":"2022-02-17T21:33:07.000Z","updated_at":"2026-09-21T09:08:13.000Z","dependencies_parsed_at":"2026-09-07T05:28:27.434Z","dependency_job_id":"710f8d03-ce3a-431b-ba83-735a35df4b20","html_url":"https://github.com/dora-rs/dora","commit_stats":null,"previous_names":[],"tags_count":141,"template":false,"template_full_name":null,"purl":"pkg:github/dora-rs/dora","repository_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositor