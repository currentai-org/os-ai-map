<script src="https://www.kunlunxin.com/wp-content/themes/default/js/wow.js"></script>
<link rel="stylesheet" href="https://www.kunlunxin.com/wp-content/themes/default/css/animate.css">
<script type="text/javascript">
new WOW().init();
</script>
<script type="text/javascript">

var $Li1 = $(".in_product .tab li a");
$Li1.click(function(){
    var index = $(this).closest("li").index()
    $(".in_product .tab li").attr('class',"");
    $(this).closest("li").attr('class',"active");
    $('.in_product .main').eq(index).addClass("active").siblings('.in_product .main').removeClass("active")
})
var q = 1;
if( q == $('.in_product .tab li a').length ) q = 0;
$('.in_product .tab li a:eq('+q+')').click();
q++;

$(".in_advantage .main a").click(function(){
  var index = $(".in_advantage .main a.active").index()
  $('.in_advantage .content').eq($(this).index()).fadeIn(300).siblings('.in_advantage .content').fadeOut(0);
  $(".in_advantage .main a").removeClass("active");
  $(".in_advantage .main a").removeClass("right");
  $(".in_advantage .main a").removeClass("left");
  $(this).addClass("active");


  if ( $(this).index() == 0 ) {
    $(this).next().addClass("right")
    $(this).next().next().addClass("left")
  }

  if ( $(this).index() == 1 ) {
    $(this).next().addClass("right")
    $(this).prev().addClass("left")
  }
  if ( $(this).index() == 2 ) {
    $(this).prev().prev().addClass("right")
    $(this).prev().addClass("left")
  }
})
$(".in_advantage .content").eq($(".in_advantage .main a.active").index()).show();


</script>

