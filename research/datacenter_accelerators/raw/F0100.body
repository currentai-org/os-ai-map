_at":1357,"default_branch":87,"namespace":1340,"namespace_info":1358,"visibility":12,"open_issues_count":1359,"open_merge_requests_count":1360,"open_change_requests_count":1360,"starred":59,"last_activity_at":1361,"main_repository_language":1362,"forked_from_project":13,"permissions":13,"member_count":1363,"repository_size":1364,"repo_size":13,"task":13,"tag_list":1365,"avatar_url":13},247,2322,9865789,"cann-outreach","CANN \u002F cann-outreach","cann\u002Fcann-outreach","2026-05-11T21:16:19.507+08:00","2026-05-15T21:27:04.806+08:00","git@gitcode.com:cann\u002Fcann-outreach.git","https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcann-outreach.git","https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcann-outreach",[1347,1348,1351,1352,1353,1354,1355,1356],{"project_id":1333,"topic_id":759,"name":760,"type":58,"icon":15,"gstar":59},{"project_id":1333,"topic_id":1349,"name":1350,"type":58,"icon":15,"gstar":59},"7abc1a233092fc104c7af72a","MIT",{"project_id":1333,"topic_id":335,"name":336,"type":58,"icon":15,"gstar":59},{"project_id":1333,"topic_id":328,"name":40,"type":58,"icon":15,"gstar":59},{"project_id":1333,"topic_id":458,"name":49,"type":58,"icon":15,"gstar":59},{"project_id":1333,"topic_id":411,"name":412,"type":58,"icon":15,"gstar":59},{"project_id":1333,"topic_id":397,"name":9,"type":58,"icon":15,"gstar":59},{"project_id":1333,"topic_id":344,"name":345,"type":58,"icon":15,"gstar":59},"2026-09-23T16:31:31.428+08:00",{"id":7,"name":9,"path":8,"develop_mode":290,"region":13,"cell":305,"kind":306,"full_path":8,"full_name":9,"parent_id":13,"visibility_level":307,"enable_file_control":59,"owner_id":13,"enterprise_member_mode":13},150,716,"2026-09-27T03:46:41.974+08:00",[40,41],36,397.65,[],"\n\n\n\n\n\n\n\n\n\n\n\u003Cdiv class=\"org-liquid-page org-liquid-page--v2 org-custom-layout reset-list layout-root\" data-org-liquid-root=\"1\" data-org-liquid-ns=\"cann\" data-imagepath=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\" data-imageversion=\"1789387680082\">\n\n  \u003Cdiv class=\"org-liquid-page__loading\" id=\"org-liquid-loading\">\n    \u003Cdiv class=\"org-liquid-page__loading-spinner\">\u003C\u002Fdiv>\n  \u003C\u002Fdiv>\n\n  \u003Cheader class=\"org-liquid-page__header org-liquid-page__header--surface\">\n    \u003Cdiv class=\"org-liquid-page__header-row\">\n      \u003Cdiv class=\"org-liquid-page__header-avatar\">\n        \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fcann_logo.png?version=1789387680082\" alt=\"CANN\" width=\"128\" height=\"128\" class=\"org-liquid-page__avatar-img\" loading=\"lazy\" \u002F>\n      \u003C\u002Fdiv>\n      \u003Cdiv class=\"org-liquid-page__header-main\">\n        \u003Ch1 class=\"org-liquid-page__title\">\n          CANN\n          \u003Cimg class=\"org-liquid-page__title-gstar\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fg-star.svg?version=1789387680082\" alt=\"\" loading=\"lazy\" data-tooltip=\"G-Star官方认证组织\" data-tooltip-dark=\"1\" \u002F>\n        \u003C\u002Fh1>\n        \n        \u003Cp class=\"org-liquid-page__desc org-liquid-page__desc--clamp\">CANN（Compute Architecture for Neural Networks）是华为针对AI场景推出的异构计算架构，对上支持多种AI框架，对下服务AI处理器与编程，发挥承上启下的关键作用，是提升昇腾AI处理器计算效率的关键平台。\u003C\u002Fp>\n        \n        \u003Cdiv class=\"org-liquid-page__followers-row\">\n          \u003Cspan class=\"org-liquid-page__inline-row org-liquid-page__header-meta-item\">\n            \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_followers.png?version=1789387680082\" width=\"16\" height=\"16\" loading=\"lazy\" class=\"org-liquid-page__icon-followers\" \u002F>\n            \u003Ca href=\"\u002Forg\u002Fcann\u002Ffollowers\" class=\"org-liquid-page__link\">\n              \u003Cspan class=\"org-liquid-page__link-follower\">6363\u003C\u002Fspan>\n            \u003C\u002Fa>\n          \u003C\u002Fspan>\n          \n          \u003Cspan class=\"org-liquid-page__inline-row org-liquid-page__header-meta-item org-liquid-page__header-meta-item--homepage\">\n            \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_link.png?version=1789387680082\" width=\"16\" height=\"16\" loading=\"lazy\" class=\"org-icon--link\" \u002F>\n            \u003Ca href=\"https:\u002F\u002Fwww.hiascend.com\u002Fcann\" class=\"org-liquid-page__link org-liquid-page__header-meta-link\" target=\"_blank\" rel=\"noopener noreferrer nofollow\">https:\u002F\u002Fwww.hiascend.com\u002Fcann\u003C\u002Fa>\n          \u003C\u002Fspan>\n          \n        \u003C\u002Fdiv>\n      \u003C\u002Fdiv>\n      \u003Cdiv class=\"org-liquid-page__header-actions\">\n        \n        \u003Ca href=\"#\" class=\"org-liquid-toggle-follow follow-btn org-liquid-btn-follow org-liquid-btn-follow--primary\">关注\u003C\u002Fa>\n        \n      \u003C\u002Fdiv>\n    \u003C\u002Fdiv>\n  \u003C\u002Fheader>\n\n  \u003Cdiv class=\"org-liquid-page__content\">\n    \u003Cdiv class=\"org-liquid-page__main\">\n\n      \u003Csection class=\"org-liquid-page__section org-liquid-page__quick-section\">\r\n  \u003Cdiv class=\"org-quick\" data-org-quick-carousel=\"1\" data-autoplay=\"5000\">\r\n    \u003Cdiv class=\"org-quick__header\">\r\n      \u003Cnav class=\"org-quick__tabs\" data-org-liquid-tabs=\"quick\">\r\n        \u003Cbutton type=\"button\" class=\"org-quick__tab org-quick__tab--active\" data-org-liquid-tab=\"q-deploy\">\r\n          \u003Cdiv class=\"org-quick__tab-btn-text\">模型部署\u003C\u002Fdiv>\u003C\u002Fbutton>\r\n        \u003Cspan class=\"org-quick__tab-arrow\">\u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" width=\"10\" height=\"10\" alt=\"\" \u002F>\u003C\u002Fspan>\r\n        \u003Cbutton type=\"button\" class=\"org-quick__tab\" data-org-liquid-tab=\"q-train\">\r\n          \u003Cdiv class=\"org-quick__tab-btn-text\">模型训练\u003C\u002Fdiv>\u003C\u002Fbutton>\r\n        \u003Cspan class=\"org-quick__tab-arrow\">\u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" width=\"10\" height=\"10\" alt=\"\" \u002F>\u003C\u002Fspan>\r\n        \u003Cbutton type=\"button\" class=\"org-quick__tab\" data-org-liquid-tab=\"q-tune\">\r\n          \u003Cdiv class=\"org-quick__tab-btn-text\">模型调优\u003C\u002Fdiv>\u003C\u002Fbutton>\r\n        \u003Cspan class=\"org-quick__tab-arrow\">\u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" width=\"10\" height=\"10\" alt=\"\" \u002F>\u003C\u002Fspan>\r\n        \u003Cbutton type=\"button\" class=\"org-quick__tab\" data-org-liquid-tab=\"q-operator\">\r\n          \u003Cdiv class=\"org-quick__tab-btn-text\">算子开发\u003C\u002Fdiv>\u003C\u002Fbutton>\r\n      \u003C\u002Fnav>\r\n    \u003C\u002Fdiv>\r\n\r\n    \u003Cdiv class=\"org-quick__viewport\">\r\n      \u003Cdiv class=\"org-quick__track\">\r\n        \u003Cdiv class=\"org-quick__slide\" data-org-quick-slide=\"q-deploy\" data-bg=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fmodel_deployment.png?version=1789387680082\">\r\n          \u003Cdiv class=\"org-quick__content-wrap\">\r\n            \u003Cdiv class=\"org-quick__title\">快速体验模型部署\u003C\u002Fdiv>\r\n            \u003Cp class=\"org-quick__desc\">零距离接触模型部署流程，玩转CANN部署操作。\u003C\u002Fp>\r\n            \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcann-recipes-infer\u002Fblob\u002Fmaster\u002Fmodels\u002Fsana-video\u002FREADME.md#cannlab一站式开发平台的快速启动\" target=\"_blank\" rel=\"noopener\" class=\"org-quick__btn\">快速部署模型示例 \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" class=\"org-quick__btn-icon\" alt=\"\" \u002F>\u003C\u002Fa>\r\n          \u003C\u002Fdiv>\r\n        \u003C\u002Fdiv>\r\n\r\n        \u003Cdiv class=\"org-quick__slide\" data-org-quick-slide=\"q-train\" data-bg=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fmodel_training.png?version=1789387680082\">\r\n          \u003Cdiv class=\"org-quick__content-wrap\">\r\n            \u003Cdiv class=\"org-quick__title\">快速体验模型训练\u003C\u002Fdiv>\r\n            \u003Cp class=\"org-quick__desc\">零门槛开启模型训练体验，探索智能模型自主学习的技术奥秘。\u003C\u002Fp>\r\n            \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcann-recipes-train\u002Fblob\u002Fmaster\u002Fllm_sft\u002Fqwen3\u002FREADME.md#一站式平台快速启动sft训练示例\" target=\"_blank\" rel=\"noopener\" class=\"org-quick__btn\">快速训练模型示例 \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" class=\"org-quick__btn-icon\" alt=\"\" \u002F>\u003C\u002Fa>\r\n          \u003C\u002Fdiv>\r\n        \u003C\u002Fdiv>\r\n\r\n        \u003Cdiv class=\"org-quick__slide\" data-org-quick-slide=\"q-tune\" data-bg=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fmodel_tuning.png?version=1789387680082\">\r\n          \u003Cdiv class=\"org-quick__content-wrap\">\r\n            \u003Cdiv class=\"org-quick__title\">模型深度调优达成极致性能\u003C\u002Fdiv>\r\n            \u003Cp class=\"org-quick__desc\">基于CANN深度优化的主流模型训练与推理脚本，提供完整的算法示例，使用指南与性能调优技巧。\u003C\u002Fp>\r\n            \u003Cdiv class=\"org-banner_card_3_button-parent\">\r\n              \u003Cdiv class=\"org-banner_card_3_button-block\">\r\n                \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcann-recipes-infer\u002Fblob\u002Fmaster\u002Fdocs\u002Fmodels\u002Fdeepseek_v4\u002Fdeepseek_v4_inference_guide.md\" target=\"_blank\" rel=\"noopener\" class=\"org-quick__btn org-banner_card_3_button\">\r\n                  \u003Cspan>DeepSeek-V4模型推理优化实践\u003C\u002Fspan> \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" class=\"org-quick__btn-icon\" alt=\"\" \u002F>\u003C\u002Fa>\r\n              \u003C\u002Fdiv>\r\n              \u003Cdiv class=\"org-banner_card_3_button-block\">\r\n                \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcann-recipes-infer\u002Fblob\u002Fmaster\u002Fdocs\u002Fmodels\u002Fqwen3_moe\u002Fqwen3_moe_optimization.md\" target=\"_blank\" rel=\"noopener\" class=\"org-quick__btn org-banner_card_3_button\">\r\n                  \u003Cspan>Qwen3-MoE模型低时延推理优化实践\u003C\u002Fspan> \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" class=\"org-quick__btn-icon\" alt=\"\" \u002F>\u003C\u002Fa>\r\n              \u003C\u002Fdiv>\r\n              \u003Cdiv class=\"org-banner_card_3_button-block\">\r\n                \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcann-recipes-infer\u002Fblob\u002Fmaster\u002Fdocs\u002Fmodels\u002Fsana-video\u002FSANA-Video_optimization.md\" target=\"_blank\" rel=\"noopener\" class=\"org-quick__btn org-banner_card_3_button\">\r\n                  \u003Cspan>SANA-Video多模态模型推理优化实践\u003C\u002Fspan> \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" class=\"org-quick__btn-icon\" alt=\"\" \u002F>\u003C\u002Fa>\r\n              \u003C\u002Fdiv>\r\n            \u003C\u002Fdiv>\r\n          \u003C\u002Fdiv>\r\n        \u003C\u002Fdiv>\r\n\r\n        \u003Cdiv class=\"org-quick__slide\" data-org-quick-slide=\"q-operator\" data-bg=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fmodel_operator.png?version=1789387680082\">\r\n          \u003Cdiv class=\"org-quick__content-wrap--operator\">\r\n            \u003Cdiv class=\"org-quick__operator-left\">\r\n              \u003Cdiv class=\"org-quick__title card-title\">高性能算子开发\u003C\u002Fdiv>\r\n              \u003Cp class=\"org-quick__desc card-desp\">基于Ascend C编程语言，面向昇腾AI处理器，让开发者高效实现高性能自定义算子，从入门到精通一站搞定。\u003C\u002Fp>\r\n              \u003Cdiv class=\"org-quick__operator-btns\">\r\n                \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Forg\u002Fcann\u002Fcannlab\" target=\"_blank\" class=\"org-quick__operator-btn\">\r\n                  \u003Cspan class=\"card-sub-title\">CANNLab\u003C\u002Fspan>\r\n                  \u003Cspan class=\"org-quick__operator-btn-arrow\">\u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\u003C\u002Fspan>\u003C\u002Fa>\r\n                \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcannbot-skills\" target=\"_blank\" class=\"org-quick__operator-btn\">\r\n                  \u003Cspan class=\"card-sub-title\">CANNBot\u003C\u002Fspan>\r\n                  \u003Cspan class=\"org-quick__operator-btn-arrow\">\u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\u003C\u002Fspan>\u003C\u002Fa>\r\n              \u003C\u002Fdiv>\r\n            \u003C\u002Fdiv>\r\n            \u003Cdiv class=\"org-quick__operator-right\">\r\n              \u003Cdiv class=\"org-quick__operator-label card-right-title\">快速开始\u003C\u002Fdiv>\r\n              \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcann-learning-hub\u002Ftree\u002Fmaster\u002Fquick_start\u002Ffirst_custom_operator\" target=\"_blank\" class=\"org-quick__operator-card org-quick__operator-card--primary org-quick__operator-card-1\">\r\n                \u003Cdiv class=\"cannlab-link\">\r\n                  \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_rocket.png?version=1789387680082\" width=\"24\" height=\"24\" alt=\"\" class=\"first-img\" \u002F>\r\n                  \u003Cspan>快速跑通第一个自定义算子\u003C\u002Fspan>\r\n                \u003C\u002Fdiv>\r\n                \u003Cspan class=\"org-quick__operator-card-arrow\">\u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\u003C\u002Fspan>\r\n              \u003C\u002Fa>\r\n              \u003Cdiv class=\"org-quick__operator-label\">进阶探索\u003C\u002Fdiv>\r\n              \u003Cdiv class=\"org-quick__operator-grid\">\r\n                \u003Ca href=\"https:\u002F\u002Fhiascend.com\u002Fdocument\u002Fredirect\u002FCannCommunityOpdevAscendC\" class=\"org-quick__operator-card\" target=\"_blank\" rel=\"noopener noreferrer nofollow\">\r\n                  \u003Cdiv class=\"org-quick__operator-card-icon org-quick__operator-card-icon--doc\">\u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fbanner_4_1.png?version=1789387680082\" width=\"28\" height=\"28\" alt=\"\" \u002F>\u003C\u002Fdiv>\r\n                  \u003Cdiv class=\"org-quick__operator-card-body\">\r\n                    \u003Cdiv class=\"org-quick__operator-card-tag\">文档\u003C\u002Fdiv>\r\n                    \u003Cdiv class=\"org-quick__operator-card-title\" data-tooltip=\"Ascend C 编程指南\">Ascend C 编程指南\u003C\u002Fdiv>\r\n                  \u003C\u002Fdiv>\r\n                  \u003Cspan class=\"org-quick__operator-card-arrow\">\u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\u003C\u002Fspan>\r\n                \u003C\u002Fa>\r\n                \u003Ca href=\"https:\u002F\u002Fhiascend.com\u002Fdocument\u002Fredirect\u002FCannCommunityAscendCApi\" class=\"org-quick__operator-card\" target=\"_blank\" rel=\"noopener noreferrer nofollow\">\r\n                  \u003Cdiv class=\"org-quick__operator-card-icon org-quick__operator-card-icon--api\">\u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fbanner_4_2.png?version=1789387680082\" width=\"28\" height=\"28\" alt=\"\" \u002F>\u003C\u002Fdiv>\r\n                  \u003Cdiv class=\"org-quick__operator-card-body\">\r\n                    \u003Cdiv class=\"org-quick__operator-card-tag\">文档\u003C\u002Fdiv>\r\n                    \u003Cdiv class=\"org-quick__operator-card-title\" data-tooltip=\"Ascend C API 参考\">Ascend C API 参考\u003C\u002Fdiv>\r\n                  \u003C\u002Fdiv>\r\n                  \u003Cspan class=\"org-quick__operator-card-arrow\">\u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\u003C\u002Fspan>\r\n                \u003C\u002Fa>\r\n                \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcann-samples\" class=\"org-quick__operator-card\" target=\"_blank\">\r\n                  \u003Cdiv class=\"org-quick__operator-card-icon org-quick__operator-card-icon--sample\">\u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fbanner_4_3.png?version=1789387680082\" width=\"28\" height=\"28\" alt=\"\" \u002F>\u003C\u002Fdiv>\r\n                  \u003Cdiv class=\"org-quick__operator-card-body\">\r\n                    \u003Cdiv class=\"org-quick__operator-card-tag\">样例\u003C\u002Fdiv>\r\n                    \u003Cdiv class=\"org-quick__operator-card-title\" data-tooltip=\"cann-samples\">cann-samples\u003C\u002Fdiv>\r\n                  \u003C\u002Fdiv>\r\n                  \u003Cspan class=\"org-quick__operator-card-arrow\">\u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\u003C\u002Fspan>\r\n                \u003C\u002Fa>\r\n                \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcann-learning-hub\u002Ftree\u002Fmaster\u002Ftutorials\u002Fascendc_operator_development\" target=\"_blank\" class=\"org-quick__operator-card\">\r\n                  \u003Cdiv class=\"org-quick__operator-card-icon org-quick__operator-card-icon--tutorial\">\u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fbanner_4_4.png?version=1789387680082\" width=\"28\" height=\"28\" alt=\"\" \u002F>\u003C\u002Fdiv>\r\n                  \u003Cdiv class=\"org-quick__operator-card-body\">\r\n                    \u003Cdiv class=\"org-quick__operator-card-tag\">教程\u003C\u002Fdiv>\r\n                    \u003Cdiv class=\"org-quick__operator-card-title\" data-tooltip=\"算子开发系列教程\">算子开发系列教程\u003C\u002Fdiv>\r\n                  \u003C\u002Fdiv>\r\n                  \u003Cspan class=\"org-quick__operator-card-arrow\">\u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\u003C\u002Fspan>\r\n                \u003C\u002Fa>\r\n              \u003C\u002Fdiv>\r\n            \u003C\u002Fdiv>\r\n          \u003C\u002Fdiv>\r\n        \u003C\u002Fdiv>\r\n      \u003C\u002Fdiv>\r\n    \u003C\u002Fdiv>\r\n\r\n    \u003Cdiv class=\"org-quick__indicators\">\r\n      \u003Cspan class=\"org-quick__indicator org-quick__indicator--active\" data-org-quick-indicator=\"0\">\u003C\u002Fspan>\r\n      \u003Cspan class=\"org-quick__indicator\" data-org-quick-indicator=\"1\">\u003C\u002Fspan>\r\n      \u003Cspan class=\"org-quick__indicator\" data-org-quick-indicator=\"2\">\u003C\u002Fspan>\r\n      \u003Cspan class=\"org-quick__indicator\" data-org-quick-indicator=\"3\">\u003C\u002Fspan>\r\n    \u003C\u002Fdiv>\r\n\r\n    \u003Cbutton type=\"button\" class=\"org-quick__nav org-quick__nav--prev\" data-quick-carousel-action=\"prev\" aria-label=\"上一张\">\r\n      \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\r\n    \u003C\u002Fbutton>\r\n    \u003Cbutton type=\"button\" class=\"org-quick__nav org-quick__nav--next\" data-quick-carousel-action=\"next\" aria-label=\"下一张\">\r\n      \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\r\n    \u003C\u002Fbutton>\r\n  \u003C\u002Fdiv>\r\n\u003C\u002Fsection>\n\n      \u003Csection class=\"org-liquid-page__section org-liquid-page__growth-section\">\n        \u003Cdiv class=\"org-liquid-page__h2 org-liquid-page__h2--light\">开发与成长\u003C\u002Fdiv>\n        \u003Cdiv class=\"org-liquid-page__growth-grid\">\n          \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcann-learning-hub\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__growth-card org-liquid-page__growth-card-bg\">\n            \u003Cdiv class=\"org-liquid-page__growth-card-title\">CANN-Learning-hub\u003C\u002Fdiv>\n            \u003Cp class=\"org-liquid-page__growth-card-desc\">CANN学习中心仓，支持在线互动运行、边学边练、提供教程、示例与优化方案，覆盖从入门到进阶的全栈学习资源。\u003C\u002Fp>\n          \u003C\u002Fa>\n          \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcann-samples\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__growth-card\">\n            \u003Cdiv class=\"org-liquid-page__growth-card-title\">CANN-Samples\u003C\u002Fdiv>\n            \u003Cp class=\"org-liquid-page__growth-card-desc\">CANN官方示例代码库，覆盖算子开发、模型推理、训练等典型场景，可直接编译运行，开箱即用上手CANN\u003C\u002Fp>\n          \u003C\u002Fa>\n          \u003Ca href=\"https:\u002F\u002Fcannjudge.cn\u002F\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" class=\"org-liquid-page__growth-card\">\n            \u003Cdiv class=\"org-liquid-page__growth-card-title\">\n              CANNJudge\n              \u003Cimg class=\"org-liquid-page__growth-ext-icon\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_export.png?version=1789387680082\" width=\"16\" height=\"16\" \u002F>\n            \u003C\u002Fdiv>\n            \u003Cp class=\"org-liquid-page__growth-card-desc\">边学边练，快速成长。在线挑战榜单，刷题积分赢取算力卡券，对接外部评测平台，与全球开发者同台竞技。\u003C\u002Fp>\n          \u003C\u002Fa>\n          \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Forg\u002Fcann\u002Fcannlab\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__growth-card\">\n            \u003Cdiv class=\"org-liquid-page__growth-card-title\">CANNLab\u003C\u002Fdiv>\n            \u003Cp class=\"org-liquid-page__growth-card-desc\">CANNLab为CANN社区开发者提供\"免费、在线、开箱即用\"的云端开发平台，支持开发者基于社区进行包括Ascend C\u002FPyPTO\u002FPyASC各类型算子开发、模型部署验证和性能调优等活动。\u003C\u002Fp>\n          \u003C\u002Fa>\n          \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcannbot-skills\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__growth-card\">\n            \u003Cdiv class=\"org-liquid-page__growth-card-title\">CANNBot\u003C\u002Fdiv>\n            \u003Cp class=\"org-liquid-page__growth-card-desc\">CANNBot是CANN 社区为开发者提供的\"多智能体、端到端、自动化\"智能助手，支持代码自动生成，具备自主排障、闭环修复、端到端调优能力，有效降低开发者门槛。\u003C\u002Fp>\n          \u003C\u002Fa>\n          \u003Ca href=\"https:\u002F\u002Fcannbench.com\u002F\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" class=\"org-liquid-page__growth-card\">\n            \u003Cdiv class=\"org-liquid-page__growth-card-title\">CANNBench\u003C\u002Fdiv>\n            \u003Cp class=\"org-liquid-page__growth-card-desc\">CANNBench是CANN 社区提供的昇腾算子AI生成能力的公开评测平台，提供覆盖\"标准评测任务 - 评测框架 - Leaderboard榜单\"的全流程基准测试体系。\u003C\u002Fp>\n          \u003C\u002Fa>\n        \u003C\u002Fdiv>\n      \u003C\u002Fsection>\n\n      \u003Csection class=\"org-liquid-page__section org-liquid-page__recipes-section\" id=\"recipes-container\">\n  \u003Cdiv class=\"org-liquid-page__h2 org-liquid-page__h2--light\">模型实践\u003C\u002Fdiv>\n\n  \n\u003C\u002Fsection>\n\n      \u003Csection class=\"org-liquid-page__section org-liquid-page__core-section\">\n        \u003Cdiv class=\"org-liquid-page__h2 org-liquid-page__h2--light\">核心组件\u003C\u002Fdiv>\n        \u003Cdiv class=\"org-liquid-page__arch-diagram\">\n          \u003Cdiv class=\"org-liquid-page__arch-layer org-liquid-page__arch-layer--top\">AI框架\u003C\u002Fdiv>\n          \u003Cdiv class=\"org-liquid-page__arch-layer org-liquid-page__arch-layer--adapter\">AI框架适配 Framework Adapter\u003C\u002Fdiv>\n          \u003Cdiv class=\"org-liquid-page__arch-body\">\n            \u003Cdiv class=\"org-liquid-page__arch-content\">\n              \u003Cdiv class=\"org-liquid-page__arch-main\">\n                \u003Cdiv class=\"org-liquid-page__arch-row\">\n                  \u003Cdiv class=\"org-liquid-page__arch-label\">加速库\u003C\u002Fdiv>\n                  \u003Cdiv class=\"org-liquid-page__arch-group\">\n                    \u003Cdiv class=\"org-liquid-page__arch-col\">\n                      \u003Ca href=\"https:\u002F\u002Fai.gitcode.com\u002Fcollections\u002Fcann\u002F2004097926814294017\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__arch-col-head\">算子库\u003Cimg class=\"org-liquid-page__arch-info\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_info.svg?version=1789387680082\" width=\"13\" height=\"13\" alt=\"\" data-tooltip=\"提供了丰富的深度优化、硬件亲和的高性能算子，为神经网络在昇腾硬件上加速计算提供基础。\" \u002F>\u003C\u002Fa>\n                        \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fops-nn\" class=\"org-liquid-page__arch-link\">ops-nn\u003C\u002Fa>\n                        \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fops-math\" class=\"org-liquid-page__arch-link\">ops-math\u003C\u002Fa>\n                        \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fops-transformer\" class=\"org-liquid-page__arch-link\">ops-transformer\u003C\u002Fa>\n                        \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fops-cv\" class=\"org-liquid-page__arch-link\">ops-cv\u003C\u002Fa>\n                      \u003C\u002Fdiv>\n                    \u003Cdiv class=\"org-liquid-page__arch-col org-core-card-1\">\n                      \u003Ca href=\"https:\u002F\u002Fai.gitcode.com\u002Fcollections\u002Fcann\u002F2004102826775773185\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__arch-col-head\">通信库\u003Cimg class=\"org-liquid-page__arch-info\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_info.svg?version=1789387680082\" width=\"13\" height=\"13\" alt=\"\" data-tooltip=\"基于昇腾硬件的高性能通信库，提供单机多卡及多机多卡间的数据并行、模型并行通信方案。\" \u002F>\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fhixl\" class=\"org-liquid-page__arch-link\">hixl\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fshmem\" class=\"org-liquid-page__arch-link\">shmem\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fhccl\" class=\"org-liquid-page__arch-link\">hccl\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fhcomm\" class=\"org-liquid-page__arch-link\">hcomm\u003C\u002Fa>\n                    \u003C\u002Fdiv>\n                    \u003Cdiv class=\"org-liquid-page__arch-col\">\n                      \u003Ca href=\"https:\u002F\u002Fai.gitcode.com\u002Fcollections\u002Fcann\u002F2004105238387326977\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__arch-col-head\">领域加速库\u003Cimg class=\"org-liquid-page__arch-info\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_info.svg?version=1789387680082\" width=\"13\" height=\"13\" alt=\"\" data-tooltip=\"针对特定领域或场景的算子和算法的结合。\" \u002F>\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fsip\" class=\"org-liquid-page__arch-link\">sip\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fops-collections\" class=\"org-liquid-page__arch-link\">ops-collections\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fops-fft\" class=\"org-liquid-page__arch-link\">ops-fft\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fops-gnn\" class=\"org-liquid-page__arch-link\">ops-gnn\u003C\u002Fa>\n                    \u003C\u002Fdiv>\n                    \u003Cdiv class=\"org-liquid-page__arch-col\">\n                      \u003Ca href=\"https:\u002F\u002Fai.gitcode.com\u002Fcollections\u002Fcann\u002F2004103670073765889\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__arch-col-head\">图引擎\u003Cimg class=\"org-liquid-page__arch-info\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_info.svg?version=1789387680082\" width=\"13\" height=\"13\" alt=\"\" data-tooltip=\"面向昇腾的图编译器和执行器，提供图优化、多流并行、内存复用和模型下沉等功能。\" \u002F>\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fge\" class=\"org-liquid-page__arch-link\">ge\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fmetadef\" class=\"org-liquid-page__arch-link\">metadef\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fgraph-autofusion\" class=\"org-liquid-page__arch-link\">graph-autofusion\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Ftriton-inference-server-ge-backend\" class=\"org-liquid-page__arch-link\">triton-inference-server-ge-backend\u003C\u002Fa>\n                    \u003C\u002Fdiv>\n                  \u003C\u002Fdiv>\n                \u003C\u002Fdiv>\n                \u003Cdiv class=\"org-liquid-page__arch-row\">\n                  \u003Cdiv class=\"org-liquid-page__arch-label\">编程与\u003Cbr \u002F>编译\u003C\u002Fdiv>\n                  \u003Cdiv class=\"org-liquid-page__arch-full-row\">\n                    \u003Cdiv class=\"org-liquid-page__arch-inline-group\">\n                      \u003Ca href=\"https:\u002F\u002Fai.gitcode.com\u002Fcollections\u002Fcann\u002F2004103843625676802\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__arch-inline-label\">算子编程\u003Cimg class=\"org-liquid-page__arch-info\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_info.svg?version=1789387680082\" width=\"13\" height=\"13\" alt=\"\" data-tooltip=\"基于Ascend C编程语言开放的芯片完备编程能力以及提供的多层级编程API，面向异构AI处理器，让开发者高效实现高性能自定义算子。\" \u002F>\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fasc-devkit\" class=\"org-liquid-page__arch-link\">asc-devkit\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fpyasc\" class=\"org-liquid-page__arch-link\">pyasc\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fpypto\" class=\"org-liquid-page__arch-link\">pypto\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fpto-isa\" class=\"org-liquid-page__arch-link\">pto-isa\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fatvoss\" class=\"org-liquid-page__arch-link\">atvoss\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcatlass\" class=\"org-liquid-page__arch-link\">catlass\u003C\u002Fa>\n                    \u003C\u002Fdiv>\n                    \u003Cdiv class=\"org-liquid-page__arch-sub-item\">毕昇编译器\u003C\u002Fdiv>\n                  \u003C\u002Fdiv>\n                \u003C\u002Fdiv>\n                \u003Cdiv class=\"org-liquid-page__arch-row\">\n                  \u003Cdiv class=\"org-liquid-page__arch-label\">运行时与\u003Cbr \u002F>驱动\u003C\u002Fdiv>\n                  \u003Cdiv class=\"org-liquid-page__arch-full-row\">\n                    \u003Cdiv class=\"org-liquid-page__arch-inline-group\">\n                      \u003Ca href=\"https:\u002F\u002Fai.gitcode.com\u002Fcollections\u002Fcann\u002F2004104174527283202\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__arch-inline-label\">运行时\u003Cimg class=\"org-liquid-page__arch-info\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_info.svg?version=1789387680082\" width=\"13\" height=\"13\" alt=\"\" data-tooltip=\"提供了高效的硬件资源管理、媒体数据预处理、单算子加载执行、模型推理等开发接口，供开发者轻松构建高性能人工智能应用。\" \u002F>\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fruntime\" class=\"org-liquid-page__arch-link\">runtime\u003C\u002Fa>\n                    \u003C\u002Fdiv>\n                    \u003Cdiv class=\"org-liquid-page__arch-inline-group\">\n                      \u003Ca href=\"https:\u002F\u002Fai.gitcode.com\u002Fcollections\u002Fcann\u002F2004104385663971329\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__arch-inline-label\">驱动\u003Cimg class=\"org-liquid-page__arch-info\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_info.svg?version=1789387680082\" width=\"13\" height=\"13\" alt=\"\" data-tooltip=\"提供了基础驱动、设备管理、资源管理及调度、通信能力等功能，使能昇腾芯片，充分发挥硬件能力，支撑CANN上层软件高效稳定运行。\" \u002F>\u003C\u002Fa>\n                      \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fdriver\" class=\"org-liquid-page__arch-link\">driver\u003C\u002Fa>\n                    \u003C\u002Fdiv>\n                  \u003C\u002Fdiv>\n                \u003C\u002Fdiv>\n              \u003C\u002Fdiv>\n            \u003C\u002Fdiv>\n            \u003Cdiv class=\"org-liquid-page__arch-tools\">\n              \u003Cdiv class=\"org-liquid-page__arch-tool-col\">\n                \u003Ca href=\"https:\u002F\u002Fai.gitcode.com\u002Fcollections\u002Fcann\u002F2004105624812748802\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__arch-col-head\">工具\u003Cimg class=\"org-liquid-page__arch-info\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_info.svg?version=1789387680082\" width=\"13\" height=\"13\" alt=\"\" data-tooltip=\"提供CANN平台的各种工具，如算子调试调优工具、故障定位、模型压缩等。\" \u002F>\u003C\u002Fa>\n                \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fasc-tools\" class=\"org-liquid-page__arch-link\">asc-tools\u003C\u002Fa>\n                \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Foam-tools\" class=\"org-liquid-page__arch-link\">oam-tools\u003C\u002Fa>\n                \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Famct\" class=\"org-liquid-page__arch-link\">amct\u003C\u002Fa>\n              \u003C\u002Fdiv>\n            \u003C\u002Fdiv>\n          \u003C\u002Fdiv>\n          \u003Cdiv class=\"org-liquid-page__arch-layer org-liquid-page__arch-layer--bottom\">昇腾AI处理器\u003C\u002Fdiv>\n        \u003C\u002Fdiv>\n      \u003C\u002Fsection>\n\n      \u003Csection class=\"org-liquid-page__section org-liquid-page__about-section\">\r\n        \u003Cdiv class=\"org-liquid-page__h2\">关于社区\u003C\u002Fdiv>\r\n        \u003Cdiv class=\"org-liquid-page__about-wrap\">\r\n    \u003Cdiv class=\"org-liquid-page__governance-header\">\r\n      \u003Ch3 class=\"sqgx_title\">社区治理架构及章程\u003C\u002Fh3>\r\n      \u003Cp class=\"org-liquid-page__governance-more\">\r\n        \u003Cspan class=\"org-liquid-page__governance-more-desktop\">更多社区治理内容，详见：\u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcommunity\u002Fblob\u002Fmaster\u002FREADME.md#%E7%A4%BE%E5%8C%BA%E6%B2%BB%E7%90%86%E7%AB%A0%E7%A8%8B\" target=\"_blank\" rel=\"noopener\">社区治理章程\u003C\u002Fa>\u003C\u002Fspan>\r\n        \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcommunity\u002Fblob\u002Fmaster\u002FREADME.md#%E7%A4%BE%E5%8C%BA%E6%B2%BB%E7%90%86%E7%AB%A0%E7%A8%8B\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__governance-more-mobile\">查看更多 \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\u003C\u002Fa>\r\n      \u003C\u002Fp>\r\n    \u003C\u002Fdiv>\r\n\r\n    \u003Cp class=\"org-liquid-page__governance-desc\">CANN社区采用分层协作的治理模式，当前架构主要包括以下组织：\u003C\u002Fp>\r\n\r\n    \u003Cdiv class=\"org-liquid-page__governance-grid\">\r\n      \u003Cdiv class=\"org-liquid-page__governance-card\">\r\n        \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ftext_tsc.png?version=1789387680082\" width=\"48\" height=\"48\" class=\"org-liquid-page__governance-img\" data-governance=\"tsc\" \u002F>\r\n        \u003Cdiv class=\"org-liquid-page__governance-info\">\r\n          \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcommunity\u002Fblob\u002Fmaster\u002FCANN\u002FTSC\u002FREADME.md\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"org-liquid-page__governance-name\">技术指导委员会\u003C\u002Fa>\r\n          \u003Cp class=\"org-liquid-page__governance-subtitle\">Technical Steering Committee\u003C\u002Fp>\r\n        \u003C\u002Fdiv>\r\n      \u003C\u002Fdiv>\r\n\r\n      \u003Cdiv class=\"org-liquid-page__governance-card\">\r\n        \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ftext_pmc.png?version=1789387680082\" width=\"48\" height=\"48\" class=\"org-liquid-page__governance-img\" data-governance=\"pmc\" \u002F>\r\n        \u003Cdiv class=\"org-liquid-page__governance-info\">\r\n          \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcommunity\u002Fblob\u002Fmaster\u002FCANN\u002FPMC\u002FREADME.md\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"org-liquid-page__governance-name\">项目管理委员会\u003C\u002Fa>\r\n          \u003Cp class=\"org-liquid-page__governance-subtitle\">Project Management Committee\u003C\u002Fp>\r\n        \u003C\u002Fdiv>\r\n      \u003C\u002Fdiv>\r\n\r\n      \u003Cdiv class=\"org-liquid-page__governance-card\">\r\n        \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ftext_sig.png?version=1789387680082\" width=\"48\" height=\"48\" class=\"org-liquid-page__governance-img\" data-governance=\"sig\" \u002F>\r\n        \u003Cdiv class=\"org-liquid-page__governance-info\">\r\n          \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcommunity\u002Fblob\u002Fmaster\u002FCANN\u002Fsigs\u002FREADME.md\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"org-liquid-page__governance-name\">特别兴趣小组\u003C\u002Fa>\r\n          \u003Cp class=\"org-liquid-page__governance-subtitle\">Special Interest Group\u003C\u002Fp>\r\n        \u003C\u002Fdiv>\r\n      \u003C\u002Fdiv>\r\n    \u003C\u002Fdiv>\r\n  \u003C\u002Fdiv>\r\n        \u003Cdiv class=\"org-liquid-page__about-wrap\">\r\n          \u003Cdiv class=\"sqgx_title\">成为社区贡献者\u003C\u002Fdiv>\r\n          \u003Cdiv class=\"org-liquid-page__about-grid\">\r\n             \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcommunity#基础贡献\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"org-liquid-page__about-card org-liquid-page__about-card--basic\">\r\n            \u003Cdiv class=\"org-liquid-page__about-card-inner\">\r\n              \u003Cdiv class=\"org-liquid-page__about-icon\">\r\n                 \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_basic.png?version=1789387680082\" width=\"40\" height=\"40\" class=\"org-liquid-page__about-icon-img\" \u002F>\r\n              \u003C\u002Fdiv>\r\n              \u003Cdiv class=\"org-liquid-page__about-content\">\r\n                \u003Ch3 class=\"org-liquid-page__about-card-title\">基础贡献\u003C\u002Fh3>\r\n                \u003Cp class=\"org-liquid-page__about-card-text\">包含参与社区会议、社区邮件讨论、提交Issue、处理Issue任务提交PR等\u003C\u002Fp>\r\n              \u003C\u002Fdiv>\r\n              \u003Cdiv class=\"org-liquid-page__about-arrow\">\r\n                \u003Cspan>基础贡献\u003C\u002Fspan>\r\n                \u003Cimg class=\"org-icon-right\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\r\n              \u003C\u002Fdiv>\r\n            \u003C\u002Fdiv>\r\n          \u003C\u002Fa>\r\n\r\n          \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcommunity#进阶贡献\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"org-liquid-page__about-card org-liquid-page__about-card--advanced\">\r\n            \u003Cdiv class=\"org-liquid-page__about-card-inner\">\r\n              \u003Cdiv class=\"org-liquid-page__about-icon org-liquid-page__about-icon--advanced\">\r\n               \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_advanced.png?version=1789387680082\" width=\"40\" height=\"40\" class=\"org-liquid-page__about-icon-img org-liquid-page__about-icon-img--advanced\" \u002F>\r\n              \u003C\u002Fdiv>\r\n              \u003Cdiv class=\"org-liquid-page__about-content\">\r\n                \u003Ch3 class=\"org-liquid-page__about-card-title\">进阶贡献\u003C\u002Fh3>\r\n                \u003Cp class=\"org-liquid-page__about-card-text\">包含新建SIG、成为核心贡献者、组织会议、新建仓库、引入开源软件、发布新版本或新仓库等\u003C\u002Fp>\r\n              \u003C\u002Fdiv>\r\n              \u003Cdiv class=\"org-liquid-page__about-arrow\">\r\n                \u003Cspan>进阶贡献\u003C\u002Fspan>\r\n                \u003Cimg class=\"org-icon-right\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\r\n              \u003C\u002Fdiv>\r\n            \u003C\u002Fdiv>\r\n          \u003C\u002Fa>\r\n          \u003C\u002Fdiv>\r\n         \r\n        \u003C\u002Fdiv>\r\n      \u003C\u002Fsection>\n\n      \u003Csection class=\"org-liquid-page__section org-liquid-page__honor-section\">\n  \u003Cdiv class=\"org-liquid-page__honor-title\">\u003C\u002Fdiv>\n  \u003Cdiv class=\"org-liquid-page__honor-cup\">\u003C\u002Fdiv>\n  \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcann-ops-competitions\u002Ftree\u002Fmaster\u002F05_honor\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__honor-btn\">\n    \u003Cdiv class=\"org-liquid-page__honor-btn-text\">查看更多\u003C\u002Fdiv>\n    \u003Cimg class=\"org-liquid-page__honor-btn-icon\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fhonour_icon.svg?version=1789387680082\" alt=\"\" \u002F>\n  \u003C\u002Fa>\n  \u003Ca href=\"https:\u002F\u002Fgitcode.com\u002Fcann\u002Fcann-ops-competitions\u002Ftree\u002Fmaster\u002F05_honor\" target=\"_blank\" rel=\"noopener\" class=\"org-liquid-page__honor-card-link\">\u003C\u002Fa>\n\u003C\u002Fsection>\n\n      \u003Csection class=\"org-liquid-page__section org-liquid-page__contact-section\">\n  \u003Cdiv class=\"org-liquid-page__h2 org-liquid-page__h2--light\">联系我们\u003C\u002Fdiv>\n  \u003Cdiv class=\"org-liquid-page__contact-body\">\n    \u003Cdiv class=\"org-liquid-page__contact-subscribe\">\n      \u003Cdiv class=\"org-liquid-page__subscribe-title\">社区邮件订阅\u003C\u002Fdiv>\n      \u003Cdiv class=\"org-liquid-page__contact-email\">\n        \u003Cspan class=\"org-liquid-page__subscribe-desc\">选择需要订阅的组织（TSC \u002F PMC \u002F SIG 等），填写相关信息进行\u003Ca href=\"https:\u002F\u002Flink.gitcode.com\u002F?target=https%3A%2F%2Fmailweb.cann.osinfra.cn%2Fmailman3%2Flists&amp;from=https%3A%2F%2Fgitcode.com%2Fcann&amp;lang=zh&amp;theme=white\" class=\"org-liquid-page__subscribe-link\">邮件订阅\u003C\u002Fa>。\u003C\u002Fspan>\n        \u003Cdiv class=\"org-liquid-page__subscribe-email\">\n          \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_email.png?version=1789387680082\" width=\"15\" height=\"15\" class=\"org-liquid-page__icon-email\" \u002F>\n          联系邮箱：\u003Cspan>cann@cann.team\u003C\u002Fspan>\n        \u003C\u002Fdiv>\n      \u003C\u002Fdiv>\n    \u003C\u002Fdiv>\n    \u003Cdiv class=\"org-liquid-page__contact-media\">\n      \u003Cdiv class=\"org-liquid-page__media-title\">昇腾 CANN 社交媒体\u003C\u002Fdiv>\n      \u003Cdiv class=\"org-liquid-page__media-grid\">\n        \u003Cdiv class=\"org-liquid-page__media-card\">\n          \u003Cdiv class=\"org-liquid-page__media-card-head\">\n            \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_bilibili.png?version=1789387680082\" width=\"24\" height=\"24\" \u002F>\n            \u003Cspan class=\"docs_link\">\n              \u003Ca href=\"https:\u002F\u002Flink.gitcode.com\u002F?target=https%3A%2F%2Fspace.bilibili.com%2F1190614918%3Fspm_id_from%3D333.337.0.0&amp;from=https%3A%2F%2Fgitcode.com%2Fcann&amp;lang=zh&amp;theme=white\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">bilibili\u003C\u002Fa>\n              \u003Cimg class=\"org-icon-right\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\n            \u003C\u002Fspan>\n          \u003C\u002Fdiv>\n          \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fdocs_images_bilibili.png?version=1789387680082\" width=\"132\" height=\"132\" class=\"org-liquid-page__media-qr\" loading=\"lazy\" \u002F>\n        \u003C\u002Fdiv>\n        \u003Cdiv class=\"org-liquid-page__media-card org-liquid-page__media-card--static\">\n          \u003Cdiv class=\"org-liquid-page__media-card-head\">\n            \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_wechat.png?version=1789387680082\" width=\"24\" height=\"24\" \u002F>\n            \u003Cspan>微信公众号\u003C\u002Fspan>\n          \u003C\u002Fdiv>\n          \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fdocs_images_wechat.png?version=1789387680082\" width=\"132\" height=\"132\" class=\"org-liquid-page__media-qr\" loading=\"lazy\" \u002F>\n        \u003C\u002Fdiv>\n        \u003Cdiv class=\"org-liquid-page__media-card\">\n          \u003Cdiv class=\"org-liquid-page__media-card-head\">\n            \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_zhihu.png?version=1789387680082\" width=\"24\" height=\"24\" \u002F>\n            \u003Cspan class=\"docs_link\">\n              \u003Ca href=\"https:\u002F\u002Flink.gitcode.com\u002F?target=https%3A%2F%2Fwww.zhihu.com%2Fpeople%2Fha-ha-ha-ha-51-33-24&amp;from=https%3A%2F%2Fgitcode.com%2Fcann&amp;lang=zh&amp;theme=white\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">知乎\u003C\u002Fa>\n              \u003Cimg class=\"org-icon-right\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\n            \u003C\u002Fspan>\n          \u003C\u002Fdiv>\n          \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fdocs_images_zhihu.png?version=1789387680082\" width=\"132\" height=\"132\" class=\"org-liquid-page__media-qr\" loading=\"lazy\" \u002F>\n        \u003C\u002Fdiv>\n        \u003Cdiv class=\"org-liquid-page__media-card\">\n          \u003Cdiv class=\"org-liquid-page__media-card-head\">\n            \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_csdn.png?version=1789387680082\" width=\"24\" height=\"24\" \u002F>\n            \u003Cspan class=\"docs_link\">\n              \u003Ca href=\"https:\u002F\u002Fblog.csdn.net\u002Fm0_71340392\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">CSDN\u003C\u002Fa>\n              \u003Cimg class=\"org-icon-right\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\n            \u003C\u002Fspan>\n          \u003C\u002Fdiv>\n          \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Fdocs_images_csdn.png?version=1789387680082\" width=\"132\" height=\"132\" class=\"org-liquid-page__media-qr\" loading=\"lazy\" \u002F>\n        \u003C\u002Fdiv>\n      \u003C\u002Fdiv>\n    \u003C\u002Fdiv>\n    \u003Cdiv class=\"org-liquid-page__contact-links\">\n      \u003Cdiv class=\"org-liquid-page__links-title\">相关链接\u003C\u002Fdiv>\n      \u003Cdiv class=\"org-liquid-page__links-grid\">\n        \u003Ca href=\"https:\u002F\u002Fwww.hiascend.com\u002Fcann\" rel=\"noopener noreferrer nofollow\" target=\"_blank\" class=\"org-liquid-page__link-item\">\n          \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Flogo_ascend.png?version=1789387680082\" width=\"63\" height=\"24\" class=\"org-liquid-page__logo-ascend\" \u002F>\n          \u003Cspan class=\"org-liquid-page__link-sub\">昇腾社区\u003C\u002Fspan>\n          \u003Cimg class=\"org-icon-right\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\n        \u003C\u002Fa>\n        \u003Ca href=\"https:\u002F\u002Fdeveloper.huawei.com\u002Fconsumer\u002Fcn\u002Fsdk\u002Fcann-kit\u002F\" rel=\"noopener noreferrer nofollow\" target=\"_blank\" class=\"org-liquid-page__link-item\">\n          \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Flogo_harmonyos.png?version=1789387680082\" width=\"87\" height=\"24\" class=\"org-liquid-page__logo-harmonyos\" \u002F>\n          \u003Cspan class=\"org-liquid-page__link-sub\">鸿蒙社区\u003C\u002Fspan>\n          \u003Cimg class=\"org-icon-right\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\n        \u003C\u002Fa>\n        \u003Ca href=\"https:\u002F\u002Fgithub.com\u002Ftile-ai\u002Ftilelang-ascend\u002Ftree\u002Fascendc_pto\" rel=\"noopener noreferrer nofollow\" target=\"_blank\" class=\"org-liquid-page__link-item\">\n          \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Flogo_tilelang.png?version=1789387680082\" width=\"20\" height=\"20\" \u002F>\n          \u003Cspan class=\"org-liquid-page__link-sub\">TileLang\u003C\u002Fspan>\n          \u003Cimg class=\"org-icon-right\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\n        \u003C\u002Fa>\n        \u003Ca href=\"https:\u002F\u002Fwww.hiascend.com\u002Fcn\u002Fdeveloper\u002Fsoftware\u002Fai-frameworks\u002Fpytorch\" rel=\"noopener noreferrer nofollow\" target=\"_blank\" class=\"org-liquid-page__link-item\">\n          \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Flogo_pytorch.png?version=1789387680082\" width=\"14\" height=\"17\" \u002F>\n          \u003Cspan class=\"org-liquid-page__link-sub\">PyTorch\u003C\u002Fspan>\n          \u003Cimg class=\"org-icon-right\" src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Ficon_right.svg?version=1789387680082\" alt=\"\" \u002F>\n        \u003C\u002Fa>\n        \u003Ca href=\"https:\u002F\u002Fgithub.com\u002Fvllm-project\u002Fvllm\" rel=\"noopener noreferrer nofollow\" target=\"_blank\" class=\"org-liquid-page__link-item\">\n          \u003Cimg src=\"https:\u002F\u002Fcdn-img.gitcode.com\u002Fcustom-homepage\u002F5162848\u002Fimages\u002Flogo_vll