}
#page .announcement-panel p.summary {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}
#page .announcement-panel .secondary-cta {
  margin-top: auto;
}
/*GC IN THE NEWS */
#page .gc-news {
