}
#page .three-panel div.grid-item h3 {
  font-size: 1.2em;
  font-family: "Graphik-Medium", sans-serif;
  line-height: 1.3;
  color: #292c31;
  margin: 0.5rem 0;
}
#page .three-panel div.grid-item p, #page .announcement-panel p.summary {
  font-size: 0.8em;
