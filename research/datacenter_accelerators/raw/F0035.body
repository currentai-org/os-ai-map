/*   HERO IMAGE ANIMATION  */
@keyframes orbit {
  0% {
    -webkit-transform: translateZ(0) rotate(0deg);
    -ms-transform: translateZ(0) rotate(0deg);
    transform: translateZ(0) rotate(0deg);
  }
  100% {
    -webkit-transform: translateZ(0) rotate(359.99deg);
    -ms-transform: translateZ(0) rotate(359.99deg);
    transform: translateZ(0) rotate(359.99deg);
  }
}
/* ARROW DOWN ANIMATION */
@keyframes bobbing {
  0% {
    -webkit-transform: translate3d(-50%,-50%, 0);
    -ms-transform: translate3d(-50%,-50%, 0);
    transform: translate3d(-50%,-50%, 0);
  }
  50% {
    -webkit-transform: translate3d(-50%,-38%, 0);
    -ms-transform: translate3d(-50%,-38%, 0);
    transform: translate3d(-50%,-38%, 0);
  }
  100% {
    -webkit-transform: translate3d(-50%,-50%, 0);
    -ms-transform: translate3d(-50%,-50%, 0);
    transform: translate3d(-50%,-50%, 0);
  }
}
@keyframes bobbingRight {
  0% {
    -webkit-transform: translate3d(-50%,-50%, 0);
    -ms-transform: translate3d(-50%,-50%, 0);
    transform: translate3d(-50%,-50%, 0);
  }
  50% {
    -webkit-transform: translate3d(-38%, -50%, 0);
    -ms-transform: translate3d(-38%, -50%, 0);
    transform: translate3d(-38%, -50%, 0);
  }
  100% {
    -webkit-transform: translate3d(-50%,-50%, 0);
    -ms-transform: translate3d(-50%,-50%, 0);
    transform: translate3d(-50%,-50%, 0);
  }
}
@keyframes bobbingLeft {
  0% {
    -webkit-transform: translate3d(-50%,-50%, 0);
    -ms-transform: translate3d(-50%,-50%, 0);
    transform: translate3d(-50%,-50%, 0);
  }
  50% {
    -webkit-transform: translate3d(-62%, -50%, 0);
    -ms-transform: translate3d(-62%, -50%, 0);
    transform: translate3d(-62%, -50%, 0);
  }
  100% {
    -webkit-transform: translate3d(-50%,-50%, 0);
    -ms-transform: translate3d(-50%,-50%, 0);
    transform: translate3d(-50%,-50%, 0);
  }
}
</style>


