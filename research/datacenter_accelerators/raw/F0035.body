}
  #page .three-panel div.grid-item {
  padding: 0;
}
/* CUSTOMER CAROUSEL CSS */
#page.homepage_page section.homepage-carousel.careers_page-v2 .gr-testimonials-cards {
  padding-top: 2em;
  padding-bottom: 2em;
}
  #page div.performance {
    text-align: center;
    background: #fff;
}
#page #hs_cos_wrapper_module_16348284168217 > div.chart-container.single-chart {
    max-width: 1200px;
  }
#page .featured > h2 {
 margin-bottom: 20px;
font-size: 1.6em;
    font-family: 'Caslons Egyptian Pentagram Reg', sans-serif;
}
#page div.performance h2.featured.benchmark_title {
 font-size: 1.2em;
 line-height: 1.4;
 -webkit-font-feature-settings: "calt" 0, "liga";
 font-feature-settings: "calt" 0, "liga";
 font-family: "Caslons Egyptian Pentagram Reg", sans-serif;
}
#page div.performance p {
 color: #333;
 margin: 0 auto 30px;
}
#page div.performance div.benchmarks-container {
 display: flex;
 justify-content: space-between;
 align-items: stretch;
 margin-top:3em;
}
#page summary {
    display: list-item;
}
 	/*HIDE CAROUSEL WHEN LOADING*/
.slide { display: none; }
.slide.slick-initialized { display: block; }
.loader-square-container {
    width: 160px;
    height: 160px;
    margin: auto;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    transform: scale(.7);
    background: #fff;
    z-index: 500;
}
.loader-square-container:before {
    content: '';
    background: #ff6f79;
    width: 40px;
    height: 40px;
    left: -40px;
    top: 0;
    position: absolute;
    animation: 4s infinite alternate slideShrink;
    }
.loader-square:nth-child(1), .loader-square-container:before, .loader-.circle {
    animation-delay: -0.75s;
}
.loader-square {
    background: #ff6f79;
    width: 80px;
    height: 80px;
    left: 0;
    bottom: 80px;
    position: absolute;
    transform: translate3d(0,0,0);
    animation: 4s infinite alternate loadingAnimation;
}
.loader-circle {
    background: #fbe8aa;
    width: 70px;
    height: 70px;
    right: 0;
    bottom: -5px;
    position: absolute;
    border-radius: 50%;
    animation: 4s infinite alternate shrink;
}
.loader-poly {
    height: 115px;
    width: 115px;
    position: absolute;
    bottom: -58px;
    left: -50px;
    animation: 6s infinite linear roundAround;
}
.loader-poly > path {
    fill: #d9d9d9;
}
  .slick-initialized div.loader-square-container {
    display: none;
}
@keyframes loadingAnimation {
  0% {
    left: 0;
    bottom: 80px;
  }
  20% {
    left: 0;
    bottom: 80px;
  }
  40% {
    left: 80px;
    bottom: 80px;
  }
  60% {
    left: 80px;
    bottom: 80px;
  }
  80% {
    left: 80px;
    bottom: 0px;
  }
  100% {
    left: 80px;
    bottom: 0px;
  }
}
@keyframes roundAround {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(359deg);
  }
}
@keyframes slideShrink {
  0% { width: 40px; }
  20% { width: 40px; }
  40% { width: 0px; }
  100% { width: 0px; }
}
@keyframes shrink {
  0% { transform: scale(1); }
  20% { transform: scale(1); }
  40% { transform: scale(0); }
  100% { transform: scale(0); }
}
/*END CAROUSEL*/
/* ANNOUNCEMENT GRID */
#page .announcement-grid {
  display: flex;
  justify-content: center;
  align-items: stretch;
  flex-wrap: wrap;
}
#page article.announcement-panel {
  width: 40%;
  margin: 10px;
  background: #faf8f9;
  padding: 20px 25px 20px;
  display: inline-flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-start;
  transition: transform .3s, background .3s;
}
#page article.announcement-panel small.date {
  font-family: "Graphik-Medium",sans-serif;
  color: rgba(16, 30, 36, 0.4);
  width:100%;
}
  #page article.announcement-panel:hover a.secondary-cta:after {
    transform: translateX(8px);
}
  #page article.announcement-panel a.secondary-cta {
