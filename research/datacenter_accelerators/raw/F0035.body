  /*   SECTION SPACER */
  #page section.spacer {
    padding: 9em 0;
    position: relative;
    margin-bottom: 0;
  }
  #page section#firstblock {
    padding-bottom: 2.5em;
  }
  #page section.spacer.blue::before {
    content: url(https://www.graphcore.ai/hubfs/assets/images/blue%20spacer-right-01.svg);
    display: block;
    margin: auto;
    width: 44%;
    position: absolute;
    top: -3%;
    right: 0;
  }
  #page section.spacer.blue::after {
    content: url(https://www.graphcore.ai/hubfs/assets/images/blue%20spacer-left.svg);
    display: block;
    margin: auto;
    width: 34%;
    position: absolute;
    top: 0;
    left: 0;
}
    #page section.spacer.yellow::before {
    content: url(https://www.graphcore.ai/hubfs/assets/images/icons/yellow-right.svg);
    display: block;
    margin: auto;
    width: 44%;
    position: absolute;
    top: -3%;
    right: 0;
  }
#page section.spacer.yellow::after {
    content: url(https://www.graphcore.ai/hubfs/assets/images/icons/yellow-left.svg);
    display: block;
    margin: auto;
    width: 34%;
    position: absolute;
    top: 0;
    left: 0;
}
#page .container.benchmark-wrapper {
    margin-top: 2em;
}
  #page .bg-grey {
    background: #faf8f9;
  }
  #page section.cutout-sibling {
    padding-bottom: calc(4em + 140px);
    position: relative;
    background: #fff;
    -webkit-clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 100%, 50% calc(100% - 35px), calc(50% - 35px) calc(100% - 35px), calc(50% - 35px) calc(100% - 70px), 20% calc(100% - 70px), 20% calc(100% - 140px), 0% calc(100% - 140px));
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 100%, 50% calc(100% - 35px), calc(50% - 35px) calc(100% - 35px), calc(50% - 35px) calc(100% - 70px), 20% calc(100% - 70px), 20% calc(100% - 140px), 0% calc(100% - 140px));
  }
  #page section.cutout-sibling::after {
    content: "";
    position: absolute;
    bottom: 70px;
    left: 20%;
    width: 70px;
    height: 70px;
    background-color: #faf8f9;
    border-radius: 50%;
  }
  /*HERO TEXT BOX*/
  .gc_hero_text {
    padding: 25px;
  }
  .gc_hero_text h1.hero-heading {
    font-size: 1.5em;
    margin: 0;
    width: 100%;
    background: transparent;
    max-width: none;
  }
  .gc_hero_text p {
    font-size: 1.1rem;
    line-height: 1.4;
    padding-bottom: .5em;
  }
  article.gc_hero_text .cta_container.primary-red > div a {
    line-height: 50px;
    text-align: left;
  }
  article.gc_hero_text .cta_container.primary-red > div a:hover {
    background-color: transparent;
    border-color: #ffffff;
    color: #ffffff;
  }
  article.gc_hero_text .cta_container.primary-red > div a:hover:after {
    color: #ffffff;
  }
  .gc-image-hero {
    max-height: 932px;
    margin-bottom: 100px;
    background: #000;
  }
  .gc-image-hero > img {
    will-change: transform;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    animation: orbit 1500s linear infinite;
    animation-delay: 100ms;
    -webkit-transform-origin-z: 0;
    padding: 1px;
    background-color: #000;
  }
   #page.homepage_page .hero_img_mobile {
    display:none;
  }
  #page .gc_hero_text a.primary-btn-white {
    margin: 20px 0 0;
    display: inline-block;
    border: 1px solid #fff;
    font-size: 1rem;
    width: 49%;
}
   #page .gc_hero_text a.ghost-btn {
    background-color: #0000;
    border: solid #fff 1px;
    color: #fff;
}
  /* CTA CSS */
  #page a.primary-btn-white, #page a.primary-btn-red {
    background-color: #FFFFFF;
    display: block;
    color: #292c31;
    border: 2px solid transparent;
    line-height: 50px;
    padding: 0px 15px;
    position: relative;
    font-size: 1em;
    text-align: left;
		font-weight: normal;
    font-family: 'Graphik-Medium',sans-serif;
    max-width: 280px;
  }
  #page a.primary-btn-red {
    background-color: #ff6f79;
    color: #292c31;
  }
  #page a.primary-btn-red.blog-cta,  #page a.primary-btn-red.trial-cta {
  margin:auto;
  }
  #page section.cloud-area a.primary-btn-red {
    margin-top: 2em;
}
  #page a.primary-btn-white:after {
    font-family: "GCSymbols-Regular";
    content: '\E002';
    position: absolute;
    right: 1em;
    top: 0;
    font-size: 100%;
    transition: transform ease-out .3s;
    display: block;
  }
  #page a.secondary-cta {
    color: #ff6f79;
    font-family: "Graphik-Medium",sans-serif;
    position: relative;
  }
  #page a.secondary-cta:after {
    font-family: "GCSymbols-Regular";
    content: '\E002';
    transition: transform ease-out .3s;
    display: inline-block;
    margin-left: 1em;
  }
  #page a.primary-btn-red:after {
    font-family: "GCSymbols-Regular";
    content: '\E002';
    position: absolute;
    right: 1em;
    top: 0;
    font-size: 100%;
    transition: transform ease-out .3s;
    display: block;
  }
  #page a.primary-btn-red:hover:after, #page a.primary-btn-white:hover:after, #page a.secondary-cta:hover:after {
    transform: translateX(8px);
  }
  #page .benchmark-wrapper a.primary-btn-white {
    border: #ff6f79 solid 2px;
    color: #ff6f79;
    width: 232px;
}
  #page .feature-cta {
    padding: 2em 1.5em;
  }
  #page .feature-cta a.primary-btn-red {
    margin: auto;
    min-width: 230px;
  }
  #page .gc-news a.primary-btn-red.blog-cta {
    margin-top: 2em;
}
  #page div.cta-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
}
  #page a.to-content {
    width: 50px;
    height: 50px;
    position: absolute;
    left: 50%;
    bottom: -150px;
    -ms-filter: drop-shadow(0px 2px 5px #000);
    filter: drop-shadow(0px 2px 5px #000);
    -webkit-transform: translateX(-50%);
    -ms-transform: translateX(-50%);
    transform: translateX(-50%);
  }
  #page a.to-content::before {
    content: "";
    width: 50px;
    height: 50px;
    background-color: #fff;
    position: relative;
    display: block;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transform: rotate(0deg) translateZ(0);
    -webkit-clip-path: polygon(30% 0, 70% 0, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0 70%, 0 30%);
    clip-path: polygon(30% 0, 70% 0, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0 70%, 0 30%);
    transition: -webkit-transform .7s cubic-bezier(0,.12,.25,.99), -ms-transform .7s cubic-bezier(0,.12,.25,.99), transform .7s cubic-bezier(0,.12,.25,.99), background-color .3s;
  }
  #page a.to-content:hover::before {
    background-color: #FAF8F9;
    transform: rotate(180deg) translateZ(0);
  }
  #page a.to-content::after {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    -webkit-transform: translate3d(-50%,-50%, 0);
    -ms-transform: translate3d(-50%,-50%, 0);
    transform: translate3d(-50%,-50%, 0);
    content: "\E004";
    font-family: "GCSymbols-Regular";
    color: #ff6f79;
  }
  #page a.to-content:hover::after{
    animation: bobbing .7s cubic-bezier(0,.12,.25,.99);
  }
  #page.homepage_page .gc-image-hero:before {
    display: none;
  }
  /* BENCHMARK HEADER */
  #page .benchmark-header {
    text-align: center;
    margin-bottom: 2em;
  }
  #page .benchmark-header h2 {
    font-size: 2em;
    line-height: 1.4;
    -webkit-font-feature-settings: "calt" 0, "liga";
    font-feature-settings: "calt" 0, "liga";
    font-family: "Caslons Egyptian Pentagram Reg", sans-serif;
  }
  #page .benchmark-header p {
    font-family: "Graphik-Regular", sans-serif;
    font-size: 1em;
    line-height: 1.6;
    max-width: 700px;
    margin: auto;
    margin-top: 15px;
    margin-bottom: 2em;
  }
  /* TWO + THREE PANEL CSS */
  #page .two-panel, #page .three-panel {
   display: block;
 }
 #page .two-panel div.copy-block h2 {
  font-size: 1.6em;
  line-height: 1.4;
  margin-bottom: 1em;
}
#page.two-panel div.copy-block p {
  font-size: 1em;
  line-height: 1.4;
  margin-bottom: 1em;
  color: #646464;
}
  #page .two-panel div.copy-block p {
    margin-bottom: 1em;
}
  #page .two-panel {
    margin-bottom: 2em;
