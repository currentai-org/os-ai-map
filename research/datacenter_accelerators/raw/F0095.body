<div id="site-tooltip" role="tooltip" aria-hidden="true"
     class="tooltip-panel pointer-events-none fixed z-50 hidden w-max max-w-[240px] sm:max-w-xs p-2.5 text-center
            rounded-sm shadow-md bg-foreground text-background
            dark:bg-background dark:text-foreground dark:border dark:border-border whitespace-normal break-words">
    <span id="site-tooltip-text"></span>
    <span id="site-tooltip-arrow"
          class="absolute top-full border-4 border-transparent border-t-foreground dark:border-t-background"></span>
</div>
<script>
    (function () {
        const GAP = 10;
        const panel = document.getElementById('site-tooltip');
        const text = document.getElementById('site-tooltip-text');
        const arrow = document.getElementById('site-tooltip-arrow');
        if (!panel) return;
        let current = null;

        function hide() {
            current = null;
            panel.classList.add('hidden');
            panel.setAttribute('aria-hidden', 'true');
        }

        function show(trigger) {
            const message = trigger.getAttribute('data-tooltip');
            if (!message) return;
            current = trigger;
            text.textContent = message;
            panel.classList.remove('hidden');
            panel.setAttribute('aria-hidden', 'false');
            position();
        }

        function position() {
            if (!current) return;
            const icon = current.getBoundingClientRect();
            const width = panel.offsetWidth;
            const centre = icon.left + icon.width / 2;
            let left = centre - width / 2;
            // Back inside the viewport, right edge first: a panel wider than the window
            // would otherwise be pushed off the left by the clamp meant to save it.
            if (left + width > window.innerWidth - GAP) left = window.innerWidth - GAP - width;
            if (left < GAP) left = GAP;
            panel.style.left = `${left}px`;
            panel.style.top = `${icon.top - panel.offsetHeight - 8}px`;
            // The arrow points at the icon wherever the panel ended up.
            arrow.style.left = `${Math.min(Math.max(centre - left, 8), width - 8) - 4}px`;
        }

        document.addEventListener('pointerover', (event) => {
            const trigger = event.target.closest('[data-tooltip]');
            if (trigger && trigger !== current) show(trigger);
            else if (!trigger && current) hide();
        });
        document.addEventListener('focusin', (event) => {
            const trigger = event.target.closest('[data-tooltip]');
            if (trigger) show(trigger);
            else if (current) hide();
        });
        document.addEventListener('click', (event) => {
            const trigger = event.target.closest('[data-tooltip]');
            if (!trigger) return hide();
            // A tap on the open one closes it; the pointerover above has already opened
            // it on a device that has a pointer at all.
            if (trigger === current) hide();
            else show(trigger);
        });
        // The panel is fixed to the viewport, so anything that moves the trigger under
        // it has to move it too. Cheaper to re-measure than to close, and closing on
        // scroll makes it unreadable on a touch device, where scrolling is how you look.
        window.addEventListener('scroll', position, { passive: true, capture: true });
        window.addEventListener('resize', position, { passive: true });
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') hide();
        });
    })();
</script>



