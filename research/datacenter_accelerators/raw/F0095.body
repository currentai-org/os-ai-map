<script>
    if (typeof window.gpuSearchTerms === 'undefined') {
        window.gpuSearchTerms = function (query) {
            if (!query) return [];
            return query
                .toLowerCase()
                .split(/[\s,;]+/)
                .map((term) => term.replace(/^[.\-_:,;]+|[.\-_:,;]+$/g, ''))
                .filter(Boolean);
        };
    }
</script>

<script>
    if (typeof window.gpuPanel === 'undefined') {
        window.gpuPanel = function (options) {
            return {
                // Control state. The hidden fields bind to these, so a request always
                // carries every control's value and not just the one that changed.
                view: options.view || 'cards',
                billing: options.billing || '',
                rows: '',
                // Which column the configuration table is ordered by, as the server's
                // own control value: a key from offers.TABLE_SORTS, with a leading "-"
                // for descending, and empty for the ranker's order. Held here rather
                // than in the table because the table is inside the swap target and
                // this is what tells the server what to send back.
                sort: '',

                // Alpine owns the filter inputs outright (`x-model`), which is what lets
                // "Clear filters" empty the boxes the reader is looking at and what makes
                // its own visibility reactive. Values stay strings: coercing them per
                // keystroke is the class of thing this design exists to stop.
                // `available` is a checkbox, so its value is a boolean rather than a
                // string; `hasFilters` and `clearFilters` treat all six identically
                // because false and '' are both falsy. Only the GPU panel renders an
                // input for it, and the provider panel simply never submits one.
                filters: { max_price: '', min_gpus: '', min_vram: '', min_cpus: '', min_ram: '', available: false },

                // Whether the spec filters belong to one view rather than to the panel.
                // On both pages they do: a filter changes what every card *says* (narrow
                // to 8x and each headline stops quoting its 1x rate), which is a
                // different reading of the catalog rather than a narrower one, while in
                // the configuration table narrowing is the whole point. The search is not
                // one of these and stays in both views: it hides whole cards and never
                // restates one. `showFilters` is what the row binds its visibility to.
                //
                // Kept as an option rather than assumed, because it is a claim about what
                // a card on that page means and the next panel to use this may disagree.
                filtersOnlyInTable: !!options.filtersOnlyInTable,

                // Which view carries the billing tab row: 'table', 'cards', or 'both'.
                // Not derived from `filtersOnlyInTable`, because the two panels answer
                // differently. A provider page tabs its configuration table alone: a tab
                // there is a narrowing, which is what the table is for, and over its
                // cards it would restate every headline. A GPU page tabs both, because
                // its cards *are* the market for one model, so "at what kind of price" is
                // the first question a reader has about them rather than a side effect.
                tabsIn: options.tabsIn || 'table',

                // Browser-only.
                search: '',
                showAll: false,
                // Fallback only. The two panels open at different folds
                // (GPU_MODEL_CARD_LIMIT vs PROVIDER_CARD_LIMIT), so there is no single
                // right number here; both callers pass their own and this is the floor
                // if one ever forgets to.
                limit: options.limit || 8,

                // Written by the results container each time one arrives, so the tab
                // counts and the total stay faceted by the current filters without the
                // tabs themselves ever being replaced. See the `x-init` on it.
                facets: options.facets || {},
                // The catalog in the unit the panel is drawn in, which the card list's
                // empty state counts its own misses against. It had a unit beside it
                // (`scopeUnit`, and a `unitLabel()` that pluralised it) for as long as a
                // control row printed the figure in words; both toggles say what each
                // view holds now, so the figure is read and never written out.
                scopeCount: options.scopeCount || 0,

                submit() {
                    // requestSubmit, not submit: it fires a real submit event, which is
                    // what htmx is listening for. `.submit()` bypasses the event
                    // entirely and the panel would simply never update.
                    this.$nextTick(() => this.$refs.controls.requestSubmit());
                },

                // Set one control and go.
                //
                // "Show me all of it" is deliberately NOT reset by a tab or a filter. It
                // is an explicit request that stays meaningful in any pool, and clearing
                // it meant a reader who had loaded the whole table was dropped back to
                // the opening fifty rows, and offered "view all N configurations" again,
                // every time they touched a tab. A view change does clear it, because the
                // two views are counted in different units.
                pick(field, value) {
                    this[field] = value;
                    // A view change resets every narrowing control except the search. Two
                    // of them are not offered by the card list at all, and one left set
                    // behind it gives the reader a silently narrowed catalog with nothing
                    // on screen saying so and no control to undo it with.
                    //
                    // The search survives, and is the one control that can. It is offered
                    // in both views over one vocabulary (`offers.offer_search_text`, which
                    // a card's own text is the union of), so a term that finds a row finds
                    // the card it lives under and the other view opens on the same answer
                    // in its own unit: "aws" over the cards is one company, and over the
                    // configs it is that company's rows. Clearing it was the earlier rule,
                    // written when the table searched GPU names only and the same query
                    // meant two different things; with the vocabularies unified it just
                    // made a reader retype what they were plainly still looking for, and
                    // the box they had typed it into is outside the swap, so nothing on
                    // screen was even asking to be reset. `clearSearch` is how it goes.
                    if (field === 'view') {
                        this.filters = { max_price: '', min_gpus: '', min_vram: '', min_cpus: '', min_ram: '', available: false };
                        this.billing = '';
                        this.showAll = false;
                        this.rows = '';
                        // The sort goes with them, and has to: it names a column, only
                        // one of the two views has columns, and a card list ordered by
                        // "cpus" is not a thing the panel can draw.
                        this.sort = '';
                    }
                    this.submit();
                },

                showFilters() {
                    return !this.filtersOnlyInTable || this.view === 'table';
                },

                showTabs() {
                    return this.tabsIn === 'both' || this.view === this.tabsIn;
                },

                // Clearing the box is enough for the card list, which filters itself, and
                // not for the configuration table, whose search is a scope the server
                // applied. Without the round trip the box emptied and the rows stayed as
                // the query had left them.
                clearSearch() {
                    this.search = '';
                    if (this.view === 'table') this.submit();
                },

                hasFilters() {
                    return Object.values(this.filters).some(Boolean);
                },

                // Cleared in the browser, so the inputs the reader is looking at are the
                // ones that get emptied. Sending a "no filters" URL instead would empty
                // the pool on the server and leave the values sitting in the boxes,
                // which reads as a filter that stopped working.
                clearFilters() {
                    this.filters = { max_price: '', min_gpus: '', min_vram: '', min_cpus: '', min_ram: '', available: false };
                    this.submit();
                },

                // Three states per column, the same cycle both other tables on the site
                // use: ascending, descending, then back to the order the page arrived
                // in. The third one matters here more than it does in a browser-side
                // sort, because the unsorted order is the ranker's and carries the
                // sponsor pin: there has to be a way back to it that is not a reload.
                //
                // A round trip rather than a reorder of the loaded rows. The table holds
                // its opening page, so sorting in the browser would order fifty rows out
                // of four hundred and present the result as the cheapest on the page.
                toggleSort(key) {
                    if (this.sort === key) {
                        this.sort = '-' + key;
                    } else if (this.sort === '-' + key) {
                        this.sort = '';
                    } else {
                        this.sort = key;
                    }
                    this.submit();
                },

                // Called on every keystroke in the search box, and does something exactly
                // once. The table opens at a fixed number of rows because a rendered row
                // costs about 5KB and a long catalog is a megabyte nobody asked for, but
                // a search that quietly only covered the opening page is a wrong answer
                // presented as a complete one. So the first keystroke fetches the rest,
                // and from then on the search is instant over the whole catalog.
                terms() {
                    return window.gpuSearchTerms(this.search);
                },

                // `el` is passed in rather than read as `$el` inside a getter: in a
                // getter `$el` resolves to whichever element is evaluating the
                // expression, which once made every card report "no matches" with the
                // matching card visible directly above it.
                matches(el) {
                    const haystack = el.dataset.search || '';
                    return this.terms().every((term) => haystack.includes(term));
                },

                cardVisible(el, index) {
                    if (!this.matches(el)) return false;
                    // A search reaches past the reveal limit. Hiding a match because it
                    // happened to be the fortieth card is indistinguishable from not
                    // having it, and the reader has already told us what they want.
                    if (this.search) return true;
                    return this.showAll || index < this.limit;
                },

                // What a tab says it holds: the server's figure, faceted by the spec
                // filters, and nothing else.
                //
                // Not the search. It was tried, counting the matching rows in the
                // document, and it can only work on the All tab: with a tab picked, the
                // document holds that tab's rows and no others, so there is no honest way
                // to count what the other tabs would yield. Counts that changed meaning
                // depending on which tab you were standing on were worse than counts that
                // are consistently one thing, so every figure on this row is now the same
                // kind of figure. Making them search-aware means sending the query to the
                // server, which is the thing this control exists to avoid.
                //
                // The search reports itself where it runs: the list underneath says what
                // it left.
                tabCount(slug) {
                    return this.facets.tabs ? this.facets.tabs[slug] : 0;
                },

                // How many cards match, for the card list's own empty state. Only the
                // card list searches in the browser; the table's search is a scope, so
                // its empty state is the server's to render and can name the query.
                visibleMatches() {
                    if (!this.search) return this.scopeCount;
                    return this.$refs.results
                        ? Array.from(this.$refs.results.querySelectorAll('[data-search]')).filter((el) =>
                              this.matches(el),
                          ).length
                        : 0;
                },
            };
        };
    }

    if (typeof window.gpuConfigTable === 'undefined') {
        window.gpuConfigTable = function () {
            return {
                key: null,
                dir: 'asc',

                sort(key) {
                    if (this.key === key) {
                        this.dir = this.dir === 'asc' ? 'desc' : 'asc';
                    } else {
                        this.key = key;
                        this.dir = 'asc';
                    }

                    const body = this.$refs.rows;
                    const factor = this.dir === 'asc' ? 1 : -1;
                    const rows = Array.from(body.children);

                    rows.sort((a, b) => {
                        const left = a.dataset[key];
                        const right = b.dataset[key];
                        // Blanks last in both directions, so sorting by vCPUs
                        // descending does not open with the configs nobody published a
                        // vCPU count for.
                        if (left === '' && right === '') return 0;
                        if (left === '') return 1;
                        if (right === '') return -1;
                        const diff = parseFloat(left) - parseFloat(right);
                        return diff === 0 ? 0 : (diff < 0 ? -1 : 1) * factor;
                    });

                    rows.forEach((row) => body.appendChild(row));
                },
            };
        };
    }
</script>


    




<div class="not-prose py-4">
    <p class="note m-0">
        <strong>Heads up:</strong>
        
        A provider's own page may quote a different figure, for example on tax, region or a promotion. A monthly-only plan shows a derived hourly rate.
        
        
        
        
        
        Verify before provisioning. More on <a href="/methodology/pricing" target="_blank">how we price</a>.
        
    </p>
</div>

</div>

        

        
        
            <section id="model-fit">
                
<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-3.5">
    <h2 class="heading-2 m-0">What can the GB300 run?</h2>
    
    
</div>

                
                <div class="prose dark:prose-invert max-w-7xl mb-4">
                    <p class="mb-0">One GB300 has 288 GB of VRAM. In practice, that&#x27;s enough memory for roughly 460B parameters at 4-bit or 125B at 16-bit, assuming a 32K context. Below are some open-weight LLMs, with the estimated memory and GPUs each one needs.</p>
                </div>
                
                <div class="not-prose" x-data="{ precision: '4-bit' }">
                    <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
                        <div class="switch self-start shrink-0"
                             role="group" aria-label="Model precision">
                            
                                <button type="button"
                                        @click="precision = '4-bit'"
                                        class="switch-option"
                                        :data-active="precision === '4-bit'"
                                        data-active="true"
                                        :aria-current="precision === '4-bit'"
                                        aria-current="true"
                                        title="INT4 / FP4">4-bit</button>
                            
                                <button type="button"
                                        @click="precision = '8-bit'"
                                        class="switch-option"
                                        :data-active="precision === '8-bit'"
                                        
                                        :aria-current="precision === '8-bit'"
                                        
                                        title="FP8 / INT8">8-bit</button>
                            
                                <button type="button"
                                        @click="precision = '16-bit'"
                                        class="switch-option"
                                        :data-active="precision === '16-bit'"
                                        
                                        :aria-current="precision === '16-bit'"
                                        
                                        title="FP16 / BF16">16-bit</button>
                            
                        </div>
                        
                        
                            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 sm:ml-auto">
                                
                                    <span class="hint inline-flex items-center gap-1.5">
                                        <span class="fit-square fit-tier" data-tier="one"></span>Fits on 1
                                    </span>
                                
                                    <span class="hint inline-flex items-center gap-1.5">
                                        <span class="fit-square fit-tier" data-tier="node"></span>Single node ≤ 8
                                    </span>
                                
                                    <span class="hint inline-flex items-center gap-1.5">
                                        <span class="fit-square fit-tier" data-tier="over"></span>Multi-node
                                    </span>
                                
                            </div>
                        
                    </div>
                    
