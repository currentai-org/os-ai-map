         class="fixed z-40 inset-0 bg-black/80"
         x-transition:enter="transition-opacity ease-in-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition-opacity ease-in-out duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0">
        <div class="fixed inset-0 z-50 flex w-screen h-full justify-center items-end sm:items-center overflow-y-auto">
            <div @click.away="close()"
                 class="relative max-h-[80vh] overflow-y-scroll bg-card text-card-foreground border border-border p-4 sm:p-6 rounded-t sm:rounded-sm shadow-xl w-full sm:max-w-lg"
                 x-show="showModal"
                 x-transition:enter="transition-transform ease-in-out duration-200"
                 x-transition:enter-start="transform translate-y-4"
                 x-transition:enter-end="transform translate-y-0"
                 x-transition:leave="transition-translate ease-in-out duration-200"
                 x-transition:leave-start="transform translate-y-0"
                 x-transition:leave-end="transform translate-y-2">
                
                <div class="w-full flex flex-col justify-start items-start text-left space-y-6 prose dark:prose-invert">
                    
<h3 class="mt-0! mb-2!">How this list works</h3>

<div class="w-full">
    <h4 class="mt-0!">The two views</h4>
    
    <p class="mb-0!">By provider shows one card per company, placed where its best offer
        ranked. By configuration lists every offer.</p>
</div>

<div class="w-full">
    <h4 class="mt-0!">Order</h4>
    <p>What you can rent comes first: in stock, then waitlist, then not reported, then out
        of stock. Priced offers rank ahead of quote-only, and on-demand ahead of other
        billing types.</p>

    <p>Within a group, five factors set the order:</p>

    
    <ol class="mb-0!">
        <li><strong>Location:</strong> datacenter proximity, blended with provider HQ.</li>
        <li><strong>Price:</strong> hourly price, per GPU and in total.</li>
        <li><strong>Billing type:</strong> reserved ahead of spot, spot ahead of
            quote-only.</li>
        <li><strong>Specs:</strong> more VRAM, vCPUs and RAM.</li>
        <li><strong>Provider diversity:</strong> a provider's repeat
            rows rank slightly lower, so one company can't take all the top spots.</li>
    </ol>
</div>

<div class="w-full">
    <h4 class="mt-0!">Search</h4>
    
    <p class="mb-0!">We match the provider, its country, GPU model, form factor, billing
        type, availability and instance name. Matching is partial and case-insensitive.
        Everyday words work too, so "interruptible" finds spot and "sold out" finds out of
        stock.</p>
</div>


<div class="w-full">
    <h4 class="mt-0!">Transparency and funding</h4>
    <ul class="mb-0!">
        
            <li><strong>Ads and sponsors:</strong> Paid placements sit at the top of the list
                and are always labeled as sponsored content. Sponsorship never influences the
                organic ranking itself.</li>
        
        <li><strong>Affiliates:</strong> Affiliate links are marked. We may earn a commission
            if you click them, but commissions never affect the order.</li>
        
            <li><strong>Prices:</strong> Shown in USD, converted at daily reference rates where a
                provider publishes in another currency. A month means 720 hours.
                <a href="/methodology/pricing">Pricing methodology</a>.</li>
        
    </ul>
</div>


                </div>
                <div class="mt-4 w-full flex flex-row justify-end items-center">
                    <button type="button" @click="close()" class="mt-3 button button-primary">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

    </div>

    

<form x-ref="controls"
      hx-get="/gpus/nvidia-gb300/offers"
      hx-target="#gpu-results" hx-swap="outerHTML"
      hx-indicator="#gpu-results"
      hx-trigger="submit, input changed delay:200ms">
    
    <input type="hidden" name="gpu_view" :value="view">
    <input type="hidden" name="billing" :value="billing">
    <input type="hidden" name="rows" :value="rows">
    <input type="hidden" name="sort" :value="sort">
    
    <input type="hidden" name="pin" value="runpod">

    
    <div class="not-prose w-full flex flex-col sm:flex-row sm:items-center gap-3 mb-4">
        <div class="switch self-start sm:self-auto shrink-0">
            
        
        <button type="button" @click="pick('view', 'cards')"
                class="switch-option"
                :data-active="view === 'cards'"
                data-active="true"
                :aria-current="view === 'cards'">By provider<span class="count">7</span></button>
            <button type="button" @click="pick('view', 'table')"
                class="switch-option"
                :data-active="view === 'table'"
                
                :aria-current="view === 'table'">By configuration<span class="count">27</span></button>
        </div>

        
        <input id="gpu-search" name="search" type="search" x-model="search"
               @input="if (view !== 'table') $event.stopPropagation()"
               placeholder="Search eg. aws or germany"
               aria-label="Search providers"
               class="control control-compact w-full sm:ml-auto sm:w-65">

        
    </div>

    

    
    
    <div x-show="showTabs() && facets.view === view"
         
         class="flex flex-row flex-nowrap gap-6 overflow-x-auto no-scrollbar pb-px border-b border-border mb-4" role="tablist"
         aria-label="Filter GPUs by billing type">
        
            <button type="button"
                    @click="pick('billing', '')"
                    class="gpu-tab"
                    :data-active="billing === ''"
                    data-active="true"
                    role="tab"
                    :aria-selected="billing === '' ? 'true' : 'false'"
                    aria-selected="true">
                All
                
                <span class="count"
                      x-text="tabCount('')">7</span>
            </button>
        
            <button type="button"
                    @click="pick('billing', 'on-demand')"
                    class="gpu-tab"
                    :data-active="billing === 'on-demand'"
                    
                    role="tab"
                    :aria-selected="billing === 'on-demand' ? 'true' : 'false'"
                    aria-selected="false">
                On-Demand
                
                <span class="count"
                      x-text="tabCount('on-demand')">2</span>
            </button>
        
            <button type="button"
                    @click="pick('billing', 'spot')"
                    class="gpu-tab"
                    :data-active="billing === 'spot'"
                    
                    role="tab"
                    :aria-selected="billing === 'spot' ? 'true' : 'false'"
                    aria-selected="false">
                Spot
                
                <span class="count"
                      x-text="tabCount('spot')">1</span>
            </button>
        
            <button type="button"
                    @click="pick('billing', 'reserved')"
                    class="gpu-tab"
                    :data-active="billing === 'reserved'"
                    
                    role="tab"
                    :aria-selected="billing === 'reserved' ? 'true' : 'false'"
                    aria-selected="false">
                Reserved
                
                <span class="count"
                      x-text="tabCount('reserved')">2</span>
            </button>
        
            <button type="button"
                    @click="pick('billing', 'custom')"
                    class="gpu-tab"
                    :data-active="billing === 'custom'"
                    
                    role="tab"
                    :aria-selected="billing === 'custom' ? 'true' : 'false'"
                    aria-selected="false">
                Custom
                
                <span class="count"
                      x-text="tabCount('custom')">4</span>
            </button>
        
    </div>



    
    
    <div x-show="showFilters()"
         style="display: none"
         class="not-prose flex flex-wrap gap-2 mb-4 items-center">
        <label class="filter-pill" :data-set="!!filters.max_price">
            <span>Max $/hr</span>
            
            <input id="gpu-max-price" name="max_price" x-model="filters.max_price"
                   type="text" inputmode="decimal" autocomplete="off" placeholder="Any">
        </label>
        <label class="filter-pill" :data-set="!!filters.min_gpus">
            <span>Min GPUs</span>
            <input id="gpu-min-gpus" name="min_gpus" x-model="filters.min_gpus" type="number" min="0"
                   placeholder="Any">
        </label>
        <label class="filter-pill" :data-set="!!filters.min_vram">
            <span>Min VRAM</span>
            <input id="gpu-min-vram" name="min_vram" x-model="filters.min_vram" type="number" min="0"
                   placeholder="Any" class="w-14">
        </label>
        <label class="filter-pill" :data-set="!!filters.min_cpus">
            <span>Min vCPU</span>
            <input id="gpu-min-cpus" name="min_cpus" x-model="filters.min_cpus" type="number" min="0"
                   placeholder="Any">
        </label>
        <label class="filter-pill" :data-set="!!filters.min_ram">
            <span>Min RAM</span>
            <input id="gpu-min-ram" name="min_ram" x-model="filters.min_ram" type="number" min="0"
                   placeholder="Any" class="w-14">
        </label>
        
        <label class="inline-flex items-center gap-2 px-1 label cursor-pointer select-none">
            <input id="gpu-available" name="available" value="1" type="checkbox" x-model="filters.available"
                   @input="$event.stopPropagation()" @change="submit()"
                   class="size-4 rounded-sm border-input text-primary cursor-pointer focus:ring-2 focus:ring-ring">
            In stock only
        </label>
        <button type="button" x-show="hasFilters()" style="display: none" @click="clearFilters()"
                class="inline-flex items-center gap-1 py-1.5 label hover:text-foreground cursor-pointer">
            Clear filters
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
            </svg>
        </button>
    </div>
</form>

    
<div id="gpu-results" class="not-prose w-full swap-pending"
     x-ref="results"
     x-init="facets = {&quot;view&quot;: &quot;cards&quot;, &quot;tabs&quot;: {&quot;&quot;: 7, &quot;on-demand&quot;: 2, &quot;spot&quot;: 1, &quot;reserved&quot;: 2, &quot;custom&quot;: 4}}; scopeCount = 7">
    
        


