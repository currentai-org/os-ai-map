<nav class="rail w-[180px] shrink-0 max-lg:hidden  "
     aria-label="On this page"
     x-data="sectionRail()"
     x-init="observe()">
    
        
            <a href="#prices" :class="active === 'prices' && 'is-active'">Prices</a>
        
            <a href="#model-fit" :class="active === 'model-fit' && 'is-active'">Model fit</a>
        
            <a href="#technical-specs" :class="active === 'technical-specs' && 'is-active'">Specs</a>
        
