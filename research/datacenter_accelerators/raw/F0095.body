            <a href="#alternatives" :class="active === 'alternatives' && 'is-active'">Alternatives</a>
        
    
</nav>

<script>
    function sectionRail() {
        return {
            active: "",
            observe(attempt = 0) {
                const ids = [...this.$el.querySelectorAll("a")]
                    .map((a) => a.getAttribute("href").slice(1));
                const sections = ids
                    .map((id) => document.getElementById(id))
                    .filter(Boolean);
                // A section a React root draws (the price index's charts) is not in the
                // document when Alpine starts. Wait for it, a few seconds at most, rather
                // than observing a rail with half its sections missing for good.
                if (sections.length < ids.length && attempt < 40) {
                    setTimeout(() => this.observe(attempt + 1), 150);
                    return;
                }
                if (!sections.length) return;

                // The first section is marked before anything has been scrolled past,
                // so the rail is never blank at the top of the page.
                this.active = ids[0];

                const seen = new Map();
                const observer = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) seen.set(entry.target.id, entry.isIntersecting);
                        // The first section still inside the band, in document order:
                        // scrolling down that is the one you have just reached, and
                        // scrolling up it is the one you have come back to.
                        const current = ids.find((id) => seen.get(id));
                        if (current) this.active = current;
                    },
                    { rootMargin: "-80px 0px -70% 0px" },
                );
                sections.forEach((section) => observer.observe(section));
                // The page is long-lived but the component is not: an observer left
                // running after an htmx swap replaced the rail would hold its sections.
                this.$el._railObserver = observer;
            },
        };
    }
</script>


