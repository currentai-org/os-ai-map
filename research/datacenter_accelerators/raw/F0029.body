	$('.tabproaul').eq(0).hide();
	$('.mainpro').click(function(){
		if($(this).hasClass('on'))
		{
			$(this).removeClass('on');
			$('.tabproaul').eq(1).show();
			$('.tabproaul').eq(0).hide();
		}
		else{
			$(this).addClass('on');
			$('.tabproaul').eq(1).hide();
			$('.tabproaul').eq(0).show();
		}
	})
	
	$('.maintzz').click(function(){
		$(this).fadeOut(300);
	})
	
	$(".counter").countUp();
	
					
