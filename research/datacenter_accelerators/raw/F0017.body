" cy=\"221\" r=\"5.95\" fill=\"#EFC0E5\"/\u003e\u003ccircle cx=\"527\" cy=\"187\" r=\"9.35\" fill=\"#EFC0E5\"/\u003e\u003ccircle cx=\"561\" cy=\"187\" r=\"5.95\" fill=\"#EFC0E5\"/\u003e\u003ccircle cx=\"595\" cy=\"187\" r=\"5.95\" fill=\"#EFC0E5\"/\u003e\u003ccircle cx=\"595\" cy=\"221\" r=\"5.95\" fill=\"#EFC0E5\"/\u003e\u003ccircle cx=\"629\" cy=\"85\" r=\"5.95\" fill=\"#EFC0E5\"/\u003e\u003ccircle cx=\"629\" cy=\"187\" r=\"5.95\" fill=\"#EFC0E5\"/\u003e\u003ccircle cx=\"663\" cy=\"51\" r=\"5.95\" fill=\"#EFC0E5\"/\u003e\u003ccircle cx=\"663\" cy=\"85\" r=\"9.35\" fill=\"#EFC0E5\"/\u003e\u003ccircle cx=\"663\" cy=\"187\" r=\"9.35\" fill=\"#EFC0E5\"/\u003e\u003ccircle cx=\"697\" cy=\"85\" r=\"9.35\" fill=\"#EFC0E5\"/\u003e\u003crect x=\"719.1\" y=\"73.1\" width=\"23.8\" height=\"23.8\" fill=\"#EFC0E5\"/\u003e\u003ccircle cx=\"731\" cy=\"85\" r=\"6.8\" fill=\"#53003F\"/\u003e\u003ccircle cx=\"731\" cy=\"119\" r=\"9.35\" fill=\"#EFC0E5\"/\u003e\u003c/svg\u003e"])</script><script>self.__next_f.push([1,"25:[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"BlogHeaderArt_art__zlLhF\",\"children\":[[\"$\",\"div\",null,{\"className\":\"BlogHeaderArt_svg__CzwEx\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2b\"}}],\"$L2c\"]}]\n26:[\"$\",\"time\",null,{\"className\":\"ArticleLayout_date__cvdh5\",\"dateTime\":\"2025-12-24T00:00:00.000Z\",\"children\":\"December 24, 2025\"}]\n27:[\"$\",\"h1\",null,{\"className\":\"ArticleLayout_title__Zy4Yy\",\"children\":\"Groq and Nvidia Enter Non-Exclusive Inference Technology Licensing Agreement to Accelerate AI Inference at Global Scale \"}]\n"])</script><script>self.__next_f.push([1,"28:[\"$\",\"section\",null,{\"className\":\"ArticleLayout_body__8IL9c stack text use-type-class\",\"children\":[[\"$\",\"p\",\"0c960e74bb56\",{\"children\":[\"Today, Groq announced that it has entered into a non-exclusive licensing agreement with Nvidia for Groq’s inference technology. The agreement reflects a shared focus on expanding access to high-performance, low cost inference.\"]}],[\"$\",\"p\",\"e46af9e41377\",{\"children\":[\"As part of this agreement, Jonathan Ross, Groq’s Founder, Sunny Madra, Groq’s President, and other members of the Groq team will join Nvidia to help advance and scale the licensed technology.\"]}],[\"$\",\"p\",\"1640c294da53\",{\"children\":[\"Groq will continue to operate as an independent company with Simon Edwards stepping into the role of Chief Executive Officer.\"]}],[\"$\",\"p\",\"1de6ad8765e8\",{\"children\":[\"GroqCloud will continue to operate without interruption.\"]}]]}]\n"])</script><script>self.__next_f.push([1,"29:[\"$\",\"$L22\",null,{}]\n"])</script><script>self.__next_f.push([1,"2c:[\"$\",\"span\",null,{\"className\":\"BlogHeaderArt_pill__bdY8i\",\"style\":{\"backgroundColor\":\"#53003F\",\"color\":\"#FAFAF8\"},\"children\":\"Partnership\"}]\n"])</script><script>self.__next_f.push([1,"24:[\"$\",\"aside\",null,{\"aria-label\":\"Announcement\",\"className\":\"AnnouncementBanner_banner__heWHB\",\"data-announcement\":true,\"children\":[[\"$\",\"p\",null,{\"className\":\"AnnouncementBanner_text__QbwgC\",\"children\":\"Groq Closes $350 million Series A, Building the World's Leading AI Inference Cloud\"}],[\"$\",\"$L1b\",null,{\"href\":\"/newsroom/groq-closes-usd350-million-series-a-building-the-world-s-leading-ai-inference-cloud\",\"rel\":\"$undefined\",\"className\":\"AnnouncementBanner_link__B2CVp\",\"data-internal-link\":\"internal\",\"children\":[\"Read more\",[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"\u003e\"}]]}]]}]\n"])</script></body></html>