5 47.4465 295.895 52.5347V77.1153C295.895 82.2035 291.754 86.3331 286.65 86.3331H246.589Z" fill="currentColor"></path><path d="M523.937 116.96V18.7363C523.937 8.55988 515.653 0.300781 505.447 0.300781H425.878C414.993 0.300781 405.823 8.37553 404.479 19.1419L382.192 196.946H431.5L437.675 147.686H486.969C493.773 147.686 499.297 153.193 499.297 159.977V196.946H548.603V141.541C548.603 134.757 543.081 129.251 536.276 129.251C529.472 129.251 523.95 123.745 523.95 116.96H523.937ZM477.712 104.67H443.061L450.753 43.3169H468.467C473.57 43.3169 477.712 47.4465 477.712 52.5347V104.67Z" fill="currentColor"></path></svg></div></div></footer></div><!--]--></div><div id="teleports"></div><script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script type="application/json" data-nuxt-data="nuxt-app" data-ssr="true" id="__NUXT_DATA__">[["ShallowReactive",1],{"data":2,"state":330,"once":340,"_errors":341,"serverRendered":321,"path":344},["ShallowReactive",3],{"default-layout":4,"i-local-icon:right-chevron":53,"home":57,"i-local-icon:tiles-icon":325,"i-local-icon:top-right-arrow":328},{"header":5,"footer":20},{"links":6,"callToAction":17},[7,11,14],{"to":8,"text":9,"target":10},"/about","About","_self",{"to":12,"text":13,"target":10},"/jobs","Jobs",{"to":15,"text":16,"target":10},"/news","News",{"to":18,"target":10,"text":19},"#contact","Contact us",{"title":21,"adress":28,"contact":29,"socialLinksLabel":32,"links":33,"socialLinks":42,"anchor":52},{"content":22},[23],{"type":24,"text":25,"spans":26,"direction":27},"heading2","Interested in our tech? We’d love to hear from you.",[],"ltr","London, United Kingdom",{"to":30,"target":10,"text":31},"mailto:hello@fractile.ai","hello@fractile.ai","Follow us on:",[34,36,37,39],{"to":8,"text":35,"target":10},"Career",{"to":12,"text":13,"target":10},{"to":15,"text":38,"target":10},"News & Insights",{"to":40,"text":41,"target":10},"/legal-notices","Legal notices",[43],{"link":44,"icon":48},{"to":45,"target":46,"text":47},"https://www.linkedin.com/company/fractile/","_blank","LinkedIn",{"src":49,"width":50,"height":50,"alt":51,"copyright":-1},"https://fractile-landing-page.cdn.prismic.io/fractile-landing-page/aBjf1vIqRLdaB4GU_linkedin.svg",24,"Linkedin icon","contact",{"left":54,"top":54,"width":50,"height":50,"rotate":54,"vFlip":55,"hFlip":55,"body":56},0,false,"\u003Cg fill=\"none\">\u003Cpath d=\"M17.1945 10.7748C17.9756 11.5558 17.9756 12.8222 17.1945 13.6033L7.41888 23.3781L5 20.9592L13.7701 12.189L5 3.41888L7.41888 1L17.1945 10.7748Z\" fill=\"black\"/>\u003C/g>",{"metaData":58,"hero":66,"fullWidthMedia":81,"centerQuote":119,"cardMasonry":135,"editoCardReel":172,"jobs":231,"partners":278,"featuredArticles":302},{"title":59,"description":60,"image":61},"Fractile - Radically Accelerate\nFrontier Model Inference","Fractile is designing AI compute systems that will enable the next generation of AI scaling: frontier model inference, 25x faster, at 1/10th the cost.",{"src":62,"width":63,"height":64,"alt":65,"copyright":-1},"https://images.prismic.io/fractile-landing-page/aEg02bh8WN-LV75U_Thumbnail.jpg",2400,1260,"",{"title":67,"description":73,"button":79,"anchor":-1},{"content":68},[69],{"type":70,"text":71,"spans":72,"direction":27},"heading1","Radically Accelerate Frontier Model Inference",[],{"content":74},[75],{"type":76,"text":77,"spans":78,"direction":27},"paragraph","Run the most advanced models up to 25x faster and at 1/10th the cost.",[],{"to":18,"target":10,"text":80},"Get in touch",{"mobileMediaWebm":82,"desktopMediaWebm":95,"mobileMediaMov":106,"desktopMediaMov":113,"anchor":-1},{"type":83,"data":84},"video",{"sources":85,"text":89,"fallbackImage":90},[86],{"src":87,"type":88,"width":-1,"height":-1},"https://fractile-landing-page.cdn.prismic.io/fractile-landing-page/aDS2uSdWJ-7kSjbj_mobile-hero-1500.webm","video/webm","Fractile intro mobile",{"src":91,"width":92,"height":93,"alt":94,"copyright":-1},"https://images.prismic.io/fractile-landing-page/aBkwGfIqRLdaB4mo_mobile-mock.webp",1080,1512,"Fractile intro mobile mock",{"type":83,"data":96},{"sources":97,"text":100,"fallbackImage":101},[98],{"src":99,"type":88,"width":-1,"height":-1},"https://fractile-landing-page.cdn.prismic.io/fractile-landing-page/aDS4IidWJ-7kSjbw_desktop-hero-2070-less-opti.webm","Fractile intro desktop",{"src":102,"width":103,"height":104,"alt":105,"copyright":-1},"https://images.prismic.io/fractile-landing-page/aBkv1fIqRLdaB4mj_desktop-mock.webp",1920,1536,"Fractile intro desktop mock",{"type":83,"data":107},{"sources":108,"text":100,"fallbackImage":112},[109],{"src":110,"type":111,"width":-1,"height":-1},"https://fractile-landing-page.cdn.prismic.io/fractile-landing-page/aDXBRSdWJ-7kSlZj_mobile-hero-1500.mov","video/quicktime; codecs=hvc1",{"src":91,"width":92,"height":93,"alt":94,"copyright":-1},{"type":83,"data":114},{"sources":115,"text":100,"fallbackImage":118},[116],{"src":117,"type":111,"width":-1,"height":-1},"https://fractile-landing-page.cdn.prismic.io/fractile-landing-page/aDXBRSdWJ-7kSlZh_desktop-hero-2070.mov",{"src":102,"width":103,"height":104,"alt":105,"copyright":-1},{"quote":120,"anchor":-1},{"content":121},[122],{"type":76,"text":123,"spans":124,"direction":27},"At Fractile, we are revolutionising compute to build the engine that can power the next generation of AI. ",[125,131],{"start":126,"end":127,"type":128,"data":129},20,43,"label",{"label":130},"colored",{"start":132,"end":133,"type":128,"data":134},83,104,{"label":130},{"cards":136,"anchor":-1},[137,156],{"title":138,"keyNumber":139,"caption":140,"description":141,"disclaimer":146,"charts":151},"Maximum throughput per Watt (and per dollar)",">10x","throughput efficiency (tokens/s/MW)*",{"content":142},[143],{"type":76,"text":144,"spans":145,"direction":27},"The world will soon be bottlenecked on inference throughput. Available data centre power cannot scale as fast as our aspirations. Fractile’s chips are optimised for performance-per-Watt, meaning every kWh of energy generates 10x the tokens of a frontier GPU system, transforming the economics of AI inference.",[],{"content":147},[148],{"type":76,"text":149,"spans":150,"direction":27},"* Projected performance per megawatt on reference models versus Vera Rubin NVL144.",[],[152,154],{"label":153,"value":65,"unit":65},"Fractile",{"label":155,"value":65,"unit":65},"Nvidia Rubin",{"title":157,"keyNumber":139,"caption":158,"description":159,"disclaimer":164,"charts":169},"World-leading inference speed without sacrifices","faster*",{"content":160},[161],{"type":76,"text":162,"spans":163,"direction":27},"Every other hardware platform serving AI models trades off throughput and latency. Fractile doesn’t. A Fractile system can serve hundreds or thousands of concurrent user queries while providing generation latencies (TTFT, TBOT) up to two orders of magnitude faster. Across frontier models from 7B to 7T+ parameters, and from dense models to highly sparse MoEs.",[],{"content":165},[166],{"type":76,"text":167,"spans":168,"direction":27},"* Projected performance on reference models versus Vera Rubin NVL144.",[],[170,171],{"label":153,"value":65,"unit":65},{"label":155,"value":65,"unit":65},{"kicker":65,"title":173,"editoCards":178,"anchor":-1},{"content":174},[175],{"type":24,"text":176,"spans":177,"direction":27},"The Future of AI Scaling",[],[179,197,215],{"title":180,"description":181,"video":186},"Exponential demand",{"content":182},[183],{"type":76,"text":184,"spans":185,"direction":27},"The number of tokens we are processing with frontier AI models is growing by more than 10x every year. This exponential is set to continue, above all because of the continuing trend that AI models that reason with more tokens produce far smarter outputs. Players that fail to scale their token processing will be out of the race.",[],{"sources":187,"text":65,"fallbackImage":192},[188,190],{"src":189,"type":111,"width":-1,"height":-1},"https://fractile-landing-page.cdn.prismic.io/fractile-landing-page/aULFJ3NYClf9oWyt_in-compute2.mov",{"src":191,"type":88,"width":-1,"height":-1},"https://fractile-landing-page.cdn.prismic.io/fractile-landing-page/aULFKHNYClf9oWyu_in-compute2.webm",{"src":193,"width":194,"height":195,"alt":196,"copyright":-1},"https://images.prismic.io/fractile-landing-page/aFlifnfc4bHWinuM_in-compute.jpg",1556,1558,"Abstract dot illustration of gathering and concentration",{"title":198,"description":199,"video":204},"Cheaper and faster",{"content":200},[201],{"type":76,"text":202,"spans":203,"direction":27},"Frontier model inference has two critical requirements that existing hardware cannot satisfy simultaneously: low latency and high throughput. Fractile is building the first of a new generation of processors, where memory and compute are physically interleaved to deliver both, simultaneously — serving thousands of tokens per second to thousands of concurrent users, at a power budget and scale that no other system can match.",[],{"sources":205,"text":65,"fallbackImage":210},[206,208],{"src":207,"type":111,"width":-1,"height":-1},"https://fractile-landing-page.cdn.prismic.io/fractile-landing-page/aFlif3fc4bHWinuN_scale.mov",{"src":209,"type":88,"width":-1,"height":-1},"https://fractile-landing-page.cdn.prismic.io/fractile-landing-page/aFlignfc4bHWinuR_scale.webm",{"src":211,"width":212,"height":213,"alt":214,"copyright":-1},"https://images.prismic.io/fractile-landing-page/aFlifXfc4bHWinuK_scale.jpg",1552,1554,"Abstract dot illustration of scalability, composability and compatibility",{"title":216,"description":217,"video":222},"The fast frontier",{"content":218},[219],{"type":76,"text":220,"spans":221,"direction":27},"Serving tokens cheaper at such a radically faster pace will not only optimise existing deployments, it will create entire new possibilities. Massively longer context windows will enable new workloads, with models capable of complex autonomous tasks like research and software development, compressed from days of human work into minutes.",[],{"sources":223,"text":65,"fallbackImage":228},[224,226],{"src":225,"type":111,"width":-1,"height":-1},"https://fractile-landing-page.cdn.prismic.io/fractile-landing-page/aFligHfc4bHWinuO_parallelism.mov",{"src":227,"type":88,"width":-1,"height":-1},"https://fractile-landing-page.cdn.prismic.io/fractile-landing-page/aFlig3fc4bHWinuS_parallelism.webm",{"src":229,"width":212,"height":213,"alt":230,"copyright":-1},"https://images.prismic.io/fractile-landing-page/aFlifXfc4bHWinuL_parallelism.jpg","/mock/edito-card-reel/parallelism.jpg",{"kicker":232,"title":233,"edito":238,"numberOfJobs":253,"button":254,"jobs":256,"jobsTitle":275,"allJobsLink":276,"anchor":-1},"Team & Jobs",{"content":234},[235],{"type":24,"text":236,"spans":237,"direction":27},"Join us and build the future of AI",[],{"content":239},[240,243,245,248,250],{"type":76,"text":241,"spans":242,"direction":27},"Fractile’s hardware performance is only possible because of the full-stack approach we take to building the next class of processors for AI acceleration. Our team spans transistor-level circuit design up to cloud inference server logic, and everything in between. ",[],{"type":76,"text":65,"spans":244,"direction":27},[],{"type":76,"text":246,"spans":247,"direction":27},"Fractile is home to some of the world’s most talented, driven and energetic technologists and thinkers, who are inspired to take on some of the world’s most impactful technical challenges in a deeply collaborative environment. ",[],{"type":76,"text":65,"spans":249,"direction":27},[],{"type":76,"text":251,"spans":252,"direction":27},"If you are interested in being a part of the Fractile mission, then we would love to hear from you.",[],39,{"to":8,"text":255,"target":10},"Discover the team",[257,262,267,271],{"kicker":258,"title":259,"link":260}," Bristol","Board Test Engineer",{"to":261,"target":46},"https://job-boards.eu.greenhouse.io/fractile/jobs/4740021101",{"kicker":263,"title":264,"link":265},"Bristol","Developer Experience / DevEx",{"to":266,"target":46},"https://job-boards.eu.greenhouse.io/fractile/jobs/4890205101",{"kicker":268,"title":264,"link":269},"London",{"to":270,"target":46},"https://job-boards.eu.greenhouse.io/fractile/jobs/4890206101",{"kicker":258,"title":272,"link":273},"DRAM Product Engineer",{"to":274,"target":46},"https://job-boards.eu.greenhouse.io/fractile/jobs/4895770101","Selected positions",{"to":12,"text":277,"target":10},"View all positions",{"kicker":279,"title":280,"logos":285,"mobileBackground":296,"desktopBackground":300,"anchor":-1},"They trust us",{"content":281},[282],{"type":24,"text":283,"spans":284,"direction":27},"Advancing AI with Industry Leaders",[],[286,291],{"src":287,"width":288,"height":289,"alt":290,"copyright":-1},"https://fractile-landing-page.cdn.prismic.io/fractile-landing-page/aB3XEidWJ-7kR0e5_nvidia.svg",78,79,"Nvidia logo",{"src":292,"width":293,"height":294,"alt":295,"copyright":-1},"https://fractile-landing-page.cdn.prismic.io/fractile-landing-page/aB3XECdWJ-7kR0e3_IBM.svg",87,33,"IBM logo",{"src":297,"width":298,"height":103,"alt":299,"copyright":-1},"https://images.prismic.io/fractile-landing-page/aCHFfCdWJ-7kR6_g_Mobilepartnersimage.webp",2434,"Fractile tiles",{"src":301,"width":298,"height":103,"alt":299,"copyright":-1},"https://images.prismic.io/fractile-landing-page/aCGz-CdWJ-7kR6iS_Desktoppartnersimage.webp",{"kicker":38,"button":303,"title":305,"readLabel":309,"articleCards":310,"anchor":-1},{"to":15,"text":304,"target":10},"See more",{"content":306},[307],{"type":24,"text":16,"spans":308,"direction":27},[],"read",[311,318],{"date":312,"readDuration":313,"publisher":-1,"title":314,"external":55,"link":315,"description":65},"May 2026",5,"Fractile raises $220M to build the next generation of inference hardware ",{"to":316,"text":317,"target":10},"/news/fractile-raises-220m-to-build-the-next-generation-of-inference-hardware","Read more",{"date":312,"readDuration":313,"publisher":319,"title":320,"external":321,"link":322,"description":324},"Wall Street Journal","Chips Startup Fractile Raises $220 Million to Speed Up AI Queries",true,{"to":323,"text":317,"target":46},"https://www.wsj.com/tech/ai/chips-startup-fractile-raises-220-million-to-speed-up-ai-queries-c8681944","Factorial Funds, Accel and Peter Thiel’s Founders Fund invested in the company.",{"left":54,"top":54,"width":326,"height":326,"rotate":54,"vFlip":55,"hFlip":55,"body":327},22,"\u003Cg fill=\"none\">\u003Crect width=\"7.07091\" height=\"7.07091\" rx=\"1.36194\" transform=\"matrix(0.707085 -0.707128 0.707085 0.707128 0 11.001)\" fill=\"black\"/>\n\u003Crect width=\"7.07091\" height=\"7.07091\" rx=\"1.36194\" transform=\"matrix(0.707085 -0.707128 0.707085 0.707128 6.00031 5)\" fill=\"black\"/>\n\u003Crect width=\"7.07091\" height=\"7.07091\" rx=\"1.36194\" transform=\"matrix(0.707085 -0.707128 0.707085 0.707128 12.0005 11.001)\" fill=\"black\"/>\n\u003Crect width=\"7.07091\" height=\"7.07091\" rx=\"1.36194\" transform=\"matrix(0.707085 -0.707128 0.707085 0.707128 6.00031 17)\" fill=\"black\"/>\u003C/g>",{"left":54,"top":54,"width":50,"height":50,"rotate":54,"vFlip":55,"hFlip":55,"body":329},"\u003Cg fill=\"none\">\u003Cpath d=\"M23 22.4207H20.2062V5.76901L2.97624 23L1 21.0238L18.231 3.79382H1.57933V1H21.6031L21.7458 1.00735C22.4503 1.07885 23 1.67353 23 2.39691V22.4207Z\" fill=\"black\"/>\u003C/g>",["Reactive",331],{"$ssite-config":332},{"_priority":333,"env":337,"name":338,"url":339},{"name":334,"env":335,"url":336},-5,-15,-4,"production","fractile-landing-page","https://www.fractile.ai/",["Set"],["ShallowReactive",342],{"default-layout":343,"home":343,"i-local-icon:right-chevron":343,"i-local-icon:tiles-icon":343,"i-local-icon:top-right-arrow":343},null,"/"]</script>
