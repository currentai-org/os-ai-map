<li about="#cite_note-:0-2" id="cite_note-:0-2" data-mw-footnote-number="2"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwpA"><a href="#cite_ref-:0_2-0" id="mwpQ"><span class="mw-linkback-text" id="mwpg">1</span></a> <a href="#cite_ref-:0_2-1" id="mwpw"><span class="mw-linkback-text" id="mwqA">2</span></a> <a href="#cite_ref-:0_2-2" id="mwqQ"><span class="mw-linkback-text" id="mwqg">3</span></a></span> <span id="mw-reference-text-cite_note-:0-2" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt13" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwqw" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web ","href":"./Template:Cite_web"},"params":{"last":{"wt":"Jing"},"first":{"wt":"Meng"},"date":{"wt":"22 November 2019"},"title":{"wt":"Meet the brothers who put AI chips in 100 million devices"},"url":{"wt":"https://www.scmp.com/tech/start-ups/article/3038734/brothers-behind-cambricon-chip-start-powering-chinas-ai-ambitions"},"access-date":{"wt":"24 February 2024"},"website":{"wt":"South China Morning Post"},"language":{"wt":"en"}},"i":0}}]}'/><cite id="CITEREFJing2019" class="citation web cs1" about="#mwt13">Jing, Meng (22 November 2019). <a rel="mw:ExtLink nofollow" href="https://www.scmp.com/tech/start-ups/article/3038734/brothers-behind-cambricon-chip-start-powering-chinas-ai-ambitions" class="external text" id="mwrA">"Meet the brothers who put AI chips in 100 million devices"</a>. <i id="mwrQ">South China Morning Post</i><span class="reference-accessdate" id="mwrg">. Retrieved <span class="nowrap" id="mwrw">24 February</span> 2024</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=South+China+Morning+Post&amp;rft.atitle=Meet+the+brothers+who+put+AI+chips+in+100+million+devices&amp;rft.date=2019-11-22&amp;rft.aulast=Jing&amp;rft.aufirst=Meng&amp;rft_id=https%3A%2F%2Fwww.scmp.com%2Ftech%2Fstart-ups%2Farticle%2F3038734%2Fbrothers-behind-cambricon-chip-start-powering-chinas-ai-ambitions&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ACambricon+Technologies" class="Z3988" about="#mwt13" id="mwsA"></span></span></li>
