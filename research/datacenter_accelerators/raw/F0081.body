e27e7772607d128f890d21c5-783x915.png?auto=format&amp;dpr=2&amp;fit=max&amp;q=75&amp;w=350 350w, https://cdn.sanity.io/images/e4qjo92p/production/ac4d09d9eefecc4be27e7772607d128f890d21c5-783x915.png?auto=format&amp;dpr=2&amp;fit=max&amp;q=75&amp;w=700 700w, https://cdn.sanity.io/images/e4qjo92p/production/ac4d09d9eefecc4be27e7772607d128f890d21c5-783x915.png?auto=format&amp;dpr=2&amp;fit=max&amp;q=75&amp;w=783 783w" src="https://cdn.sanity.io/images/e4qjo92p/production/ac4d09d9eefecc4be27e7772607d128f890d21c5-783x915.png?auto=format&amp;dpr=2&amp;fit=max&amp;q=75&amp;w=700" width="700" height="818"/></figure><div class="flex flex-col gap-8 justify-between flex-1 "><div class="space-y-4"><h3 class="whitespace-pre-wrap text-[20px] md:text-[20px] leading-[1.3] -tracking-[0.02em] font-medium">Three WSE-3 Turbos per System​</h3><div class="[&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0"><p class="whitespace-pre-wrap text-[16px] md:text-[16px] leading-[1.5] font-medium mb-4">Each wafer delivers up to 2x the speed of the previous generation​</p></div></div></div></div><div class="flex-1 flex flex-col gap-6 rounded-lg"><figure class="block aspect-[325/370] w-full rounded-lg overflow-hidden relative"><img alt="" loading="lazy" class="block max-w-full object-cover w-full h-full absolute inset-0" sizes="40vw" srcSet="https://cdn.sanity.io/images/e4qjo92p/production/2aa8a745a65a0feead73341133cd832d347f8add-1920x2172.png?auto=format&amp;dpr=2&amp;fit=max&amp;q=75&amp;w=350 350w, https://cdn.sanity.io/images/e4qjo92p/production/2aa8a745a65a0feead73341133cd832d347f8add-1920x2172.png?auto=format&amp;dpr=2&amp;fit=max&amp;q=75&amp;w=700 700w, https://cdn.sanity.io/images/e4qjo92p/production/2aa8a745a65a0feead73341133cd832d347f8add-1920x2172.png?auto=format&amp;dpr=2&amp;fit=max&amp;q=75&amp;w=1050 1050w, https://cdn.sanity.io/images/e4qjo92p/production/2aa8a745a65a0feead73341133cd832d347f8add-1920x2172.png?auto=format&amp;dpr=2&amp;fit=max&amp;q=75&amp;w=1400 1400w" src="https://cdn.sanity.io/images/e4qjo92p/production/2aa8a745a65a0feead73341133cd832d347f8add-1920x2172.png?auto=format&amp;dpr=2&amp;fit=max&amp;q=75&amp;w=700" width="700" height="792"/></figure><div class="flex flex-col gap-8 justify-between flex-1 "><div class="space-y-4"><h3 class="whitespace-pre-wrap text-[20px] md:text-[20px] leading-[1.3] -tracking-[0.02em] font-medium">Faster Wafer I/O</h3><div class="[&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0"><p class="whitespace-pre-wrap text-[16px] md:text-[16px] leading-[1.5] font-medium mb-4">Scales massive models and enables heterogeneous, disaggregated inference</p></div></div></div></div><div class="flex-1 flex flex-col gap-6 rounded-lg"><figure class="block aspect-[325/370] w-full rounded-lg overflow-hidden relative"><img alt="" loading="lazy" class="block max-w-full object-cover w-full h-full absolute inset-0" sizes="40vw" srcSet="https://cdn.sanity.io/images/e4qjo92p/production/c7f995780e1f92ff5b62b44381de787465bc11e9-1920x1920.png?auto=format&amp;dpr=2&amp;fit=max&amp;q=75&amp;w=350 350w, https://cdn.sanity.io/images/e4qjo92p/production/c7f995780e1f92ff5b62b44381de787465bc11e9-1920x1920.png?auto=format&amp;dpr=2&amp;fit=max&amp;q=75&amp;w=700 700w, https://cdn.sanity.io/images/e4qjo92p/production/c7f995780e1f92ff5b62b44381de787465bc11e9-1920x1920.png?auto=format&amp;dpr=2&amp;fit=max&amp;q=75&amp;w=1050 1050w, https://cdn.sanity.io/images/e4qjo92p/production/c7f995780e1f92ff5b62b44381de787465bc11e9-1920x1920.png?auto=format&amp;dpr=2&amp;fit=max&amp;q=75&amp;w=1400 1400w" src="https://cdn.sanity.io/images/e4qjo92p/production/c7f995780e1f92ff5b62b44381de787465bc11e9-1920x1920.png?auto=format&amp;dpr=2&amp;fit=max&amp;q=75&amp;w=700" width="700" height="700"/></figure><div class="flex flex-col gap-8 justify-between flex-1 "><div class="space-y-4"><h3 class="whitespace-pre-wrap text-[20px] md:text-[20px] leading-[1.3] -tracking-[0.02em] font-medium">Nexus Rack-Scale Platform</h3><div class="[&amp;&gt;*:first-child]:mt-0 [&amp;&gt;*:last-child]:mb-0"><p class="whitespace-pre-wrap text-[16px] md:text-[16px] leading-[1.5] font-medium mb-4">Enables rapid deployment in hyperscale datacenters​</p></div></div></div></div></div></div><div class="absolute w-[14px] h-[14px] z-10 bottom-[0px] translate-y-1/2 left-[-1] -translate-x-1/2"><div class="absolute w-[14px] h-[7px] overflow-hidden z-10"><div class="rounded-full w-[14px] h-[14px] bg-background-behind"></div></div></div><div class="absolute w-[14px] h-[14px] z-10 bottom-[0px] translate-y-1/2 right-[-1px] translate-x-1/2"><div class="absolute w-[14px] h-[7px] overflow-hidden z-10"><div class="rounded-full w-[14px] h-[14px] bg-background-behind"></div></div></div><div class="absolute right-[-2px] top-0 h-full w-[2px] bg-background-behind z-10"></div></div></div></div></div></section><section data-slicetype="twoUpCards" class="theme-dark theme-dark bg-background text-foreground relative" data-sanity="id=69a5086d-9df6-46ac-a0c0-78ddc5f2937c;type=page;path=slices:412beebc15274d2b32e7ac2bf79235d9;base=https%3A%2F%2Fwww.cerebras.ai"><div class="w-full h-full relative"><div class="bg-background-behind absolute top-0 left-0 h-[2px] w-full z-10"></div><div class="mx-auto px-[2px]"><div class="mx-auto max-w-[1600px]"><div class="relative"><div class="absolute left-[-2px] top-0 h-full w-[2px] bg-background-behind z-10"></div><div class="absolute w-[14px] h-[14px] z-10 top-[0px] -translate-y-1/2 rotate-180 origin-center left-[-1] -translate-x-1/2"><div class="absolute w-[14px] h-[7px] overflow-hidden z-10"><div class="rounded-full w-[14px] h-[14px] bg-background-behind"></div></div></div><div class="absolute w-[14px] h-[14px] z-10 top-[0px] -translate-y-1/2 rotate-180 origin-center right-[-1px] translate-x-1/2"><div class="absolute w-[14px] h-[7px] overflow-hidden z-10"><div class="rounded-full w-[14px] h-[14px] bg-background-behind"></div></div></div><div class="grid-default relative"><div class="flex flex-col gap-[2px] to-md:orde