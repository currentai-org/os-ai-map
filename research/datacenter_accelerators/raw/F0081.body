ns\":null,\"caption\":null,\"children\":[{\"_key\":\"8a0851a5eeae\",\"_type\":\"span\",\"marks\":[],\"text\":\"Cerebras has fundamentally re-imagined the server. Each Wafer-Scale Backpack is a self-contained assembly that folds the wafer, power conversion, direct liquid cooling, high-speed I/O, and control electronics into a compact 3D package with 50% fewer components. This design simplifies manufacturing and reduces deployment time from days to hours.​\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"normal\"}],\"prose\":true,\"className\":\"max-w-[400px]\"}]]}]\n77:[\"$\",\"div\",null,{\"className\":\"absolute w-[14px] h-[14px] z-10 bottom-[0px] translate-y-1/2 left-[-1] -translate-x-1/2\",\"children\":[\"$\",\"div\",null,{\"className\":\"absolute w-[14px] h-[7px] overflow-hidden z-10\",\"children\":[\"$\",\"div\",null,{\"className\""])</script><script>self.__next_f.push([1,":\"rounded-full w-[14px] h-[14px] bg-background-behind\"}]}]}]\n78:[\"$\",\"div\",null,{\"className\":\"absolute w-[14px] h-[14px] z-10 bottom-[0px] translate-y-1/2 right-[-1px] translate-x-1/2\",\"children\":[\"$\",\"div\",null,{\"className\":\"absolute w-[14px] h-[7px] overflow-hidden z-10\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-full w-[14px] h-[14px] bg-background-behind\"}]}]}]\n79:[\"$\",\"div\",null,{\"className\":\"absolute right-[-2px] top-0 h-full w-[2px] bg-background-behind z-10\"}]\n7c:[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[\"$undefined\",[\"$\",\"$L4a\",null,{\"blocks\":[{\"_key\":\"768a10f7a4db\",\"_type\":\"block\",\"asset\":null,\"avatar\":null,\"buttons\":null,\"caption\":null,\"children\":[{\"_key\":\"f7d15e101d3b\",\"_type\":\"span\",\"marks\":[],\"text\":\"High-density power delivery\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"h2\"},{\"_key\":\"857cfc13d643\",\"_type\":\"block\",\"asset\":null,\"avatar\":null,\"buttons\":null,\"caption\":null,\"children\":[{\"_key\":\"6e7cfd0aca6f\",\"_type\":\"span\",\"marks\":[],\"text\":\"With power delivery just 0.5 millimeters away from the processor - roughly 100x closer than the roughly 50mm of conventional GPU boards - CS-4 nearly eliminates board-level power loss. This enables the delivery of twice as much power to the WSE-3T, enabling higher operating frequencies and faster token generation.​\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"normal\"}],\"prose\":true,\"className\":\"max-w-[400px]\"}]]}]\na2:T4b6,data:image/png;base64,:[\"$\",\"$L5c\",\"2419fab88255\",{\"_key\":\"2419fab88255\",\"_type\":\"imageOrVideoCard\",\"aspect\":\"intrinsic\",\"imageOrVideo\":{\"controls\":false,\"image\":{\"altText\":null,\"asset\":{\"_id\":\"image-41dfa7c54517453771770b8510f881239e497c2b-3124x1960-png\",\"_type\":\"sanity.imageAsset\",\"altText\":null,\"metadata\":{\"lqip\":\"$a2\"}},\"crop\":null,\"hotspot\":null},\"loopVideo\":true,\"type\":\"image\",\"video\":null,\"videoFile\":null,\"videoPoster\":null,\"videoUrl\":null},\"disableNotch\":false,\"className\":\"col-span-2 md:col-span-4\"}]\n7e:[\"$\",\"div\",null,{\"className\":\"absolute w-[14px] h-[14px] z-10 bottom-[0px] translate-y-1/2 left-[-1] -translate-x-1/2\",\"children\":[\"$\",\"div\",null,{\"className\":\"absolute w-[14px] h-[7px] overflow-hidden z-10\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-full w-[14px] h-[14px] bg-background-behind\"}]}]}]\n7f:[\"$\",\"div\",null,{\"className\":\"absolute w-[14px] h-[14px] z-10 bottom-[0px] translate-y-1/2 right-[-1px] translate-x-1/2\",\"children\":[\"$\",\"div\",null,{\"className\":\"absolute w-[14px] h-[7px] overflow-hidden z-10\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-full w-[14px] h-[14px] bg-background-behind\"}]}]}]\n80:[\"$\",\"div\",null,{\"className\":\"absolute right-[-2px] top-0 h-full w-[2px] bg-background-behind z-10\"}]\n83:[\"$\",\"div\",null,{\"className\":