className\":\"absolute w-[14px] h-[7px] overflow-hidden z-10\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-full w-[14px] h-[14px] bg-background-behind\"}]}]}],[\"$\",\"div\",null,{\"className\":\"absolute w-[14px] h-[14px] z-10 top-[0px] -translate-y-1/2 rotate-180 origin-center right-[-1px] translate-x-1/2\",\"children\":[\"$\",\"div\",null,{\"className\":\"absolute w-[14px] h-[7px] overflow-hidden z-10\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-full w-[14px] h-[14px] bg-background-behind\"}]}]}],[\"$\",\"$L2c\",null,{\"asChild\":true,\"children\":[\"$\",\"div\",null,{\"ref\":\"$undefined\",\"className\":\"opacity-0 relative bg-background\",\"style\":{\"clipPath\":\"$95\",\"WebkitClipPath\":\"$96\"},\"onClick\":\"$undefined\",\"children\":[\"$L97\",\"$L98\"]}]}],\"$L99\",\"$L9a\",\"$L9b\"]}]}]}]]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"3c:[\"$\",\"$1\",\"d3f129c18042\",{\"children\":[[\"$\",\"$L2a\",null,{\"moduleIds\":[\"9624731384585762409\"]}],[\"$\",\"$L9c\",null,{\"data-sanity\":\"id=69a5086d-9df6-46ac-a0c0-78ddc5f2937c;type=page;path=slices:d3f129c18042;base=https%3A%2F%2Fwww.cerebras.ai\",\"documentId\":\"69a5086d-9df6-46ac-a0c0-78ddc5f2937c\",\"className\":\"$undefined\",\"_key\":\"d3f129c18042\",\"_type\":\"accordion\",\"description\":null,\"items\":[{\"_key\":\"cb8127979a81\",\"body\":[{\"_key\":\"af28efd39d8c\",\"_type\":\"block\",\"asset\":null,\"avatar\":null,\"buttons\":null,\"caption\":null,\"children\":[{\"_key\":\"fa1ee17bf507\",\"_type\":\"span\",\"marks\":[],\"text\":\"Cerebras CS-4 is an integrated rack-scale AI system built from three WSE-3 Turbo processors. It is the first system on the Cerebras Nexus Platform Architecture and delivers up to 30x faster inference than GPU-based systems, up to 2x the speed of CS-3, and up to 10x more throughput per watt than CS-3.\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"normal\"}],\"imageOrVideo\":{\"controls\":false,\"image\":null,\"loopVideo\":true,\"type\":\"image\",\"video\":null,\"videoFile\":null,\"videoPoster\":null,\"videoUrl\":null},\"title\":\"What is Cerebras CS-4? \"},{\"_key\":\"0125f18207ad\",\"body\":[{\"_key\":\"c37cfe6f64c3\",\"_type\":\"block\",\"asset\":null,\"avatar\":null,\"buttons\":null,\"caption\":null,\"children\":[{\"_key\":\"4df28337c95d\",\"_type\":\"span\",\"marks\":[],\"text\":\"CS-4 combines three WSE-3 Turbo processors in one integrated rack-scale system and introduces an entirely new modular architecture for compute, power, and I/O. Compared with CS-3, CS-4 delivers up to 2x faster token generation and up to 10x more throughput per watt, while enabling faster deployment, service, and upgrades.\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"normal\"}],\"imageOrVideo\":{\"controls\":false,\"image\":null,\"loopVideo\":true,\"type\":\"image\",\"video\":null,\"videoFile\":null,\"videoPoster\":null,\"videoUrl\":null},\"title\":\"How is CS4 different from CS-3? \"},{\"_key\":\"6c3ac35d84b1\",\"body\":[{\"_key\":\"729afb9c7a13\",\"_type\":\"block\",\"asset\":null,\"avatar\":null,\"buttons\":null,\"caption\":null,\"children\":[{\"_key\":\"659a6c5f80c1\",\"_type\":\"span\",\"marks\":[],\"text\":\"CS-4 delivers up to 30x faster inference than GPU-based systems and up to 2x the speed of CS-3. Actual performance varies by model architecture, context length, precision, and serving configuration.\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"normal\"}],\"imageOrVideo\":{\"controls\":false,\"image\":null,\"loopVideo\":true,\"type\":\"image\",\"video\":null,\"videoFile\":null,\"videoPoster\":null,\"videoUrl\":null},\"title\":\"How fast is CS-4? \"},{\"_key\":\"6e50d32883a1\",\"body\":[{\"_key\":\"3933e72b62fa\",\"_type\":\"block\",\"asset\":null,\"avatar\":null,\"buttons\":null,\"caption\":null,\"children\":[{\"_key\":\"2ecc5ee45333\",\"_type\":\"span\",\"marks\":[],\"text\":\"CS-4 delivers up to 10x more throughput per watt than CS-3. By producing both higher-value fast tokens and more total tokens within a given power budget, CS-4 is designed to improve data-center economics without sacrificing the interactivity required by real-time AI.\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"normal\"}],\"imageOrVideo\":{\"controls\":false,\"image\":null,\"loopVideo\":true,\"type\":\"image\",\"video\":null,\"videoFile\":null,\"videoPoster\":null,\"videoUrl\":null},\"title\":\"How much throughput does CS-4 provide? \"},{\"_key\":\"d8ff488d5e85\",\"body\":[{\"_key\":\"418f4bf7f2f5\",\"_type\":\"block\",\"asset\":null,\"avatar\":null,\"buttons\":null,\"caption\":null,\"children\":[{\"_key\":\"77a610e3671d\",\"_type\":\"span\",\"marks\":[],\"text\":\"Agentic systems repeatedly reason, plan, use tools, verify outputs, and revise their work. Faster inference gives these systems room for substantially more reasoning, verification, and tool use within the same wall-clock time, enabling more responsive and capable product experiences.\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"normal\"}],\"imageOrVideo\":{\"controls\":false,\"image\":null,\"loopVideo\":true,\"type\":\"image\",\"video\":null,\"videoFile\":null,\"videoPoster\":null,\"videoUrl\":null},\"title\":\"Why is CS-4 well suited for agentic AI? \"},{\"_key\":\"6f6feae8051a\",\"body\":[{\"_key\":\"785e220d686b\",\"_type\":\"block\",\"asset\":null,\"avatar\":null,\"buttons\":null,\"caption\":null,\"children\":[{\"_key\":\"ca0ff8e770b5\",\"_type\":\"span\",\"marks\":[],\"text\":\"A Wafer-Scale Backpack is a self-contained compute assembly built around one WSE-3 Turbo processor. It integrates power conversion, direct liquid cooling, high-speed I/O, and control electronics in a compact, three-dimensional package. Compared with the prior-generation system, it has 50% fewer components, uses 60% more automated manufacturing, and helps reduce deployment time from days to hours.\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"normal\"}],\"imageOrVideo\":{\"controls\":false,\"image\":null,\"loopVideo\":true,\"type\":\"image\",\"video\":null,\"videoFile\":null,\"videoPoster\":null,\"videoUrl\":null},\"title\":\"What is a Wafer-Scale Backpack? \"},{\"_key\":\"63738cd16600\",\"body\":[{\"_key\":\"966d157803d0\",\"_type\":\"block\",\"asset\":null,\"avatar\":null,\"buttons\":null,\"caption\":null,\"children\":[{\"_key\":\"1a09051d4c6e\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Cerebras Nexus Platform Architecture separates compute, power, and I/O into modular elements that can scale and advance independently. This enables faster innovation, rapid deployment and upgrades, and a simpler path to manufacturing, installing, and servicing CS-4 systems across hyperscale data centers.\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"normal\"}],\"imageOrVideo\":{\"controls\":false,\"image\":null,\"loopVideo\":true,\"type\":\"image\",\"video\":null,\"videoFile\":null,\"videoPoster\":null,\"videoUrl\":null},\"title\":\"How does the Nexus Platform Architecture simplify hyperscale deployment? \"},{\"_key\":\"ea59bcc81872\",\"body\":[{\"_key\":\"fbf3c4b15c01\",\"_type\":\"block\",\"asset\":null,\"avatar\":null,\"buttons\":null,\"caption\":null,\"children\":[{\"_key\":\"ed00a44fcb0f\",\"_type\":\"span\",\"marks\":[],\"text\":\"CS-4 supports both aggregated and heterogeneous disaggregated inference. Its programmable Wafer I/O Module supports standards-based RoCE v2 RDMA over Ethernet and Direct Wafer Links with wafer-to-wafer latency as low as two microseconds, enabling massive clusters and models with more than 50 trillion parameters. Disaggregated solutions can pair Cerebras ultra-low-latency decode with purpose-built prefill platforms such as AMD Helios and AWS Trainium.\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"normal\"}],\"imageOrVideo\":{\"controls\":false,\"image\":null,\"loopVideo\":true,\"type\":\"image\",\"video\":null,\"videoFile\":null,\"videoPoster\":null,\"videoUrl\":null},\"title\":\"What models and inference architectures does CS-4 support? \"}],\"notches\":{\"bottomLeft\":true,\"bottomRight\":true,\"topLeft\":true,\"topRight\":true},\"theme\":\"theme-dark\",\"title\":[{\"_key\":\"53cc409b78f4\",\"_type\":\"block\",\"asset\":null,\"avatar\":null,\"buttons\":null,\"caption\":null,\"children\":[{\"_key\":\"387d3ca50bb9\",\"_type\":\"span\",\"marks\":[],\"text\":\"FAQ\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"h2\"}]}]]}]\n"])</script><script>self.__next_f.push([1,"9d:I[443880,[\"/_next/static/chunks/2457ce5e4f1a3b18.js?dpl=dpl_Hd84dH7YMs6DaXb3L8EzVfkqUfey\",\"/_next/static/chunks/a420386646eee72d.js?dpl=dpl_Hd84dH7YMs6DaXb3L8EzVfkqUfey\",\"/_next/static/chunks/654047998a53ac59.js?dpl=dpl_Hd84dH7YMs6DaXb3L8EzVfkqUfey\",\"/_next/static/chunks/be42f0a63c9115a8.js?dpl=dpl_Hd84dH7YMs6DaXb3L8EzVfkqUfey\",\"/_next/static/chunks/4d19d0bfa73a591c.js?dpl=dpl_Hd84dH7YMs6DaXb3L8EzVfkqUfey\",\"/_next/static/chunks/c1731e89f0b5a011.js?dpl=dpl_Hd84dH7YMs6DaXb3L8EzVfkqUfey\",\"/_next/static/chunks/fe703abd1a4efd45.js?dpl=dpl_Hd84dH7YMs6DaXb3L8EzVfkqUfey\",\"/_next/static/chunks/bd065fc4afe8c030.js?dpl=dpl_Hd84dH7YMs6DaXb3L8EzVfkqUfey\",\"/_next/static/chunks/bfcd632257f1f237.js?dpl=dpl_Hd84dH7YMs6DaXb3L8EzVfkqUfey\",\"/_next/static/chunks/b09039ff2e09caf9.js?dpl=dpl_Hd84dH7YMs6DaXb3L8EzVfkqUfey\",\"/_next/static/chunks/3adaf461635b688b.js?dpl=dpl_Hd84dH7YMs6DaXb3L8EzVfkqUfey\"],\"Analytics\"]\n9e:I[413764,[\"/_next/static/chunks/2457ce5e4f1a3b18.js?dpl=dpl_Hd84dH7YMs6DaXb3L8EzVfkqUfey\",\"/_next/static/chunks/a420386646eee72d.js?dpl=dpl_Hd84dH7YMs6DaXb3L8EzVfkqUfey\",\"/_next/static/chunks/654047998a53ac59.js?dpl=dpl_Hd84dH7YM