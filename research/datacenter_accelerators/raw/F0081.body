",null,{\"className\":\"space-y-4\",\"children\":[\"$undefined\",[\"$\",\"$L4a\",null,{\"blocks\":[{\"_key\":\"e2c662cc99ea\",\"_type\":\"block\",\"asset\":null,\"avatar\":null,\"buttons\":null,\"caption\":null,\"children\":[{\"_key\":\"297722a347ce\",\"_type\":\"span\",\"marks\":[],\"text\":\"THE FASTEST \\nWAFER YET​\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"h2\"},{\"_key\":\"475d7d7fce67\",\"_type\":\"block\",\"asset\":null,\"avatar\":null,\"buttons\":null,\"caption\":null,\"children\":[{\"_key\":\"0736486fd86a\",\"_type\":\"span\",\"marks\":[],\"text\":\"CS-4 runs on WSE-3 Turbo—the world’s largest and fastest AI processor. Its four trillion transistors and 900,000 AI cores deliver 250 PFLOPS of compute and 43.2 petabytes per second of memory bandwidth. ​\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"normal\"},{\"_key\":\"a01623e17b19\",\"_type\":\"block\",\"asset\":null,\"avatar\":null,\"buttons\":null,\"caption\":null,\"children\":[{\"_key\":\"83bd2f11e50e\",\"_type\":\"span\",\"marks\":[],\"text\":\"Twice the compute. Twice the bandwidth. Less than half the latency. A massive leap in AI speed and throughput.​\"}],\"image\":null,\"link\":null,\"logotype\":null,\"markDefs\":[],\"muxVideo\":null,\"style\":\"normal\"}],\"prose\":true,\"className\":\"max-w-[400px]\"}]]}]\na3:T4ae,data:image/png;base64,"])</script><script>self.__next_f.push([1,"8a:[\"$\",\"$L5c\",\"2419fab88255\",{\"_key\":\"2419fab88255\",\"_type\":\"imageOrVideoCard\",\"aspect\":\"intrinsic\",\"imageOrVideo\":{\"controls\":false,\"image\":{\"altText\":null,\"asset\":{\"_id\":\"image-cd6b8df9a3450e7d78fd88ac20f8493525c66f2c-3124x1960-png\",\"_type\":\"sanity.imageAsset\",\"altText\":null,\"metadata\":{\"lqip\":\"$a3\"}},\"crop\":null,\"hotspot\":null},\"loopVideo\":true,\"type\":\"image\",\"video\":null,\"videoFile\":null,\"videoPoster\":null,\"videoUrl\":null},\"disableNotch\":false,\"classNa