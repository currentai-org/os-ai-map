n-width:640px){body.skin--responsive .mw-parser-output .infobox-table{display:table!important}body.skin--responsive .mw-parser-output .infobox-table>caption{display:table-caption!important}body.skin--responsive .mw-parser-output .infobox-table>tbody{display:table-row-group}body.skin--responsive .mw-parser-output .infobox-table th,body.skin--responsive .mw-parser-output .infobox-table td{padding-left:inherit;padding-right:inherit}}</style><style data-mw-deduplicate="TemplateStyles:r1326365004" typeof="mw:Extension/templatestyles" about="#mwt5" data-mw='{"name":"templatestyles","attrs":{"src":"Infobox company/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .ib-company .infobox-label{padding-right:0.5em}.mw-parser-output .ib-company-logo img{background-color:#f8f9fa;color:inherit}.mw-parser-output .ib-company-logo .logo-nobg img{background-color:inherit;color:inherit}.mw-parser-output .ib-company-locality,.mw-parser-output .ib-company-country{display:inline}</style></span><table class="infobox ib-company vcard" about="#mwt3" id="mwBw"><caption class="infobox-title fn org" style="font-size: 125%;">Shanghai Enflame Technology Co., Ltd.</caption><tbody><tr><td colspan="2" class="infobox-image ib-company-logo logo"><span class="mw-default-size" typeof="mw:File/Frameless"><a href="https://en.wikipedia.org/wiki/File:Enflame_Technology.svg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Enflame_Technology.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/Enflame_Technology.svg/250px-Enflame_Technology.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/c/cd/Enflame_Technology.svg/500px-Enflame_Technology.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="512" data-file-height="231" data-file-type="drawing" height="113" width="250" class="mw-file-element mw-file-upright" style="--mw-file-upright: 1"/></a></span></td></tr><tr><th scope="row" class="infobox-label"><div style="display: inline-block; line-height: 1.2em; padding: .1em 0; "><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Trade_name" title="Trade name">Trade name</a></div></th><td class="infobox-data">Enflame</td></tr><tr><th scope="row" class="infobox-label"><div style="display: inline-block; line-height: 1.2em; padding: .1em 0; ">Native name</div></th><td class="infobox-data">上海燧原科技股份有限公司</td></tr><tr><th scope="row" class="infobox-label">Type</th><td class="infobox-data category"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Public_company" title="Public company">Public</a></td></tr><tr><th scope="row" class="infobox-label"><div style="display: inline-block; line-height: 1.2em; padding: .1em 0; "><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Ticker_symbol" title="Ticker symbol">Traded as</a></div></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Shanghai_Stock_Exchange" title="Shanghai Stock Exchange">SSE</a>: <a rel="mw:ExtLink nofollow" href="https://english.sse.com.cn/markets/equities/list/overview/?COMPANY_CODE=688801&amp;STOCK_CODE=688801" class="external text">688801</a></td></tr><tr><th scope="row" class="infobox-label">Industry</th><td class="infobox-data category"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Semiconductors" title="Semiconductors" class="mw-redirect">Semiconductors</a></td></tr><tr><th scope="row" class="infobox-label">Founded</th><td class="infobox-data">19<span typeof="mw:Entity"> </span>March 2018<span class="noprint"><span typeof="mw:Entity">;</span><span typeof="mw:Entity"> </span>8 years ago</span><span style="display:none"><span typeof="mw:Entity"> </span>(<span class="bday dtstart published updated">2018-03-19</span>)</span></td></tr><tr><th scope="row" class="infobox-label">Founders</th><td class="infobox-data agent"><span class="mw-empty-elt"><style data-mw-deduplicate="TemplateStyles:r1126788409" typeof="mw:Extension/templatestyles" about="#mwt6" data-mw='{"name":"templatestyles","attrs":{"src":"Plainlist/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .plainlist ol,.mw-parser-output .plainlist ul{line-height:inherit;list-style:none;margin:0;padding:0}.mw-parser-output .plainlist ol li,.mw-parser-output .plainlist ul li{margin-bottom:0}</style></span><div class="plainlist"><ul><li>Zhao Lidong</li><li>Zhang Yalin</li></ul></div></td></tr><tr><th scope="row" class="infobox-label">Headquarters</th><td class="infobox-data label"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Shanghai" title="Shanghai">Shanghai</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/China" title="China">China</a><span style="display:none" data-plural="0"></span></td></tr><tr><th scope="row" class="infobox-label">Key<span typeof="mw:Entity"> </span>people</th><td class="infobox-data agent">Zhang Yalin (CEO)</td></tr><tr><th scope="row" class="infobox-label">Website</th><td class="infobox-data"><span class="url"><a rel="mw:ExtLink nofollow" href="http://www.enflame-tech.com" class="external text">www<wbr/>.enflame-tech<wbr/>.com</a></span></td></tr></tbody></table>

<p id="mwCA"><b id="mwCQ">Shanghai Enflame Technology Co., Ltd.</b> (Enflame; <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Simplified_Chinese_characters" title="Simplified Chinese characters" about="#mwt7" typeof="mw:Transclusion" id="mwCg" data-mw='{"parts":[{"template":{"target":{"wt":"Zh","href":"./Template:Zh"},"params":{"c":{"wt":""},"p":{"wt":"Suìyuán Kējì"},"s":{"wt":"燧原科技"}},"i":0}}]}'>Chinese</a><span typeof="mw:Entity" about="#mwt7">:</span><span about="#mwt7"> </span><span lang="zh-Hans" about="#mwt7"><link rel="mw:PageProp/Category" href="./Category:Articles_containing_simplified_Chinese-language_text"/>燧原科技</span><span about="#mwt7">; </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pinyin" title="Pinyin" about="#mwt7">pinyin</a><span typeof="mw:Entity" about="#mwt7">:</span><span about="#mwt7"> </span><i about="#mwt7" id="mwCw"><span lang="zh-Latn">Suìyuán Kējì</span></i>) is a Chinese technology company headquartered in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Shanghai" title="Shanghai" id="mwDA">Shanghai</a>.</p>

<p id="mwDQ">The company develops <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/General-purpose_computing_on_graphics_processing_units" title="General-purpose computing on graphics processing units" id="mwDg">general-purpose computing on graphics processing units</a> (GPGPUs) for use in the field of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Cloud_computing" title="Cloud computing" id="mwDw">cloud computing</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Artificial_intelligence" title="Artificial intelligence" id="mwEA">artificial intelligence</a> (AI). It has been compared to <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Nvidia" title="Nvidia" id="mwEQ">Nvidia</a> due to their similar focus.</p>

</section><section data-mw-section-id="1" id="mwEg" aria-labelledby="Background"><div class="mw-heading mw-heading2"><h2 id="Background">Background</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Enflame&amp;action=edit&amp;section=1" title="Edit section: Background"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>

<p id="mwEw">Enflame was founded in March 2018 by two former <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/AMD" title="AMD" id="mwFA">AMD</a> employees.<sup about="#mwt10" class="mw-ref reference" id="cite_ref-:0_1-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":0"},"body":{"id":"mw-reference-text-cite_note-:0-1"}}'><a href="#cite_note-:0-1" id="mwFQ"><span class="mw-reflink-text" id="mwFg"><span class="cite-bracket" id="mwFw">[</span>1<span class="cite-bracket" id="mwGA">]</span></span></a></sup><sup about="#mwt13" class="mw-ref reference" id="cite_ref-:1_2-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":1"},"body":{"id":"mw-reference-text-cite_note-:1-2"}}'><a href="#cite_note-:1-2" id="mwGQ"><span class="mw-reflink-text" id="mwGg"><span class="cite-bracket" id="mwGw">[</span>2<span class="cite-bracket" id="mwHA">]</span></span></a></sup> Early on, it received funding from investors such as <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Tencent" title="Tencent" id="mwHQ">Tencent</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ZhenFund" title="ZhenFund" id="mwHg">ZhenFund</a>.<sup about="#mwt14" class="mw-ref reference" id="cite_ref-:0_1-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":0"}}'><a href="#cite_note-:0-1" id="mwHw"><span class="mw-reflink-text" id="mwIA"><span class="cite-bracket" id="mwIQ">[</span>1<span class="cite-bracket" id="mwIg">]</span></span></a></sup> Other investors include <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Meitu" title="Meitu" id="mwIw">Meitu</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Primavera_Capital_Group" title="Primavera Capital Group" id="mwJA">Primavera Capital Group</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/CITIC_Private_Equity" title="CITIC Private Equity" class="mw-redirect" id="mwJQ">CITIC Private Equity</a> and the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/China_Integrated_Circuit_Industry_Investment_Fund" title="China Integrated Circuit Industry Investment Fund" id="mwJg">China Integrated Circuit Industry Investment Fund</a>.<sup about="#mwt17" class="mw-ref reference" id="cite_ref-3" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-3"}}'><a href="#cite_note-3" id="mwJw"><span class="mw-reflink-text" id="mwKA"><span class="cite-bracket" id="mwKQ">[</span>3<span class="cite-bracket" id="mwKg">]</span></span></a></sup></p>

<p id="mwKw">In October 2018, Enflame purchased multiple licenses of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Arteris" title="Arteris" id="mwLA">Arteris</a> FlexNoC interconnect for use as the on-chip communications backbone of its AI training chips in cloud data centers.<sup about="#mwt18" class="mw-ref reference" id="cite_ref-:0_1-2" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":0"}}'><a href="#cite_note-:0-1" id="mwLQ"><span class="mw-reflink-text" id="mwLg"><span class="cite-bracket" id="mwLw">[</span>1<span class="cite-bracket" id="mwMA">]</span></span></a></sup></p>

<p id="mwMQ">In June 2024, it was reported that that Enflame submitted downgraded designs of its chips to <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/TSMC" title="TSMC" id="mwMg">TSMC</a> in late 2023 to comply with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/United_States_New_Export_Controls_on_Advanced_Computing_and_Semiconductors_to_China" title="United States New Export Controls on Advanced Computing and Semiconductors to China" id="mwMw">U.S. restrictions</a>. Enflame has been noted to sell its chips to <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/State-owned_enterprises_of_China" title="State-owned enterprises of China" id="mwNA">state-owned enterprises</a> and has cooperated with several local governments on projects.<sup about="#mwt21" class="mw-ref reference" id="cite_ref-4" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-4"}}'><a href="#cite_note-4" id="mwNQ"><span class="mw-reflink-text" id="mwNg"><span class="cite-bracket" id="mwNw">[</span>4<span class="cite-bracket" id="mwOA">]</span></span></a></sup></p>

<p id="mwOQ">In August 2024, Enflame stated it planned to hold an <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Initial_public_offering" title="Initial public offering" id="mwOg">initial public offering</a> (IPO) on the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Shanghai_Stock_Exchange_STAR_Market" title="Shanghai Stock Exchange STAR Market" id="mwOw">Shanghai Stock Exchange STAR Market</a> and had hired <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/China_International_Capital_Corporation" title="China International Capital Corporation" id="mwPA">China International Capital Corporation</a> to advise on the process.<sup about="#mwt22" class="mw-ref reference" id="cite_ref-:1_2-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":1"}}'><a href="#cite_note-:1-2" id="mwPQ"><span class="mw-reflink-text" id="mwPg"><span class="cite-bracket" id="mwPw">[</span>2<span class="cite-bracket" id="mwQA">]</span></span></a></sup><sup about="#mwt25" class="mw-ref reference" id="cite_ref-:2_5-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":2"},"body":{"id":"mw-reference-text-cite_note-:2-5"}}'><a href="#cite_note-:2-5" id="mwQQ"><span class="mw-reflink-text" id="mwQg"><span class="cite-bracket" id="mwQw">[</span>5<span class="cite-bracket" id="mwRA">]</span></span></a></sup></p>

<p id="mwRQ">In October 2024, it was reported that Enflame had partnered with government entities in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wuxi" title="Wuxi" id="mwRg">Wuxi</a> to begin construction of an AI computing hub there.<sup about="#mwt28" class="mw-ref reference" id="cite_ref-6" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-6"}}'><a href="#cite_note-6" id="mwRw"><span class="mw-reflink-text" id="mwSA"><span class="cite-bracket" id="mwSQ">[</span>6<span class="cite-bracket" id="mwSg">]</span></span></a></sup></p>

<p id="mwSw">In September 2026, Enflame held its IPO to become a listed company on the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Shanghai_Stock_Exchange" title="Shanghai Stock Exchange" id="mwTA">Shanghai Stock Exchange</a>.<sup about="#mwt31" class="mw-ref reference" id="cite_ref-7" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-7"}}'><a href="#cite_note-7" id="mwTQ"><span class="mw-reflink-text" id="mwTg"><span class="cite-bracket" id="mwTw">[</span>7<span class="cite-bracket" id="mwUA">]</span></span></a></sup></p>

</section><section data-mw-section-id="2" id="mwUQ" aria-labelledby="See_also"><div class="mw-heading mw-heading2"><h2 id="See_also">See also</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Enflame&amp;action=edit&amp;section=2" title="Edit section: See also"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<ul id="mwUg"><li id="mwUw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Cambricon_Technologies" title="Cambricon Technologies" id="mwVA">Cambricon Technologies</a></li>
<li id="mwVQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/MetaX" title="MetaX" id="mwVg">MetaX</a></li>
<li id="mwVw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Semiconductor_industry_in_China" title="Semiconductor industry in China" id="mwWA">Semiconductor industry in China</a></li></ul>

</section><section data-mw-section-id="3" id="mwWQ" aria-labelledby="References"><div class="mw-heading mw-heading2"><h2 id="References">References</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Enflame&amp;action=edit&amp;section=3" title="Edit section: References"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
