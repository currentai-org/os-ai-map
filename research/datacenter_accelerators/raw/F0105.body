var complianz = {"prefix":"cmplz_","debug":"","user_banner_id":"1","set_cookies":[],"block_ajax_content":"","banner_version":"1870","version":"7.6.4","store_consent":"","do_not_track_enabled":"","consenttype":"optin","region":"us","geoip":"1","dismiss_timeout":"","disable_cookiebanner":"","soft_cookiewall":"","dismiss_on_scroll":"","cookie_expiry":"365","url":"https://vsora.com/wp-json/complianz/v1/","locale":"lang=en&locale=en_US","set_cookies_on_root":"","cookie_domain":"","current_policy_id":"38","cookie_path":"/","categories":{"statistics":"statistics","marketing":"marketing"},"tcf_active":"","placeholdertext":"Click to accept {category} cookies and enable this content","css_file":"https://vsora.com/wp-content/uploads/complianz/css/banner-{banner_id}-{type}.css?v=1870","page_links":{"eu":{"cookie-statement":{"title":"Cookie Policy ","url":"https://vsora.com/cookie-policy/"},"privacy-statement":{"title":"Privacy Policy","url":"https://vsora.com/privacy-policy/"}},"us":{"cookie-statement":{"title":"Opt-out preferences","url":"https://vsora.com/opt-out-preferences/"},"privacy-statement":{"title":"","url":"https://vsora.com/"},"privacy-statement-children":{"title":"","url":"https://vsora.com/"}},"uk":{"cookie-statement":{"title":"Cookie Policy ","url":"https://vsora.com/cookie-policy-uk/"},"privacy-statement":{"title":"","url":"https://vsora.com/"},"privacy-statement-children":{"title":"","url":"https://vsora.com/"}}},"tm_categories":"","forceEnableStats":"","preview":"","clean_cookies":"","aria_label":"Click to accept {category} cookies and enable this content","iapi_nav":"fallback"};
