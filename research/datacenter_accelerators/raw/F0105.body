<style id="backbone-header-fix">
/* --- Backbone header fix (style.css du theme non charge en mode canvas Elementor) --- */
.bg-wrapper{position:fixed;top:0;left:0;width:100%;height:100vh;z-index:-1;}
header#header{position:fixed;top:0;left:0;right:0;width:100%;background:none;color:#fff;box-shadow:none;z-index:99;}
.admin-bar header#header{top:32px;}
header#header .content-wrapper{max-width:1600px;margin:0 auto;padding:0 32px;position:relative;width:100%;box-sizing:border-box;}
header#header .header-main{width:100%;max-width:1260px;margin:10px auto 0;min-height:64px;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;position:relative;padding:10px 0;}
header#header .header-left,header#header .header-right{display:flex;align-items:center;}
header#header .header-left .logotype{display:flex;align-items:center;}
header#header .header-left .logotype img{width:180px;height:auto;max-width:180px;display:block;}
#menu-primary ul.menu-main-list{display:flex;gap:25px;margin:0;padding:0;list-style:none;align-items:center;}
#menu-primary ul.menu-main-list li{display:flex;align-items:center;position:relative;}
#menu-primary ul.menu-main-list a{color:#fff;font-size:17px;text-decoration:none;line-height:1.2;}
#menu-primary ul.menu-main-list a:hover{color:#EC6726;}
header#header .mobile-main-wrapper .mobile-inner{position:fixed;top:0;bottom:0;right:-360px;width:360px;max-width:85vw;height:100vh;z-index:999;background:#0b0e14;overflow:hidden;box-sizing:border-box;transition:right .4s ease-in-out;}
header#header .mobile-main-wrapper.open .mobile-inner{right:0;box-shadow:-7px 0 18px rgba(0,0,0,.35);}
header#header .mobile-main-wrapper .mobile-inner-wrap{height:100%;overflow-y:auto;padding:80px 32px 40px;box-sizing:border-box;}
header#header .mobile-main-wrapper .mobile-main-list{list-style:none;margin:0;padding:0;}
header#header .mobile-main-wrapper .mobile-main-list li{display:block;padding:8px 0;}
header#header .mobile-main-wrapper .mobile-main-list a{color:#fff;text-decoration:none;font-size:20px;}
header#header .mobile-menu-button{display:none;cursor:pointer;width:34px;height:22px;position:relative;z-index:1000;}
header#header .mobile-menu-button .menu-btn{width:100%;height:100%;position:relative;}
header#header .mobile-menu-button .bar1,header#header .mobile-menu-button .bar2{position:absolute;left:0;width:100%;height:3px;background-color:#fff;border-radius:2px;transition:all .3s;}
header#header .mobile-menu-button .bar1{top:4px;}
header#header .mobile-menu-button .bar2{bottom:4px;}
header#header .mobile-menu-button.open .bar1{top:50%;transform:translateY(-50%) rotate(45deg);}
header#header .mobile-menu-button.open .bar2{bottom:auto;top:50%;transform:translateY(-50%) rotate(-45deg);}
@media screen and (max-width:959px){
  #menu-primary{display:none;}
  header#header .mobile-menu-button{display:block;}
}
@media screen and (min-width:960px){
  header#header .mobile-menu-button{display:none;}
  header#header .mobile-main-wrapper{display:none;}
}
@media all and (max-width:768px){
  header#header .header-left .logotype img{width:130px;max-width:130px;}
  header#header .content-wrapper{padding:0 18px;}
}

</style>
