				<div class="elementor-widget-container">
															<img loading="lazy" decoding="async" width="800" height="598" src="https://vsora.com/wp-content/uploads/2025/04/SPEED_PRICE_NEW-1024x766.png" class="attachment-large size-large wp-image-488" alt="" srcset="https://vsora.com/wp-content/uploads/2025/04/SPEED_PRICE_NEW-1024x766.png 1024w, https://vsora.com/wp-content/uploads/2025/04/SPEED_PRICE_NEW-300x224.png 300w, https://vsora.com/wp-content/uploads/2025/04/SPEED_PRICE_NEW-768x574.png 768w, https://vsora.com/wp-content/uploads/2025/04/SPEED_PRICE_NEW-1536x1149.png 1536w, https://vsora.com/wp-content/uploads/2025/04/SPEED_PRICE_NEW-2048x1531.png 2048w" sizes="(max-width: 800px) 100vw, 800px" />															</div>
