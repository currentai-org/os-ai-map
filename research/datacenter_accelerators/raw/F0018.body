0x3200.png\"},\"video\":null}],\"shippingNoteI18n\":[{\"_key\":\"9SqAZx1N8m9IspGhLs8Mol\",\"_type\":\"internationalizedArrayStringValue\",\"language\":\"en\"}],\"slug\":{\"_type\":\"slug\",\"current\":\"wormhole-n300d\"},\"store\":{\"barcode\":null,\"compareAtPrice\":0,\"createdAt\":\"2025-02-06T05:13:21-08:00\",\"gid\":\"gid://shopify/ProductVariant/45512611627162\",\"id\":45512611627162,\"inventory\":{\"isAvailable\":true,\"policy\":\"CONTINUE\"},\"isDeleted\":false,\"option1\":\"n300d\",\"option2\":\"\",\"option3\":\"\",\"price\":1449,\"productGid\":\"gid://shopify/Product/7634272190618\",\"productId\":7634272190618,\"shop\":{\"domain\":\"tenstorrent.myshopify.com\"},\"sku\":\"TC-02004/65-0000E-2\",\"status\":\"active\",\"title\":\"n300d\",\"variants\":null},\"subtitle\":\"Active (Axial Fan) cooling\",\"title\":\"Wormhole™ n300d\"},{\"_createdAt\":\"2025-02-06T13:13:04Z\",\"_id\":\"shopifyProductVariant-45512611528858\",\"_rev\":\"DtEQ1iYMGLUvUeLzWpdb97\",\"_system\":{\"base\":{\"id\":\"shopifyProductVariant-45512611528858\",\"rev\":\"DKZJqyvcXEh3wTKaZQAn7V\"}},\"_type\":\"product\",\"_updatedAt\":\"2026-07-30T20:01:14Z\",\"bodyI18n\":[{\"_key\":\"9SqAZx1N8m9IspGhLs8Rem\",\"_type\":\"internationalizedArrayBodyValue\",\"language\":\"en\",\"value\":[{\"_key\":\"9c9da57dc1a5\",\"_type\":\"block\",\"children\":[{\"_key\":\"b82a33787274\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n300s features two of Tenstorrent’s flexible, scalable Wormhole™ Tensix Processors operating at up to 300W, offering superior performance for cost compared to traditional GPUs and broad data precision format support. The processor can network into a multichip mesh for workstations and servers (such as Galaxy) and is supported by Tenstorrent’s fully open source software stack, granting developers full access to the metal. n300s includes a dual-slot passive heatsink and separate, bundled Active Cooling Kit.\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"9SqAZx1N8m9IspGhLs8Ri9\",\"_type\":\"internationalizedArrayBodyValue\",\"language\":\"ja\",\"value\":[{\"_key\":\"15ebc671a21d\",\"_type\":\"block\",\"children\":[{\"_key\":\"4356b282a8c4\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n300s は、最大 300W で動作する Tenstorrent の柔軟でスケーラブルな Wormhole™ Tensix プロセッサ 2 基を搭載しており、従来の GPU に比べてコストパフォーマンスに優れ、幅広いデータ精度フォーマットをサポートしています。このプロセッサは、ワークステーションやサーバー (Galaxy など) のマルチチップ メッシュにネットワーク化でき、高レベル (TT-Buda™) または低レベル (TT-Metalium™) 開発用の 2 つのオープン ソース SDK でサポートされています。n300sにはデュアルスロットのパッシブヒートシンクと、別途同梱されたアクティブクーリングキットが含まれています。\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"9SqAZx1N8m9IspGhLs8RlW\",\"_type\":\"internationalizedArrayBodyValue\",\"language\":\"ko\",\"value\":[{\"_key\":\"81e9e03148fa\",\"_type\":\"block\",\"children\":[{\"_key\":\"a3b1169d44ce\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n300s는 최대 300W에서 작동하는 Tenstorrent의 유연하고 확장 가능한 Wormhole™ Tensix 프로세서 두 개를 탑재하여 기존 GPU와 광범위한 데이터 정밀 형식 지원에 비해 비용 대비 우수한 성능을 제공합니다. 이 프로세서는 워크스테이션 및 서버(예: Galaxy)를 위한 멀티칩 메시로 네트워크화할 수 있으며, 상위 수준(TT-Buda™) 또는 하위 수준(TT-Metalium™) 개발을 위한 두 개의 오픈 소스 SDK로 지원됩니다. n300s는 듀얼 슬롯 패시브 히트싱크와 별도로 제공되는 액티브 쿨링 키트를 포함합니다.\"}],\"markDefs\":[],\"style\":\"normal\"}]}],\"callout\":\"\",\"description\":[{\"_key\":\"7c4cce120cd6\",\"_type\":\"block\",\"asset\":null,\"children\":[{\"_key\":\"51a96fc869d8\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n300s features two of Tenstorrent’s flexible, scalable Wormhole™ Tensix Processors operating at up to 300W, offering superior performance for cost compared to traditional GPUs and broad data precision format support. The processor can network into a multichip mesh for workstations and servers (such as Galaxy) and is supported by Tenstorrent’s fully open source software stack, granting developers full access to the metal. n300s includes a dual-slot passive heatsink and separate, bundled Active Cooling Kit.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"details\":[{\"header\":\"Software Capabilities\",\"text\":[{\"_key\":\"f2d7618e95ea\",\"_type\":\"block\",\"children\":[{\"_key\":\"7d8b53cd5a94\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Wormhole n300s offers a range of capabilities, tailored to suit the needs of ML developers seeking alternatives to traditional GPUs. Our hardware supports a wide array of models, ensuring versatility in your AI projects.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c63943395119\",\"_type\":\"block\",\"children\":[{\"_key\":\"c6f911d5ff42\",\"_type\":\"span\",\"marks\":[],\"text\":\"TT-Forge™: run models right away\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"45d3617c308b\",\"_type\":\"block\",\"children\":[{\"_key\":\"6b4034498ab5\",\"_type\":\"span\",\"marks\":[],\"text\":\"Great for production customers who want to get models up and running with ease. They want flexibility, but don’t have time to program new operations or contact support every time something changes.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a96dd4dc3b6d\",\"_type\":\"block\",\"children\":[{\"_key\":\"ce14d6be0332\",\"_type\":\"span\",\"marks\":[],\"text\":\"TT-Metalium: Open Access to Tenstorrent Hardware \u0026 Software\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2307c7fdc680\",\"_type\":\"block\",\"children\":[{\"_key\":\"6d1d397bf46d\",\"_type\":\"span\",\"marks\":[],\"text\":\"Great for development customers who want to customize their models, write new ones or even run non-machine learning code. No black boxes, encrypted APIs or hidden functions.\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"header\":\"System Requirements\",\"text\":[{\"_key\":\"4766afe9dbff\",\"_type\":\"block\",\"children\":[{\"_key\":\"4daa84c0a7a9\",\"_type\":\"span\",\"marks\":[],\"text\":\"CPU\\nx86_64 architecture*\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"692e82ab1248\",\"_type\":\"block\",\"children\":[{\"_key\":\"efad6b0b2fe1\",\"_type\":\"span\",\"marks\":[],\"text\":\"Motherboard\\nPCI Express 4.0 x16 slot - Dual-slot width\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"275ceb194ffb\",\"_type\":\"block\",\"children\":[{\"_key\":\"35084beb26b9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Memory\\n64 GB\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5d81fe813134\",\"_type\":\"block\",\"children\":[{\"_key\":\"e1412956f2aa\",\"_type\":\"span\",\"marks\":[],\"text\":\"Storage\\n100 GB (≥2TB recommended)Power Connectors\\n4+4-pin EPS12V** (add'l. 6+2-pin PCIe required if using Active Cooling Kit) (cable not included)\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4976918a409a\",\"_type\":\"block\",\"children\":[{\"_key\":\"cc6b7a7fb210\",\"_type\":\"span\",\"marks\":[],\"text\":\"Total Board Power\\nUp to 300W\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"41ac5044c763\",\"_type\":\"block\",\"children\":[{\"_key\":\"7b15cf65f359\",\"_type\":\"span\",\"marks\":[],\"text\":\"Operating Temperature Range (Die)\\n0C - 75C\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5dfc9732c020\",\"_type\":\"block\",\"children\":[{\"_key\":\"6c596b56d064\",\"_type\":\"span\",\"marks\":[],\"text\":\"Operating System\\nUbuntu version 22.04 (Jammy Jellyfish)**\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7d86ad633bc4\",\"_type\":\"block\",\"children\":[{\"_key\":\"887ac43c07b2\",\"_type\":\"span\",\"marks\":[],\"text\":\"Internet Connection\\nRequired for driver and stack installation.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c512f76feb05\",\"_type\":\"block\",\"children\":[{\"_key\":\"934adf1164ac\",\"_type\":\"span\",\"marks\":[],\"text\":\"*CPU core count and number of sockets will depend on the amount of host preprocessing and post-processing required before and after the accelerator processing.*\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6c5558efb2f6\",\"_type\":\"block\",\"children\":[{\"_key\":\"df02b569a377\",\"_type\":\"span\",\"marks\":[],\"text\":\"**See \"},{\"_key\":\"e8e44c0b5ca8\",\"_type\":\"span\",\"marks\":[\"71366f538721\"],\"text\":\"FAQ\"},{\"_key\":\"fa57b9fb4454\",\"_type\":\"span\",\"marks\":[],\"text\":\" for more information on PSU cable.\"}],\"markDefs\":[{\"_key\":\"71366f538721\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://docs.tenstorrent.com/aibs/wormhole/support.html\"}],\"style\":\"normal\"},{\"_key\":\"7ae17c113003\",\"_type\":\"block\",\"children\":[{\"_key\":\"82a4789e2c41\",\"_type\":\"span\",\"marks\":[],\"text\":\"***To check your version, type cat /etc/os-release.\"}],\"markDefs\":[],\"style\":\"normal\"}]}],\"displayName\":null,\"eusAgreements\":[{\"_key\":\"c1e447362b4a\",\"_ref\":\"9555d12e-294a-4890-a3f4-bb49b8b7624d\",\"_type\":\"reference\"}],\"images\":[{\"_key\":\"9d672175d42b\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-a364420c39fbc2e1acf15cfbe994a7e7c5cf2bed-1420x1760-jpg\",\"_type\":\"reference\"}},{\"_key\":\"6a218e589463\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-99f2970729110519ddecd5cbdea3d3404488f2e1-1420x1760-jpg\",\"_type\":\"reference\"}},{\"_key\":\"6ef11c24387a\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-20352d1228592bb7142dfef8dfa17e18001462e5-1420x1760-jpg\",\"_type\":\"reference\"}}],\"lead\":{\"inStockOverrideMessage\":\"In stock: Ships in 2 weeks. Transit: 2-5 weeks.\",\"time\":\"in-stock\",\"xWeeksMessage\":\"\",\"xWeeksMessage2\":\"\"},\"leadTime\":{\"type\":\"available\"},\"media\":[{\"image\":{\"_createdAt\":\"2026-04-20T16:14:11Z\",\"_id\":\"image-c3d844345bd2990205e86a216a8906d3e13d9c27-3200x3200-png\",\"_rev\":\"Azr6jnPnblfJFZmxqSawGy\",\"_type\":\"sanity.imageAsset\",\"_updatedAt\":\"2026-04-20T16:14:11Z\",\"assetId\":\"c3d844345bd2990205e86a216a8906d3e13d9c27\",\"extension\":\"png\",\"metadata\":{\"_type\":\"sanity.imageMetadata\",\"blurHash\":\"eA4.Plax8^kE.Aozj[V@WBozD#j]%iWAITV@WCozs:RjacaykEj[jX\",\"dimensions\":{\"_type\":\"sanity.imageDimensions\",\"aspectRatio\":1,\"height\":3200,\"width\":3200},\"hasAlpha\":true,\"isOpaque\":false,\"lqip\":\"$47\",\"palette\":{\"_type\":\"sanity.imagePalette\",\"darkMut