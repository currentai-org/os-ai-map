-DD cable here). p150a is supported by Tenstorrent’s fully open source software stack, granting developers full access to the metal.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"details\":[{\"header\":\"Software Capabilities\",\"text\":[{\"_key\":\"6c9731e54ffe\",\"_type\":\"block\",\"children\":[{\"_key\":\"bf3f487e08f6\",\"_type\":\"span\",\"marks\":[],\"text\":\"Learn more about software capabilities in the \"},{\"_key\":\"02aa639b0b8f\",\"_type\":\"span\",\"marks\":[\"strong\",\"4602b8af627c\"],\"text\":\"Developer Hub\"},{\"_key\":\"78f53e02761b\",\"_type\":\"span\",\"marks\":[],\"text\":\" or visit the \"},{\"_key\":\"5c34f59ec589\",\"_type\":\"span\",\"marks\":[\"65f11e81cbad\",\"strong\"],\"text\":\"Documentation Site\"},{\"_key\":\"940062984e99\",\"_type\":\"span\",\"marks\":[],\"text\":\" for full hardware specifications.\"}],\"markDefs\":[{\"_key\":\"65f11e81cbad\",\"_type\":\"link\",\"href\":\"https://docs.tenstorrent.com/\"},{\"_key\":\"4602b8af627c\",\"_type\":\"link\",\"blank\":false,\"href\":\"https://www.tenstorrent.com/developers\"}],\"style\":\"normal\"}]},{\"header\":\"System Requirements\",\"text\":[{\"_key\":\"757ab356ecc2\",\"_type\":\"block\",\"children\":[{\"_key\":\"43bebee88050\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"CPU: \"},{\"_key\":\"5d4efebaa927\",\"_type\":\"span\",\"marks\":[],\"text\":\"x86_64 architecture*\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6881fbe5c7f9\",\"_type\":\"block\",\"children\":[{\"_key\":\"75e2f91cb7c4\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Motherboard: \"},{\"_key\":\"b6760dc08dc6\",\"_type\":\"span\",\"marks\":[],\"text\":\"PCI Express 5.0 x16 slot, dual-slot width**\"}],\"level\":1,\"listItem\":\"bullet\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0122d16282f8\",\"_type\":\"block\",\"children\":[{\"_key\":\"38ad386e8865\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Memory: \"},{\"_key\":\"49d8e74274c4\",\"_type\":\"s