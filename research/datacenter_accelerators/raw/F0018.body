population\":0,\"title\":\"#fff\"},\"vibrant\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#ad8d51\",\"foreground\":\"#fff\",\"population\":0,\"title\":\"#fff\"}},\"thumbHash\":\"FAiCBQASp0WEl4r1BxtQfgroh1aGh4Cnpw==\"},\"mimeType\":\"image/png\",\"originalFilename\":\"qsfp-dd-800g-cable.png\",\"path\":\"images/jpb4ed5r/production/f441aa199809b5fb60938c51c4b56290f4f4d380-2920x2920.png\",\"sha1hash\":\"f441aa199809b5fb60938c51c4b56290f4f4d380\",\"size\":1550207,\"uploadId\":\"H5Av9pHJuVaUiSURs9YhQD81L2wItOOk\",\"url\":\"https://cdn.sanity.io/images/jpb4ed5r/production/f441aa199809b5fb60938c51c4b56290f4f4d380-2920x2920.png\"},\"video\":null}],\"shippingNoteI18n\":[{\"_key\":\"UGwWtdJ2seQbU9nVXIASX6\",\"_type\":\"internationalizedArrayStringValue\",\"language\":\"en\"}],\"slug\":{\"_type\":\"slug\",\"current\":\"qsfp-dd-800g-cable\"},\"store\":{\"createdAt\":\"2025-10-10T09:43:04-07:00\",\"descriptionHtml\":\"\u003cp\u003e\u003cspan style=\\\"font-size: 11pt; font-family: Arial,sans-serif; color: #000000; background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline; white-space: pre-wrap;\\\" id=\\\"docs-internal-guid-53d9f007-7fff-5fcc-3a09-ecee88fd2dd8\\\"\u003eThis passive 0.5m QSFP-DD cable from FS inc. can be used for connectivity between add-in boards and systems built around Tenstorrent Blackhole™ Tensix Processors.\u003c/span\u003e\u003c/p\u003e\",\"gid\":\"gid://shopify/Product/8646402277530\",\"id\":8646402277530,\"isDeleted\":false,\"options\":[{\"_key\":\"Size\",\"_type\":\"option\",\"name\":\"Size\",\"values\":[\"0.5m (FS inc.)\"]}],\"previewImageUrl\":\"https://cdn.shopify.com/s/files/1/0577/7106/5498/files/QSFP-DD400GCable_9932c323-b17e-43e4-8252-d3f633e87c25.png?v=1724933136\",\"priceRange\":{\"maxVariantPrice\":200,\"minVariantPrice\":200},\"productType\":\"\",\"shop\":{\"domain\":\"tenstorrent.myshopify.com\"},\"shopifyTriggeredAt\":\"2026-09-17T18:18:09.820Z\",\"slug\":{\"_type\":\"slug\",\"current\":\"qsfp-dd-cables-800g\"},\"status\":\"active\",\"tags\":\"\",\"title\":\"QSFP-DD 800G DAC Cable (0.5m)\",\"variants\":[{\"_createdAt\":\"2025-10-10T16:43:07Z\",\"_id\":\"shopifyProductVariant-46655864012954\",\"_rev\":\"eBN5f2uxgSPj2G1hNwVTDr\",\"_type\":\"productVariant\",\"_updatedAt\":\"2026-09-17T18:18:12Z\",\"callout\":\"\",\"description\":\"\",\"details\":null,\"displayName\":null,\"lead\":null,\"media\":null,\"name\":null,\"store\":{\"barcode\":null,\"compareAtPrice\":0,\"createdAt\":\"2025-10-10T09:43:05-07:00\",\"gid\":\"gid://shopify/ProductVariant/46655864012954\",\"id\":46655864012954,\"inventory\":{\"isAvailable\":false,\"policy\":\"CONTINUE\"},\"isDeleted\":false,\"option1\":\"0.5m (FS inc.)\",\"option2\":\"\",\"option3\":\"\",\"previewImageUrl\":\"https://cdn.shopify.com/s/files/1/0577/7106/5498/files/QSFP-DD400GCable_9932c323-b17e-43e4-8252-d3f633e87c25.png?v=1724933136\",\"price\":200,\"productGid\":\"gid://shopify/Product/8646402277530\",\"productId\":8646402277530,\"shop\":{\"domain\":\"tenstorrent.myshopify.com\"},\"sku\":\"TX-01008/05-00021-1\",\"status\":\"active\",\"title\":\"0.5m (FS inc.)\"},\"subtitle\":\"\",\"title\":null}],\"vendor\":\"Tenstorrent\"},\"subtitle\":\"\",\"title\":\"QSFP-DD 800G Cable\"}],\"slug\":null},\"translations\":{\"checkout\":\"Go to Checkout\",\"deposit\":\"Deposit\",\"add\":\"Add to Cart\",\"soldOut\":\"Sold Out\",\"lead\":{\"in-stock\":\"In stock and ready to ship.\",\"out-of-stock\":\"Out of stock.\"}},\"locale\":\"en\"}]\n44:T422,data:image/png;base64,:T422,data:image/png;base64,:[\"$\",\"$L42\",\"6\",{\"section\":{\"_type\":\"product-modal\",\"name\":\"Wormhole™ n150 Series\",\"options\":{\"lightboxGradient\":\"teal\"},\"products\":[{\"_createdAt\":\"2025-02-06T12:24:57Z\",\"_id\":\"shopifyProductVariant-45512558936218\",\"_rev\":\"vW8kcbkQclM4hNx1EDMicK\",\"_system\":{\"base\":{\"id\":\"shopifyProductVariant-45512558936218\",\"rev\":\"I7Qx9hmy7W4JRWHFFZ5Z79\"}},\"_type\":\"product\",\"_updatedAt\":\"2026-08-29T04:40:35Z\",\"bodyI18n\":[{\"_key\":\"9SqAZx1N8m9IspGhLs8BwZ\",\"_type\":\"internationalizedArrayBodyValue\",\"language\":\"en\",\"value\":[{\"_key\":\"d413de9a2d57\",\"_type\":\"block\",\"children\":[{\"_key\":\"7f75d7335082\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n150d features Tenstorrent’s flexible, scalable Wormhole™ Tensix Processor operating at up to 160W, offering superior performance for cost compared to traditional GPUs and broad data precision format support. The processor can network into a multichip mesh for workstations and servers (such as Galaxy) and is supported by Tenstorrent’s fully open source software stack, granting developers full access to the metal. n150d includes a 2.5-slot active cooling solution.\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"9SqAZx1N8m9IspGhLs8Bzw\",\"_type\":\"internationalizedArrayBodyValue\",\"language\":\"ja\",\"value\":[{\"_key\":\"3189cc6d863e\",\"_type\":\"block\",\"children\":[{\"_key\":\"aa3bd7a14c9f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n150d は、最大 160W で動作する Tenstorrent の柔軟でスケーラブルな Wormhole™ Tensix プロセッサを搭載しており、従来の GPU と比較してコストパフォーマンスに優れ、幅広いデータ精度フォーマットをサポートしています。このプロセッサは、ワークステーションやサーバー (Galaxy など) のマルチチップ メッシュにネットワーク化でき、高レベル (TT-Buda™) または低レベル (TT-Metalium™) 開発用の 2 つのオープン ソース SDK でサポートされています。n150dには2.5スロットのアクティブ冷却ソリューションが含まれています。\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"9SqAZx1N8m9IspGhLs8C3J\",\"_type\":\"internationalizedArrayBodyValue\",\"language\":\"ko\",\"value\":[{\"_key\":\"421400f702e9\",\"_type\":\"block\",\"children\":[{\"_key\":\"93edf9b88956\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n150d는 최대 160W에서 작동하는 Tenstorrent의 유연하고 확장 가능한 Wormhole™ Tensix 프로세서를 특징으로 하며, 기존 GPU와 광범위한 데이터 정밀 형식 지원에 비해 비용 대비 우수한 성능을 제공합니다. 프로세서는 워크스테이션 및 서버(예: Galaxy)를 위한 멀티칩 메시로 네트워크화할 수 있으며, 상위 수준(TT-Buda™) 또는 하위 수준(TT-Metalium™) 개발을 위한 두 개의 오픈 소스 SDK로 지원됩니다. n150d는 2.5슬롯 액티브 냉각 솔루션을 포함합니다.\"}],\"markDefs\":[],\"style\":\"normal\"}]}],\"callout\":\"\",\"description\":[{\"_key\":\"370ee55992f1\",\"_type\":\"block\",\"asset\":null,\"children\":[{\"_key\":\"a1a8d221c2b4\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n150d features Tenstorrent's flexible, scalable Wormhole™ Tensix Processor operating at up to 160W, offering superior performance for cost compared to traditional GPUs and broad data precision format support. The processor can network into a multichip mesh for workstations and servers (such as Galaxy) and is supported by two open-source SDKs for either high-level (TT-Forge™) or low-level (TT-Metalium™) development. (Active Cooling Kit included.)\"}],\"markDefs\":[],\"style\":\"normal\"}],\"details\":[{\"header\":\"Software Capabilities\",\"text\":[{\"_key\":\"4f8a1b3499cd\",\"_type\":\"block\",\"children\":[{\"_key\":\"6b3590ca84a1\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Wormhole™ n150d offers a range of capabilities, tailored to suit the needs of ML developers seeking alternatives to traditional GPUs. Our hardware supports a wide array of models, ensuring versatility in your AI projects.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8f2d8c7d1523\",\"_type\":\"block\",\"children\":[{\"_key\":\"3dbf6adbdcc1\",\"_type\":\"span\",\"marks\":[],\"text\":\"TT-Forge™: Run Models Right Away\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ee30fd651f36\",\"_type\":\"block\",\"children\":[{\"_key\":\"3d742949ccba\",\"_type\":\"span\",\"marks\":[],\"text\":\"Great for production customers who want to get models up and running with ease. They want flexibility, but don’t have time to program new operations or contact support every time something changes.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2c11bd35b246\",\"_type\":\"block\",\"children\":[{\"_key\":\"b765b145ae69\",\"_type\":\"span\",\"marks\":[],\"text\":\"TT-Metalium™: Open Access to Tenstorrent Hardware \u0026 Software\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f01c3017fe61\",\"_type\":\"block\",\"children\":[{\"_key\":\"cfbe89f76b38\",\"_type\":\"span\",\"marks\":[],\"text\":\"Great for development customers who want to customize their models, write new ones or even run non-machine learning code. No black boxes, encrypted APIs or hidden functions.\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"header\":\"System Requirements\",\"text\":[{\"_key\":\"1e776d487553\",\"_type\":\"block\",\"children\":[{\"_key\":\"c7add94d5c3f\",\"_type\":\"span\",\"marks\":[],\"text\":\"CPU\\nx86_64 architecture*\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e41b7f85bd84\",\"_type\":\"block\",\"children\":[{\"_key\":\"e49c6d538888\",\"_type\":\"span\",\"marks\":[],\"text\":\"Motherboard\\nPCI Express 4.0 x16 slot, Triple-slot width\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"84bda0072e67\",\"_type\":\"block\",\"children\":[{\"_key\":\"faa182498584\",\"_type\":\"span\",\"marks\":[],\"text\":\"Memory\\n64 GB\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f59476e1434c\",\"_type\":\"block\",\"children\":[{\"_key\":\"d1944e4b60d3\",\"_type\":\"span\",\"marks\":[],\"text\":\"Storage\\n100 GB (≥2TB recommended)Power Connectors\\n4+4-pin EPS12V** (cable not included)\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1da9a0460bc8\",\"_type\":\"block\",\"children\":[{\"_key\":\"76d0e802020f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Total Board Power\\nUp to 160W\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"38d7becbc782\",\"_type\":\"block\",\"children\":[{\"_key\":\"b67ccc6b6225\",\"_type\":\"span\",\"marks\":[],\"text\":\"Operating Temperature Range (Die)\\n0C - 75C\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e3a51cf6ce37\",\"_type\":\"block\",\"children\":[{\"_key\":\"5b61ba96e4e7\",\"_type\":\"span\",\"marks\":[],\"text\":\"Operating System\\nUbuntu version 22.04 (Jammy Jellyfish)***\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5e84d5cd6fc1\",\"_type\":\"block\",\"children\":[{\"_key\":\"56eebcaac4e2\",\"_type\":\"span\",\"marks\":[],\"text\":\"Internet Connection:\\nRequired for driver and stack installation\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"cbb29037c8f3\",\"_type\":\"block\",\"children\":[{\"_key\":\"f4fa0d155a54\",\"_type\":\"span\",\"marks\":[],\"text\":\"*CPU core count and number of sockets will depend on the amount of host preprocessing and post-processing required before and after the accelerator processing.*\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"07ceee11a32c\",\"_type\":\"block\",\"children\":[{\"_key\":\"2ed15dc374d6\",\"_type\":\"span\",\"marks\":[],\"text\":\"**See \"},{\"_key\":\"bc90ceddd364\",\"_type\":\"span\",\"marks\":[\"07e2fdfe7f54\"],\"text\":\"FAQ\"},{\"_key\":\"414eea7b0a62\",\"_type\":\"span\",\"marks\":[],\"text\":\" for more information on PSU cable.\"}],\"markDefs\":[{\"_key\":\"07e2fdfe7f54\",\"_type\":\"link\",\"href\":\"https://docs.tenstorrent.com/aibs/wormhole/support.html\"}],\"style\":\"normal\"},{\"_key\":\"967ced6b7031\",\"_type\":\"block\",\"children\":[{\"_key\":\"464855e5f9f9\",\"_type\":\"span\",\"marks\":[],\"text\":\"***To check your version, type `cat /etc/os-release`.\"}],\"markDefs\":[],\"style\":\"normal\"}]}],\"displayName\":null,\"eusAgreements\":[{\"_key\":\"717d2346e20c\",\"_ref\":\"9555d12e-294a-4890-a3f4-bb49b8b7624d\",\"_type\":\"reference\"}],\"images\":[{\"_key\":\"3e54fbaa350d\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-cdcb6be8ba420f571b4cb0b531bef4656c790e73-1420x1760-jpg\",\"_type\":\"reference\"}},{\"_key\":\"8ad87f35a685\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-28295049d1e14a7255dd8173c3870b949a2383d6-1420x1760-jpg\",\"_type\":\"reference\"}}],\"lead\":{\"inStockOverrideMessage\":\"In stock: Ships in 2 weeks. Transit: 2-5 weeks.\",\"time\":\"in-stock\",\"xWeeksMessage\":\"\",\"xWeeksMessage2\":\"\"},\"leadTime\":{\"type\":\"available\"},\"media\":[{\"image\":{\"_createdAt\":\"2026-04-20T16:09:00Z\",\"_id\":\"image-11998107ae9b1ffce906b13ac6c244ccc2e48d7