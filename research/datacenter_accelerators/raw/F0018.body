s/jpb4ed5r/production/153c1569f196e06c8e8d71c7381dabc790a76d1b-3200x3200.png\"},\"video\":null}],\"shippingNoteI18n\":[{\"_key\":\"9SqAZx1N8m9IspGhLs8CGn\",\"_type\":\"internationalizedArrayStringValue\",\"language\":\"en\"}],\"slug\":{\"_type\":\"slug\",\"current\":\"wormhole-n150s\"},\"store\":{\"barcode\":\"\",\"compareAtPrice\":0,\"createdAt\":\"2025-02-06T04:24:56-08:00\",\"gid\":\"gid://shopify/ProductVariant/45512558903450\",\"id\":45512558903450,\"inventory\":{\"isAvailable\":true,\"policy\":\"CONTINUE\"},\"isDeleted\":false,\"option1\":\"n150s\",\"option2\":\"\",\"option3\":\"\",\"price\":999,\"productGid\":\"gid://shopify/Product/7866380124314\",\"productId\":7866380124314,\"shop\":{\"domain\":\"tenstorrent.myshopify.com\"},\"sku\":\"TC-02001/65-0000B-4\",\"status\":\"active\",\"title\":\"n150s\",\"variants\":null},\"subtitle\":\"Passive cooling\",\"title\":\"Wormhole™ n150s\"}],\"slug\":null},\"translations\":{\"checkout\":\"Go to Checkout\",\"deposit\":\"Deposit\",\"add\":\"Add to Cart\",\"soldOut\":\"Sold Out\",\"lead\":{\"in-stock\":\"In stock and ready to ship.\",\"out-of-stock\":\"Out of stock.\"}},\"locale\":\"en\"}]\n"])</script><script>self.__next_f.push([1,"46:T412,data:image/png;base64,:T412,data:image/png;base64,:[\"$\",\"$L42\",\"7\",{\"section\":{\"_type\":\"product-modal\",\"name\":\"Wormhole™ n300 Series\",\"options\":{\"lightboxGradient\":\"teal\"},\"products\":[{\"_createdAt\":\"2025-02-06T13:13:22Z\",\"_id\":\"shopifyProductVariant-45512611627162\",\"_rev\":\"c2zPP4j5A8uLc0yrL7mPIw\",\"_system\":{\"base\":{\"id\":\"shopifyProductVariant-45512611627162\",\"rev\":\"L9OeS243rfi2D2PJvYQgM3\"}},\"_type\":\"product\",\"_updatedAt\":\"2026-08-18T18:46:33Z\",\"bodyI18n\":[{\"_key\":\"9SqAZx1N8m9IspGhLs8Mee\",\"_type\":\"internationalizedArrayBodyValue\",\"language\":\"en\",\"value\":[{\"_key\":\"87c187d8ac64\",\"_type\":\"block\",\"children\":[{\"_key\":\"2aeddfb66f0f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n300d features two of Tenstorrent’s flexible, scalable Wormhole™ Tensix Processors operating at up to 300W, offering superior performance for cost compared to traditional GPUs and broad data precision format support. The processor can network into a multichip mesh for workstations and servers (such as Galaxy) and is supported by Tenstorrent’s fully open source software stack, granting developers full access to the metal. n300d includes a 2.5-slot active cooling solution.\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"9SqAZx1N8m9IspGhLs8Mi1\",\"_type\":\"internationalizedArrayBodyValue\",\"language\":\"ja\",\"value\":[{\"_key\":\"1f27e739d02d\",\"_type\":\"block\",\"children\":[{\"_key\":\"6cb5ad94c7a9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n300d は、最大 300W で動作する Tenstorrent の柔軟でスケーラブルな Wormhole™ Tensix プロセッサ 2 基を搭載しており、従来の GPU に比べてコストパフォーマンスに優れ、幅広いデータ精度フォーマットをサポートしています。このプロセッサは、ワークステーションやサーバー (Galaxy など) のマルチチップ メッシュにネットワーク化でき、高レベル (TT-Buda™) または低レベル (TT-Metalium™) 開発用の 2 つのオープン ソース SDK でサポートされています。n300dには2.5スロットのアクティブ冷却ソリューションが含まれています。\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"9SqAZx1N8m9IspGhLs8MlO\",\"_type\":\"internationalizedArrayBodyValue\",\"language\":\"ko\",\"value\":[{\"_key\":\"beebbde2a08c\",\"_type\":\"block\",\"children\":[{\"_key\":\"6bffe466c37c\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n300d는 최대 300W에서 작동하는 Tenstorrent의 유연하고 확장 가능한 Wormhole™ Tensix 프로세서를 특징으로 하며, 기존 GPU와 광범위한 데이터 정밀 형식 지원에 비해 비용 대비 우수한 성능을 제공합니다. 프로세서는 워크스테이션 및 서버(예: Galaxy)를 위한 멀티칩 메시로 네트워크화할 수 있으며, 상위 수준(TT-Buda™) 또는 하위 수준(TT-Metalium™) 개발을 위한 두 개의 오픈 소스 SDK로 지원됩니다. n300d는 2.5슬롯 액티브 냉각 솔루션을 포함합니다.\"}],\"markDefs\":[],\"style\":\"normal\"}]}],\"callout\":\"\",\"description\":[{\"_key\":\"8e2842e65d99\",\"_type\":\"block\",\"asset\":null,\"children\":[{\"_key\":\"955db216e756\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n300d features two of Tenstorrent’s flexible, scalable Wormhole™ Tensix Processors operating at up to 300W, offering superior performance for cost compared to traditional GPUs and broad data precision format support. The processor can network into a multichip mesh for workstations and servers (such as Galaxy) and is supported by Tenstorrent’s fully open source software stack, granting developers full access to the metal. n300d includes a 2.5-slot active cooling solution.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"details\":[{\"header\":\"Software Capabilities\",\"text\":[{\"_key\":\"258a09164e1b\",\"_type\":\"block\",\"children\":[{\"_key\":\"a03766624194\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Wormhole™ n300d offers a range of capabilities, tailored to suit the needs of ML developers seeking alternatives to traditional GPUs. Our hardware supports a wide array of models, ensuring versatility in your AI projects.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2bd8a8f2b61a\",\"_type\":\"block\",\"children\":[{\"_key\":\"c9f97f3dadd5\",\"_type\":\"span\",\"marks\":[],\"text\":\"TT-Forge™: Run Models Right Away\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"7411c0146487\",\"_type\":\"block\",\"children\":[{\"_key\":\"7120108851e6\",\"_type\":\"span\",\"marks\":[],\"text\":\"Great for production customers who want to get models up and running with ease. They want flexibility, but don’t have time to program new operations or contact support every time something changes.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5b1e2d4bd01e\",\"_type\":\"block\",\"children\":[{\"_key\":\"5dccc5aba420\",\"_type\":\"span\",\"marks\":[],\"text\":\"TT-Metalium™: Open Access to Tenstorrent Hardware \u0026 Software\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"f3ff5b3345e8\",\"_type\":\"block\",\"children\":[{\"_key\":\"452613792c86\",\"_type\":\"span\",\"marks\":[],\"text\":\"Great for development customers who want to customize their models, write new ones or even run non-machine learning code. No black boxes, encrypted APIs or hidden functions.\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"header\":\"System Requirements\",\"text\":[{\"_key\":\"041151398d71\",\"_type\":\"block\",\"children\":[{\"_key\":\"3f76fa8310e5\",\"_type\":\"span\",\"marks\":[],\"text\":\"CPU\\nx86_64 architecture*\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"8073a593d67e\",\"_type\":\"block\",\"children\":[{\"_key\":\"711d45746fb2\",\"_type\":\"span\",\"marks\":[],\"text\":\"Motherboard\\nPCI Express 4.0 x16 slot, Triple-slot width\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"04c24fffd136\",\"_type\":\"block\",\"children\":[{\"_key\":\"b588f410602d\",\"_type\":\"span\",\"marks\":[],\"text\":\"Memory\\n64 GB\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"782efda87518\",\"_type\":\"block\",\"children\":[{\"_key\":\"2ac323f1d1e1\",\"_type\":\"span\",\"marks\":[],\"text\":\"Storage\\n100 GB (≥2TB recommended)\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d6cd62ec0bbe\",\"_type\":\"block\",\"children\":[{\"_key\":\"36ae5a994c65\",\"_type\":\"span\",\"marks\":[],\"text\":\"Power Connectors\\n4+4-pin EPS12V** (cable not included)\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fa27d27ae1fa\",\"_type\":\"block\",\"children\":[{\"_key\":\"b9e478cf9327\",\"_type\":\"span\",\"marks\":[],\"text\":\"Total Board Power\\nUp to 300W\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"1b9a37a4dbb7\",\"_type\":\"block\",\"children\":[{\"_key\":\"2c06a4dcdf4f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Operating Temperature Range (Die)\\n0C - 75C\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"fb60a01f3ed8\",\"_type\":\"block\",\"children\":[{\"_key\":\"77b046f145cb\",\"_type\":\"span\",\"marks\":[],\"text\":\"Operating System\\nUbuntu version 22.04 (Jammy Jellyfish)**\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5a9abf4b282e\",\"_type\":\"block\",\"children\":[{\"_key\":\"cb85bedfe718\",\"_type\":\"span\",\"marks\":[],\"text\":\"Internet Connection:\\nRequired for driver and stack installation\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"230e61529e73\",\"_type\":\"block\",\"children\":[{\"_key\":\"3bd097235e83\",\"_type\":\"span\",\"marks\":[],\"text\":\"*CPU core count and number of sockets will depend on the amount of host preprocessing and post-processing required before and after the accelerator processing.*\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2ebbd97a18a5\",\"_type\":\"block\",\"children\":[{\"_key\":\"dcdd012a6007\",\"_type\":\"span\",\"marks\":[],\"text\":\"**See \"},{\"_key\":\"2e5a23e51902\",\"_type\":\"span\",\"marks\":[\"17a1bddf4243\"],\"text\":\"FAQ\"},{\"_key\":\"81cdfecd6966\",\"_type\":\"span\",\"marks\":[],\"text\":\" for more information on PSU cable.\"}],\"markDefs\":[{\"_key\":\"17a1bddf4243\",\"_type\":\"link\",\"href\":\"https://docs.tenstorrent.com/aibs/wormhole/support.html\"}],\"style\":\"normal\"},{\"_key\":\"673c7941dbf2\",\"_type\":\"block\",\"children\":[{\"_key\":\"c06a2d65c8c7\",\"_type\":\"span\",\"marks\":[],\"text\":\"***To check your version, type `cat /etc/os-release`.\"}],\"markDefs\":[],\"style\":\"normal\"}]}],\"displayName\":null,\"eusAgreements\":[{\"_key\":\"e66384e802e1\",\"_ref\":\"9555d12e-294a-4890-a3f4-bb49b8b7624d\",\"_type\":\"reference\"}],\"images\":[{\"_key\":\"710daf453415\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-a364420c39fbc2e1acf15cfbe994a7e7c5cf2bed-1420x1760-jpg\",\"_type\":\"reference\"}},{\"_key\":\"3685934e5fe8\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-da8be2ab9e3c8921fc44ff78ddac95b84669ea02-1420x1760-jpg\",\"_type\":\"reference\"}}],\"lead\":{\"inStockOverrideMessage\":\"In stock: Ships in 2 weeks. Transit: 2-5 weeks.\",\"time\":\"in-stock\",\"xWeeksMessage\":\"\",\"xWeeksMessage2\":\"\"},\"leadTime\":{\"type\":\"available\"},\"media\":[{\"image\":{\"_createdAt\":\"2026-04-20T16:14:11Z\",\"_id\":\"image-c3d844345bd2990205e86a216a8906d3e13d9c27-3200x3200-png\",\"_rev\":\"Azr6jnPnblfJFZmxqSawGy\",\"_type\":\"sanity.imageAsset\",\"_updatedAt\":\"2026-04-20T16:14:11Z\",\"assetId\