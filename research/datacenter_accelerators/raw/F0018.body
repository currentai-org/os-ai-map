ng\"},\"video\":null},{\"image\":{\"_createdAt\":\"2026-04-20T16:09:11Z\",\"_id\":\"image-1badd86bdad05718bad42d20224219d77d2eb53c-3200x3200-png\",\"_rev\":\"6IFqLXQK07mFWbhNJ7dinh\",\"_type\":\"sanity.imageAsset\",\"_updatedAt\":\"2026-04-20T16:09:11Z\",\"assetId\":\"1badd86bdad05718bad42d20224219d77d2eb53c\",\"extension\":\"png\",\"metadata\":{\"_type\":\"sanity.imageMetadata\",\"blurHash\":\"e355FARj00t8D%xuofRjWBay00xu_3M{-;D%WB%Mt7of~qM{D%%MIU\",\"dimensions\":{\"_type\":\"sanity.imageDimensions\",\"aspectRatio\":1,\"height\":3200,\"width\":3200},\"hasAlpha\":true,\"isOpaque\":false,\"lqip\":\"data:image/png;base64,\",\"palette\":{\"_type\":\"sanity.imagePalette\",\"darkMuted\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#514a38\",\"foreground\":\"#fff\",\"population\":0.08,\"title\":\"#fff\"},\"darkVibrant\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#2f1d06\",\"foreground\":\"#fff\",\"population\":0.03,\"title\":\"#fff\"},\"dominant\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#b8b8b8\",\"foreground\":\"#000\",\"population\":0.47,\"title\":\"#fff\"},\"lightMuted\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#b8b8b8\",\"foreground\":\"#000\",\"population\":0.47,\"title\":\"#fff\"},\"lightVibrant\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#efc289\",\"foreground\":\"#000\",\"population\":0,\"title\":\"#000\"},\"muted\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#957d5f\",\"foreground\":\"#fff\",\"population\":0.01,\"title\":\"#fff\"},\"vibrant\":{\"_type\":\"sanity.imagePaletteSwatch\",\"background\":\"#e28b1c\",\"foreground\":\"#000\",\"population\":0,\"title\":\"#fff\"}},\"thumbHash\":\"FgiCBQAiow2KdsgVd792+UmmOHeHd3CM1w==\"},\"mimeType\":\"image/png\",\"originalFilename\":\"n150d-Shroud.png\",\"path\":\"images/jpb4ed5r/production/1badd86bdad05718bad42d20224219d77d2eb53c-3200x3200.png\",\"sha1hash\":\"1badd86bdad05718bad42d20224219d77d2eb53c\",\"size\":1560562,\"uploadId\":\"wo2QDljQFnWHJQNDxZ5oBdCrknDn6DAz\",\"url\":\"https://cdn.sanity.io/images/jpb4ed5r/production/1badd86bdad05718bad42d20224219d77d2eb53c-3200x3200.png\"},\"video\":null}],\"shippingNoteI18n\":[{\"_key\":\"9SqAZx1N8m9IspGhLs8BtC\",\"_type\":\"internationalizedArrayStringValue\",\"language\":\"en\"}],\"slug\":{\"_type\":\"slug\",\"current\":\"wormhole-n150d\"},\"store\":{\"barcode\":\"\",\"compareAtPrice\":0,\"createdAt\":\"2025-02-06T04:24:56-08:00\",\"gid\":\"gid://shopify/ProductVariant/45512558936218\",\"id\":45512558936218,\"inventory\":{\"isAvailable\":true,\"policy\":\"CONTINUE\"},\"isDeleted\":false,\"option1\":\"n150d\",\"option2\":\"\",\"option3\":\"\",\"price\":1099,\"productGid\":\"gid://shopify/Product/7866380124314\",\"productId\":7866380124314,\"shop\":{\"domain\":\"tenstorrent.myshopify.com\"},\"sku\":\"TC-02002/65-0000C-2\",\"status\":\"active\",\"title\":\"n150d\",\"variants\":null},\"subtitle\":\"Active (Axial Fan) cooling\",\"title\":\"Wormhole™ n150d\"},{\"_createdAt\":\"2025-02-06T12:24:57Z\",\"_id\":\"shopifyProductVariant-45512558903450\",\"_rev\":\"vW8kcbkQclM4hNx1EDMicK\",\"_system\":{\"base\":{\"id\":\"shopifyProductVariant-45512558903450\",\"rev\":\"L9OeS243rfi2D2PJvYPxiH\"}},\"_type\":\"product\",\"_updatedAt\":\"2026-08-29T04:40:35Z\",\"bodyI18n\":[{\"_key\":\"9SqAZx1N8m9IspGhLs8CKA\",\"_type\":\"internationalizedArrayBodyValue\",\"language\":\"en\",\"value\":[{\"_key\":\"dc47a5acb7c7\",\"_type\":\"block\",\"children\":[{\"_key\":\"fb31981c858e\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n150s features Tenstorrent's flexible, scalable Wormhole™ Tensix Processor operating at up to 160W, offering superior performance for cost compared to traditional GPUs and broad data precision format support. The processor can network into a multichip mesh for workstations and servers (such as Galaxy) and is supported by Tenstorrent’s fully open source software stack, granting developers full access to the metal. n150s includes a dual-slot passive heatsink and separate, bundled Active Cooling Kit.\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"9SqAZx1N8m9IspGhLs8CNX\",\"_type\":\"internationalizedArrayBodyValue\",\"language\":\"ja\",\"value\":[{\"_key\":\"7a7e308badfa\",\"_type\":\"block\",\"children\":[{\"_key\":\"bbab1de7f3f9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n150s は、最大 160W で動作する Tenstorrent の柔軟でスケーラブルな Wormhole™ Tensix プロセッサを搭載しており、従来の GPU と比較してコストパフォーマンスに優れ、幅広いデータ精度フォーマットをサポートしています。このプロセッサは、ワークステーションやサーバー (Galaxy など) のマルチチップ メッシュにネットワーク化でき、高レベル (TT-Buda™) または低レベル (TT-Metalium™) 開発用の 2 つのオープン ソース SDK でサポートされています。n150sにはデュアルスロットのパッシブヒートシンクと、別途同梱されたアクティブクーリングキットが含まれています。\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"_key\":\"9SqAZx1N8m9IspGhLs8CQu\",\"_type\":\"internationalizedArrayBodyValue\",\"language\":\"ko\",\"value\":[{\"_key\":\"237fd38a2ee3\",\"_type\":\"block\",\"children\":[{\"_key\":\"c94669b48419\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n150s는 최대 160W에서 작동하는 Tenstorrent의 유연하고 확장 가능한 Wormhole™ Tensix 프로세서를 특징으로 하며, 기존 GPU와 광범위한 데이터 정밀 형식 지원에 비해 비용 대비 우수한 성능을 제공합니다. 프로세서는 워크스테이션 및 서버(예: Galaxy)를 위한 멀티칩 메시로 네트워크화할 수 있으며, 상위 수준(TT-Buda™) 또는 하위 수준(TT-Metalium™) 개발을 위한 두 개의 오픈 소스 SDK로 지원됩니다. n150s는 듀얼 슬롯 패시브 히트싱크와 별도로 번들된 액티브 쿨링 키트를 포함합니다.\"}],\"markDefs\":[],\"style\":\"normal\"}]}],\"callout\":\"\",\"description\":[{\"_key\":\"3d3104da2fa5\",\"_type\":\"block\",\"asset\":null,\"children\":[{\"_key\":\"94a4638c562b\",\"_type\":\"span\",\"marks\":[],\"text\":\"Wormhole™ n150s features Tenstorrent's flexible, scalable Wormhole™ Tensix Processor operating at up to 160W, offering superior performance for cost compared to traditional GPUs and broad data precision format support. The processor can network into a multichip mesh for workstations and servers (such as Galaxy) and is supported by Tenstorrent’s fully open source software stack, granting developers full access to the metal. n150s includes a dual-slot passive heatsink and separate, bundled Active Cooling Kit.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"details\":[{\"header\":\"Software Capabilities\",\"text\":[{\"_key\":\"745eaa94a571\",\"_type\":\"block\",\"children\":[{\"_key\":\"8afb25113a6d\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Wormhole™ n150s offers a range of capabilities, tailored to suit the needs of ML developers seeking alternatives to traditional GPUs. Our hardware supports a wide array of models, ensuring versatility in your AI projects.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"36716ddf305e\",\"_type\":\"block\",\"children\":[{\"_key\":\"4541ca881095\",\"_type\":\"span\",\"marks\":[],\"text\":\"TT-Forge™: Run models right away\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"01a0c5d52fa0\",\"_type\":\"block\",\"children\":[{\"_key\":\"ef4385627f8b\",\"_type\":\"span\",\"marks\":[],\"text\":\"Great for production customers who want to get models up and running with ease. They want flexibility, but don’t have time to program new operations or contact support every time something changes.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"ce20ab0a49af\",\"_type\":\"block\",\"children\":[{\"_key\":\"793137073028\",\"_type\":\"span\",\"marks\":[],\"text\":\"TT-Metalium™: Open Access to Tenstorrent Hardware \u0026 Software\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"65b06b3ba9bc\",\"_type\":\"block\",\"children\":[{\"_key\":\"764b71f30f4c\",\"_type\":\"span\",\"marks\":[],\"text\":\"Great for development customers who want to customize their models, write new ones or even run non-machine learning code. No black boxes, encrypted APIs or hidden functions.\"}],\"markDefs\":[],\"style\":\"normal\"}]},{\"header\":\"System Requirements\",\"text\":[{\"_key\":\"27ce324304c0\",\"_type\":\"block\",\"children\":[{\"_key\":\"e8175d370ed8\",\"_type\":\"span\",\"marks\":[],\"text\":\"CPU\\nx86_64 architecture*\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e277199e109b\",\"_type\":\"block\",\"children\":[{\"_key\":\"1f8d7f7c15e1\",\"_type\":\"span\",\"marks\":[],\"text\":\"Motherboard\\nPCI Express 4.0 x16 slot, Dual-slot width\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d4fc05bff57f\",\"_type\":\"block\",\"children\":[{\"_key\":\"9cd460e6794d\",\"_type\":\"span\",\"marks\":[],\"text\":\"Memory\\n64 GB\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5a8b0e43be20\",\"_type\":\"block\",\"children\":[{\"_key\":\"af3712303656\",\"_type\":\"span\",\"marks\":[],\"text\":\"Storage\\n100 GB (≥2TB recommended)\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6593f679fb15\",\"_type\":\"block\",\"children\":[{\"_key\":\"eeddb5386a02\",\"_type\":\"span\",\"marks\":[],\"text\":\"Power Connectors\\n4+4-pin EPS12V** (add'l. 6+2-pin PCIe required if using Active Cooling Kit) (cable not included)\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"906423caabfb\",\"_type\":\"block\",\"children\":[{\"_key\":\"db18006c70b1\",\"_type\":\"span\",\"marks\":[],\"text\":\"Total Board Power\\nUp to 160W\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d3c8c4058f23\",\"_type\":\"block\",\"children\":[{\"_key\":\"1c27f2e7a6e1\",\"_type\":\"span\",\"marks\":[],\"text\":\"Operating Temperature Range (Die)\\n0C - 75C\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4f83063c18fb\",\"_type\":\"block\",\"children\":[{\"_key\":\"619d82a58db7\",\"_type\":\"span\",\"marks\":[],\"text\":\"Operating System\\nUbuntu version 22.04 (Jammy Jellyfish)***\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"15c0da96b8b2\",\"_type\":\"block\",\"children\":[{\"_key\":\"25297c970c71\",\"_type\":\"span\",\"marks\":[],\"text\":\"Internet Connection:\\nRequired for driver and stack installation\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"a0ae74237183\",\"_type\":\"block\",\"children\":[{\"_key\":\"a19e6acd59d1\",\"_type\":\"span\",\"marks\":[],\"text\":\"*CPU core count and number of sockets will depend on the amount of host preprocessing and post-processing required before and after the accelerator processing.*\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"9abb8f9a8763\",\"_type\":\"block\",\"children\":[{\"_key\":\"2ae929dd7cab\",\"_type\":\"span\",\"marks\":[],\"text\":\"**See \"},{\"_key\":\"f988cafa65ba\",\"_type\":\"span\",\"marks\":[\"a9f76a63d36d\"],\"text\":\"FAQ\"},{\"_key\":\"33f4aec479c4\",\"_type\":\"span\",\"marks\":[],\"text\":\" for more information on PSU cable.\"}],\"markDefs\":[{\"_key\":\"a9f76a63d36d\",\"_type\":\"link\",\"blank\":true,\"href\":\"https://docs.tenstorrent.com/aibs/wormhole/support.html\"}],\"style\":\"normal\"},{\"_key\":\"cb09352e8cd4\",\"_type\":\"block\",\"children\":[{\"_key\":\"be9d959f1b26\",\"_type\":\"span\",\"marks\":[],\"text\":\"***To check your version, type `cat /etc/os-release`.\"}],\"markDefs\":[],\"style\":\"normal\"}]}],\"displayName\":null,\"eusAgreements\":[{\"_key\":\"70f846a114a6\",\"_ref\":\"9555d12e-294a-4890-a3f4-bb49b8b7624d\",\"_type\":\"reference\"}],\"images\":[{\"_key\":\"36a63684352f\",\"_type\":\"image\",\"alt\":\"Wormhole n150s\",\"asset\":{\"_ref\":\"image-e1bc20d56e732c027f6320ccb74d5d07ce89d49c-1420x1760-jpg\",\"_type\":\"reference\"}},{\"_key\":\"2a1ad5f14791\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-4a3818ea9bfddd4df542120bf74ea0665caaa7b7-1420x1760-jpg\",\"_type\":\"reference\"}},{\"_key\":\"94fd54f1446e\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-20352d1228592bb7142dfef8dfa17e18001462e5-1420x1760-jpg\",\"_type\":\"reference\"}}],\"lead\":{\"inStockOverrideMessage\":\"In stock: Ships in 2 weeks. Transit: 2-5 weeks.\",\"time\":\"in-stock\",\"xWeeksMessage\":\"\",\"xWeeksMessage2\":\"\"},\"leadTime\":{\"type\":\"available\"},\"media\":[{\"image\":{\"_createdAt\":\"2026-04-20T16:09:00Z\",\"_id\":\"image-11998107ae9b1ffce906b13ac6c244ccc2e48d71-3200x3200-png\",\"_rev\":\"6IFqLXQK07mFWbhNJ7dfth\",\"_type\":\"sanity.imageAsset\",\"_updatedAt\":\"2026-04-20T16:09:00Z\",\"assetId\":\"11998107ae9b1ffce906b13ac6c244ccc2e48d71\",\"extension\":\"png\",\"metadat