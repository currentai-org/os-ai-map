<article id="post-52562691" class="m-blog-post post-52562691 post type-post status-publish format-standard has-post-thumbnail hentry category-featured category-the-official-microsoft-blog tag-ai tag-azure tag-datacenters" ms.cmpnm="post content">
	<header class="entry-header m-blog-content">
		<h1 class="entry-title c-heading-3">Maia 200: The AI accelerator built for inference</h1>			<div>
				<p class="c-meta-text">
					<time datetime="2026-01-26">
						<abbr title="January 26, 2026">Jan 26, 2026</abbr>
					</time>
					<span class="c-meta-divider-space">|</span>					<a href="https://blogs.microsoft.com/blog/author/scottguthrie/" ms.title="Scott Guthrie" class="c-hyperlink u-underline" aria-label="See more written by Scott Guthrie">
	Scott Guthrie - Executive Vice President, Cloud + AI</a>
				</p>
			</div><!-- .entry-meta -->
