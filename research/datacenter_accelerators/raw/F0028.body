<script type="text/javascript"> 
  function setCookie(name, value, days) {
    var expires = "";
    if (days) {
      var date = new Date();
      date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
      expires = "; expires=" + date.toUTCString();
    }
    document.cookie = name + "=" + (value || "") + expires + "; path=/";
  }

  // Function to get a cookie
  function getCookie(name) {
    var nameEQ = name + "=";
    var ca = document.cookie.split(";");
    for (var i = 0; i < ca.length; i++) {
      var c = ca[i].trim();
      if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length);
    }
    return null;
  }
$(document).ready(function () {
  //console.log("coming");
    var queryString = window.location.search;
    var URLSearchParams_wb = new URLSearchParams(queryString);
    const utmParameters = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "gclid", "hsa_acc", "hsa_cam", "hsa_grp", "hsa_ad", "hsa_src", "hsa_tgt", "hsa_kw", "hsa_mt", "hsa_net", "hsa_ver"];
    
    // Object to store UTM values
    let utmData = {};

    // Process UTM parameters and set cookies
    utmParameters.forEach((utm) => {
        if (URLSearchParams_wb.has(utm)) {
            const value = URLSearchParams_wb.get(utm);
          	if(value){
              setCookie(utm, value, 7); // Set cookie for 7 days
              utmData[utm] = value;
            }
        } else {
            const cookieValue = getCookie(utm);
            if (cookieValue) {
                utmData[utm] = cookieValue;
            }
        }
    });
  
  	// Function to append UTM parameters to a URL
    function appendUTMToURL(url, utmData) {
        let urlObj = new URL(url, window.location.origin);
        Object.keys(utmData).forEach(key => {
            if (utmData[key]) {
                urlObj.searchParams.set(key, utmData[key]);
            }
        });
        return urlObj.toString();
    }

    // Example: Modify the href of an anchor with a specific ID or class
    let linkSelector = ".header-link .cta-btn"; // Change this to match your anchor element
  	let seclinkSelector = ".cloud-cta"; // Change this to match your anchor element
    let $link = $(linkSelector).find('a');
  	let $seclink = $(seclinkSelector).find('a');
    let headerlinkSelector = ".header-outline-cta-wrapper .header-cloud-cta";
    let $headerlink = $(headerlinkSelector); 
    if ($link.length) {
        let originalHref = $link.attr("href");
      //console.log(originalHref);
        let newHref = appendUTMToURL(originalHref, utmData);
        $link.attr("href", newHref);
    }
  	if ($seclink.length) {
      //console.log("second");
        let secoriginalHref = $seclink.attr("href");
      //console.log(secoriginalHref);
        let secnewHref = appendUTMToURL(secoriginalHref, utmData);
        $seclink.attr("href", secnewHref);
    }
    if ($headerlink.length) {
        let headerOriginalHref = $headerlink.attr("href");
        let headerNewHref = appendUTMToURL(headerOriginalHref, utmData);
        $headerlink.attr("href", headerNewHref);
    }

    function populateUTMFields() {
      console.log('Attempting to populate UTM fields with:', utmData);
      Object.keys(utmData).forEach(key => {
        // More specific selector for HubSpot forms
        $(`.hs-input[name="${key}"]`).each(function() {
          if (utmData[key]) {
            $(this).val(utmData[key]);
            console.log(`Set ${key} to:`, utmData[key]);
          }
        });
      });
    }

    // Initial population
    populateUTMFields();

    // Handle HubSpot form load
    window.addEventListener('message', function(event) {
      if (event.data.type === 'hsFormCallback' && event.data.eventName === 'onFormReady') {
        console.log('HubSpot form ready, populating UTM fields');
        setTimeout(populateUTMFields, 500); // Give a small delay to ensure form is fully ready
      }
    });

    // Set up a MutationObserver to watch for form changes
    const observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        if (mutation.addedNodes.length) {
          const hasNewForm = Array.from(mutation.addedNodes).some(node => 
            node.querySelector && node.querySelector('.hs-input[name^="utm_"]')
          );
          if (hasNewForm) {
            console.log('New form detected, populating UTM fields');
            populateUTMFields();
          }
        }
      });
    });

    // Start observing the document for form changes
    observer.observe(document.body, {
      childList: true,
      subtree: true
    });

    // Now you can access UTM parameters globally via `utmData`
    console.log("Utm Data ----->>>",utmData); // For debugging
});
</script>

<script>
(function () {
  'use strict';

  /* ----------------------------- config ----------------------------- */
  var SEARCH_PARAM    = 'term';                        // query-string key
  var SEARCH_ENDPOINT = 'contentsearch/v2/search';     // substring match (host-agnostic)
  var POPUP_SELECTOR  = '.site-search__popup';          // Act3 overlay element
  var ACTIVE_CLASS    = 'site-search__popup--active';   // class present while open

  var DEBUG = /^(localhost|127\.0\.0\.1)$/.test(location.hostname);

  /* ----------------------------- helpers ---------------------------- */
  var lastTracked = '', overlayOpen = false;

  function logErr(e) { if (DEBUG && window.console) { console.error('[search-tracking]', e); } }

  function updateUrl(term) {
    try {
      var url = new URL(window.location.href);
      if (term) { url.searchParams.set(SEARCH_PARAM, term); }
      else      { url.searchParams.delete(SEARCH_PARAM); }
      window.history.replaceState({ searchTerm: term || null }, '', url.toString());
    } catch (e) { logErr(e); }
  }

  function trackSearch(term) {
    if (!term || term === lastTracked) { return; }   // dedupe identical re-submits
    lastTracked = term;
    if (typeof window.gtag === 'function') {
      window.gtag('event', 'view_search_results', { search_term: term });
    }
    if (Array.isArray(window.dataLayer)) {
      window.dataLayer.push({ event: 'view_search_results', search_term: term });
    }
  }

  // One request per Enter => fire immediately, no debounce, no min-length.
  function handleTerm(raw) {
    var term = (raw || '').trim();
    updateUrl(term);     // empty term clears the param
    trackSearch(term);   // no-op on empty
  }

  /* -------------------- capture the search request ------------------ */
  function extractTerm(u) {
    try { return new URL(u, location.origin).searchParams.get('term') || ''; }
    catch (e) { logErr(e); return ''; }
  }
  function reqUrl(input) {
    if (typeof input === 'string') return input;
    if (input instanceof Request)  return input.url;
    if (typeof URL !== 'undefined' && input instanceof URL) return input.href;
    return (input && input.url) || '';
  }

  var _fetch = window.fetch;
  if (_fetch) {
    window.fetch = function (input) {
      try {
        var u = reqUrl(input);
        if (u && u.indexOf(SEARCH_ENDPOINT) !== -1) { handleTerm(extractTerm(u)); }
      } catch (e) { logErr(e); }
      return _fetch.apply(this, arguments);
    };
  }
  var _open = window.XMLHttpRequest && XMLHttpRequest.prototype.open;
  if (_open) {
    XMLHttpRequest.prototype.open = function (m, url) {
      try {
        if (url && url.indexOf(SEARCH_ENDPOINT) !== -1) { handleTerm(extractTerm(url)); }
      } catch (e) { logErr(e); }
      return _open.apply(this, arguments);
    };
  }

  /* ---------------- clear the param when the overlay closes --------- */
  function isOpen() {
    var popups = document.querySelectorAll(POPUP_SELECTOR);
    for (var i = 0; i < popups.length; i++) {
      if (popups[i].classList.contains(ACTIVE_CLASS)) { return true; }
    }
    return false;
  }

  function reevaluate() {
    var open = isOpen();
    if (overlayOpen && !open) {   // open -> closed edge
      updateUrl('');              // strip ?term=
      lastTracked = '';           // let the same query be tracked again next session
    }
    overlayOpen = open;
  }

  function watch() {
    var popups = document.querySelectorAll(POPUP_SELECTOR);
    if (!popups.length) { return; }
    overlayOpen = isOpen();

    var mo = new MutationObserver(reevaluate);
    for (var i = 0; i < popups.length; i++) {
      mo.observe(popups[i], { attributes: true, attributeFilter: ['class'] });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', watch);
  } else {
    watch();
  }
})();
</script>
<script>
  (function() {
    jQuery(document).ready(function($) {
      var pageURL = window.location.href;
      if (
        pageURL.includes('/tag/blog') ||
        pageURL.includes('/tag/business') ||
        pageURL.includes('/tag/technology')
      ) {
        $(".blog-sub-filter").addClass('show-blog-filters');
      }
      
      if (pageURL.includes('/tag/blog') ) {
        $(".blog-sub-filter #blog_all").addClass('sub-tag--active');
      } else if (pageURL.includes('/tag/business') ) {
        $(".blog-sub-filter #blog_business").addClass('sub-tag--active');
      } else if (pageURL.includes('/tag/technology') ) {
        $(".blog-sub-filter #blog_technology").addClass('sub-tag--active');
      }
      
      function updateDropdownText() {
        var activeText = $('.drop-down__option--active').text();
        $('.drop-down__btn-text').text(activeText);
    }

    // Initial call on page load
    updateDropdownText();

    // If the active class is added dynamically, observe DOM changes
    const targetNode = document.querySelector('.resource-dd .drop-down__list');
    const config = { attributes: true, subtree: true, attributeFilter: ['class'] };

    const callback = function(mutationsList) {
        for (let mutation of mutationsList) {
            if (mutation.type === 'attributes' && mutation.target.classList.contains('drop-down__option--active')) {
                updateDropdownText();
            }
        }
    };

    const observer = new MutationObserver(callback);
    if (targetNode) {
        observer.observe(targetNode, config);
    }
      
    });
  })();
</script>
