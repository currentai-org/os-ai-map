<style id="rms-hero-style-inline-css">
/* ======================================================
   RMS Hero - Background Media + Gradient Overlays
   Place this file next to template.php and reference it in block.json.
====================================================== */

.block--hero {
    overflow: hidden;
    isolation: isolate;
}

.rms-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
}

.rms-hero-bg--mobile {
    display: none;
}

.rms-hero-bg__image,
.rms-hero-bg__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
}

.rms-hero-bg__video {
    display: block;
}

.rms-hero-bg__overlay {
    --rms-hero-overlay-opacity: 0.7;
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: var(--rms-hero-overlay-opacity);
}

/* Left-side readability gradient. */
.rms-hero-bg__overlay--dark-left {
    background: linear-gradient(
        90deg,
        rgba(0, 0, 0, 1) 0%,
        rgba(0, 0, 0, 1) 42%,
        rgba(0, 0, 0, 0) 78%
    );
}

/* Full, even overlay. */
.rms-hero-bg__overlay--dark-full {
    background: rgba(0, 0, 0, 1);
}

/* Bottom readability gradient. */
.rms-hero-bg__overlay--dark-bottom {
    background: linear-gradient(
        0deg,
        rgba(0, 0, 0, 1) 0%,
        rgba(0, 0, 0, 1) 46%,
        rgba(0, 0, 0, 0) 82%
    );
}

/* Combined left + bottom readability gradient. */
.rms-hero-bg__overlay--dark-left-bottom {
    background:
        linear-gradient(
            90deg,
            rgba(0, 0, 0, 1) 0%,
            rgba(0, 0, 0, 1) 42%,
            rgba(0, 0, 0, 0) 78%
        ),
        linear-gradient(
            0deg,
            rgba(0, 0, 0, 1) 0%,
            rgba(0, 0, 0, 1) 42%,
            rgba(0, 0, 0, 0) 78%
        );
}

/* Keep content above the media and overlay layers. */
.block--hero > :not(.rms-hero-bg):not(.rms-hero-bg__overlay) {
    position: relative;
    z-index: 10;
}

@media (max-width: 767px) {
    .rms-hero-has-mobile-static-bg .rms-hero-bg--desktop {
        display: none;
    }

    .rms-hero-has-mobile-static-bg .rms-hero-bg--mobile {
        display: block;
    }

    /*
       Mobile keeps the same opacity behavior:
       the ACF opacity value controls the whole overlay exactly.
    */
    .rms-hero-bg__overlay--dark-left {
        background: linear-gradient(
            90deg,
            rgba(0, 0, 0, 1) 0%,
            rgba(0, 0, 0, 1) 58%,
            rgba(0, 0, 0, 0.35) 100%
        );
    }

    .rms-hero-bg__overlay--dark-left-bottom {
        background:
            linear-gradient(
                90deg,
                rgba(0, 0, 0, 1) 0%,
                rgba(0, 0, 0, 1) 58%,
                rgba(0, 0, 0, 0.35) 100%
            ),
            linear-gradient(
                0deg,
                rgba(0, 0, 0, 1) 0%,
                rgba(0, 0, 0, 0) 72%
            );
    }
}

/*# sourceURL=https://www.d-matrix.ai/wp-content/themes/d-matrix-2023/blocks/hero/hero-background-media.css */
</style>
<link rel='stylesheet' id='flickity-css' href='https://unpkg.com/flickity@2/dist/flickity.min.css?ver=7.0.5' media='all' />
<style id="acf-carousel-style-2-inline-css">
.wp-block-acf-carousel{

}

.wp-block-acf-carousel--item{
	padding: 1rem;
	width:calc( 100% - 0rem );
}

.wp-block-acf-carousel--item h4{ font-size: 16px; line-height: 21px; margin-top:10px;

}


.wp-block-acf-carousel--item img,
.wp-block-acf-carousel--item picture{
	max-width:100%;
	height: 150px;
	object-fit: cover;

}

/* no circle */
.wp-block-acf-carousel .flickity-button {
	background: transparent;
	transition: all ease 0.2s;
  }
  /* big previous & next buttons */
  .wp-block-acf-carousel .flickity-prev-next-button {
	width: 50px;
	height: 50px;
  }
  /* icon color */
  .wp-block-acf-carousel .flickity-button-icon {
	fill: white;
	transition: all ease 0.2s;
  }
  /* hide disabled button */
  .wp-block-acf-carousel .flickity-button:disabled {
	display: none;
  }

  .wp-block-acf-carousel .flickity-button:hover {background: none;;}

  .wp-block-acf-carousel .flickity-button:hover .flickity-button-icon {
	fill: rgb(133, 119, 119);
  }

  .wp-block-acf-carousel .flickity-prev-next-button.previous {left: -30px;}
  .wp-block-acf-carousel .flickity-prev-next-button.next {right:-30px;}


@media screen and (min-width: 768px) {
	.wp-block-acf-carousel--item{
		width:calc( 33.33333% - 2rem );
	}
	.wp-block-acf-carousel .flickity-prev-next-button.previous {left:-70px;}
  	.wp-block-acf-carousel .flickity-prev-next-button.next {right:-70px;}
}
/*# sourceURL=https://www.d-matrix.ai/wp-content/plugins/acf-carousel-block/blocks/carousel/style.css */
</style>

