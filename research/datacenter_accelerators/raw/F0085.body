<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" id="mwAw" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox company\n","href":"./Template:Infobox_company"},"params":{"name":{"wt":"Graphcore Limited"},"logo":{"wt":"Graphcore logo.png"},"type":{"wt":"[[Privately-held company|Private]]"},"founded":{"wt":"{{Start date and age|2016}}"},"founders":{"wt":"{{ubl|Nigel Toon|Simon Knowles}}"},"key_people":{"wt":"{{ubl|Nigel Toon (CEO)|Simon Knowles (CTO)}}"},"industry":{"wt":"[[Semiconductors]]"},"hq_location_city":{"wt":"[[Bristol]]"},"hq_location_country":{"wt":"[[United Kingdom]]"},"products":{"wt":"IPU, Poplar"},"revenue":{"wt":"{{US$|2.7 million}} (2022)&lt;ref name=reuters2023>{{Cite news |last=Cherney |first=Max A. |date=5 October 2023 |title=Losses widen, cash needed at chip startup Graphcore, an Nvidia rival, filing shows |url=https://www.reuters.com/technology/losses-widen-cash-needed-chip-startup-graphcore-an-nvidia-rival-filing-2023-10-05/ |work=Reuters}}&lt;/ref>"},"net_income":{"wt":"{{US$|-205 million}} (2022)&lt;ref name=reuters2023 />"},"num_employees":{"wt":"450 (2024)&lt;ref>{{Cite news |last=Sun |first=Yazhou |date=7 November 2024 |title=Chip Designer Graphcore Boosts Staff 20% After SoftBank Purchase |url=https://www.bloomberg.com/news/articles/2024-11-07/chip-designer-graphcore-is-boosting-staff-20-after-softbank-purchase |publisher=Bloomberg News}}&lt;/ref>"},"website":{"wt":"{{URL|https://graphcore.ai/}}"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1358620234" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-ch