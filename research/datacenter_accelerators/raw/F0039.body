  <section id="section-2" class="block-links_grid scroll-margin-navbar mt-block mb-0 bust-out-container border-b border-black" style="">
    <div class="">
      
              
  <div class="container-fluid">

          <h2 class="allcaps-sm text-red-500 mb-8"><p class="allcaps-md text-red-500">Platforms</p></h2>
    
      </div>  <div class="border-t border-black">
    <div class="container-fluid">

      <div class="w-full max-w-container mx-auto border-l border-r border-black">
  
                                    <div class="grid md:grid-cols-2 border-b border-black">
                          <div class="p-8 lg:p-10 flex flex-col gap-4 border-b border-black md:border-b-0 md:border-r ">
                                  <h3 class="text-xl lg:text-2xl font-medium leading-snug">Passage L200</h3>
                                                                  <div class="editor-content text-sm lg:text-base leading-relaxed text-gray-700"><p>Designed for frontier-scale training. Supports 32 to 64 Tbps of aggregate bandwidth through co-packaged optics, using 112G PAM4 signaling to enable dense and fast interconnects.</p>
</div>
                                                  <p class="mt-auto">
                    <a
                      href="https://lightmatter.co/products/l200/"
                                            class="inline-flex items-center gap-1 text-base font-medium hover:text-red-500 transition-colors"
                    >Learn more &rarr;</a>
                  </p>
                              </div>
                          <div class="p-8 lg:p-10 flex flex-col gap-4">
                                  <h3 class="text-xl lg:text-2xl font-medium leading-snug">Passage L20</h3>
                                                                  <div class="editor-content text-sm lg:text-base leading-relaxed text-gray-700"><p>Accelerate your optics integration roadmap. Delivers 12.8 Tbps of aggregate bandwidth and 4x pluggable density, enabling high-capacity deployments in compact systems.</p>
</div>
                                                  <p class="mt-auto">
                    <a
                      href="https://lightmatter.co/products/passage-l20/"
                                            class="inline-flex items-center gap-1 text-base font-medium hover:text-red-500 transition-colors"
                    >Learn more &rarr;</a>
                  </p>
                              </div>
                      </div>
                            <div class="grid md:grid-cols-2 border-b border-black">
                          <div class="p-8 lg:p-10 flex flex-col gap-4 border-b border-black md:border-b-0 md:border-r ">
                                  <h3 class="text-xl lg:text-2xl font-medium leading-snug">Passage M1000 EVK</h3>
                                                                  <div class="editor-content text-sm lg:text-base leading-relaxed text-gray-700"><p>A rack-level 3D photonic interposer reference platform delivering 114 Tbps across a 4,000 mm² footprint.</p>
</div>
                                                  <p class="mt-auto">
                    <a
                      href="https://lightmatter.co/products/passage-m1000-evk/"
                                            class="inline-flex items-center gap-1 text-base font-medium hover:text-red-500 transition-colors"
                    >Learn more &rarr;</a>
                  </p>
                              </div>
                          <div class="p-8 lg:p-10 flex flex-col gap-4">
                                  <h3 class="text-xl lg:text-2xl font-medium leading-snug">Passage EVK100</h3>
                                                                  <div class="editor-content text-sm lg:text-base leading-relaxed text-gray-700"><p>A high-bandwidth unidirectional link reference platform delivering up to 3.2 Tbps aggregate bandwidth at 3.2 pJ/bit.</p>
</div>
                                                  <p class="mt-auto">
                    <a
                      href="https://lightmatter.co/products/passage-evk100/"
                                            class="inline-flex items-center gap-1 text-base font-medium hover:text-red-500 transition-colors"
                    >Learn more &rarr;</a>
                  </p>
                              </div>
                      </div>
                            <div class="grid md:grid-cols-2">
                          <div class="p-8 lg:p-10 flex flex-col gap-4 border-b border-black md:border-b-0 md:border-r ">
                                  <h3 class="text-xl lg:text-2xl font-medium leading-snug">Passage EVK50</h3>
                                                                  <div class="editor-content text-sm lg:text-base leading-relaxed text-gray-700"><p>A 16-wavelength bidirectional link reference platform delivering 800 Gbps per fiber at 2.6 pJ/bit.</p>
</div>
                                                  <p class="mt-auto">
                    <a
                      href="https://lightmatter.co/products/passage-evk50/"
                                            class="inline-flex items-center gap-1 text-base font-medium hover:text-red-500 transition-colors"
