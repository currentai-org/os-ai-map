    .fade-in.in {
      opacity: 1;
    }

    .slide-fade-in {
      opacity: 0;
      transition: opacity 600ms, transform 600ms;
      transform: translateY(40px);
    }

    .slide-fade-in.in {
      opacity: 1;
      transform: translateY(0);
