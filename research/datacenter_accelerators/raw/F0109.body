<script nonce="y1rcqPtag0HfK7nYn+qugg==">window.AX_MEDIA_BASE = window.AX_MEDIA_BASE || "/hubfs/axelera-home-2026/";</script>
    <section data-glass-section="reels" class="section" id="reels">
      <header class="section-head reveal" style="text-align:center">
        <p class="eyebrow">Examples</p>
        <h2>Axelera in action</h2>
