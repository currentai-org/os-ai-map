<script nonce="y1rcqPtag0HfK7nYn+qugg==">
  (function () {
    function initLogoSlider() {
      var root = document.querySelector('.logo_slider_module_17855826343174');
                                        if (!root) return;

      var primaryEl   = root.querySelector('#logo-slider-primary');
      var secondaryEl = root.querySelector('#logo-slider-secondary');

      var baseOptions = {
        type       : 'loop',
        drag       : 'free',
        focus      : 'center',
        perPage    : 6,
        pagination : false,
        arrows     : false,
        gap        : "40px",
        
        autoScroll : {
        speed: 0.5,
        pauseOnHover: false,
      },
          
          breakpoints: {
            1024: {
              perPage: 4,
            },
              768: {
                perPage: 3,
              },
                480: {
                  perPage: 2,
                    gap: "20px",
                },
          },
    };

    var extensions = window.splide.Extensions;

    var splidePrimary;
    if (primaryEl) {
      splidePrimary = new Splide(primaryEl, baseOptions);
      splidePrimary.mount(extensions);
    }


    if (secondaryEl) {
      var secondaryOptions = Object.assign({}, baseOptions, { direction: 'rtl' });
      var splideSecondary = new Splide(secondaryEl, secondaryOptions);
      splideSecondary.mount(extensions);
    }


  }

   if (document.readyState === 'complete') {
    initLogoSlider();
  } else {
    window.addEventListener('load', initLogoSlider);
  }
  })();
</script>

