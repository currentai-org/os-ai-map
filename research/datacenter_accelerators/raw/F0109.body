    </noscript>
    <script nonce="y1rcqPtag0HfK7nYn+qugg==">
      /* Each scrub holds its first frame as a still until the reader reaches it,
         and the markup above names the desktop file so the still survives with
         scripting off. Point it at the same tier the scrub itself will load, so a
         phone never decodes a desktop frame and a 1x screen never decodes a 2x one. */
      (function () {
        var AXB = window.AX_MEDIA_BASE || '';
        var small = matchMedia('(max-width: 900px)').matches;
        var dir = small ? AXB + 'media/seq-sm/' : AXB + 'media/seq/';
        var chip = (!small && window.devicePixelRatio < 1.5) ? AXB + 'media/seq-1x/' : dir;
        [['o-seq', chip + 'chip/000.webp'], ['mul-img', dir + 'multiply/001.webp'], ['crd-img', dir + 'card/001.webp']]
          .forEach(function (p) {
            var el = document.getElementById(p[0]);
            if (el && el.getAttribute('src') !== p[1]) el.src = p[1];
          });
      })();
    </script>
    <div class="olayer oseq2" id="o-dcx"><video id="dcx-vid" muted playsinline preload="none" poster="/hubfs/axelera-home-2026/media/ascent/chain-poster.jpg" aria-label="One accelerator card multiplies, seats into a server, stacks into a rack and becomes a data center"></video></div>

    <!-- the travelling text column -->
    
