      </header>
      <div class="reel-stage reveal">
        <button class="rail-btn rail-prev" type="button" aria-label="Previous video">‹</button>
        <div class="reel-rail" id="reelRail" tabindex="0" role="group" aria-label="Example videos, use the left and right arrow keys">
      <!-- every clip is held in data-src behind its poster: the rail attaches
           exactly one file, once, when that slide reaches the centre -->
      
      
      
      <div class="reel"><video data-src="/hubfs/axelera-home-2026/media/videos/store-1.mp4" poster="/hubfs/axelera-home-2026/media/videos/store-1-poster.webp" muted loop playsinline preload="none"></video><p class="reel-cap"><b>TILED INFERENCE</b> high-resolution scenes sliced into sections, so small objects stay detectable</p></div>
      
      
      
      
      <div class="reel"><video data-src="/hubfs/axelera-home-2026/media/videos/store-2.mp4" poster="/hubfs/axelera-home-2026/media/videos/store-2-poster.webp" muted loop playsinline preload="none"></video><p class="reel-cap"><b>SEGMENTATION AND DETECTION</b> self-checkout: shopper, basket, bags and products masked and labelled, 18.6 to 22.6 fps end to end</p></div>
      
      
      
      
      <div class="reel"><video data-src="/hubfs/axelera-home-2026/media/videos/store-6.mp4" poster="/hubfs/axelera-home-2026/media/videos/store-6-poster.webp" muted loop playsinline preload="none"></video><p class="reel-cap"><b>PPE DETECTION</b> hard-hat compliance across a wall of 24 live streams, with the host CPU at 4%</p></div>
      
      
      
      
      <div class="reel"><div class="clip-chat"><video id="llmReel" data-src="/hubfs/axelera-home-2026/media/video/llm-demo.mp4" poster="/hubfs/axelera-home-2026/media/videos/llm-poster.webp" muted loop playsinline preload="none"></video></div><p class="reel-cap"><b>LLM, illustration</b> an on-device language model answering across twelve camera streams</p></div>
      
      
        </div>
        <button class="rail-btn rail-next" type="button" aria-label="Next video">›</button>
      </div>

      
      <script nonce="y1rcqPtag0HfK7nYn+qugg==">
        (function () {
          var rail = document.getElementById('reelRail');
          if (!rail) return;
          var slides = Array.prototype.slice.call(rail.querySelectorAll('.reel'));
          if (!slides.length) return;
          var centered = slides[0];
          var railInView = false;
          /* while an arrow, a key or a wrap is driving the rail, the slides it
             passes through must not steal the centre from the destination */
          var navLock = 0;

          var live = document.createElement('span');
          live.setAttribute('aria-live', 'polite');
          live.style.cssText = 'position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)';
          rail.parentElement.appendChild(live);

          /* The rail owns its clips outright: they carry no data-autoplay, so
             the global warmer in main.js never touches them. Two observers
             driving the same element was what made a single clip download
             three times, because every play/pause cycle abandoned the range
             request in flight and opened a fresh one.

             attach() is the only place a src is ever set. It runs once per
             clip and is never reversed, so a file that has been fetched can
             never be fetched again. Raising .preload alone would do nothing
             here, and calling load() after assigning src would restart
             selection and cost a second request. */
          var noMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
          var saveData = navigator.connection && navigator.connection.saveData === true;
          var mayLoad = !noMotion && !saveData;

          function attach(v) {
            if (v.dataset.attached) return;
            v.dataset.attached = '1';
            var src = v.getAttribute('data-src');
            if (!src) return;
            v.preload = 'auto';
            v.src = src;
          }

          function sync() {
            slides.forEach(function (sl) {
              var v = sl.querySelector('video');
              if (!v) return;
              if (mayLoad && railInView && sl === centered) {
                attach(v);
                v.play().catch(function () {});
              } else if (!v.paused) { v.pause(); }
            });
          }

          function setCentered(sl) {
            if (!sl) return;
            if (centered !== sl) {
              centered = sl;
              slides.forEach(function (x) { x.classList.toggle('is-center', x === sl); });
              sync();
            }
            var cap = sl.querySelector('.reel-cap');
            live.textContent = 'Video ' + (slides.indexOf(sl) + 1) + ' of ' + slides.length + (cap ? ': ' + cap.textContent : '');
          }

          slides[0].classList.add('is-center');

          var hio = new IntersectionObserver(function (es) {
            if (Date.now() < navLock) return;
            es.forEach(function (e) { if (e.intersectionRatio >= 0.6) setCentered(e.target); });
          }, { root: rail, threshold: [0.6] });
          slides.forEach(function (sl) { hio.observe(sl); });

          var vio = new IntersectionObserver(function (es) {
            es.forEach(function (e) { railInView = e.isIntersecting; sync(); });
          }, { threshold: 0.25 });
          vio.observe(rail);

          /* the rail cycles: past the last slide comes the first, and the same
             the other way round, so neither arrow ever dead-ends */
          function goTo(i) {
            var n = slides.length;
            var sl = slides[((i % n) + n) % n];
            var railBox = rail.getBoundingClientRect();
            var slBox = sl.getBoundingClientRect();
            var delta = (slBox.left + slBox.width / 2) - (railBox.left + railBox.width / 2);
            navLock = Date.now() + 900;
            setCentered(sl);
            rail.scrollTo({
              left: rail.scrollLeft + delta,
              behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
            });
          }

          function step(dir) {
            var i = slides.indexOf(centered);
            goTo((i < 0 ? 0 : i) + dir);
          }

          document.querySelector('.rail-prev').addEventListener('click', function () { step(-1); });
          document.querySelector('.rail-next').addEventListener('click', function () { step(1); });
          rail.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
            else if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
            else if (e.key === 'Home') { e.preventDefault(); goTo(0); }
            else if (e.key === 'End') { e.preventDefault(); goTo(slides.length - 1); }
          });
        })();
      </script>
      
</section>

