      <script nonce="y1rcqPtag0HfK7nYn+qugg==">
        (function () {
          var AXB = window.AX_MEDIA_BASE || '';
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          document.querySelectorAll('.deploy-media').forEach(function (media, idx) {
            var imgs = media.querySelectorAll('img');
            if (imgs.length < 2) return;
            var i = 0;
            setTimeout(function () {
              setInterval(function () {
                imgs[i].classList.remove('on');
                i = (i + 1) % imgs.length;
                imgs[i].classList.add('on');
              }, 3400);
            }, idx * 1150);
          });
        })();
      </script>
