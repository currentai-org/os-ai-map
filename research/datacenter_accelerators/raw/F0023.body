/* =======================
   NON-BLOCKING POPUP CSS
   ======================= */

/* Wrapper covers viewport but does NOT block the site */
.cy-popup {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: none;
  pointer-events: none; /* IMPORTANT: user can still use the site */
}

.cy-popup.is-open {
  display: block;
}

/* Fullscreen positioning container; still doesn't block the site */
.cy-popup__panel {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 16px;
  pointer-events: none;
}

/* Only the card is interactive */
.cy-popup__card {
  pointer-events: auto;
  width: min(420px, 100%);
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 18px 50px rgba(0,0,0,0.18);
  padding: 18px;
  transform: translateY(12px);
  opacity: 0;
  transition: transform 220ms ease, opacity 220ms ease;
}

.cy-popup.is-open .cy-popup__card {
  transform: translateY(0);
  opacity: 1;
}

.cy-popup__title {
  margin: 0 0 10px;
  font-size: 14px;
  font-weight: 700;
  text-align: center;
  line-height: 1.35;
  color: #111;
}

.cy-popup__content {
  max-height: 220px;
  overflow: auto;
  padding: 10px 10px 0;
  border: 1px solid rgba(0,0,0,0.08);
  border-radius: 10px;
  background: rgba(0,0,0,0.02);
}

.cy-popup__content p {
  margin: 0 0 10px;
  font-size: 12px;
  line-height: 1.55;
  color: rgba(0,0,0,0.75);
}

.cy-popup__controls {
  display: flex;
  justify-content: center;
  margin-top: 12px;
}

.cy-popup__checkbox {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: rgba(0,0,0,0.7);
  user-select: none;
}

.cy-popup__checkbox input {
  width: 14px;
  height: 14px;
}

.cy-popup__actions {
  margin-top: 14px;
}

.cy-popup__btn {
  width: 100%;
  border: 0;
  border-radius: 10px;
  padding: 10px 12px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  color: #fff;
  background: #e21500;
  transition: opacity 180ms ease;
}

.cy-popup__btn:hover {
  opacity: 0.9;
}

@media (min-width: 1024px) {
  .cy-popup__panel {
    justify-content: flex-end;
    padding: 24px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .cy-popup__card {
    transition: none;
  }
}
</style></div></div></div></div><div class="nav-wrapper"><div data-animation="default" class="nav w-variant-487ee804-8a1f-edf4-4b2b-914be333d63a w-nav" data-easing2="ease" data-wf--nav--settings-color-mode="dark" data-wf-component-id="2bb3e920-91be-def7-1509-d38c2b3acc09" data-easing="ease" data-wf-variant-state="487ee804-8a1f-edf4-4b2b-914be333d63a" data-collapse="medium" role="banner" data-duration="0"><div class="u-d-none w-embed"><style>
