/*!
 * Homepage background particles (p5.js) — efficient + safe
 * - Lazy-loads p5 only when a [data-bg-particles] element is near viewport
 * - Creates p5 instances only when needed (per element)
 * - Fixes early ResizeObserver -> resizeCanvas() crash
 * - Uses pixelDensity(1) + point() for better performance
 */
(() => {
  "use strict";

  const FALLBACK_PALETTE = {
    black: "#000000",
    white: "#ffffff",
    transparent: "transparent",
    grey: { 10: "#444444", 20: "#7F7F7F", 30: "#D4D4D4" },
    blue: { 10: "#76D6FF", 20: "#F4F7FF", 30: "#1B0333" },
    green: { 10: "#70E697", 20: "#F3FFF7", 30: "#02250D" },
    yellow: { 10: "#FFFA82", 20: "#FFFEEE", 30: "#44391C" },
    red: { 20: "#E21500", 30: "#440A07" },
    peach: { 10: "#FEC2A0" },
    purple: { 20: "#CDBBFF", 30: "#290e5f" }
  };

  const P5_VERSION = "2.1.2";
  const P5_SRC = `https://cdn.jsdelivr.net/npm/p5@${P5_VERSION}/lib/p5.min.js`;

  // ---------- utils ----------
  const isTouch = () =>
    "ontouchstart" in window ||
    navigator.maxTouchPoints > 0 ||
    window.matchMedia?.("(pointer: coarse)")?.matches;

  const isMob = () => window.matchMedia?.("(max-width: 767px)")?.matches;
  const isDesktop = () => window.matchMedia?.("(min-width: 1024px)")?.matches;

  function numAttr(el, name, fallback) {
    const raw = el.getAttribute(name);
    if (raw == null || raw === "") return fallback;
    const n = Number(raw);
    return Number.isFinite(n) ? n : fallback;
  }

  let p5LoadPromise = null;
  function loadP5Once() {
    if (window.p5) return Promise.resolve();
    if (p5LoadPromise) return p5LoadPromise;

    p5LoadPromise = new Promise((resolve, reject) => {
      if (document.querySelector(`script[data-bg-p5-src="${P5_SRC}"]`)) return resolve();
      const s = document.createElement("script");
      s.src = P5_SRC;
      s.async = true;
      s.defer = true;
      s.dataset.bgP5Src = P5_SRC;
      s.onload = () => resolve();
      s.onerror = () => reject(new Error(`Failed to load ${P5_SRC}`));
      document.head.appendChild(s);
    });

    return p5LoadPromise;
  }

  // cache computed class lookups so we don't probe repeatedly
  const computedBgCache = new Map();
  function getComputedBgFromClass(bgClass) {
    if (!bgClass) return null;
    if (computedBgCache.has(bgClass)) return computedBgCache.get(bgClass);

    const probe = document.createElement("div");
    probe.style.position = "absolute";
    probe.style.left = "-99999px";
    probe.style.top = "-99999px";
    probe.style.width = "1px";
    probe.style.height = "1px";
    probe.className = bgClass;
    document.body.appendChild(probe);
    const color = getComputedStyle(probe).backgroundColor;
    document.body.removeChild(probe);

    const val = color && color !== "rgba(0, 0, 0, 0)" ? color : null;
    computedBgCache.set(bgClass, val);
    return val;
  }

  function getColorFromToken(token) {
    if (!token) return "#ffffff";
    const t = token.trim();
    if (t[0] === "#" || t.startsWith("rgb") || t.startsWith("hsl") || t.startsWith("color(")) return t;

    const m = t.match(/bg-([a-zA-Z]+)-(\d+)/);
    if (m) {
      const name = m[1];
      const level = m[2];
      const pal = FALLBACK_PALETTE[name];
      if (typeof pal === "string") return pal;
      if (pal && pal[level] != null) return pal[level];
      const computed = getComputedBgFromClass(t);
      if (computed) return computed;
    }

    const computed = getComputedBgFromClass(t);
    if (computed) return computed;

    return "#ffffff";
  }

  function getSize(el) {
    const r = el.getBoundingClientRect();
    return {
      w: Math.max(1, Math.round(r.width)),
      h: Math.max(1, Math.round(r.height))
    };
  }

  // ---------- per-container controller ----------
  const controllers = new Map();

  function createController(container) {
    const ctrl = {
      el: container,
      p: null,
      ready: false,
      running: false,
      ioRun: null,
      ro: null,

      async ensureCreated() {
        if (this.p) return;

        // if element is not in DOM anymore, skip
        if (!document.documentElement.contains(this.el)) return;

        await loadP5Once();
        if (!window.p5) return;

        const bgColor = getColorFromToken(this.el.dataset.lightColor);
        const dotColor = getColorFromToken(this.el.dataset.darkColor);

        const defaultCount = isDesktop() ? 5000 : isMob() ? 2000 : 4000;
        const particleCount = numAttr(this.el, "data-particles", defaultCount);
        const noiseScale = numAttr(this.el, "data-noise-scale", 1200);
        const dotSizeDesktop = numAttr(this.el, "data-dot-size-desktop", 3);
        const dotSize = numAttr(this.el, "data-dot-size", 2.5);
        const trailAlpha = numAttr(this.el, "data-trail-alpha", 10);

        const sketch = (p) => {
          let particles = [];
          let size = { w: 1, h: 1 };
          let pointSize = isDesktop() ? dotSizeDesktop : dotSize;

          function rebuild() {
            particles = new Array(particleCount);
            for (let i = 0; i < particleCount; i++) {
              particles[i] = {
                x: p.random(1.2 * p.width),
                y: p.random(p.height),
                // keep same behavior (negative drift); use correct min/max order
                speed: p.random(-0.45, -0.15)
              };
            }
          }

          p.setup = () => {
            size = getSize(container);
            const c = p.createCanvas(size.w, size.h);
            c.parent(container);

          
            p.noFill();
            p.noStroke();
            p.background(bgColor);

            pointSize = isDesktop() ? dotSizeDesktop : dotSize;
            rebuild();

            // start paused; controller decides when to loop
            p.noLoop();
            ctrl.ready = true;

            // if IO already wants it running, start now
            if (ctrl.running) p.loop();
          };

          p.draw = () => {
            // trail effect
            p.background(bgColor);
            p.noStroke();
            p.fill(0, trailAlpha);
            p.rect(0, 0, p.width, p.height);

            // draw particles cheaply
            p.noFill();
            p.stroke(dotColor);
            p.strokeWeight(pointSize);

            for (let i = 0; i < particles.length; i++) {
              const pt = particles[i];

              const a =
                p.noise(pt.x / noiseScale, pt.y / noiseScale, p.frameCount / noiseScale) *
                p.TWO_PI *
                4;

              pt.x += p.cos(a) * pt.speed;
              pt.y += p.sin(a) * pt.speed;

              // wrap/reset
              if (pt.x < 0 || pt.x > p.width || pt.y < 0 || pt.y > p.height) {
                pt.x = p.random(1.2 * p.width);
                pt.y = p.random(p.height);
              }

              p.point(pt.x, pt.y);
            }
          };

          // NOTE: we do NOT rely on p.windowResized firing from p5;
          // the controller calls safeResize() below.
        };

        this.p = new window.p5(sketch);

        // Safe resize observer (guarded until p5 renderer exists)
        this.ro = new ResizeObserver(() => {
          if (!this.p || !this.ready) return;
          if (isTouch()) return; // keep your original behavior
          // ensure canvas/renderer exists before resizing (fixes your crash)
          if (!this.p._renderer || !this.p._renderer.canvas) return;

          const { w, h } = getSize(this.el);
          if (w === this.p.width && h === this.p.height) return;

          try {
            this.p.resizeCanvas(w, h);
          } catch (e) {
            // if element disappeared mid-resize, just ignore
          }
        });
        this.ro.observe(this.el);

        // Run/pause IO (after created so we can call loop/noLoop safely)
        const trigger = this.el.parentElement || this.el;
        this.ioRun = new IntersectionObserver(
          ([entry]) => {
            this.running = !!entry.isIntersecting;

            if (!this.p) return;
            if (!this.ready) return;

            if (this.running) this.p.loop();
            else this.p.noLoop();
          },
          { threshold: 0.15 }
        );
        this.ioRun.observe(trigger);
      },

      destroy() {
        try {
          this.ioRun?.disconnect();
          this.ro?.disconnect();
        } catch (_) {}

        if (this.p) {
          try { this.p.remove(); } catch (_) {}
        }

        this.p = null;
        this.ready = false;
        this.running = false;
        this.ioRun = null;
        this.ro = null;
      }
    };

    return ctrl;
  }

  // ---------- lazy creation IO ----------
  function boot() {
    const containers = Array.from(document.querySelectorAll("[data-bg-particles]"));
    if (!containers.length) return;

    // Create controllers
    for (const el of containers) {
      if (!controllers.has(el)) controllers.set(el, createController(el));
    }

    // IO to CREATE instances only when close to viewport
    const ioCreate = new IntersectionObserver(
      async (entries) => {
        for (const entry of entries) {
          const ctrl = controllers.get(entry.target);
          if (!ctrl) continue;

          if (entry.isIntersecting) {
            // Create only when needed
            ctrl.running = true; // if it comes in, we want it running
            await ctrl.ensureCreated();
          } else {
            // Don’t destroy by default (avoids re-init spikes). Just pause when offscreen.
            // If you DO want to destroy when far away, tell me and I’ll add a distance-based destroy.
          }
        }
      },
      {
        // start loading/creating before it scrolls into view
        rootMargin: "400px 0px 400px 0px",
        threshold: 0.01
      }
    );

    containers.forEach((el) => ioCreate.observe(el));

    // Expose for debugging
    window.bgParticlesHomepage = {
      destroyAll() {
        controllers.forEach((c) => c.destroy());
        controllers.clear();
      },
      controllers
    };
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot, { once: true });
  } else {
    boot();
  }
})();
</script><script src="https://hubspotv2.use1-marketplace-1p-apps-prod-red.if.webflow.services/static/disable-hubspot-chatbot.js" type="text/javascript" async="" defer=""></script><script src="https://js.hs-scripts.com/242397185.js" type="text/javascript" async="" defer=""></script><script src="https://hubspotv2.use1-marketplace-1p-apps-prod-red.if.webflow.services/static/loader.js" type="text/javascript" async="" defer=""></script></body></html>