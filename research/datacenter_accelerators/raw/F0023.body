/* =======================
   NON-BLOCKING POPUP JS
   - Show only if timezone = Asia/Seoul (simple, fast)
   - "Don't show again" hides for 30 days
   ======================= */
(() => {
  "use strict";

  const popup = document.getElementById("recruitmentNotice");
  if (!popup) return;

  const checkbox = document.getElementById("cyNoticeDontShow");
  const closeSelectors = "[data-popup-close]";

  // "Don't show again" for 30 days
  const HIDE_UNTIL_KEY = "recruitment_notice_hide_until";
  const HIDE_MS = 30 * 24 * 60 * 60 * 1000;

  const open = () => {
    popup.classList.add("is-open");
    popup.setAttribute("aria-hidden", "false");
  };

  const close = () => {
    popup.classList.remove("is-open");
    popup.setAttribute("aria-hidden", "true");
  };

  const isHiddenByPreference = () => {
    try {
      return Number(localStorage.getItem(HIDE_UNTIL_KEY) || 0) > Date.now();
    } catch (e) {
      return false;
    }
  };

  const hideFor30Days = () => {
    try {
      localStorage.setItem(HIDE_UNTIL_KEY, String(Date.now() + HIDE_MS));
    } catch (e) {}
  };

  // Close only when clicking the Close button (or anything you mark with data-popup-close)
  popup.addEventListener("click", (e) => {
    const closeEl = e.target.closest(closeSelectors);
    if (!closeEl) return;

    if (checkbox && checkbox.checked) hideFor30Days();
    close();
  });

  // Timezone-based check (simple / fast)
  function isSouthKoreaByTimeZone() {
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "";
      return tz === "Asia/Seoul";
    } catch (e) {
      return false;
    }
  }

  // Init
  close();
  if (isHiddenByPreference()) return;

  if (isSouthKoreaByTimeZone()) open();
})();
</script></div><div class="w-embed w-script"><script>
/* =======================
