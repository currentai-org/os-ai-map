<style>
  /* Tablet and below (Webflow breakpoint = 991px) */
  @media (max-width: 991px) {

    /* Force the dropdown content to always show */
    .nav-dropdown_content {
      display: block !important;
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
      height: auto !important;
      position: static !important; /* optional: makes it sit naturally in the flow */
    }

    /* Optional: remove the dropdown toggle behavior feeling */
    .nav-dropdown .w-dropdown-toggle {
      pointer-events: none; /* makes it non-clickable */
      cursor: default;
    }

    /* Optional: hide the arrow since it implies collapsing */
    .nav-dropdown_arrow {
      display: none;
    }
}
</style></div><div class="u-d-none w-embed w-script"><script>
	//---- Skip to <main> backup if #main anchor link isn't set ----
  document.addEventListener('DOMContentLoaded', () => {
    const skipLinkEle = document.getElementById('skip-link');
    if (!skipLinkEle) return;

    skipLinkEle.addEventListener('click', handleSkipLink);
    skipLinkEle.addEventListener('keydown', handleSkipLink);
  });

  function handleSkipLink(e) {
    if (e.type === 'keydown' && e.key !== 'Enter') return;

    e.preventDefault();
    const target = document.querySelector('main');
    target.setAttribute('tabindex', '-1');
    target.focus();
  }
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // ✅ Only run on pages that have the hero
    const hero = document.querySelector('[section="top"]');
    if (!hero) return;

    const nav = document.querySelector(".nav");
    if (!nav) return;

    const MODE_ATTR = "data-wf--nav--settings-color-mode";
    const VARIANT_TRANSPARENT = "w-variant-ca1d7055-4faf-cc5f-cfa6-386a09fc63d0";
    const VARIANT_DARK = "w-variant-487ee804-8a1f-edf4-4b2b-914be333d63a"; // cleared just in case

    let currentMode = null;
    let isAnimating = false;

    function toggleVariantEverywhere(className, add) {
      const all = [nav, ...nav.querySelectorAll("*")];
      all.forEach((el) => el.classList.toggle(className, add));
    }

    function setBaseInstant() {
      nav.setAttribute(MODE_ATTR, "base");
      toggleVariantEverywhere(VARIANT_TRANSPARENT, false);
      toggleVariantEverywhere(VARIANT_DARK, false);
      currentMode = "base";
    }

    function setTransparentInstant() {
      nav.setAttribute(MODE_ATTR, "transparent");
      toggleVariantEverywhere(VARIANT_DARK, false);
      toggleVariantEverywhere(VARIANT_TRANSPARENT, true);
      currentMode = "transparent";
    }

    function animateTo(mode) {
      if (currentMode === mode || isAnimating) return;

      isAnimating = true;

      gsap.to(nav, {
        opacity: 0,
        duration: 0.2,
        ease: "power1.out",
        overwrite: "auto",
        onComplete: () => {
          mode === "transparent" ? setTransparentInstant() : setBaseInstant();

          gsap.to(nav, {
            opacity: 1,
            duration: 0.2,
            ease: "power1.out",
            overwrite: "auto",
            onComplete: () => (isAnimating = false)
          });
        }
      });
    }

    function updateMode() {
      const atTop = (window.scrollY || window.pageYOffset || 0) === 0;
      animateTo(atTop ? "transparent" : "base");
    }

    // Initial mode (no animation)
    ((window.scrollY || window.pageYOffset || 0) === 0)
      ? setTransparentInstant()
      : setBaseInstant();

    // Update on scroll (rAF-throttled)
    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateMode();
          ticking = false;
        });
      },
      { passive: true }
    );
  });
</script>




<script>
  document.addEventListener("DOMContentLoaded", () => {
    const nav = document.querySelector(".nav-wrapper");
    if (!nav) return;

    // Starting position
    gsap.set(nav, { yPercent: 0 });

    let lastScrollY = window.scrollY;
    let isHidden = false;

    // Tweak these
    const threshold = 8;   // px needed before it reacts
    const showAtTop = true;

    function showNav() {
      if (!isHidden) return;
      isHidden = false;

      gsap.to(nav, {
        yPercent: 0,
        duration: 0.35,
        ease: "power2.out",
        overwrite: "auto"
      });
    }

    function hideNav() {
      if (isHidden) return;
      isHidden = true;

      gsap.to(nav, {
        yPercent: -101, // moves it fully out of view upward
        duration: 0.35,
        ease: "power2.out",
        overwrite: "auto"
      });
    }

    window.addEventListener("scroll", () => {
      const currentY = window.scrollY;
      const delta = currentY - lastScrollY;

      // Optional: always show when at top
      if (showAtTop && currentY <= 0) {
        showNav();
        lastScrollY = currentY;
        return;
      }

      // Ignore tiny scroll changes
      if (Math.abs(delta) < threshold) return;

      if (delta > 0) {
        // scrolling down
        hideNav();
      } else {
        // scrolling up
        showNav();
      }

      lastScrollY = currentY;
    }, { passive: true });
  });
</script>

<script>
(() => {
  // Requires GSAP to already be on the page
  const menus = Array.from(document.querySelectorAll('.nav-menu.w-nav-menu'));
  if (!menus.length || !window.gsap) return;

  const DURATION = 0.2;
  const EASE = "power1.out";

  menus.forEach((menu) => {
    // set initial opacity instantly (no CSS needed)
    const sync = (animate = false) => {
      const isOpen = menu.hasAttribute('data-nav-menu-open');

      if (animate) {
        gsap.to(menu, {
          opacity: isOpen ? 1 : 0,
          duration: DURATION,
          ease: EASE,
          overwrite: "auto"
        });
      } else {
        gsap.set(menu, { opacity: isOpen ? 1 : 0 });
      }
    };

    // initial state
    sync(false);

    // watch for Webflow toggling the attribute
    const mo = new MutationObserver((mutations) => {
      for (const m of mutations) {
        if (m.type === "attributes" && m.attributeName === "data-nav-menu-open") {
          sync(true);
        }
      }
    });

    mo.observe(menu, { attributes: true, attributeFilter: ["data-nav-menu-open"] });
  });
})();
</script></div><a id="skip-link" data-wf-native-id-path="3efe1c08-ffda-7ef1-213a-ea328a9868cf:e1c94093-8d13-da52-3f96-64c333050b66:2bb3e920-91be-def7-1509-d38c2b3acc0b" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="2bb3e920-91be-def7-1509-d38c2b3acc0b" data-wf-component-context="%5B%7B%22componentId%22%3A%22e1c94093-8d13-da52-3f96-64c333050b63%22%2C%22instanceId%22%3A%223efe1c08-ffda-7ef1-213a-ea328a9868cf%22%7D%2C%7B%22componentId%22%3A%222bb3e920-91be-def7-1509-d38c2b3acc09%22%2C%22instanceId%22%3A%22e1c94093-8d13-da52-3f96-64c333050b66%22%7D%5D" href="#main" class="nav-skip-link">Skip to Main Content</a><div search="background" class="search-background"></div><div class="container cc-nav"><a data-wf-native-id-path="3efe1c08-ffda-7ef1-213a-ea328a9868cf:e1c94093-8d13-da52-3f96-64c333050b66:2bb3e920-91be-def7-1509-d38c2b3acc0e" data-wf-ao-click-engagement-tracking="true" data-wf-element-id="2bb3e920-91be-def7-1509-d38c2b3acc0e" data-wf-component-context="%5B%7B%22componentId%22%3A%22e1c94093-8d13-da52-3f96-64c333050b63%22%2C%22instanceId%22%3A%223efe1c08-ffda-7ef1-213a-ea328a9868cf%22%7D%2C%7B%22componentId%22%3A%222bb3e920-91be-def7-1509-d38c2b3acc09%22%2C%22instanceId%22%3A%22e1c94093-8d13-da52-3f96-64c333050b66%22%7D%5D" href="/" class="nav-logo_link w-variant-487ee804-8a1f-edf4-4b2b-914be333d63a w-nav-brand"><div class="icon-embed-custom w-variant-487ee804-8a1f-edf4-4b2b-914be333d63a w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 100 27" fill="none" preserveAspectRatio="xMidYMid meet" aria-hidden="true" role="img">
