<script type="text/javascript" wd_script_id="download_page_as_pdf_script" nonce="YjBmYzFjMjhhMTAxMmE0YjYyOGNhMTQyYmE0Mjc3MWNjOGI0YWMzNw==">
	function download_page_as_pdf(el) {

		function load_script(src) {
			return new Promise(function(resolve, reject) {
				var s = document.createElement("script");
				s.src = src;
				s.onload = resolve;
				s.onerror = function () { reject(new Error("failed to load " + src)); };
				document.head.appendChild(s);
			});
		}

		function ensure_libs() {
			var need = [];
			if (typeof window.html2canvas === "undefined")
				need.push(load_script("https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"));
			if (typeof window.jspdf === "undefined")
				need.push(load_script("https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"));
			return Promise.all(need);
		}

		function fallback_to_server(err) {
			if (window.console && console.error)
				console.error("Client-side PDF generation failed, falling back to server download:", err);
			window.location.href = el.href;
		}

		function safe_filename() {
			var title = (document.title || "page").replace(/[\/:*?"<>|]+/g, "").trim();
			return (title || "page") + ".pdf";
		}

		// Known third-party widgets (cookie/consent banners, social embeds, iframes)
		// that are (a) not meaningful in a static PDF and (b) commonly served
		// without CORS headers, which taints the canvas and breaks export.
		var known_widget_selector = [
			"iframe",
			"[id*='trustarc' i]", "[class*='trustarc' i]", "[id*='teconsent' i]",
			"[id*='consent_blackbar' i]", "[class*='truste' i]", "[id^='pop-frame']",
			"[id*='onetrust' i]", "[class*='onetrust' i]", "[class*='ot-sdk' i]",
			"[id*='cookiebot' i]", "[class*='cookie-consent' i]", "[class*='cookiebanner' i]"
		].join(",");

		function is_cross_origin_url(url) {
			try {
				return new URL(url, document.baseURI).origin !== window.location.origin;
			} catch (e) {
				return false;
			}
		}

		// strict = also skip any element whose image/background is cross-origin,
		// used as a fallback retry when a first, lighter-touch capture gets tainted.
		function build_ignore_elements(strict) {
			return function (node) {
				if (node.matches && node.matches(known_widget_selector))
					return true;
				if (!strict)
					return false;
				if (node.tagName === "IMG" && node.src && is_cross_origin_url(node.src))
					return true;
				var bg = window.getComputedStyle ? window.getComputedStyle(node).backgroundImage : "";
				var m = bg && /url\((['"]?)(.*?)\1\)/.exec(bg);
				if (m && is_cross_origin_url(m[2]))
					return true;
				return false;
			};
		}

		function capture_canvas(strict) {
			var exclude_selector = ".wd_toolbar, [data-pdf-exclude]";

			return window.html2canvas(document.body, {
				useCORS: true,
				allowTaint: false,
				scale: window.devicePixelRatio > 1 ? 2 : 1.5,
				windowWidth: document.documentElement.scrollWidth,
				windowHeight: document.documentElement.scrollHeight,
				ignoreElements: build_ignore_elements(strict),
				onclone: function (cloned_doc) {
					var nodes = cloned_doc.querySelectorAll(exclude_selector);
					for (var i = 0; i < nodes.length; i++)
						nodes[i].style.display = "none";
				}
			}).then(function (canvas) {
				// Force the taint check now (rather than later, at save time) so
				// we can retry with a stricter capture before giving up.
				var data_url = canvas.toDataURL("image/jpeg", 0.95);
				return { canvas: canvas, data_url: data_url };
			});
		}

		var original_cursor = document.body.style.cursor;
		document.body.style.cursor = "wait";

		ensure_libs().then(function () {

			return capture_canvas(false).catch(function (err) {
				if (window.console && console.warn)
					console.warn("PDF capture tainted, retrying without cross-origin images:", err);
				return capture_canvas(true);
			});

		}).then(function (result) {

			var canvas = result.canvas;
			var jsPDF = window.jspdf.jsPDF;
			var pdf = new jsPDF("p", "pt", "a4");

			var page_width = pdf.internal.pageSize.getWidth();
			var page_height = pdf.internal.pageSize.getHeight();
			var img_width = page_width;
			var img_height = (canvas.height * img_width) / canvas.width;
			var height_left = img_height;
			var position = 0;

			pdf.addImage(result.data_url, "JPEG", 0, position, img_width, img_height);
			height_left -= page_height;

			while (height_left > 0) {
				position = height_left - img_height;
				pdf.addPage();
				pdf.addImage(result.data_url, "JPEG", 0, position, img_width, img_height);
				height_left -= page_height;
			}

			pdf.save(safe_filename());

		}).catch(fallback_to_server).finally(function () {
			document.body.style.cursor = original_cursor;
		});

		return false;
	}
</script>

