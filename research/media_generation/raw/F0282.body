rl":"pkg:github/Comfy-Org/comfy-cli@v0.0.1","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/Comfy-Org%2Fcomfy-cli/tags/v0.0.1","manifests_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/Comfy-Org%2Fcomfy-cli/tags/v0.0.1/manifests"},{"name":"2024.05.01","sha":"187a4749ae4e97f271a275b79e1049b7efb973dd","kind":"commit","published_at":"2024-05-01T10:53:24.000Z","download_url":"https://codeload.github.com/Comfy-Org/comfy-cli/tar.gz/2024.05.01","html_url":"https://github.com/Comfy-Org/comfy-cli/releases/tag/2024.05.01","dependencies_parsed_at":null,"dependency_job_id":null,"purl":"pkg:github/Comfy-Org/comfy-cli@2024.05.01","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/Comfy-Org%2Fcomfy-cli/tags/2024.05.01","manifests_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/Comfy-Org%2Fcomfy-cli/tags/2024.05.01/manifests"}]},"repo_metadata_updated_at":"2026-09-26T10:16:40.140Z","dependent_packages_count":0,"downloads":80654,"downloads_period":"last-month","dependent_repos_count":0,"rankings":{"downloads":null,"dependent_repos_count":63.02641635060954,"dependent_packages_count":9.553128920883397,"stargazers_count":null,"forks_count":null,"docker_downloads_count":null,"average":36.289772635746466},"purl":"pkg:pypi/comfy-cli","advisories":[{"uuid":"GSA_kwCzR0hTQS01NjJyLTg0NDUtNTRyMs4ABRB4","url":"https://github.com/advisories/GHSA-562r-8445-54r2","title":"ComfyUI-Manager is Vulnerable to CRLF Injection in Configuration Handler","description":"## Impact\n\n**Vulnerability Type**: CRLF Injection via ConfigParser\n\nAn attacker can inject special characters into HTTP query parameters to add arbitrary configuration values to the `config.ini` file. This can lead to security setting tampering or modification of application behavior.\n\n**Affected Users**: Users running ComfyUI-Manager in environments where ComfyUI is configured with the `--listen` option to allow remote access.\n\n**CVSS Score**: 7.5 (High)\n\n## Patches\n\nFixed in the following versions:\n- **3.39.2** (v3.x branch)\n- **4.0.5** (v4.x branch)\n\nSanitization logic was added to the `write_config()` function to remove CRLF and NULL characters from all string values.\n\n## Workarounds\n\nIf upgrading is not possible:\n- Run ComfyUI-Manager only on trusted networks\n- Block external access via firewall\n- Run on localhost only without the `--listen` option\n\n## References\n\n- [CWE-93: Improper Neutralization of CRLF Sequences](https://cwe.mitre.org/data/definitions/93.html)\n- [OWASP CRLF Injection](https://owasp.org/www-community/vulnerabilities/CRLF_Injection)\n\n## Credit\n\nThis vulnerability was reported by:\n- 李存义 \u003cxiaoheihei1107@gmail.com\u003e\n- D0n9 Li \u003cwyd0n9@gmail.com\u003e\n- Swings \u003cswing@mail.exp.sh\u003e\n- Osword from SGLAB of Legendsec at Qi'anxin Group \u003czhzhdoai@gmail.com\u003e","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2026-01-13T19:02:52.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":7.5,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:H/A:N","references":["https://github.com/Comfy-Org/ComfyUI-Manager/security/advisories/GHSA-562r-8445-54r2","https://nvd.nist.gov/vuln/detail/CVE-2026-22777","https://github.com/Comfy-Org/ComfyUI-Manager/commit/ef8703a3d7ab4e6ecda8f96e0c5816c23d1cb262","https://github.com/Comfy-Org/ComfyUI-Manager/commit/f4fa394e0f03b013f1068c96cff168ad10bd0410","https://github.com/advisories/GHSA-562r-8445-54r2"],"source_kind":"github","identifiers":["GHSA-562r-8445-54r2","CVE-2026-22777"],"repository_url":null,"blast_radius":0.0,"created_at":"2026-01-13T20:00:08.466Z","updated_at":"2026-09-26T17:04:48.932Z","epss_percentage":0.00347,"epss_percentile":0.25564,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS01NjJyLTg0NDUtNTRyMs4ABRB4","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS01NjJyLTg0NDUtNTRyMs4ABRB4","packages":[{"ecosystem":"pypi","package_name":"comfy-cli","versions":[{"first_patched_version":"3.39.2","vulnerable_version_range":"\u003c 3.39.2"},{"first_patched_version":"4.0.5","vulnerable_version_range":"\u003e= 4.0.0, \u003c= 4.0.4"}],"purl":"pkg:pypi/comfy-cli"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS01NjJyLTg0NDUtNTRyMs4ABRB4/related_packages","related_advisories":[]}],"docker_usage_url":"https://docker.ecosyste.ms/usage/pypi/comfy-cli","docker_dependents_count":null,"docker_downloads_count":null,"usage_url":"https://repos.ecosyste.ms/usage/pypi/comfy-cli","dependent_repositories_url":"https://repos.ecosyste.ms/api/v1/usage/pypi/comfy-cli/dependencies","status":null,"funding_links":[],"critical":null,"issue_metadata":{"last_synced_at":"2026-09-25T09:25:57.368Z","issues_count":136,"pull_requests_count":511,"avg_time_to_close_issue":3501462.327586207,"avg_time_to_close_pull_request":597138.456937799,"issues_closed_count":58,"pull_requests_closed_count":418,"pull_request_authors_count":51,"issue_authors_count":85,"avg_comments_per_issue":1.2058823529411764,"avg_comments_per_pull_request":1.5088062622309197,"merged_pull_requests_count":379,"bot_issues_count":10,"bot_pull_requests_count":43,"past_year_issues_count":35,"past_year_pull_requests_count":240,"past_year_avg_time_to_close_issue":283114.1538461539,"past_year_avg_time_to_close_pull_request":449173.2722513089,"past_year_issues_closed_count":13,"past_year_pull_requests_closed_count":191,"past_year_pull_request_authors_count":22,"past_year_issue_authors_count":17,"past_year_avg_comments_per_issue":1.3714285714285714,"past_year_avg_comments_per_pull_request":2.408333333333333,"past_year_bot_issues_count":10,"past_year_bot_pull_requests_count":39,"past_year_merged_pull_requests_count":174,"issues_url":"https://issues.ecosyste.ms/api/v1/hosts/GitHub/repositories/comfy-org%2Fcomfy-cli/issues","maintainers":[{"login":"mattmillerai","count":84,"url":"https://issues.ecosyste.ms/api/v1/hosts/GitHub/authors/mattmillerai"},{"lo