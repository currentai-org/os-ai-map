{"id":5737603,"name":"sdkit","ecosystem":"pypi","description":"sdkit (stable diffusion kit) is an easy-to-use library for using Stable Diffusion in your AI Art projects. It is fast, feature-packed, and memory-efficient. It bundles Stable Diffusion along with commonly-used features (like SDXL, ControlNet, LoRA, Embeddings, GFPGAN, RealESRGAN, k-samplers, custom VAE etc). It also includes a model-downloader with a database of commonly used models, and advanced features like running in parallel on multiple GPUs, auto-scanning for malicious models etc.","homepage":"https://github.com/easydiffusion/sdkit","licenses":"MIT License","normalized_licenses":["MIT"],"repository_url":"https://github.com/easydiffusion/sdkit","keywords_array":["stable diffusion","ai","art"],"namespace":null,"versions_count":240,"first_release_published_at":"2022-12-23T17:05:50.000Z","latest_release_published_at":"2026-04-24T10:10:23.000Z","latest_release_number":"2.1.1","last_synced_at":"2026-09-09T01:36:24.757Z","created_at":"2022-12-23T17:16:28.407Z","updated_at":"2026-09-18T08:01:21.461Z","registry_url":"https://pypi.org/project/sdkit/","install_command":"pip install sdkit --index-url https://pypi.org/simple","documentation_url":"https://sdkit.readthedocs.io/","metadata":{"funding":null,"documentation":null,"classifiers":["License :: OSI Approved :: MIT License","Operating System :: MacOS","Operating System :: Microsoft :: Windows :: Windows 10","Operating System :: Microsoft :: Windows :: Windows 11","Operating System :: POSIX :: Linux","Programming Language :: Python :: 3"],"normalized_name":"sdkit","project_status":null},"repo_metadata":{"id":65062474,"uuid":"581490945","full_name":"easydiffusion/sdkit","owner":"easydiffusion","description":"sdkit (stable diffusion kit) is an easy-to-use library for using Stable Diffusion in your AI Art projects. It is fast, feature-packed, and memory-efficient.","archived":false,"fork":false,"pushed_at":"2026-08-27T11:39:15.000Z","size":1823,"stargazers_cou