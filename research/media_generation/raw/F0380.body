banner/banner-4-en.d630aa677b5b0a38.mp4","tag":""},{"title":"スポーツ拡散エフェクト","subTitle":"ワンクリックで話題を呼ぶ集客を実現。企業向けカスタマイズにも対応しています。","imgUrl":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/images/dev-home/banner/banner-1.e9eaa3392ad536e3.png","videoUrl":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/banner-1-en.8510ecd320de5b6b.mp4","tag":""},{"title":"Kling × Honor 600","subTitle":"Honor 600と連携し、AI映像制作の新基準を築く","imgUrl":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/images/dev-home/banner/banner-cover-2-en.9fab5758bd94e928.png","videoUrl":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/banner-2-en.86fd0cc9b87548b4.mp4","tag":""}],"modelVersionCards":[{"apiLink":"/document-api/api/video/video-omni","releaseLink":"/dev/model-release/video-3-omni","imageUrl":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/images/dev-home/flagship/flagship-cover-video-3.492c32471327126d.png","videoUrl":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/flagship/flagship-video-3.5a24c6d993facac4.mp4","title":"Kling 3.0 & 3.0 Omni","subTitle":"音声と動画を同期生成。インテリジェントな絵コンテ作成・素材参照機能を搭載し、高い描写一貫性とプロンプトの忠実な再現を実現","tag":"HOT"},{"apiLink":"/document-api/api/image/image-omni","releaseLink":"/dev/model-release/image-3-omni","imageUrl":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/images/dev-home/flagship/flagship-cover-image-3.3dfe6798666f1319.png","videoUrl":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/flagship/flagship-image-3-en.c69cd141c5b3d455.mp4","title":"Kling Image 3.0 & 3.0 Omni","subTitle":"映画のような演出表現を実現。連続画像生成・一括最適化に対応し、2K/4K 解像度で直接出力可能"},{"apiLink":"/document-api/api/video/image-to-video","releaseLink":"/dev/model-release/native-4k-video","imageUrl":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/images/dev-home/flagship/flagship-cover-video-4k.9666ba031270006b.png","videoUrl":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/flagship/flagship-image-4k.071927e9a8023f08.mp4","title":"Kling ネイティブ 4K 動画","subTitle":"商業制作向けに開発された、映画クオリティの 4K 動画を生成"},{"apiLink":"/document-api/api/video/motion-control","releaseLink":"/dev/model-release/motion-control","imageUrl":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/images/dev-home/flagship/flagship-cover-motion-control.9c79201a8a71b085.png","videoUrl":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/flagship/flagship-image-motion-control.d82c7da4b01d2623.mp4","title":"Kling モーションコントロール","subTitle":"先進のモーションキャプチャ技術により、複雑な動きや繊細な表情を忠実に再現"}],"enterpriseSection":{"title":"エンタープライズサービス","cards":[{"title":"API サービス","desc":"開発者・企業向け。拡張性に優れた企業向け API を活用し、高品質な動画・画像モデルをシステムに連携可能です。","link":"/document-api/guides/get-started/overview"},{"title":"エンタープライズプラン","desc":"企業向け。ノーコードで大規模なコンテンツ一括制作に対応。データプライバシーとコンプライアンス機能を標準搭載しています。","link":"/dev/enterprise-membership"}]},"productFeatures":{"title":"製品機能","videoSectionTitle":"動画モデル","imageSectionTitle":"画像モデル","productFeaturesList":[{"tab":"動画生成 API","list":[{"media":{"cover":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/images/dev-home/video-modal/video-modal-cover-t2v.c3e6aa6167f3ca0a.png","src":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/video-model/video-modal-t2v-en.a210e0a0f9056782.mp4","type":"video"},"title":"テキスト to 動画","desc":"簡単なテキストの指示を、構成が整い論理的な高精細動画へ変換。アイデアをワンクリックでシネマ級映像に仕上げます。","link":"/document-api/api/video/text-to-video"},{"media":{"cover":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/images/dev-home/video-modal/video-modal-cover-i2v.35e56413e2822c19.png","src":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/video-model/video-modal-i2v-en.567b0518faf1dace.mp4","type":"video"},"title":"画像 to 動画","desc":"静止画を基点にスタイルや要素を維持し、滑らかに連続した動画を自動生成。","link":"/document-api/api/video/image-to-video"},{"media":{"cover":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/images/dev-home/video-modal/video-modal-cover-refer.f4c3806715bdc407.png","src":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/video-model/video-modal-refer-en.636b5f4631c2bb46.mp4","type":"video"},"title":"動画 Omni","desc":"統合型マルチモーダル基盤を採用し、複数画像・オブジェクト・動画参照など多様な参照機能に対応します。","link":"/document-api/api/video/reference-to-video"},{"media":{"cover":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/images/dev-home/video-modal/video-modal-cover-motion-control.e9a79e0127f37265.png","src":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/video-model/video-modal-motion-control-en.236f22d47c0a959b.mp4","type":"video"},"title":"モーションコントロール","desc":"モーションキャプチャ技術で人物の動きと表情を抽出し、キャラクターの挙動を精密に制御したコンテンツを出力します。","link":"/document-api/api/video/motion-control"},{"media":{"cover":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/images/dev-home/video-modal/video-modal-cover-agent.d95a72324afd1064.png","src":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/video-model/video-modal-agent-en.ed698b39248fa9d5.mp4","type":"video"},"title":"アバター","desc":"キャラクター画像をアップロードし、音声やテキストを追加するだけで、自然な動きのアバター動画を作成できます。","link":"/document-api/api/video/avatar"},{"media":{"cover":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/images/dev-home/video-modal/video-modal-cover-effect.a8d55c4fa866d03b.png","src":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/video-model/effect-en.431ad496d131595e.mp4","type":"video"},"title":"エフェクトテンプレート","desc":"人気のエフェクトテンプレートをワンクリックで適用し、少ない手間で高品質なクリエイティブ動画を制作可能です。","link":"/document-api/api/effects/templates"}]},{"tab":"画像生成 API","list":[{"media":{"src":"https://v4-kling.kechuangai.com/kcdn/cdn-kcdn112452/kling-website/page4-v3-1.mp4","type":"video"},"title":"高画質シネマティックビジュアル","desc":"ユーザーの意図を的確に把握し、構図・照明・色調・カット切り替え・被写界深度といった映像要素を自在に制御。ストーリーを軸とした表現力豊かなシネマティック映像を制作可能です。","link":"/document-api/api/image/image-generation"},{"media":{"src":"https://v4-kling.kechuangai.com/kcdn/cdn-kcdn112452/kling-website/page4-v3-2.mp4","type":"video"},"title":"ネイティブ 2K / 4K 出力","desc":"ネイティブ 2K・4K ウルトラ HD で出力可能。鮮明な高品質映像を実現し、プロ向け制作フローに最適化されています。","link":"/document-api/api/image/image-generation"},{"media":{"src":"https://v4-kling.kechuangai.com/kcdn/cdn-kcdn112452/kling-website/page4-v3-3.mp4","type":"video"},"title":"複数画像生成・一括最適化","desc":"映画風の構図を持つ連続コマ画像を生成し、ビジュアルストーリーの表現力を高めます。一括最適化機能により反復作業を削減し、大規模な制作でも映像の一貫性を保てます。","link":"/document-api/api/image/image-generation"}]}]},"demoSectionTitle":"顧客事例","demos":[{"title":"広告・EC","desc":"商品画像やテキストをもとに、マーケティング動画をインテリジェントに生成。複数主体のリファレンスや商品インタラクション表現に対応し、ファッション、美容、家電・デジタル製品など幅広い業界に活用できます。ブランド企業、制作会社、運用代行会社における大規模かつ低コストなコンテンツ制作を支援するほか、広告代理店やラグジュアリーブランドの高品質なクリエイティブ制作にも対応し、制作・納品までのリードタイムを大幅に短縮します。","leftLayout":"media","subItems":[{"title":"EC向けワンクリック動画生成","prompt":"商用プロモーション動画を生成。衣装・シーン素材・小道具の差し替えと融合で高い一貫性を実現","thumbnails":["https://p4-kling.klingai.com/kcdn/cdn-kcdn112452/kling-web-tob/images/dev-home/demo/demo-2-1.2b9e2ba90a5d398d.png","https://p2-kling.klingai.com/kcdn/cdn-kcdn112452/kling-web-tob/images/dev-home/demo/demo-2-2.eb1238900aa823ca.png"],"video":"https://v2-kling.kechuangai.com/mediacloud/user-growth-media-transcode/video/b0a13719e49d5c44-51b60338ff93a23020def6e477471eeb-ugstdh264high.mp4?x-kcdn-pid=112452&ss=vps"},{"title":"商品プロモーション動画","prompt":"クリエイティブなシーン演出で、商品を高忠実度に再現","thumbnails":["https://p2-kling.klingai.com/kcdn/cdn-kcdn112452/kling-web-tob/images/dev-home/demo/demo-2-3.f438834595ad7acb.png","https://p4-kling.klingai.com/kcdn/cdn-kcdn112452/kling-web-tob/images/dev-home/demo/demo-2-4.6b7b062a82ab984d.png"],"video":"https://v4-kling.kechuangai.com/mediacloud/user-growth-media-transcode/video/0a19ae18a144107d-2857723284cfbe263859fabc4ec2d8d6-ugstdh264high.mp4?x-kcdn-pid=112452&ss=vps"},{"title":"高品質TVC制作","prompt":"映画級の画質でブランドストーリーを伝える広告動画を、マルチショットで連続的に演出","thumbnails":["https://p2-kling.klingai.com/kcdn/cdn-kcdn112452/kling-web-tob/images/dev-home/demo/demo-2-5.0a1a84bae8cace2c.png","https://p2-kling.klingai.com/kcdn/cdn-kcdn112452/kling-web-tob/images/dev-home/demo/demo-2-6.3a661d611703d440.png"],"video":"https://v4-kling.kechuangai.com/mediacloud/user-growth-media-transcode/video/fcf284950e669892-74ab01d0eaaef51c75e7493113576004-ugstdh264high.mp4?x-kcdn-pid=112452&ss=vps"},{"title":"ゲーム広告クリエイティブ","prompt":"写実的なシーン質感、厚みのある光と影、滑らかなトランジション、安定したキャラクター表現","thumbnails":["https://p2-kling.klingai.com/kcdn/cdn-kcdn112452/kling-web-tob/images/dev-home/demo/demo-2-8.96a18e70a6940615.png","https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/images/dev-home/demo/demo-2-7.cf41ab9fe5b4a7ad.png"],"video":"https://v4-kling.kechuangai.com/mediacloud/user-growth-media-transcode/video/7ba0961d70460a25-0bfc60de1af9ae26ca4bb642ad2b2ba1-ugstdh264high.mp4?x-kcdn-pid=112452&ss=vps"}]},{"title":"スマートデバイス","desc":"自動車向けスマートコックピット、スマートフォン・タブレット、テレビ・PC、スマートウォッチなど、あらゆるスクリーン搭載デバイス向けに、画像・動画生成、デジタルヒューマン駆動、ビジュアルインタラクションのコア機能を提供。マルチモーダルなコンテンツ生成を幅広く支援し、より豊かで没入感のあるシーンベースのインタラクション体験を実現します。","leftLayout":"basic","subItems":[{"title":"スマートコックピット","video":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/demos/智能驾驶（英文）.15f73a37c8c1b81e.mp4"},{"title":"スマートフォン・タブレット","video":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/demos/手机展示（英文）.240c6256efdb9193.mp4"},{"title":"テレビ・PC","video":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/demos/电脑展示（英文）.df805272660d748a.mp4"},{"title":"スマートウォッチ","video":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/demos/手表内容(英文）.b7d495185e9237bd.mp4"}]},{"title":"プロフェッショナル制作プラットフォーム","desc":"世界中のプロフェッショナル制作プラットフォーム、AIGC制作ツール、クリエイターコミュニティ向けに、Kling AI の画像・動画生成機能を提供。テキスト、画像、マルチリファレンスなど多様な生成形式に対応し、プラットフォーム本来の制作体験にシームレスに統合できます。デザインチームやクリエイターの高品質なコンテンツ制作を支援し、制作効率とプロダクト競争力の向上を実現します。","leftLayout":"basic","subItems":[{"title":"AIGC制作ツール","video":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/demos/创作平台（英文).7427c92e49fa36e8.mp4"},{"title":"AIGCコミュニティ","video":"https://s15-kling.klingai.com/kos/s101/nlav112918/kling-web-tob/videos/dev-home/demos/创作社区（英文）.9172a84c95d74c00.mp4"}]},{"title":"AIエージェント","desc":"マルチモーダル生成とインテリジェントなタスクオーケストレーションを基盤に、高品質かつ高コストパフォーマンスな動画生成エンジンを提供。デザイン、マーケティング、ショートドラマなど、さまざまなAIエージェントのユースケースに柔軟に対応します。リアルで表現力豊かな映像を生成し、あらゆるAIエージェントに向けて、安定性と即時利用性を兼ね備えた動画生成基盤を提供します。","leftLayout":"agent","subItems":[{"title":"汎用クリエイティブAIエージェント","video":"https://v2-kling.kechuangai.com/mediacloud/user-growth-media-transcode/video/ab9ac5b0fd7562a7-851d1e6c4f50af0cc6c65fd1215045b4-ugstdh264high.mp4?x-kcdn-pid=112452&ss=vps","featureCards":[{"variant":"input","label":"入力要素：","items":["一言アイデア","参考スタイル","キーワード","絵コンテ脚本"]},{"variant":"agent","label":"エージェント連携：","text":"クリエイティブ理解 · マルチモーダル生成 · 反復的な調整"}]},{"title":"マーケティングコンテンツAIエージェント","video":"https://v4-kling.kechuangai.com/mediacloud/user-growth-media-transcode/video/c509435ee15589a4-e725dd95105bcd0b5b467977d1ab50af-ugstdh264high.mp4?x-kcdn-pid=112452&ss=vps","featureCards":[{"variant":"input","label":"入力要素：","items":["商品画像","セールスポイント","利用シーン"]},{"variant":"agent","label":"エージェント連携：","text":"シーンマッチング · 商品動画生成 · インテリジェント合成"}]},{"title":"ショートドラマ / 漫画動画AIエージェント","video":"https://v2-kling.kechuangai.com/mediacloud/user-growth-media-transcode/video/e360cd0566c3bc25-3a0fbb468b97eabbfaf00b9ee54e363a-ugstdh264high.mp4?x-kcdn-pid=112452&ss=vps","featureCards":[{"variant":"input","label":"入力要素：","text":"脚本構成、キャラクター設定、ストーリー概要"},{"variant":"agent","label":"エージェント連携：","text":"脚本から絵コンテ分解 · シーン動画生成 · 複数話編成"}]}]},{"title":"映像制作","desc":"キャラクターの一貫性維持、カメラワーク制御、マルチシーン動画生成に対応し、プリビズ、VFX、映像制作全体の効率を大幅に向上。ショートドラマ、AI実写作品、映画、テレビドラマなど幅広い映像制作に活用でき、制作期間の短縮と、企画・ビジュアル開発コストの削減を実現します。","leftLayout":"media","subItems":[{"title":"映画","video":"https://v2-kling.kechuangai.com/mediacloud/user-growth-media-transcode/video/9a67865d04ab3362-10f2a9923a776a311319b2085f4bb438-ugorgh264high.mp4?x-kcdn-pid=112452&ss=vps"},{"title":"ドラマ","video":"https://v4-kling.kechuangai.com/mediacloud/user-growth-media-transcode/video/be4b863a9660234f-5140c3f0a3bdac8daea43f5f15f1abcc-ugorgh264high.mp4?x-kcdn-pid=112452&ss=vps"},{"title":"AI実写ドラマ","video":"https://v2-kling.kechuangai.com/mediacloud/user-growth-media-transcode/video/96cbf225c1608284-e1d2cc93efb22503b72e24ebbcabebcd-ugorgh264high.mp4?x-kcdn-pid=112452&ss=vps"},{"title":"AIアニメドラマ","video":"https://v2-kling.kechuangai.com/mediacloud/user-growth-media-transcode/video/780a8b4f76547aa4-b80cebc4811273b7d689b270fd74c9d0-ugorgh264high.mp4?x-kcdn-pid=112452&ss=vps"}]}]},"models":[{"name":"動画生成","video":"https://v1-kling.kechuangai.com/kcdn/cdn-kcdn112452/kling-website/dev-home/model-video-bg.cb39536e7c0db6b4.mp4","taskTypes":["テキストから動画生成","画像から動画生成","動画の延長","リップシンク","動画エフェクト","複数の画像参照"]},{"name":"画像生成","image":"https://p1-kling.klingai.com/kcdn/cdn-kcdn112452/kling-website/dev-home/model-image-bg.b4d28687b1639508.png","taskTypes":["テキストから画像生成","画像から画像生成"]},{"name":"スマートシーン","image":"https://p1-kling.klingai.com/kcdn/cdn-kcdn112452/kling-website/dev-home/model-other-bg.b9d03458735fd5bf.png","taskTypes":["バーチャル試着"]}],"modelUpgradeNotice":"動画V2.1モデルのAPIが正式にリリースされ、カリンAIの新しいデジタルヒューマンが登場しました。","subTitle":"安全で使いやすく、信頼性の高いAPIオンラインサービスを通じて、世界で最も人気のある動画および画像生成モデルにアクセスできます","demos":[{"title":"プロフェッショナルな創作プラットフォーム","desc":"プロフェッショナルな創作シーン向けにAI動画生成機能を拡張し、テキストや静止画像からワンクリックで動画を生成することをサポートします。デザイナーやマーケティングチームが高品質な動画を迅速に生成でき、創作ツールの競争力を高め、マネタイズシーンを拡大するのに役立ちます。","video":"https://v1-kling.kechuangai.com/kcdn/cdn-kcdn112452/kling-website/dev-home/demo-1-jp.d8b437a50e6bb2c6.mp4"},{"title":"エンターテインメント・ソーシャルアプリケーション","desc":"AIエフェクト生成エンジンを提供し、hot人気のエフェクト、古い写真の修復、季節イベントテーマエフェクト、二人用エフェクトなどのクリエイティブな遊び方を実現します。エンタメアプリや各種ソーシャルアプリにおいてユーザーの交流を促進し、ユーザーの粘着性を高め、マネタイズ経路を拡大するのに役立ちます。","video":"https://v1-kling.kechuangai.com/kcdn/cdn-kcdn112452/kling-website/dev-home/demo-2-jp.4db4ba4db86f3ea9.mp4"},{"title":"電子商取引マーケティングシーン","desc":"商品画像と簡単な説明から自動的に商品展示動画を生成し、マルチエージェント参照に基づき、人と商品のインタラクション・展示を実現し、ファッション、美化粧、3Cなど多くのカテゴリーをカバーしています。商家が高品質なマーケティング素材を大量・効率的・低コストで生成できるよう支援します。","video":"https://v1-kling.kechuangai.com/kcdn/cdn-kcdn112452/kling-website/dev-home/demo-3-jp.mp4"}],"demoMobileLogoUrl":"https://p1-kling.klingai.com/kcdn/cdn-kcdn112452/kling-website/dev-home/dev-mobile-global-home-logo-1217.png","demoLogoUrl":"https://p1-kling.klingai.com/kcdn/cdn-kcdn112452/dev-global-home-logo-250717.png","coopLogoUrl":"https://p1-kling.klingai.com/kcdn/cdn-kcdn112452/kling-website/dev-home/coop-logo-en.dca2ee412bb2285b.png","apiVideoUrl":"https://v1-kling.kechuangai.com/kcdn/cdn-kcdn112452/kling-website/dev-home/page3-video-en.37caf59c5ac36bc6.mp4","productFeatures":{"title":"Product Features","title1":"Product","title2":"Features","desc":"","productFeaturesList":[{"title":"Video Generation","titleTab":"Video Generation API","commentary":"Connect to the KLing Video LargeModel, seamlessly integrate text-to-video.image-to-video, lip sync, motion brush, AI effects, and other cutting-edge video generation capabilities.","list":[{"title":"Text to Video","media":{"prompt":"The camera passes through the coral cave from a first person perspective, at high speed","type":"video","src":"https://v1-kling.kechuangai.com/kcdn/cdn-kcdn112452/kling-homepage-aio-prod_aio/assets/videos/model-video-1.6900686236fd8a15.mp4"}},{"title":"Image to Video","media":{"prompt":"The man slowly floated up with his eyes closed, and the camera followed him up slowly, his limbs naturally","referImageRight":"https://p1-kling.klingai.com/kcdn/cdn-kcdn112452/kling-homepage-aio-prod_aio/assets/images/ttv.bf155b7345c70c00.png","type":"video","src":"https://v1-kling.kechuangai.com/kcdn/cdn-kcdn112452/kling-homepage-aio-prod_aio/assets/videos/model-video-2.f136dcee53d42781.mp4"}},{"title":"Video Extension","media":{"type":"video","src":"https://v1-kling.