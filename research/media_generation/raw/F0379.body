D_printing_6.png 1200w, https://cdn.meshy.ai/ti_w:1920,q:75,f:webp/landing-assets/home/landing_3D_printing_6.png 1920w, https://cdn.meshy.ai/ti_w:2048,q:75,f:webp/landing-assets/home/landing_3D_printing_6.png 2048w, https://cdn.meshy.ai/ti_w:3840,q:75,f:webp/landing-assets/home/landing_3D_printing_6.png 3840w" src="https://cdn.meshy.ai/ti_w:3840,q:75,f:webp/landing-assets/home/landing_3D_printing_6.png"/></div><div class="base:w-[62%] base:min-w-[200px] absolute top-[15px] right-[15px] w-[54%] max-w-[300px] min-w-0 rounded-[16px] bg-black/60 px-[18px] py-[13px] backdrop-blur-[10px]"><div class="flex items-center justify-between gap-2"><span class="font-barlow text-[16px] leading-none font-semibold text-white">Printability</span><span class="inline-flex size-[17px] shrink-0 items-center justify-center rounded-full bg-[#93F16E]" style="opacity:0;transform:scale(0.4)"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#07120f" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-check "><path d="M5 12l5 5l10 -10"></path></svg></span></div><div class="overflow-hidden" style="height:auto;opacity:1"><div class="mt-[10px] mb-[8px] h-px bg-white/15"></div><div class="flex items-center justify-between gap-2 py-[3px]" style="opacity:1;transform:none"><span class="text-[13px] text-white/70">Watertight</span><span class="text-[13px] font-semibold text-[#93F16E]">Yes</span></div><div class="flex items-center justify-between gap-2 py-[3px]" style="opacity:1;transform:none"><span class="text-[13px] text-white/70">Volume</span><span class="text-[13px] font-semibold text-[#93F16E]">702.19 cm³</span></div><div class="flex items-center justify-between gap-2 py-[3px]" style="opacity:1;transform:none"><span class="text-[13px] text-white/70">Holes</span><span class="text-[13px] font-semibold text-[#93F16E]">0</span></div><div class="flex items-center justify-between gap-2 py-[3px]" style="opacity:1;transform:none"><span class="text-[13px] text-white/70">Non-manifold edges</span><span class="text-[13px] font-semibold text-[#93F16E]">0</span></div></div></div><div aria-hidden="true" class="absolute top-[-14%] left-[40%] z-[3] h-[128%] w-[3px] translate-x-[-15px] rotate-[14deg] bg-white shadow-[0_0_16px_4px_rgba(255,255,255,0.6)]"></div><div class="absolute bottom-[22px] left-[40%] z-[4] flex translate-x-[calc(-50%-40px)] items-center rounded-full bg-white px-[20px] py-[10px] shadow-[0_0_24px_6px_rgba(197,255,79,0.5)]"><span class="font-barlow text-[18px] leading-none font-semibold text-[#2C7A4A]">AI Auto-Repair</span></div></div></div><div class="base:px-[30px] base:pt-[14px] base:pb-[25px] flex flex-col gap-[15px] px-[16px] pt-[12px] pb-[18px]"><p class="font-barlow text-[24px] leading-[1.1] font-semibold tracking-[-0.72px] text-black">Born Printable, Not Patched</p><p class="font-barlow text-[16px] leading-[1.3] font-medium text-black/80">Most AI models need manual cleanup before they&#x27;ll slice. Meshy models come out watertight and manifold. A built-in printability check still scans every export and auto-repairs any edge cases before you slice.</p></div></div><div class="base:rounded-[30px] flex min-w-px flex-1 flex-col overflow-hidden rounded-[20px] bg-white/70 backdrop-blur-[20px] backdrop-saturate-[2.2] style-module__XfzE0W__cardHoverFlowBorder"><div class="relative h-[300px] w-full shrink-0 overflow-hidden"><div class="absolute inset-0 bg-[linear-gradient(149deg,#8CF7B9_5%,#69BBFF_76%)]"><div class="base:translate-x-[50px] absolute inset-0 z-[2] translate-x-0 translate-y-[15px] p-[10px]"><img alt="Skeleton wolf model auto-split into color-coded printable parts" loading="lazy" decoding="async" data-nimg="fill" class="object-contain object-left-bottom select-none" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(max-width: 1200px) 60vw, 540px" srcSet="https://cdn.meshy.ai/ti_w:384,q:75,f:webp/