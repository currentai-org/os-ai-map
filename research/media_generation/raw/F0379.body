rl(&quot;https://cdn.meshy.ai/landing-assets/home/landing_dot_mesh.svg&quot;);-webkit-mask-image:url(&quot;https://cdn.meshy.ai/landing-assets/home/landing_dot_mesh.svg&quot;);mask-size:100% 100%;-webkit-mask-size:100% 100%;mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat"></div><div class="aspect-[940/864]" style="background-image:linear-gradient(45deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.3) 50%, rgba(0, 0, 0, 0) 100%);mask-image:url(&quot;https://cdn.meshy.ai/landing-assets/home/landing_dot_mesh.svg&quot;);-webkit-mask-image:url(&quot;https://cdn.meshy.ai/landing-assets/home/landing_dot_mesh.svg&quot;);mask-size:100% 100%;-webkit-mask-size:100% 100%;mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat"></div><div class="aspect-[940/864]" style="background-image:linear-gradient(45deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.3) 50%, rgba(0, 0, 0, 0) 100%);mask-image:url(&quot;https://cdn.meshy.ai/landing-assets/home/landing_dot_mesh.svg&quot;);-webkit-mask-image:url(&quot;https://cdn.meshy.ai/landing-assets/home/landing_dot_mesh.svg&quot;);mask-size:100% 100%;-webkit-mask-size:100% 100%;mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat"></div><div class="aspect-[940/864]" style="background-image:linear-gradient(45deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.3) 50%, rgba(0, 0, 0, 0) 100%);mask-image:url(&quot;https://cdn.meshy.ai/landing-assets/home/landing_dot_mesh.svg&quot;);-webkit-mask-image:url(&quot;https://cdn.meshy.ai/landing-assets/home/landing_dot_mesh.svg&quot;);mask-size:100% 100%;-webkit-mask-size:100% 100%;mask-repeat:no-repeat;-webkit-mask-repeat:no-repeat"></div></div><div class="absolute top-[73px] left-1/2 z-20 -translate-x-1/2"><div role="tablist" class="relative inline-flex w-fit items-center gap-[10px] rounded-[15px] p-[3px] bg-black/10 backdrop-blur-[20px]"><span aria-hidden="true" class="absolute top-0 left-0 rounded-[12px] transition-[transform,width] duration-[120ms] ease-[cubic-bezier(0.65,0,0.35,1)] bg-white" style="width:0;height:0;transform:translate(0px, 0px);opacity:0"></span><a href="/3d-printing" role="tab" aria-selected="true" class="font-barlow relative z-[1] flex h-[40px] min-w-[150px] cursor-pointer items-center justify-center rounded-[12px] px-[16px] text-[18px] leading-[1.1] font-medium tracking-[-0.72px] whitespace-nowrap transition-colors duration-200 outline-none select-none"><span class="-translate-y-[1.5px] text-black">3D Printing</span></a><a href="/use-cases/free-game-assets" role="tab" aria-selected="false" class="font-barlow relative z-[1] flex h-[40px] min-w-[150px] cursor-pointer items-center justify-center rounded-[12px] px-[16px] text-[18px] leading-[1.1] font-medium tracking-[-0.72px] whitespace-nowrap transition-colors duration-200 outline-none select-none text-black/50 hover:text-black/70"><span class="-translate-y-[1.5px]">Game Dev</span></a></div></div><div class="absolute inset-x-0 bottom-0 z-10 overflow-hidden text-black" style="top:135px"><div class="mx-auto w-[min(1200px,calc(100vw-32px-var(--sidebar-w,0px)))]"><div class="flex flex-col" style="padding-top:8px;padding-bottom:80px"><div class="text-center"><h2 class="font-barlow base:px-0 base:text-[48px] base:leading-[1.1] base:tracking-[-0.04em] px-[30px] text-[28px] leading-[1.15] font-medium tracking-[-0.03em] lg:text-[60px]">The Only 3D AI Trained to Print</h2><p class="font-barlow base:px-0 base:text-[20px] base:leading-[1.3] mx-auto mt-[14px] max-w-[800px] px-[30px] text-[16px] leading-[1.4] font-medium tracking-[-0.4px] text-black/90">Meshy 3D models are generated with printing in mind — watertight, manifold, and ready to slice.</p></div><div class="mt-[20px] flex justify-center"><a style="color:#C6FF4A" class="group base:h-[60px] base:w-[269px] base:rounded-[20px] relative inline-flex h-[52px] w-[236px] shrink-0 cursor-pointer items-center justify-center overflow-hidden rounded-[16px] select-none style-module__XfzE0W__ctaFlowSurface transition-[box-shadow,transform] duration-300 ease-out hover:shadow-[0_0_22px_rgba(255,255,255,0.95),0_0_55px_rgba(255,255,255,0.7)] active:scale-[0.98]" href="/discover"><span aria-hidden="true" class="style-module__XfzE0W__ctaFlowRing"></span><span class="font-barlow base:text-[20px] relative z-[1] inline-flex translate-x-[7px] -translate-y-[1.5px] items-center gap-[10px] text-[18px] font-semibold tracking-[-0.4px]">Start Creating<span aria-hidden="true" class="relative inline-flex size-5 shrink-0 overflow-hidden"><span class="group-hover:animate-cta-arrow-loop flex w-10 shrink-0 -translate-x-5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-arrow-right size-5 shrink-0" aria-hidden="true"><path d="M5 12l14 0"></path><path d="M13 18l6 -6"></path><path d="M13 6l6 6"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="tabler-icon tabler-icon-arrow-right size-5 shrink-0" aria-hidden="true"><path d="M5 12l14 0"></path><path d="M13 18l6 -6"></path><path d="M13 6l6 6"></path></svg></span></span></span></a></div><div class="base:flex-row mt-[54px] flex flex-col gap-[15px]"><div class="base:rounded-[30px] flex min-w-px flex-1 flex-col overflow-hidden rounded-[20px] bg-white/70 backdrop-blur-[20px] backdrop-saturate-[2.2] style-module__XfzE0W__cardHoverFlowBorder"><div class="relative h-[300px] w-full shrink-0 overflow-hidden"><div class="absolute inset-0 bg-[linear-gradient(141deg,#69BAFE_17%,#8DF7B9_91%)]"><div class="base:w-[80%] absolute top-[-10%] bottom-[-4%] left-[-4%] z-[2] w-[56%] translate-x-[-10px] translate-y-[30px]"><img alt="Toy lion model with broken mesh patches, before print repair" aria-hidden="false" loading="lazy" decoding="async" data-nimg="fill" class="object-contain object-bottom select-none" style="position:absolut