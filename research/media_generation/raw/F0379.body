q:75,f:webp/landing-assets/home/landing_3D_printing_3.png 640w, https://cdn.meshy.ai/ti_w:750,q:75,f:webp/landing-assets/home/landing_3D_printing_3.png 750w, https://cdn.meshy.ai/ti_w:828,q:75,f:webp/landing-assets/home/landing_3D_printing_3.png 828w, https://cdn.meshy.ai/ti_w:1080,q:75,f:webp/landing-assets/home/landing_3D_printing_3.png 1080w, https://cdn.meshy.ai/ti_w:1200,q:75,f:webp/landing-assets/home/landing_3D_printing_3.png 1200w, https://cdn.meshy.ai/ti_w:1920,q:75,f:webp/landing-assets/home/landing_3D_printing_3.png 1920w, https://cdn.meshy.ai/ti_w:2048,q:75,f:webp/landing-assets/home/landing_3D_printing_3.png 2048w, https://cdn.meshy.ai/ti_w:3840,q:75,f:webp/landing-assets/home/landing_3D_printing_3.png 3840w" src="https://cdn.meshy.ai/ti_w:3840,q:75,f:webp/landing-assets/home/landing_3D_printing_3.png"/><span class="font-barlow absolute bottom-[9px] left-[26px] text-[12px] leading-none font-medium text-white capitalize">Auto split</span></div></div></div><div class="base:px-[30px] base:pt-[14px] base:pb-[25px] flex flex-col gap-[15px] px-[16px] pt-[12px] pb-[18px]"><p class="font-barlow text-[24px] leading-[1.1] font-semibold tracking-[-0.72px] text-black">Print in Multi-Color, or Split to Fit</p><p class="font-barlow text-[16px] leading-[1.3] font-medium text-black/80">Multi-color printing maps each texture to the right filament, with clean color boundaries. When a model is too complex, Auto Split breaks it into watertight parts, pre-arranged on the build plate.</p></div></div></div><div class="base:rounded-[30px] base:px-[30px] base:py-[20px] mt-[15px] flex flex-col gap-[20px] rounded-[20px] bg-white/70 px-[16px] py-[15px] backdrop-blur-[20px] backdrop-saturate-[2.2] lg:flex-row lg:items-center lg:justify-between lg:gap-[40px] style-module__XfzE0W__cardHoverFlowBorder"><div class="flex shrink-0 flex-col gap-[15px] lg:max-w-[380px]"><p class="font-barlow text-[24px] leading-[1.1] font-semibold tracking-[-0.72px] text-black">Straight to Your Slicer</p><p class="font-barlow text-[16px] leading-[1.3] font-medium text-black/80">Export as STL, OBJ, or 3MF, then send models directly to OrcaSlicer, Bambu Studio, and more, ready for single- or multi-color printing.</p></div><div class="min-w-0 flex-1"><div class="flex flex-col gap-[16px]"><div class="base:grid-cols-8 base:gap-[10px] grid grid-cols-4 gap-x-[10px] gap-y-[16px]"><div class="flex flex-col items-center gap-[6px]"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-9 object-contain"><path fill-rule="evenodd" clip-rule="evenodd" d="M10.395 19h6.4v-8.754l-6.4-2.527v11.28ZM10.395 1v5.64l6.4 2.529V1h-6.4ZM3 1v11.28l6.4-2.527V1H3ZM3 18.997h6.4v-8.169L3 13.357v5.64Z" fill="#4EAB50"></path></svg><span class="font-barlow text-center text-[11px] leading-[1.15] font-medium text-black/60">Bambu Studio</span></div><div class="flex flex-col items-center gap-[6px]"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" class="size-9 object-contain"><g clip-path="url(#clip0_6_2)"><g clip-path="url(#clip1_6_2)"><path fill="url(#pattern0_6_2)" d="M0 0h20v20H0z"></path></g></g><defs><clipPath id="clip0_6_2"><path fill="#fff" d="M0 0h20v20H0z"></path></clipPath><clipPath id="clip1_6_2"><path fill="#fff" d="M0 0h20v20H0z"></path></clipPath><pattern id="pattern0_6_2" patternContentUnits="objectBoundingBox" width="1" height="1"><use xlink:href="#image0_6_2" transform="scale(.00417)"></use></pattern><image id="image0_6_2" width="240" height="240" preserveAspectRatio="none" xlink:href="data:image/png;base64,"></image></defs></svg><span class="font-barlow text-center text-[11px] leading-[1.15] font-medium text-black/60">Creality Print</span></div><div class="flex flex-col items-center gap-[6px]"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-9 object-contain"><g clip-path="url(#clip0_205_21