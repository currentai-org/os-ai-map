JnMmRrbC5hLS1kXzBzcw%3D%3D&btag=c0000e00008000&dy_q=1749548249&l=2025061017372921DED736C711578F0837","description":"毛毡风格，棕色毛毡制作的小鹿低头轻嗅粉色毛毡蘑菇，白色蒲公英随风飘散，光影模拟透过树叶的斑驳阳光​。","description_en":"Felt style: a small deer made of brown felt lowers its head to gently sniff a pink felt mushroom. White dandelions drift in the wind, and the light and shadow simulate dappled sunlight filtering through tree leaves.","width":"1664","height":"1248","poster":"https:\u002F\u002Fp3-sign.douyinpic.com\u002Ftos-cn-p-13c08f\u002FoAiK3ofdEgJvBItCBarQl7n5hAicMXEBJglEF5~tplv-noop.image?dy_q=1749548249&l=2025061017372921DED736C711578F0837&x-expires=2064908254&x-signature=Oabf5Z%2F5QQP4PGyiCrQCK6d8QKQ%3D","compress_src":"https:\u002F\u002Fv3-magicarena-v.365yg.com\u002F5837a5cbda366ef6cd940b40c88a8870\u002F7b13ffde\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002FoAE1IDfflDZQvG79SuQoPRFw2aDDLKgASyzhEB\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=905&bt=905&cs=0&ds=3&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=0&rc=aDM3OjNpZDU7ZWdkOjgzM0BpamZ5c3M5cjc4NDczNGllM0AyNF5jMy8vXzMxNWBgLTMwYSNxZmJnMmRrbC5hLS1kXzBzcw%3D%3D&btag=c0000e00008000&dy_q=1749548249&feature_id=f0150a16a324336cda5d6dd0b69ed299&l=2025061017372921DED736C711578F0837"},{"src":"https:\u002F\u002Fv3-magicarena-v.365yg.com\u002Feb79676ff0b995550353b09dd5572613\u002F7b13ffde\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002FoQBEhEEEBskcJAXvQivBJIAALiEKAagdF4YfjC\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=3615&bt=3615&cs=0&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=13&rc=M2lqNXI5cjc4NDczNGllM0BpM2lqNXI5cjc4NDczNGllM0Bga2kvMmRrbC5hLS1kXzBzYSNga2kvMmRrbC5hLS1kXzBzcw%3D%3D&btag=c0000e00008000&dy_q=1749548249&l=2025061017372921DED736C711578F0837","description":"像素风，像素化的纽约曼哈顿，像素直升机在高楼间穿梭。","description_en":"Pixel style, pixelated New York Manhattan, helicopters shuttling between skyscrapers.","width":"1920","height":"1088","poster":"https:\u002F\u002Fp3-sign.douyinpic.com\u002Ftos-cn-p-13c08f\u002FoQBvKEYvfaiS5hg2AsBCLciJUBwEQJ4EEIX8Id~tplv-noop.image?dy_q=1749548249&l=2025061017372921DED736C711578F0837&x-expires=2064908254&x-signature=oMOKzukfN2J4Egc5emYXmAdpp50%3D","compress_src":"https:\u002F\u002Fv3-magicarena-v.365yg.com\u002Fe4673ae215f1420aa95347ad7b225694\u002F7b13ffde\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002FoEvaSLfZdiBEsCnioXicEIVBgYjKEQA4JvMhEJ\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=1274&bt=1274&cs=0&ds=3&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=0&rc=ZTk6NWhnOmRlMzQ2NztoOUBpM2lqNXI5cjc4NDczNGllM0BfMy8tLTJgXmMxLi5jNDVeYSNga2kvMmRrbC5hLS1kXzBzcw%3D%3D&btag=c0000e00008000&dy_q=1749548249&feature_id=f0150a16a324336cda5d6dd0b69ed299&l=2025061017372921DED736C711578F0837"},{"src":"https:\u002F\u002Fv11-magicarena-v.365yg.com\u002F2a87965eac9dc27364795b11b7dc2534\u002F7b13ffe1\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002FoklXBAA5aBgKMN3CA5iiQcBFdEJfqZAEEnv5hJ\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=3245&bt=3245&cs=0&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=13&rc=amd5c3M5cjg4NDczNGllM0Bpamd5c3M5cjg4NDczNGllM0BwZmJnMmRrbC5hLS1kXzBzYSNwZmJnMmRrbC5hLS1kXzBzcw%3D%3D&btag=40000e00008000&dy_q=1749548249&l=2025061017372921DED736C711578F0837","description":"复古未来主义风格，像素纹理，VHS 风格的图像，清晰可见的扫描线和过饱和的色彩——深橙色、洋红色和闪烁的青色。环境营造出梦幻般的模拟氛围，仿佛被录在磁带上，不断循环播放。","description_en":"Retrofuturistic style, pixelated texture, VHS-inspired imagery with visible scan lines and oversaturated colors—deep orange, magenta, and shimmering cyan. The environment evokes a dreamlike analog atmosphere, as if recorded on a looping tape.","width":"1920","height":"1088","poster":"https:\u002F\u002Fp3-sign.douyinpic.com\u002Ftos-cn-p-13c08f\u002Fo0vBJIWFC5aJ5gaXlViRAiEdfgBBnQch3EvZ5N~tplv-noop.image?dy_q=1749548249&l=2025061017372921DED736C711578F0837&x-expires=2064908257&x-signature=I9dsknutjvJvB%2FQwFwY0Snfg8lA%3D","compress_src":"https:\u002F\u002Fv11-magicarena-v.365yg.com\u002Fe1c3771c760db142dd0e6edaaf602241\u002F7b13ffe1\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002FooClQEBQUEaBiB5cmhvAfnFFC5NDXJd3Jig5lI\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=1337&bt=1337&cs=0&ds=3&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=0&rc=aWU8Z2c8ZWczPDxmMzlnOUBpamd5c3M5cjg4NDczNGllM0AwMC5eNF4tXzUxLy1iLTMxYSNwZmJnMmRrbC5hLS1kXzBzcw%3D%3D&btag=40000e00008000&dy_q=1749548249&feature_id=f0150a16a324336cda5d6dd0b69ed299&l=2025061017372921DED736C711578F0837"}],"title_en":"Diverse Stylistic Expression","description_en":"From photorealism and cyberpunk to illustration and felt texture, Seedance 1.0 can accurately interpret diverse stylistic prompts to support a wide range of creative needs.","compress_src":""},{"title":"精准的语义理解与指令遵循","description":"能够精准解析复杂的自然语言指令，稳定控制多主体互动、多重动作组合，并支持丰富的运镜选择，将文字构想精确转化为视频画面。","data":[{"src":"https:\u002F\u002Fv26-magicarena-v.365yg.com\u002Ffee5196ea96bef68d48feb54976cdd22\u002F7b13ffe1\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002FoonlEoB0AgAEWBehAinBfANSCKiBIi54SD5X37\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=2435&bt=2435&cs=0&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=13&rc=amd5c3M5cjg4NDczNGllM0Bpamd5c3M5cjg4NDczNGllM0BkZmJnMmRjbC5hLS1kXzBzYSNkZmJnMmRjbC5hLS1kXzBzcw%3D%3D&btag=c0000e00008000&dy_q=1749548249&l=2025061017372921DED736C711578F0837","description":"一名年轻男子在地铁中静坐不动，周围是快速移动的模糊人影。【镜头拉近】他几乎不眨动的双眼，凸显出孤独感。","description_en":"A young man sits still on a subway train, surrounded by blurred figures moving rapidly. [Close-up] His eyes, barely blinking, intensify the sense of loneliness.","width":"1440","height":"1440","poster":"https:\u002F\u002Fp26-sign.douyinpic.com\u002Ftos-cn-p-13c08f\u002Focf3CWKSABBit5gn5mBND0IBIEU4WXerSih75l~tplv-noop.image?dy_q=1749548249&l=2025061017372921DED736C711578F0837&x-expires=2064908257&x-signature=gbX0JQGPpo0F%2F%2FWlrssh2apoi9g%3D","compress_src":""},{"src":"https:\u002F\u002Fv11-magicarena-v.365yg.com\u002Fc4335800bb146f2c14c1678d0989ab0e\u002F7b13ffe1\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002FokuEraAhelIrggCeAG7QFCCOuIBGL3A2mLAImf\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=5587&bt=5587&cs=0&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=13&rc=amd3ank5cjg4NDczNGllM0Bpamd3ank5cjg4NDczNGllM0AwamptMmRjbC5hLS1kXzBzYSMwamptMmRjbC5hLS1kXzBzcw%3D%3D&btag=40000e00008000&dy_q=1749548249&l=2025061017372921DED736C711578F0837","description":"镜头以缓慢横移开场，掠过日落时分布满岩石的海边台阶。数十台老式 CRT 电视机沿海岸线建筑随意堆叠，发出昏暗光芒。每块屏幕都在闪烁着雪花点、循环旧影像或彩色测试条。复古未来主义风格，如梦境般的环境。","description_en":"The camera begins with a slow horizontal pan across rocky seaside steps at sunset. Dozens of vintage CRT televisions are haphazardly stacked along coastal buildings, glowing dimly. Each screen flickers with snow, looping old footage, or colorful test patterns. Retrofuturistic style, dreamlike atmosphere. ","width":"1920","height":"1088","poster":"https:\u002F\u002Fp3-sign.douyinpic.com\u002Ftos-cn-p-13c08f\u002Foo3uerIAGVlLOILuKo7afheFRgGdBCmQ2DCQmE~tplv-noop.image?dy_q=1749548249&l=2025061017372921DED736C711578F0837&x-expires=2064908257&x-signature=0gQsgSnBgqgpp6EoA5y4grOqQQM%3D","compress_src":"https:\u002F\u002Fv11-magicarena-v.365yg.com\u002F2621998a4fcfd1ac2bf728040cf47611\u002F7b13ffe1\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002Fo4CbIHFs4CDVaNICAQDSEwQf9zogXBp7BlE3fZ\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=1920&bt=1920&cs=0&ds=3&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=0&rc=Zzs5Mzk0aDc0Z2kzOGhnZkBpamd3ank5cjg4NDczNGllM0A1MGJeMi5iXi4xYS5gX18vYSMwamptMmRjbC5hLS1kXzBzcw%3D%3D&btag=40000e00008000&dy_q=1749548249&feature_id=f0150a16a324336cda5d6dd0b69ed299&l=2025061017372921DED736C711578F0837"},{"src":"https:\u002F\u002Fv11-magicarena-v.365yg.com\u002F096942080aefec3375cff8b89062556b\u002F7b13ffe1\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002FokBi3X5AEn57D3IBMC9BfAce4HSiAASgAIF0El\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=2139&bt=2139&cs=0&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=13&rc=M2Z5c3M5cjY4NDczNGllM0BpM2Z5c3M5cjY4NDczNGllM0BiZmJnMmRzbC5hLS1kXzBzYSNiZmJnMmRzbC5hLS1kXzBzcw%3D%3D&btag=c0000e00008000&dy_q=1749548249&l=2025061017372921DED736C711578F0837","description":"场景：特写镜头聚焦于一位模特的肖像，她佩戴着由巧克力碎片和干花制成的奇幻头饰。镜头以旋转侧滑的方式开场，从侧面到正面逐步展现这件雕塑感头饰。最后几秒，镜头停在正中央，框住模特静止而优雅的脸庞。","description_en":"Setting: Close-up portrait of a model wearing a fantastical headpiece made of chocolate shards and dried flowers. Start with a rotating lateral slide revealing the sculptural headpiece from profile to frontal view. Final seconds: camera stops front and center, framing the lips, still and poised.","width":"1920","height":"1088","poster":"https:\u002F\u002Fp26-sign.douyinpic.com\u002Ftos-cn-p-13c08f\u002FoY7voPIgDwSF4Elu6f9YzQfLWwDsABUQyCBoPE~tplv-noop.image?dy_q=1749548249&l=2025061017372921DED736C711578F0837&x-expires=2064908257&x-signature=HFEc6DGFt3zJiKuEiottFlF04x4%3D","compress_src":"https:\u002F\u002Fv11-magicarena-v.365yg.com\u002F4c6cce5eb237aaaf44bd63df200a9831\u002F7b13ffe1\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002Fosce5IiB3BnJtCDB7l4HXwgIBfSJiAQM5BE0SE\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=1082&bt=1082&cs=0&ds=3&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=0&rc=aTg6O2g0Zjg6NGY6aWZkOUBpM2Z5c3M5cjY4NDczNGllM0BjNDEtLl9hXzYxYi1fNWJjYSNiZmJnMmRzbC5hLS1kXzBzcw%3D%3D&btag=c0000e00008000&dy_q=1749548249&feature_id=f0150a16a324336cda5d6dd0b69ed299&l=2025061017372921DED736C711578F0837"},{"src":"https:\u002F\u002Fv11-magicarena-v.365yg.com\u002F3d9b05f7308ff5952ba15a33010c005f\u002F7b13ffe1\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002Fo0uLQBIfgAG2AulrIqC3CRFEAGLC7haIZAfmeA\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=4302&bt=4302&cs=0&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=13&rc=M2d3ank5cjg4NDczNGllM0BpM2d3ank5cjg4NDczNGllM0AtamptMmRjbC5hLS1kXzBzYSMtamptMmRjbC5hLS1kXzBzcw%3D%3D&btag=c0000e00008000&dy_q=1749548249&l=2025061017372921DED736C711578F0837","description":"场景设定：一个身着保暖衣物的男人在雪地露营地享受芝士火锅，一只狗眼巴巴地盯着融化的奶酪。镜头以手持近景对准冒泡的火锅锅具开场，拉丝的芝士在热源下缓缓延展。他夹起一块裹满奶酪的面包时，狗狗耳朵下垂，眼神中透着渴望，镜头随之小幅拉远，露出温馨的露营环境：飘落的雪花、环绕的树木，以及背景中停放的吉普车。","description_en":"Setting: A man dressed in warm clothing enjoys a cheese fondue at a snowy campsite, with a dog staring longingly at the melted cheese. The camera opens with a handheld close-up of the bubbling fondue pot, where stringy cheese slowly stretches over the pot. As he picks up a piece of bread coated in cheese, the dog’s ears droop and its eyes fill with longing. The lens then slightly pulls back to reveal the cozy camping environment: falling snowflakes, surrounding trees, and a jeep parked in the background.","width":"1920","height":"1088","poster":"https:\u002F\u002Fp26-sign.douyinpic.com\u002Ftos-cn-p-13c08f\u002FowAuXLWmGQlBACfgl2LCGH7raCeSQeBIIyAF3h~tplv-noop.image?dy_q=1749548249&l=2025061017372921DED736C711578F0837&x-expires=2064908257&x-signature=wTvIbGcd70eHaBiGLOTDtundi%2FI%3D","compress_src":"https:\u002F\u002Fv11-magicarena-v.365yg.com\u002F7fddfcbd13ccfa0e51a21abbc586c779\u002F7b13ffe1\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002FoshCA3fDDIfS9bo7zXMAFQNlCBCSJEwbFQBVEg\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=1449&bt=1449&cs=0&ds=3&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=0&rc=aWVnNmg4O2Q6NTQ2O2Y6NkBpM2d3ank5cjg4NDczNGllM0AwLzUuLTNiNmMxYS4vYGI2YSMtamptMmRjbC5hLS1kXzBzcw%3D%3D&btag=c0000e00008000&dy_q=1749548249&feature_id=f0150a16a324336cda5d6dd0b69ed299&l=2025061017372921DED736C711578F0837"},{"src":"https:\u002F\u002Fv3-magicarena-v.365yg.com\u002Fb0648b1a50335f136f56df5fcc09656d\u002F7b13ffde\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002FoM9BDAT3SfAEMABoxlDFEwbQEBCftANCQgDX7z\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=3222&bt=3222&cs=0&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=13&rc=amZ3ank5cjc4NDczNGllM0BpamZ3ank5cjc4NDczNGllM0BsamptMmRzbC5hLS1kXzBzYSNsamptMmRzbC5hLS1kXzBzcw%3D%3D&btag=c0000e00008000&dy_q=1749548249&l=2025061017372921DED736C711578F0837","description":"「I2V」固定镜头，画面右侧的男人走到画面左侧的男人面前，向他表达自己强烈的不满情绪","description_en":"[I2V] Static shot: The man on the right side of the frame walks toward the man on the left, expressing his intense dissatisfaction to him.","width":"1920","height":"1088","poster":"https:\u002F\u002Fp26-sign.douyinpic.com\u002Ftos-cn-p-13c08f\u002FoY739TEgDRSFxElX1N9MfQfCNwDWABUIbBBozC~tplv-noop.image?dy_q=1749548249&l=2025061017372921DED736C711578F0837&x-expires=2064908254&x-signature=2R%2Fp5%2FMOoQ870%2B%2F89SE4BUk9q5c%3D","compress_src":"https:\u002F\u002Fv3-magicarena-v.365yg.com\u002F5ee63e8e59365838ac27a53e7215db09\u002F7b13ffde\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002FoAi7fhIKuwmeyEGD3FgnuTAQGeldLBaZ2CHQLI\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=1358&bt=1358&cs=0&ds=3&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=0&rc=PDgzNjg6ZzU4ZDM6OTc1OEBpamZ3ank5cjc4NDczNGllM0AtNF4vM14yXmAxYjJfMDJiYSNsamptMmRzbC5hLS1kXzBzcw%3D%3D&btag=c0000e00008000&dy_q=1749548249&feature_id=f0150a16a324336cda5d6dd0b69ed299&l=2025061017372921DED736C711578F0837"}],"title_en":"Precise Prompt Following","description_en":"Accurately parses natural language prompts, enabling stable control over multi-agent interactions, complex action sequences, and a rich variety of camera movements to precisely translate your textual concepts into videos.","compress_src":""}],"title_en":"Key Highlights","description_en":"Seedance 1.0 features stunning visual performance. Its ultra-high-definition(picture quality) is exquisitely detailed and rich, presenting scenes with authentic naturalness and minimal AI trace."},"seedancePerformance":{"reportUrl":"\u002Fseedance","title":"模型表现","description":"以下是 Seedance 1.0 在内部基准测试 SeedVideoBench-1.0 和第三方评测平台 Artificial Analysis 的模型表现结果。","charts":{"title":"SeedVideoBench-1.0 多维度评测","data":[{"src":"https:\u002F\u002Fp11-magicarena-online-sign.byteimg.com\u002Fdp-prompt\u002Fevaluation\u002Fimages\u002F0760f37545e111f082a600163e49ddba.jpeg~tplv-d77oumduh0-image.image?rk3s=a5b7ebca&x-expires=2064915537&x-signature=tkzzqfFo9%2BC1sgvBcz06cT8rtoE%3D","title":"T2V 多维度对比雷达图","title_en":"T2V Radar Chart","description":"在 T2V 任务中，指令遵循、运动质量、美学表现等指标获得较高评分。由于 Artificial 公开数据缺失，Kling 2.1 的 Elo (Artificial) 结果采用 Kling 2.0 代替。","description_en":"Achieved high scores in T2V tasks for prompt adherence, motion quality, and aesthetics. Due to unavailable public data, the Elo score for Kling 2.1 is taken from Kling 2.0.","height":"950","width":"515"},{"src":"https:\u002F\u002Fp11-magicarena-online-sign.byteimg.com\u002Fdp-prompt\u002Fevaluation\u002Fimages\u002F08fc7d2c45e111f0b8fe00163e426b26.jpeg~tplv-d77oumduh0-image.image?rk3s=a5b7ebca&x-expires=2064915537&x-signature=4a%2B%2Ft8bS6fyWUDqWC8t8BkZgPPo%3D","title":"I2V 多维度对比雷达图","title_en":"I2V Radar Chart","description":"在 I2V 任务中，各项指标同样获得较高评分，并能较好地保持原图画面的一致性。由于 Artificial 公开数据缺失，Kling 2.1 的 Elo (Artificial) 结果采用 Kling 2.0 代替。","description_en":"Also achieved high scores in I2V tasks, while effectively maintaining consistency with the source image. Due to unavailable public data, the Elo score for Kling 2.1 is taken from Kling 2.0.","height":"950","width":"515"}],"title_en":"SeedVideoBench-1.0: Multi-Dimensional Evaluation","subtitle":"在与行业其他模型的对比中，Seedance 1.0 在指令遵循、运动质量和美学表现等多个核心维度表现良好。","subtitle_en":"In comparison with other industry models, Seedance 1.0 performed well across core dimensions including prompt adherence, motion quality, and aesthetics."},"table":{"title":"Artificial Analysis 公开众测","description":"在公开盲测对比中，Seedance 1.0 在 T2V 与 I2V 两个赛道均获得了有竞争力的 Elo 评分，体现了较好的用户偏好。","src":"","title_en":"Artificial Analysis Video Arena","description_en":"In public blind tests, Seedance 1.0 achieved competitive Elo scores on both the T2V and I2V tracks, indicating positive user preference.","subtitle":"","subtitle_en":"","data":[{"src":"https:\u002F\u002Fp11-magicarena-online-sign.byteimg.com\u002Fdp-prompt\u002Fevaluation\u002Fimages\u002F05ab8d5b45e111f0a6b600163e690716.jpeg~tplv-d77oumduh0-image.image?rk3s=a5b7ebca&x-expires=2064915537&x-signature=SRfLPGyIF2CV2Zjtn3pWEOwCV%2FU%3D","description_en":"Source: Artificial Analysis official website. As of 2025-06-09 11:00 (GMT+8).","description":"榜单结果来自 Artificial Analysis 官网，数据截至 2025-06-09 11:00 (GMT+8)。","width":"2518","height":"1080","title":"T2V 榜单结果","title_en":"T2V Leaderboard"},{"src":"https:\u002F\u002Fp11-magicarena-online-sign.byteimg.com\u002Fdp-prompt\u002Fevaluation\u002Fimages\u002F0425691845e111f0a6b600163e690716.jpeg~tplv-d77oumduh0-image.image?rk3s=a5b7ebca&x-expires=2064915537&x-signature=3%2BINDAyj0kqqSxSWPsEUFCMQg6c%3D","description_en":"Source: Artificial Analysis official website. As of 2025-06-09 11:00 (GMT+8).","description":"榜单结果来自 Artificial Analysis 官网，数据截至 2025-06-09 11:00 (GMT+8)。","width":"2518","height":"1080","title":"I2V 榜单结果","title_en":"I2V Leaderboard"}]},"title_en":"Model Performance","description_en":"Below are the results of Seedance 1.0 in internal benchmarks using SeedVideoBench-1.0 and on the third-party platform Artificial Analysis."},"seedanceGallery":{"title":"创意无界，探索更多可能","title_en":"Creativity Unleashed, Explore the Possibilities","description":"从超现实的奇幻想象，到细腻的纪实生活，再到专业级的广告短片，Seedance 正在为全球的创作者与开发者提供技术支持。浏览精选案例，激发你的下一个灵感。 ","description_en":"From surreal fantasy and daily life documentaries to professional-grade commercial shorts, Seedance empowers creators and developers worldwide. Browse our curated showcase to spark your next great idea.","data":[{"src":"https:\u002F\u002Fv3-magicarena-v.365yg.com\u002F0edd1eee742ac085b00095237873b259\u002F7b13ffde\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002FoAswEDwzTDSBXCAPAlFfA9oAB7bgMBYQE3fjCE\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=2830&bt=2830&cs=0&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=13&rc=M2Z3ank5cjc4NDczNGllM0BpM2Z3ank5cjc4NDczNGllM0BsamptMmRzbC5hLS1kXzBzYSNsamptMmRzbC5hLS1kXzBzcw%3D%3D&btag=c0000e00008000&dy_q=1749548249&l=2025061017372921DED736C711578F0837","description":"咖啡馆里，特写拍摄老年男人，他若有所思地坐着，眼神专注，表情从沉思变成微笑，他抬手撩了一下头发，随后双手交握放在下巴处，最后放下双手，身体前倾，眼神中带着思索，又像是找到了答案，最后他微微眯起眼睛，露出一个欣慰的微笑。","description_en":"In a café, a close-up shot captures an elderly man sitting pensively. His gaze is focused, and his expression shifts from deep thought to a gentle smile. He raises a hand to brush through his hair, then clasps his hands under his chin. Finally, he lowers his hands, leans forward, and his eyes reflect both contemplation and the spark of finding an answer. He squints slightly, ending with a relieved smile.","width":"1920","height":"1088","poster":"https:\u002F\u002Fp26-sign.douyinpic.com\u002Ftos-cn-p-13c08f\u002Fo4obD1CzTBMElSF9fAbICBNBTQ73gTfdXwXDEw~tplv-noop.image?dy_q=1749548249&l=2025061017372921DED736C711578F0837&x-expires=2064908254&x-signature=f70ebtItTMYY5n42S8fZLKIb%2FWk%3D","compress_src":"https:\u002F\u002Fv3-magicarena-v.365yg.com\u002F8e2b8c0b529af41166205766e897cf08\u002F7b13ffde\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002FokwzfSfCDQELwX9J7Tg3IbFEr5aM3oCBDhAlBA\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=1159&bt=1159&cs=0&ds=3&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=0&rc=OWc4O2RpPDxkOGZoPGY3N0BpM2Z3ank5cjc4NDczNGllM0BhMy1eNmJgXmExMWIyYWFhYSNsamptMmRzbC5hLS1kXzBzcw%3D%3D&btag=c0000e00008000&dy_q=1749548249&feature_id=f0150a16a324336cda5d6dd0b69ed299&l=2025061017372921DED736C711578F0837","useInMobile":""},{"src":"https:\u002F\u002Fv3-magicarena-v.365yg.com\u002F165aae5e9a01eef813a3119ebf457ee8\u002F7b13ffde\u002Fvideo\u002Ftos\u002Fcn\u002Ftos-cn-v-13c08f\u002FoYI7w0ECgBuqAGGuCAefLQlGAgEfBANnBLhQX3\u002F?a=611830&ch=0&cr=0&dr=0&er=0&lr=default&cd=0%7C0%7C0%7C0&br=2942&bt=2942&cs=0&ft=7ubAHfXEBBkq8Zmo_X58-_vjVQWw&mime_type=video_mp4&qs=13&rc=amlqNXI5cjc4NDczNGllM0BpamlqNXI5cjc4NDczNGllM0Bza2kvMmRzbC5hLS1kXzBz