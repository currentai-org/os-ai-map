 in service of humanity</div><img class="mt-[20px] h-[100px] w-[100px] object-contain" src="//lf-flow-web-cdn.doubao.com/obj/flow-doubao/deploy/flow/ai_official_website/88329/static/image/footer_qr_code.1982b96e.png" alt=""/><a href="mailto:seed.feedback@bytedance.com" class="mt-[16px] whitespace-nowrap text-center text-[12px] leading-[24px] tracking-[0.02em] transition-opacity hover:opacity-80 font-[400] text-[#212121]/50">Contact us :  <!-- -->seed.feedback@bytedance.com</a></div><div class="absolute bottom-[8px] left-[16px] right-[16px] z-[1] flex h-[16px] items-center justify-between text-[12px] leading-[18px] font-[400]"><span class="whitespace-nowrap text-[#212121]/50">Copyright© <!-- -->2026<!-- --> Bytedance Seed</span><a href="/en/disclaimer" target="_blank" rel="noreferrer" class="block whitespace-nowrap text-right transition-opacity hover:opacity-80 text-[#212121]/50">Disclaimer</a></div></div></div></footer></div></div><script id="__LOADABLE_REQUIRED_CHUNKS__" type="application/json">[]</script><script id="__LOADABLE_REQUIRED_CHUNKS___ext" type="application/json">{"namedChunks":[]}</script><script>window._SSR_DATA = {"data":{},"context":{"request":{"params":{},"query":{},"pathname":"\u002Fen\u002Fseedream3_0","host":"seed.bytedance.com","url":"https:\u002F\u002Fseed.bytedance.com\u002Fen\u002Fseedream3_0"},"reporter":{}},"mode":"string","renderLevel":2}</script>
<script>window._ROUTER_DATA = {"loaderData":{"layout":{"footer_config":[{"titleZh":"模型成果","titleEn":"Models","content":[{"labelZh":"Seed2.1","labelEn":"Seed2.1","linkZh":"\u002Fzh\u002Fseed2_1","linkEn":"\u002Fen\u002Fseed2_1"},{"labelZh":"Seedance 2.5","labelEn":"Seedance 2.5","linkZh":"\u002Fzh\u002Fseedance2_5","linkEn":"\u002Fen\u002Fseedance2_5"},{"labelZh":"Seedream 5.0 Pro","labelEn":"Seedream 5.0 Pro","linkZh":"\u002Fzh\u002Fseedream5_0_pro","linkEn":"\u002Fen\u002Fseedream5_0_pro"},{"labelZh":"SeedRealtime","labelEn":"SeedRealtime","linkZh":"\u002Fzh\u002FSeedRealtime","linkEn":"\u002Fen\u002FSeedRealtime"},{"labelZh":"Seed Audio 1.0","labelEn":"Seed Audio 1.0","linkZh":"\u002Fzh\u002Fseedaudio1_0","linkEn":"\u002Fen\u002Fseedaudio1_0"},{"labelZh":"Seed GR-RL","labelEn":"Seed GR-RL","linkZh":"\u002Fzh\u002Fgr_rl","linkEn":"\u002Fen\u002Fgr_rl"}]},{"titleEn":"Learn More","titleZh":"了解更多","content":[{"labelZh":"论文","labelEn":"Publications","linkZh":"\u002Fzh\u002Fpublic_papers","linkEn":"\u002Fen\u002Fpublic_papers"},{"labelZh":"Seed Edge","labelEn":"Seed Edge","linkZh":"\u002Fzh\u002Fseed-edge","linkEn":"\u002Fen\u002Fseed-edge"},{"labelZh":"Seed STEM 科学家计划","labelEn":"Seed STEM Fellows Program","linkZh":"\u002Fzh\u002Fseedstem","linkEn":"\u002Fen\u002Fseedstem"},{"labelZh":"校园招聘","labelEn":"Seed Campus Recruitment","linkZh":"\u002Fzh\u002Fseedearlycareer","linkEn":"\u002Fen\u002Fseedearlycareer"}]}]},"(locale$)\u002Flayout":null,"(locale$)\u002F(path)\u002Fpage":{"uidl":{"name":"undefined-undefined-undefined","importMaps":[{"package":"@byted-midas-component\u002Fmidas-built-in","imports":[{"type":"namespace","tags":["midas-import-component"],"localName":"BuiltIn"}]},{"package":"@byted-midas-component\u002Fdoubao-blogs-components","imports":[{"type":"namespace","tags":["midas-import-component"],"localName":"Blog"}]}],"nodeUIDL":{"id":"94wpkWqzw2KehBR7_76","type":"BuiltIn.HTMLElement","name":"根节点","props":{"tagName":"div","style":{"height":"100%","backgroundColor":"white"},"className":"doubao-blogs-wrapper en"},"children":[{"props":{"date":"April 16, 2025","title":"Seedream 3.0","subTitle":"Next-Gen Text-to-Image Model","desc":"We are officially launching Seedream 3.0, a native high-resolution bilingual image generation foundational model (Chinese-English). Seedream 3.0 delivers significantly enhanced capabilities: it supports native 2K resolution output, offers faster response speeds, generates more accurate small text, improves text layout effects, enhances aesthetics and structural quality, and demonstrates excellent fidelity and detail performance. It has achieved leading rankings in multiple evaluations."},"type":"Blog.Header","id":"xJnwokrVXW0QcJ2T_296","gridInfo":{"area":{"col":[1,5],"row":[1,3]},"isFull":true},"name":"Blog_Header1","children":[]},{"props":{"infos":[{"content":"Tech report","type":"primary","icon":"none","link":"https:\u002F\u002Farxiv.org\u002Fpdf\u002F2504.11346"},{"content":"Get API","icon":"none","link":"https:\u002F\u002Fwww.byteplus.com\u002Fen\u002Fproduct\u002FSeedream?utm_source=seed&utm_medium=organic&utm_campaign=seedream","type":"primary"}]},"type":"Blog.Buttons","id":"oFz1tToAzGhrFKGM_407","gridInfo":{"area":{"col":[1,5],"row":[1,3]},"isFull":true},"name":"Blog_Buttons1","propsConfig":{},"eventParams":{},"children":[]},{"props":{"cover":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fbdeh7uhpsuht\u002FSeedream主KV.jpeg","video":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fbdeh7uhpsuht\u002F0416 英文终版.mp4","desc":"","isMain":true},"type":"Blog.Video","id":"WKK9LSaGo5ezNDYD_136","gridInfo":{"area":{"col":[1,5],"row":[1,3]},"isFull":true},"name":"Blog_Video1","children":[]},{"props":{"title":"Technical Innovation"},"type":"Blog.Content1","id":"gJ51OW3g8BKwPFlQ_275","gridInfo":{"area":{"col":[1,5],"row":[1,3]},"isFull":true},"name":"Blog_Content11","children":[{"props":{"content":"Compared with our previous model Seedream 2.0, we employ several innovative strategies to address existing challenges, including limited image resolutions,  complex attributes adherence, fine-grained typography generation, and suboptimal visual aesthetics and fidelity.\n\nThis is primarily reflected in the following four aspects: \n• At the data tier, the dataset scale was expanded by approximately 100% with a novel dynamic sampling mechanism operating across two orthogonal axes: image cluster distribution and textual semantic coherence. \n• In the pretraining stage, we implement several improvements compared to 2.0, resulting in better scalability, generalizability, and visual-language alignment: i) Mixed-resolution Training; ii) Cross-modality RoPE; iii) Representation Alignment Loss; iv) Resolution-aware Timestep Sampling. \n• During post-training optimization, we leverage diversified aesthetic caption and VLM-based reward model to further improve model’s comprehensive capabilities. \n• In model acceleration, we encourage stable sampling via consistent noise expectation, effectively reducing the number of function evaluations (NFE) during inference."},"type":"Blog.Text","id":"EKJcxRrDrvnqI3Vf_137","gridInfo":{"area":{"col":[1,5],"row":[1,3]},"isFull":true},"name":"Blog_Text3","children":[]},{"props":{"src":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fpfpbyvbn\u002Fseedream 3.0配图2.jpg","srcMobile":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fpfpbyvbn\u002Fseedream 3.0配图2.jpg","maskSrc":"","desc":"\u003Cb\u003EFigure 1\u003C\u002Fb\u003E Seedream 3.0 ranks first in the Artificial Analysis Image Arena Leaderboard. Due to missing data, the Portrait result for Imagen 3 and the Overall result for Seedream 2.0 are represented by the average values of other models."},"type":"Blog.Image","id":"0oVH6SOZsl7f4Qac_391","gridInfo":{"area":{"col":[1,5],"row":[1,3]},"isFull":true},"name":"Blog_Image2","children":[]}]},{"props":{"title":"Iterative Model Performance"},"type":"Blog.Content1","id":"U79gr8otZb8ycvv5_435","gridInfo":{"area":{"col":[1,5],"row":[1,3]},"isFull":true},"name":"Blog_Content12","children":[{"props":{"content":"Compared to Seedream 2.0, Seedream 3.0 achieves significant breakthroughs across multiple dimensions:\n\n• \u003Cb\u003ENative High Resolution\u003C\u002Fb\u003E: Natively supports 2K resolution output without post-processing, while also being compatible with higher resolutions and adaptable to various aspect ratios.\n\n• \u003Cb\u003EComprehensive Capability Enhancements\u003C\u002Fb\u003E: Demonstrates significant improvements in text-image alignment, compositional structure design, aesthetic quality, and text rendering capabilities.\n\n•  \u003Cb\u003ESignificant Text Rendering Performance Enhancements\u003C\u002Fb\u003E: Excels in small font generation, Chinese character accuracy, and high-aesthetic long-text layout. The model tackles industry challenges in small-text generation and long-text layout, with graphic design outputs surpassing manually designed templates from platforms like Canva. Leveraging precise and aesthetically refined text generation capabilities, it enables the effortless creation of designer-level posters, seamlessly integrating diverse fonts, styles, and layouts.\n\n• \u003Cb\u003EAesthetic Improvements\u003C\u002Fb\u003E: Achieves significant enhancements in image aesthetic quality, delivering strong performance in cinematic scene rendering and generating portraits with more realistic textures.\n\n•  \u003Cb\u003ELightning-Fast Generation Experience\u003C\u002Fb\u003E: Through multiple innovative acceleration technologies, inference costs are significantly reduced. End-to-end generation of 1K resolution images now takes only 3.0 seconds."},"type":"Blog.Text","id":"lQKFlStJQlA1BR9Q_436","gridInfo":{"area":{"col":[1,5],"row":[1,3]},"isFull":true},"name":"Blog_Text2","children":[]},{"props":{"src":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fpfpbyvbn\u002F灰底1不带图注.png","srcMobile":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fpfpbyvbn\u002F灰底1不带图注.png","maskSrc":"","desc":"\u003Cb\u003EFigure 2\u003C\u002Fb\u003E Human evaluation results.Seedream 3.0 surpasses other models in terms of image-text matching, structure, and aesthetics."},"type":"Blog.Image","id":"XAL5KrYOWfdH4srs_437","gridInfo":{"area":{"col":[1,5],"row":[1,3]},"isFull":true},"name":"Blog_Image3","children":[]}]},{"props":{"title":"Aesthetic Typography for Small Text & Long Content, More Precise Generation"},"type":"Blog.Content1","id":"xacbR63XwUu2kuBD_598","gridInfo":{"area":{"col":[1,5],"row":[1,3]},"isFull":true},"name":"Blog_Content13","children":[{"props":{"columns":3,"images":[{"size":"390\u002F390","src":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fbdeh7uhpsuht\u002FS11.png","prompt":""},{"size":"390\u002F520","src":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fbdeh7uhpsuht\u002FS2.png"},{"size":"390\u002F219","src":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fbdeh7uhpsuht\u002FS3.png"},{"size":"390\u002F520","src":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fbdeh7uhpsuht\u002FS4.png"},{"size":"390\u002F219","src":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fbdeh7uhpsuht\u002FS5.png"},{"size":"390\u002F520","src":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fbdeh7uhpsuht\u002FS6.png"},{"size":"390\u002F219","src":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fbdeh7uhpsuht\u002FS7.png"},{"size":"390\u002F390","src":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fbdeh7uhpsuht\u002FS8.png"},{"size":"390\u002F390","src":"https:\u002F\u002Flf3-static.bytednsdoc.com\u002Fobj\u002Feden-cn\u002Fbdeh7uhpsuht\u002FS9.png"}]},"type":"Blog.PicWaterfall","id":"S76D70FvYSNjWbjE_667","gridInfo":{"area":{"col":[1,5],"row":[1,3]},"isFull":true}