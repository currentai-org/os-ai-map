oard" data-copied="Copied!" data-code="invokeai-web --root ~/invokeai"><div></div></button></div></figure></div> </div><div id="tab-panel-180" aria-labelledby="tab-180" role="tabpanel" hidden> <div class="expressive-code"><figure class="frame is-terminal not-content"><figcaption class="header"><span class="title"></span><span class="sr-only">Terminal window</span></figcaption><pre data-language="bash"><code><div class="ec-line"><div class="code"><span style="--0:#82AAFF;--1:#3B61B0">invokeai-web</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#82AAFF;--1:#3B61B0">--root</span><span style="--0:#D6DEEB;--1:#403F53"> </span><span style="--0:#ECC48D;--1:#3B61B0">~/invokeai</span></div></div></code></pre><div class="copy"><div aria-live="polite"></div><button title="Copy to clipboard" data-copied="Copied!" data-code="invokeai-web --root ~/invokeai"><div></div></button></div></figure></div> </div> <starlight-tabs-restore class="astro-fpc45rav"></starlight-tabs-restore> </starlight-tabs>  
</li>
</ol>
<p>If you run Invoke on a headless server, you might want to install and run Invoke on the command line.</p>
<p>We do not plan to maintain scripts to do this moving forward, instead focusing our dev resources on the GUI <a href="../installation">launcher</a>.</p>
<p>You can create your own scripts for this by copying the handful of commands in this guide. <code dir="auto">uv</code>’s <a href="https://docs.astral.sh/uv/reference/cli/#uv-pip-install"><code dir="auto">pip</code> interface docs</a> may be useful.</p> </div> <footer class="sl-flex astro-wnxfpq7d"> <div class="meta sl-flex astro-wnxfpq7d"> <a href="https://github.com/invoke-ai/InvokeAI/edit/main/docs/src/content/docs/start-here/manual.mdx" class="sl-flex print:hidden astro-vfsizi37"><svg aria-hidden="true" class="astro-vfsizi37 astro-rciikept" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1.2em;"><path d="M22 7.24a1 1 0 0 0-.29-.71l-4.24-4.24a1 1 0 0 0-1.1-.22 1 1 0 0 0-.32.22l-2.83 2.83L2.29 16.05a1 1 0 0 0-.29.71V21a1 1 0 0 0 1 1h4.24a1 1 0 0 0 .76-.29l10.87-10.93L21.71 8c.1-.1.17-.2.22-.33a1 1 0 0 0 0-.24v-.14l.07-.05ZM6.83 20H4v-2.83l9.93-9.93 2.83 2.83L6.83 20ZM18.17 8.66l-2.83-2.83 1.42-1.41 2.82 2.82-1.41 1.42Z"/></svg>Edit page</a> <p>Last updated: <time datetime="2026-07-14T00:00:00.000Z">Jul 14, 2026</time></p> </div> <div class="pagination-links print:hidden astro-nwysp2xx" dir="ltr"> <a href="/start-here/installation/" rel="prev" class="astro-nwysp2xx"> <svg aria-hidden="true" class="astro-nwysp2xx astro-rciikept" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1.5rem;"><path d="M17 11H9.41l3.3-3.29a1.004 1.004 0 1 0-1.42-1.42l-5 5a1 1 0 0 0-.21.33 1 1 0 0 0 0 .76 1 1 0 0 0 .21.33l5 5a1.002 1.002 0 0 0 1.639-.325 1 1 0 0 0-.219-1.095L9.41 13H17a1 1 0 0 0 0-2Z"/></svg> <span class="astro-nwysp2xx"> Previous <br class="astro-nwysp2xx"> <span class="link-title astro-nwysp2xx">Simple Installation</span> </span> </a> <a href="/configuration/invokeai-yaml/" rel="next" class="astro-nwysp2xx"> <svg aria-hidden="true" class="astro-nwysp2xx astro-rciikept" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="--sl-icon-size: 1.5rem;"><path d="M17.92 11.62a1.001 1.001 0 