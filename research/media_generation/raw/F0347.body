[{"name":"Open-Sora V1.3 Release","uuid":"201570776","tag_name":"v1.3","target_commitish":"main","body":"We are excited to introduce Open-Sora V1.3.0, bringing improvements in model architecture and generation quality.\r\n\r\nOpen-Sora V1.3.0 Release 🎉\r\n\r\n### 🚀 Key Highlights:\r\n📦 Upgraded Video Compression\r\n🌀 Enhanced ST-DiT Architecture\r\n🎞️ More High-Quality Data \u0026 Multi-Stage Training\r\n✨ Advanced Model Conditioning and Generation Quality\r\n\r\nOpen-Sora 1.3 continues to support image-to-video generation and video extension with expanded resolution and frame length support.\r\n\r\n🔗 Check out our [technical report](https://github.com/hpcaitech/Open-Sora/blob/main/docs/report_04.md) and [gallery](https://hpcaitech.github.io/Open-Sora/) to explore more!","draft":false,"prerelease":false,"immutable":null,"published_at":"2025-02-21T02:30:05.000Z","created_at":"2025-02-20T09:02:31.000Z","author":"zhengzangw","assets":[],"last_synced_at":"2025-04-23T17:11:37.300Z","html_url":"https://github.com/hpcaitech/Open-Sora/releases/tag/v1.3","release_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/hpcaitech%2FOpen-Sora/releases/v1.3","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/hpcaitech%2FOpen-Sora/tags/v1.3"}]