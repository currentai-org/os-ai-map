.27.7; extra == \"cli\"","rfdetr_plus<2.0.0,>=1.0.1; extra == \"plus\"","torch==2.9.*; sys_platform == \"linux\" and extra == \"xla\"","torch_xla==2.9.*; sys_platform == \"linux\" and extra == \"xla\""],"requires_python":">=3.10","summary":"RF-DETR","version":"1.11.0","yanked":false,"yanked_reason":null},"last_serial":41419203,"ownership":{"organization":null,"roles":[{"role":"Owner","user":"SkalskiP"},{"role":"Owner","user":"capjamesg"},{"role":"Owner","user":"peter-roboflow"}]},"releases":{"0.0.1":[{"comment_text":null,"core-metadata":{"sha256":"bee2546b4f5774f9868aea35d861e91d59219e33faed46ce3d33a3cafc3c7b1f"},"digests":{"blake2b_256":"647c95942f7c42adf313e0ba6c368b54563b07b98f27b5310c7a43f996f90bb3","md5":"4ebe52aa2a604e38c1485440bdf8410a","sha256":"3d7a83591c8028a2c8c2b044b1ce3968752a8dd234632003cecf9c1b98d0fa3d"},"downloads":-1,"filename":"rfdetr-0.0.1-py3-none-any.whl","has_sig":false,"md5_digest":"4ebe52aa2a604e38c1485440bdf8410a","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.7","size":1404,"upload_time":"2025-03-19T16:19:40","upload_time_iso_8601":"2025-03-19T16:19:40.303231Z","url":"https://files.pythonhosted.org/packages/64/7c/95942f7c42adf313e0ba6c368b54563b07b98f27b5310c7a43f996f90bb3/rfdetr-0.0.1-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"044aa3ff3cd3c36b1b39d58be3e0dda342e97da18ddb5bc92e6343eec8a9ad54","md5":"0436366dcc33178e45dc31cb0cdc1ff1","sha256":"29fd9b303845501fa1eb70fdbc9dce63e85334d816c69be6786cd69d7f0735ab"},"downloads":-1,"filename":"rfdetr-0.0.1.tar.gz","has_sig":false,"md5_digest":"0436366dcc33178e45dc31cb0cdc1ff1","packagetype":"sdist","python_version":"source","requires_python":">=3.7","size":1490,"upload_time":"2025-03-19T16:19:41","upload_time_iso_8601":"2025-03-19T16:19:41.457814Z","url":"https://files.pythonhosted.org/packages/04/4a/a3ff3cd3c36b1b39d58be3e0dda342e97da18ddb5bc92e6343eec8a9ad54/rfdetr-0.0.1.tar.gz","yanked":false,"yanked_reason":null}],"1.0.0":[{"comment_text":null,"core-metadata":{"sha256":"ba807392ecab6344f12dea3e38f5a9837386985605fb3c299efee43945f9ba74"},"digests":{"blake2b_256":"bc0b774daf11a6e9be1aa998756eccbea5619ba1494ea18826073f7925829651","md5":"559e8dcb540540d770518a71084d87c2","sha256":"7fb34db1f23d9ce153a47ca9b3e1d9406eacf025975d045386465beeee9b3784"},"downloads":-1,"filename":"rfdetr-1.0.0-py3-none-any.whl","has_sig":false,"md5_digest":"559e8dcb540540d770518a71084d87c2","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.9","size":104342,"upload_time":"2025-03-20T16:24:13","upload_time_iso_8601":"2025-03-20T16:24:13.099681Z","url":"https://files.pythonhosted.org/packages/bc/0b/774daf11a6e9be1aa998756eccbea5619ba1494ea18826073f7925829651/rfdetr-1.0.0-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"0d71c2438cc9c558fb1f55b4c5482295521e30ef57deecaf8f6548d0e7e13b14","md5":"a138065166d237e05f99e661ba819d2e","sha256":"8a9ef567bbf4fc07b2c305d52d02f1e4d0452a4cc8bb0ed76e239668fa13d36b"},"downloads":-1,"filename":"rfdetr-1.0.0.tar.gz","has_sig":false,"md5_digest":"a138065166d237e05f99e661ba819d2e","packagetype":"sdist","python_version":"source","requires_python":">=3.9","size":92850,"upload_time":"2025-03-20T16:24:14","upload_time_iso_8601":"2025-03-20T16:24:14.848181Z","url":"https://files.pythonhosted.org/packages/0d/71/c2438cc9c558fb1f55b4c5482295521e30ef57deecaf8f6548d0e7e13b14/rfdetr-1.0.0.tar.gz","yanked":false,"yanked_reason":null}],"1.0.1":[{"comment_text":null,"core-metadata":{"sha256":"69cf85adb5682eb9c4865ff5f82ffb42b6297c4a1027f271ad77c3328e9c930b"},"digests":{"blake2b_256":"05d80d6cd98f0849b594a61d0e489b9eac4c733902f411ca3e0e5e7a7961c766","md5":"f323b76832dc77d6344a5c1b3c73bed7","sha256":"b4c484cafe73398edbcd50bf7368771c9ecbd6e1f355854a233bbc283191096c"},"downloads":-1,"filename":"rfdetr-1.0.1-py3-none-any.whl","has_sig":false,"md5_digest":"f323b76832dc77d6344a