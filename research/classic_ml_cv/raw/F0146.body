2.0rc1/manifests"},{"name":"db-v0.1.1rc1","sha":"f0a82f3118d0b831f8f314df63a1376e56b64a69","kind":"commit","published_at":"2020-06-12T14:41:01.000Z","download_url":"https://codeload.github.com/voxel51/fiftyone/tar.gz/db-v0.1.1rc1","html_url":"https://github.com/voxel51/fiftyone/releases/tag/db-v0.1.1rc1","dependencies_parsed_at":null,"dependency_job_id":null,"purl":"pkg:github/voxel51/fiftyone@db-v0.1.1rc1","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/voxel51%2Ffiftyone/tags/db-v0.1.1rc1","manifests_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/voxel51%2Ffiftyone/tags/db-v0.1.1rc1/manifests"},{"name":"v0.1.3","sha":"40233262cba85e372782c30ca983781ae4dd6077","kind":"commit","published_at":"2020-06-01T21:20:30.000Z","download_url":"https://codeload.github.com/voxel51/fiftyone/tar.gz/v0.1.3","html_url":"https://github.com/voxel51/fiftyone/releases/tag/v0.1.3","dependencies_parsed_at":null,"dependency_job_id":null,"purl":"pkg:github/voxel51/fiftyone@v0.1.3","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/voxel51%2Ffiftyone/tags/v0.1.3","manifests_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/voxel51%2Ffiftyone/tags/v0.1.3/manifests"}]},"repo_metadata_updated_at":"2026-09-25T04:17:48.277Z","dependent_packages_count":12,"downloads":105323,"downloads_period":"last-month","dependent_repos_count":64,"rankings":{"downloads":1.5116246957221593,"dependent_repos_count":1.8462333604248367,"dependent_packages_count":1.266954219168676,"stargazers_count":1.0955974892393152,"forks_count":2.618893048054477,"docker_downloads_count":2.4520821781025472,"average":1.7985641651186686},"purl":"pkg:pypi/fiftyone","advisories":[{"uuid":"GSA_kwCzR0hTQS1xNzhwLWhqOWgtNTQ2Ns4ABbBK","url":"https://github.com/advisories/GHSA-q78p-hj9h-5466","title":"FiftyOne App server uses wildcard CORS (Access-Control-Allow-Origin: *), enabling cross-origin reads of local server data","description":"### Impact\n\nThe FiftyOne App/API server (`fiftyone/server/app.py`) and the `/media` route (`fiftyone/server/routes/media.py`) unconditionally set a permissive CORS header (`Access-Control-Allow-Origin: *`) on their responses. Because the embedded App server runs locally and is unauthenticated, this allows **any website a user visits to make cross-origin requests to that user's running FiftyOne server and read the responses**.\n\nCombined with the unauthenticated `/media` endpoint — which serves files from the local filesystem by path — the wildcard CORS policy turns a local-only file read into a **remotely exploitable, drive-by data exfiltration** vulnerability. A malicious web page can silently issue requests such as `http://localhost:5151/media?filepath=/etc/passwd` and read arbitrary files accessible to the server process (SSH keys, cloud credentials, `.env` files, dataset media, etc.), then exfiltrate them to an attacker-controlled endpoint.\n\nThe victim only needs to have a FiftyOne server running locally and visit a malicious page — no clicks or other interaction are required. Browsers that have shipped Private Network Access / local-network-access protections (e.g. Chromium 142+) mitigate this for some users, but Safari and Firefox do not yet, so the attack remains viable in common configurations.\n\n**Who is impacted:** any user running FiftyOne (the open-source, embedded App server) locally while also browsing the web.\n\n**Not affected:** media stored in cloud buckets, which is served via signed URLs on a separate origin.\n\n### Patches\n\nFixed in **FiftyOne 1.17.0**. The hard-coded `Access-Control-Allow-Origin: *` has been removed and the server now responds **same-origin only by default**, which covers local desktop usage and the supported notebook integrations (each served through a same-origin proxy or iframe).\n\nCross-origin access is now opt-in via a new `allowed_origins` config option (environment variable `FIFTYONE_ALLOWED_ORIGINS`), an explicit comma-separated list of trusted origins, e.g.:\n\n```shell\nexport FIFTYONE_ALLOWED_ORIGINS='https://app.example.com,http://localhost:3000'\n```\n\nThe literal value `*` restores the legacy wildcard behavior for users who explicitly require it and emits a warning.\n\n**Users should upgrade to FiftyOne 1.17.0 or later.**\n\n### Workarounds\n\nIn affected versions there is no configuration flag to disable the wildcard CORS header without upgrading. Until you can upgrade:\n\n- Do not run the FiftyOne App server while browsing untrusted websites.\n- Keep the App server bound to `localhost` (the default) and avoid exposing it on a network interface.\n- Use a browser that enforces Private Network Access protections.\n\n### Resources\n\n- OWASP A01:2025 – Broken Access Control: https://owasp.org/Top10/2025/A01_2025-Broken_Access_Control/","origin":"UNSPECIFIED","severity":"MODERATE","published_at":"2026-07-15T21:57:29.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":6.3,"cvss_vector":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:C/C:H/I:N/A:N","references":["https://github.com/voxel51/fiftyone/security/advisories/GHSA-q78p-hj9h-5466","https://github.com/voxel51/fiftyone/commit/7c5b92eec5c7c0210c0c8134351ced77d2800ae0","https://github.com/voxel51/fiftyone/releases/tag/v1.17.0","https://github.com/advisories/GHSA-q78p-hj9h-5466"],"source_kind":"github","identifiers":["GHSA-q78p-hj9h-5466","CVE-2026-53656"],"repository_url":null,"blast_radius":0.0,"created_at":"2026-07-15T22:00:07.856Z","updated_at":"2026-09-25T12:01:55.800Z","epss_percentage":0.00119,"epss_percentile":0.01572,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1xNzhwLWhqOWgtNTQ2Ns4ABbBK","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1xNzhwLWhqOWgtNTQ2Ns4ABbBK","packages":[{"ecosystem":"pypi","package_name":"fiftyone","versions":[{"first_patched_version":"1.17.0","vulnerable_version_range":"\u003c 1.17.0"}],"purl":"pkg:pypi/fiftyone"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1xNzhwLWhqOWgtNTQ2Ns4ABbBK/related_packages","related_advisories":[]}],"docker_usage_url":"https://docker.ecosyste.ms/usage/pypi/fiftyone","docker_dependents_count":4,"docker_downloads_count":245,"usage_url":"https://repos.ecosyste.ms/usage/pypi/fiftyone","dependent_repositories_url":"https://repos.ecosyste.ms/api/v1/usage/pypi/fiftyone/dependencies","status":null,"funding_links":[],"critical":null,"issue_metadata":{"last_synced_at":"2026-09-25T00:00:23.250Z","issues_count":558,"pull_requests_count":4949,"avg_time_to_close_issue":17724274.38,"avg_time_to_close_pull_request":1328646.2819830712,"issues_closed_count":300,"pull_requests_closed_count":4135,"pull_request_authors_count":152,"issue_authors_count":351,"avg_comments_per_issue":2.184587813620072,"avg_comments_per_pull_request":1.5552636896342695,"merged_pull_requests_count":3589,"bot_issues_count":2,"bot_pull_requests_count":174,"past_year_issues_count":11,"past_year_pull_requests_count":633,"past_year_avg_time_to_close_issue":null,"past_year_avg_time_to_close_pull_request":602658.131147541,"past_year_issues_closed_count":0,"past_year_pull_requests_closed_count":366,"past_year_pull_request_authors_count":72,"past_year_issue_authors_count":9,"past_year_avg_comments_per_issue":1.0,"past_year_avg_comments_per_pull_request":2.9036334913112163,"past_year_bot_issues_count":0,"past_year_bot_pull_requests_count":18,"past_year_merged_pull_requests_count":302,"issues_url":"https://issues.ecosyste.ms/api/v1/hosts/GitHub/repositories/voxel51%2Ffiftyone/issues","maintainers":[{"login":"findtopher","count":181,"url":"https://issues.ecosyste.ms/api/v1/hosts/GitHub/authors/findtopher"},{"login":"voxel51-bot","count":170,"url":"https://issues.ecosyste.ms/api/v1/hosts/GitHub/authors/voxel51-bot"},{"login":"CharlesCNorton","count":119,"url":"https://issues.ecosyste.ms/api/v1/hosts/GitHub/authors/CharlesCNorton"},{"login":"benjaminpkane","count":97,"url":"https://issues.ecosyste.ms/api/v1/hosts/Git