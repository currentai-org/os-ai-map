s-master-6516/manifests"}]},"repo_metadata_updated_at":"2026-09-26T12:22:55.265Z","dependent_packages_count":14,"downloads":156866,"downloads_period":"last-month","dependent_repos_count":393,"rankings":{"downloads":0.5143716463310435,"dependent_repos_count":0.7350065127159354,"dependent_packages_count":0.9624191016915016,"stargazers_count":0.3482309336918175,"forks_count":0.3381675533833844,"docker_downloads_count":1.0786804440039341,"average":0.6628126986362695},"purl":"pkg:pypi/h2o","advisories":[{"uuid":"GSA_kwCzR0hTQS13ajNoLXd4OGcteDY5Oc4ABRy2","url":"https://github.com/advisories/GHSA-wj3h-wx8g-x699","title":"H2O has an External Control of File Name or Path vulnerability","description":"A vulnerability in h2oai/h2o-3 version 3.46.0.1 allows remote attackers to write arbitrary data to any file on the server. This is achieved by exploiting the `/3/Parse` endpoint to inject attacker-controlled data as the header of an empty file, which is then exported using the `/3/Frames/framename/export` endpoint. The impact of this vulnerability includes the potential for remote code execution and complete access to the system running h2o-3, as attackers can overwrite critical files such as private SSH keys or script files.","origin":"UNSPECIFIED","severity":"CRITICAL","published_at":"2026-02-02T12:31:14.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":9.1,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:H/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-5986","https://huntr.com/bounties/64ff5319-6ac3-4447-87f7-b53495d4d5a3","https://github.com/advisories/GHSA-wj3h-wx8g-x699"],"source_kind":"github","identifiers":["GHSA-wj3h-wx8g-x699","CVE-2024-5986"],"repository_url":null,"blast_radius":0.0,"created_at":"2026-02-02T23:00:08.039Z","updated_at":"2026-09-25T12:06:10.502Z","epss_percentage":0.00668,"epss_percentile":0.49729,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS13ajNoLXd4OGcteDY5Oc4ABRy2","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS13ajNoLXd4OGcteDY5Oc4ABRy2","packages":[{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003c= 3.46.0.1"}],"purl":"pkg:pypi/h2o"},{"ecosystem":"maven","package_name":"ai.h2o:h2o-core","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003c= 3.46.0.1"}],"purl":null}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS13ajNoLXd4OGcteDY5Oc4ABRy2/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS01dzNqLWd3Z2gtNHJmds4ABMag","url":"https://github.com/advisories/GHSA-5w3j-gwgh-4rfv","title":"H2O affected by a deserialization vulnerability","description":"A deserialization vulnerability exists in h2oai/h2o-3 versions \u003c= 3.46.0.7, allowing attackers to read arbitrary system files and execute arbitrary code. The vulnerability arises from improper handling of JDBC connection parameters, which can be exploited by bypassing regular expression checks and using double URL encoding. This issue impacts all users of the affected versions.","origin":"UNSPECIFIED","severity":"CRITICAL","published_at":"2025-09-22T18:30:34.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":9.8,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2025-6544","https://github.com/h2oai/h2o-3/commit/0298ee348f5c73673b7b542158081e79605f5f25","https://huntr.com/bounties/53f35a0f-d644-4f82-93aa-89fe7e0aed40","https://github.com/advisories/GHSA-5w3j-gwgh-4rfv"],"source_kind":"github","identifiers":["GHSA-5w3j-gwgh-4rfv","CVE-2025-6544"],"repository_url":"https://github.com/h2oai/h2o-3","blast_radius":0.0,"created_at":"2025-09-22T22:00:21.982Z","updated_at":"2026-09-23T15:07:43.621Z","epss_percentage":0.00919,"epss_percentile":0.58734,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS01dzNqLWd3Z2gtNHJmds4ABMag","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS01dzNqLWd3Z2gtNHJmds4ABMag","packages":[{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003c= 3.46.0.7"}],"purl":"pkg:pypi/h2o"},{"ecosystem":"maven","package_name":"ai.h2o:h2o-core","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003c= 3.46.0.7"}],"purl":null}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS01dzNqLWd3Z2gtNHJmds4ABMag/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS1nNDh2LTNwMzUtODhqcs4ABFuy","url":"https://github.com/advisories/GHSA-g48v-3p35-88jr","title":"H2O Vulnerable to Arbitrary File Overwrite","description":"In h2oai/h2o-3 version 3.46.0, the `/99/Models/{name}/json` endpoint allows for arbitrary file overwrite on the target server. The vulnerability arises from the `exportModelDetails` function in `ModelsHandler.java`, where the user-controllable `mexport.dir` parameter is used to specify the file path for writing model details. This can lead to overwriting files at arbitrary locations on the host system.","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2025-03-20T12:32:48.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":8.2,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-8616","https://huntr.com/bounties/aebf69a5-b9b1-4d2f-a8ff-902c11a8c97a","https://github.com/h2oai/h2o-3/blob/088190f9d0370a02a483fca68d8dc89c996b4f83/h2o-core/src/main/java/water/api/ModelsHandler.java#L310","https://github.com/advisories/GHSA-g48v-3p35-88jr"],"source_kind":"github","identifiers":["GHSA-g48v-3p35-88jr","CVE-2024-8616"],"repository_url":"https://github.com/h2oai/h2o-3","blast_radius":0.0,"created_at":"2025-03-20T21:07:46.220Z","updated_at":"2026-09-25T12:08:29.102Z","epss_percentage":0.00546,"epss_percentile":0.43326,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1nNDh2LTNwMzUtODhqcs4ABFuy","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1nNDh2LTNwMzUtODhqcs4ABFuy","packages":[{"ecosystem":"maven","package_name":"ai.h2o:h2o-core","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.10.4.1, \u003c= 3.46.0"}],"purl":null},{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.10.4.1, \u003c= 3.46.0"}],"purl":"pkg:pypi/h2o"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1nNDh2LTNwMzUtODhqcs4ABFuy/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS01YzhqLWc5NngtY2o3OM4ABFse","url":"https://github.com/advisories/GHSA-5c8j-g96x-cj78","title":"H2O Vulnerable to Denial of Service (DoS) via `HEAD` Request","description":"A vulnerability in the typeahead endpoint of h2oai/h2o-3 version 3.46.0 allows for a denial of service. The endpoint performs a `HEAD` request to verify the existence of a specified resource without setting a timeout. An attacker can exploit this by sending multiple requests to an attacker-controlled server that hangs, causing the application to block and become unresponsive to other requests.","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2025-03-20T12:32:47.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":7.5,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-8062","https://huntr.com/bounties/a04190d9-4acb-449a-9a7f-f1bf6be1ed23","https://github.com/h2oai/h2o-3/blob/047a4d617240a56e74f834207c65973d133391cb/h2o-core/src/main/java/water/persist/PersistManager.java#L302","https://github.com/advisories/GHSA-5c8j-g96x-cj78"],"source_kind":"github","identifiers":["GHSA-5c8j-g96x-cj78","CVE-2024-8062"],"repository_url":"https://github.com/h2oai/h2o-3","blast_radius":0.0,"created_at":"2025-03-20T21:07:46.277Z","updated_at":"2026-09-25T12:08:29.103Z","epss_percentage":0.00473,"epss_percentile":0.38235,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS01YzhqLWc5NngtY2o3OM4ABFse","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS01YzhqLWc5NngtY2o3OM4ABFse","packages":[{"ecosystem":"maven","package_name":"ai.h2o:h2o-core","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.2.0.1, \u003c= 3.46.0"}],"purl":null},{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.2.0.1, \u003c= 3.46.0"}],"purl":"pkg:pypi/h2o"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS01YzhqLWc5NngtY2o3OM4ABFse/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS1wMnZjLW01ZnYtOXc5bc4ABFsW","url":"https://github.com/advisories/GHSA-p2vc-m5fv-9w9m","title":"H2O Vulnerable to Denial of Service (DoS) via `/3/ImportFiles` Endpoint","description":"A vulnerability in the `/3/ImportFiles` endpoint of h2oai/h2o-3 version 3.46.1 allows an attacker to cause a denial of service. The endpoint takes a single GET parameter, `path`, which can be recursively set to reference itself. This leads the server to repeatedly call its own endpoint, eventually filling up the request queue and leaving the server unable to handle other requests.","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2025-03-20T12:32:46.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":7.5,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-7768","https://huntr.com/bounties/3fe640df-bef4-4072-8890-0d12bc2818f6","https://github.com/h2oai/h2o-3/blob/7d418fa19d3ab434f742818e37f891bef9102c97/h2o-core/src/main/java/water/api/ImportFilesHandler.java#L19","https://github.com/advisories/GHSA-p2vc-m5fv-9w9m"],"source_kind":"github","identifiers":["GHSA-p2vc-m5fv-9w9m","CVE-2024-7768"],"repository_url":"https://github.com/h2oai/h2o-3","blast_radius":0.0,"created_at":"2025-03-20T21:07:46.333Z","updated_at":"2026-09-22T08:08:20.282Z","epss_percentage":0.00772,"epss_percentile":0.54165,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1wMnZjLW01ZnYtOXc5bc4ABFsW","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1wMnZjLW01ZnYtOXc5bc4ABFsW","packages":[{"ecosystem":"maven","package_name":"ai.h2o:h2o-core","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003c= 3.46.1"}],"purl":null},{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003c= 3.46.1"}],"purl":"pkg:pypi/h2o"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1wMnZjLW01ZnYtOXc5bc4ABFsW/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS02dzYyLTNqdmotbWZqNs4ABFsY","url":"https://github.com/advisories/GHSA-6w62-3jvj-mfj6","title":"H2O Vulnerable to Denial of Service (DoS) via Large GZIP Parsing","description":"In h2oai/h2o-3 version 3.46.0.2, a vulnerability exists where uploading and repeatedly parsing a large GZIP file can cause a denial of service. The server becomes unresponsive due to memory exhaustion and a large number of concurrent slow-running jobs. This issue arises from the improper handling of highly compressed data, leading to significant data amplification.","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2025-03-20T12:32:46.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":7.5,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-7765","https://huntr.com/bounties/0e58b1a5-bdca-4e60-af92-09de9c76a9ff","https://github.com/h2oai/h2o-3/blob/7d418fa19d3ab434f742818e37f891bef9102c97/h2o-core/src/main/java/water/parser/ParseDataset.java#L900","https://github.com/advisories/GHSA-6w62-3jvj-mfj6"],"source_kind":"github","identifiers":["GHSA-6w62-3jvj-mfj6","CVE-2024-7765"],"repository_url":"https://github.com/h2oai/h2o-3","blast_radius":0.0,"created_at":"2025-03-20T20:08:10.036Z","updated_at":"2026-09-26T17:06:32.157Z","epss_percentage":0.00763,"epss_percentile":0.535,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS02dzYyLTNqdmotbWZqNs4ABFsY","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS02dzYyLTNqdmotbWZqNs4ABFsY","packages":[{"ecosystem":"maven","package_name":"ai.h2o:h2o-core","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.32.1.2, \u003c= 3.46.0.2"}],"purl":null},{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.32.1.2, \u003c= 3.46.0.2"}],"purl":"pkg:pypi/h2o"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS02dzYyLTNqdmotbWZqNs4ABFsY/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS1tMzdoLThyNDgtMmN4as4ABFt1","url":"https://github.com/advisories/GHSA-m37h-8r48-2cxj","title":"H2O Vulnerable to Execution of Arbitrary Files","description":"In h2oai/h2o-3 version 3.46.0, an endpoint exposing a custom EncryptionTool allows an attacker to encrypt any files on the target server with a key of their choosing. The chosen key can also be overwritten, resulting in ransomware-like behavior. This vulnerability makes it possible for an attacker to encrypt arbitrary files with keys of their choice, making it exceedingly difficult for the target to recover the keys needed for decryption.","origin":"UNSPECIFIED","severity":"MODERATE","published_at":"2025-03-20T12:32:45.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":6.5,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:L","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-6863","https://huntr.com/bounties/10f55937-0cba-4530-897f-2abf30ed5270","https://github.com/h2oai/h2o-3/blob/a20b5b19b769866ee24b217ee78b820e64c1cd6a/h2o-core/src/main/java/water/tools/EncryptionTool.java#L49","https://github.com/advisories/GHSA-m37h-8r48-2cxj"],"source_kind":"github","identifiers":["GHSA-m37h-8r48-2cxj","CVE-2024-6863"],"repository_url":"https://github.com/h2oai/h2o-3","blast_radius":0.0,"created_at":"2025-03-20T20:08:10.180Z","updated_at":"2026-09-25T12:08:29.106Z","epss_percentage":0.0035,"epss_percentile":0.25857,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1tMzdoLThyNDgtMmN4as4ABFt1","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1tMzdoLThyNDgtMmN4as4ABFt1","packages":[{"ecosystem":"maven","package_name":"ai.h2o:h2o-core","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.32.1.2, \u003c= 3.46.0"}],"purl":null},{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.32.1.2, \u003c= 3.46.0"}],"purl":"pkg:pypi/h2o"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1tMzdoLThyNDgtMmN4as4ABFt1/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS00N2Y2LTVwN2gtNWYzaM4ABFt4","url":"https://github.com/advisories/GHSA-47f6-5p7h-5f3h","title":"H2O Vulnerable to Arbitrary File Overwrite via File Export","description":"In h2oai/h2o-3 version 3.46.0, the endpoint for exporting models does not restrict the export location, allowing an attacker to export a model to any file in the server's file structure, thereby overwriting it. This vulnerability can be exploited to overwrite any file on the target server with a trained model file, although the content of the overwrite is not controllable by the attacker.","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2025-03-20T12:32:45.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":7.1,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:L/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-6854","https://huntr.com/bounties/97d013f9-ac51-4c80-8dd7-8dfde11f33b2","https://github.com/h2oai/h2o-3/blob/a20b5b19b769866ee24b217ee78b820e64c1cd6a/h2o-core/src/main/java/hex/Model.java#L3366","https://github.com/advisories/GHSA-47f6-5p7h-5f3h"],"source_kind":"github","identifiers":["GHSA-47f6-5p7h-5f3h","CVE-2024-6854"],"repository_url":"https://github.com/h2oai/h2o-3","blast_radius":0.0,"created_at":"2025-03-20T20:08:10.141Z","updated_at":"2026-09-25T12:08:29.106Z","epss_percentage":0.0076,"epss_percentile":0.53319,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS00N2Y2LTVwN2gtNWYzaM4ABFt4","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS00N2Y2LTVwN2gtNWYzaM4ABFt4","packages":[{"ecosystem":"maven","package_name":"ai.h2o:h2o-core","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.32.1.1, \u003c= 3.46.0"}],"purl":null},{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.32.1.1, \u003c= 3.46.0"}],"purl":"pkg:pypi/h2o"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS00N2Y2LTVwN2gtNWYzaM4ABFt4/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS03cXE3LXB2bTkteDhyZs4ABFri","url":"https://github.com/advisories/GHSA-7qq7-pvm9-x8rf","title":"H2O Vulnerable to Denial of Service (DoS) via `/3/ParseSetup` Endpoint","description":"A vulnerability in the `/3/ParseSetup` endpoint of h2oai/h2o-3 version 3.46.0.1 allows for a denial of service (DoS) attack. The endpoint applies a user-specified regular expression to a user-controllable string. This can be exploited by an attacker to cause inefficient regular expression complexity, leading to the exhaustion of server resources and making the server unresponsive.","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2025-03-20T12:32:39.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":7.5,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-10550","https://huntr.com/bounties/ef3f4d89-3b8b-4618-b134-cb93c1664ec6","https://github.com/h2oai/h2o-3/blob/51c25940ded8b7d0acc8f3f72329fd9dedbb3a34/h2o-core/src/main/java/water/api/ParseSetupHandler.java#L121","https://github.com/advisories/GHSA-7qq7-pvm9-x8rf"],"source_kind":"github","identifiers":["GHSA-7qq7-pvm9-x8rf","CVE-2024-10550"],"repository_url":"https://github.com/h2oai/h2o-3","blast_radius":0.0,"created_at":"2025-03-20T20:08:10.310Z","updated_at":"2026-09-25T12:08:29.108Z","epss_percentage":0.00624,"epss_percentile":0.47636,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS03cXE3LXB2bTkteDhyZs4ABFri","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS03cXE3LXB2bTkteDhyZs4ABFri","packages":[{"ecosystem":"maven","package_name":"ai.h2o:h2o-core","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.30.0.7, \u003c= 3.46.0.1"}],"purl":null},{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.30.0.7, \u003c= 3.46.0.1"}],"purl":"pkg:pypi/h2o"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS03cXE3LXB2bTkteDhyZs4ABFri/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS13anB2LTY0djItMnFwcc4ABFrW","url":"https://github.com/advisories/GHSA-wjpv-64v2-2qpq","title":"H2O Vulnerable to Denial of Service (DoS) and File Write","description":"In h2oai/h2o-3 version 3.46.0.1, the `run_tool` command exposes classes in the `water.tools` package through the `ast` parser. This includes the `XGBoostLibExtractTool` class, which can be exploited to shut down the server and write large files to arbitrary directories, leading to a denial of service.","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2025-03-20T12:32:39.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":7.5,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-10572","https://huntr.com/bounties/db8939a0-9be8-4d0f-a8b0-1bd181666da2","https://github.com/h2oai/h2o-3/blob/5e45e780f597961bda73adff765976db975f204b/h2o-extensions/xgboost/src/main/java/water/tools/XGBoostLibExtractTool.java#L12","https://github.com/advisories/GHSA-wjpv-64v2-2qpq"],"source_kind":"github","identifiers":["GHSA-wjpv-64v2-2qpq","CVE-2024-10572"],"repository_url":"https://github.com/h2oai/h2o-3","blast_radius":0.0,"created_at":"2025-03-20T20:08:10.365Z","updated_at":"2026-09-25T12:08:29.109Z","epss_percentage":0.00675,"epss_percentile":0.50028,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS13anB2LTY0djItMnFwcc4ABFrW","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS13anB2LTY0djItMnFwcc4ABFrW","packages":[{"ecosystem":"maven","package_name":"ai.h2o:h2o-ext-xgboost","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.34.0.1, \u003c= 3.46.0.1"}],"purl":null},{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.34.0.1, \u003c= 3.46.0.1"}],"purl":"pkg:pypi/h2o"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS13anB2LTY0djItMnFwcc4ABFrW/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS1oN3hnLWNtcHAtNDhoZs4ABFrY","url":"https://github.com/advisories/GHSA-h7xg-cmpp-48hf","title":"H2O Deserialization of Untrusted Data Vulnerability","description":"A vulnerability in the h2oai/h2o-3 REST API versions 3.46.0.4 allows unauthenticated remote attackers to execute arbitrary code via deserialization of untrusted data. The vulnerability exists in the endpoints POST /99/ImportSQLTable and POST /3/SaveToHiveTable, where user-controlled JDBC URLs are passed to DriverManager.getConnection, leading to deserialization if a MySQL or PostgreSQL driver is available in the classpath. This issue is fixed in version 3.46.0.6.","origin":"UNSPECIFIED","severity":"CRITICAL","published_at":"2025-03-20T12:32:39.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":9.8,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-10553","https://github.com/h2oai/h2o-3/commit/ac1d642b4d86f10a02d75974055baf2a4b2025ac","https://huntr.com/bounties/e6f550dd-eda2-428c-a740-ed8f893a084b","https://github.com/advisories/GHSA-h7xg-cmpp-48hf"],"source_kind":"github","identifiers":["GHSA-h7xg-cmpp-48hf","CVE-2024-10553"],"repository_url":"https://github.com/h2oai/h2o-3","blast_radius":0.0,"created_at":"2025-03-20T20:08:10.275Z","updated_at":"2026-09-24T15:07:17.130Z","epss_percentage":0.01587,"epss_percentile":0.74519,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1oN3hnLWNtcHAtNDhoZs4ABFrY","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1oN3hnLWNtcHAtNDhoZs4ABFrY","packages":[{"ecosystem":"maven","package_name":"ai.h2o:h2o-core","versions":[{"first_patched_version":"3.46.0.6","vulnerable_version_range":"\u003c 3.46.0.6"}],"purl":null},{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":"3.46.0.6","vulnerable_version_range":"\u003c 3.46.0.6"}],"purl":"pkg:pypi/h2o"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1oN3hnLWNtcHAtNDhoZs4ABFrY/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS13d3I5LTRnbXIteHZxOc4ABFq-","url":"https://github.com/advisories/GHSA-wwr9-4gmr-xvq9","title":"H2O Vulnerable to Denial of Service (DoS) via `/3/Parse` Endpoint","description":"A vulnerability in the `/3/Parse` endpoint of h2oai/h2o-3 version 3.46.0.1 allows for a denial of service (DoS) attack. The endpoint uses a user-specified string to construct a regular expression, which is then applied to another user-specified string. By sending multiple simultaneous requests, an attacker can exhaust all available threads, leading to a complete denial of service.","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2025-03-20T12:32:39.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":7.5,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-10549","https://huntr.com/bounties/ce7bd2d6-fd38-440d-a91a-dd8f3fc06bc2","https://github.com/h2oai/h2o-3/blob/51c25940ded8b7d0acc8f3f72329fd9dedbb3a34/h2o-core/src/main/java/water/api/ParseHandler.java#L80","https://github.com/advisories/GHSA-wwr9-4gmr-xvq9"],"source_kind":"github","identifiers":["GHSA-wwr9-4gmr-xvq9","CVE-2024-10549"],"repository_url":"https://github.com/h2oai/h2o-3","blast_radius":0.0,"created_at":"2025-03-20T20:08:10.234Z","updated_at":"2026-09-25T12:08:29.107Z","epss_percentage":0.00624,"epss_percentile":0.47636,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS13d3I5LTRnbXIteHZxOc4ABFq-","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS13d3I5LTRnbXIteHZxOc4ABFq-","packages":[{"ecosystem":"maven","package_name":"ai.h2o:h2o-core","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.30.0.7, \u003c= 3.46.0.1"}],"purl":null},{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003e= 3.30.0.7, \u003c= 3.46.0.1"}],"purl":"pkg:pypi/h2o"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS13d3I5LTRnbXIteHZxOc4ABFq-/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS1ocm1jLWptcDctbXBtMs4AA_WA","url":"https://github.com/advisories/GHSA-hrmc-jmp7-mpm2","title":"H2O.ai H2O vulnerable to deserialization attacks via a JDBC Connection URL","description":"H2O.ai H2O through 3.46.0.4 allows attackers to arbitrarily set the JDBC URL, leading to deserialization attacks, file reads, and command execution. Exploitation can occur when an attacker has access to post to the ImportSQLTable URI with a JSON document containing a connection_url property with any typical JDBC Connection URL attack payload such as one that uses queryInterceptors.","origin":"UNSPECIFIED","severity":"CRITICAL","published_at":"2024-09-06T18:31:31.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":9.1,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-45758","https://gist.github.com/AfterSnows/c24ca3c26dc89ab797e610e92a6a9acb","https://spear-shield.notion.site/Unauthenticated-Remote-Code-Execution-via-Unrestricted-JDBC-Connection-87a958a4874044199cbb86422d1f6068","https://github.com/h2oai/h2o-3/issues/16425","https://github.com/h2oai/h2o-3/issues/16622","https://github.com/h2oai/h2o-3/pull/16624","https://github.com/h2oai/h2o-3/commit/f714edd6b8429c7a7211b779b6ec108a95b7382d","https://github.com/advisories/GHSA-hrmc-jmp7-mpm2"],"source_kind":"github","identifiers":["GHSA-hrmc-jmp7-mpm2","CVE-2024-45758"],"repository_url":"https://github.com/h2oai/h2o-3","blast_radius":0.0,"created_at":"2025-09-23T19:00:20.489Z","updated_at":"2026-09-14T14:06:17.381Z","epss_percentage":0.00906,"epss_percentile":0.57557,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1ocm1jLWptcDctbXBtMs4AA_WA","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1ocm1jLWptcDctbXBtMs4AA_WA","packages":[{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003c= 3.46.0.7"}],"purl":"pkg:pypi/h2o"},{"ecosystem":"maven","package_name":"ai.h2o:h2o-core","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003c= 3.46.0.7"}],"purl":null}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1ocm1jLWptcDctbXBtMs4AA_WA/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS01OG0zLXJjdnAtZjl3d84AA9ZT","url":"https://github.com/advisories/GHSA-58m3-rcvp-f9ww","title":"h2o vulnerable to unexpected POST request shutting down server","description":"In h2oai/h2o-3 version 3.46.0, the `run_tool` command in the `rapids` component allows the `main` function of any class under the `water.tools` namespace to be called. One such class, `MojoConvertTool`, crashes the server when invoked with an invalid argument, causing a denial of service.","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2024-06-27T21:32:08.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":7.5,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-5979","https://huntr.com/bounties/d80a2139-fc03-44b7-b739-de41e323b458","https://github.com/h2oai/h2o-3/commit/d0899f8e0f7a584b60405a65b1d7b439aaaa55a5","https://github.com/advisories/GHSA-58m3-rcvp-f9ww"],"source_kind":"github","identifiers":["GHSA-58m3-rcvp-f9ww","CVE-2024-5979"],"repository_url":"https://github.com/h2oai/h2o-3","blast_radius":0.0,"created_at":"2024-06-28T22:05:21.123Z","updated_at":"2026-09-26T17:07:59.949Z","epss_percentage":0.00794,"epss_percentile":0.54538,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS01OG0zLXJjdnAtZjl3d84AA9ZT","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS01OG0zLXJjdnAtZjl3d84AA9ZT","packages":[{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003c= 3.46.0"}],"purl":"pkg:pypi/h2o"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS01OG0zLXJjdnAtZjl3d84AA9ZT/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS14MjM0LXI1ZmcteDUybc4AA8xY","url":"https://github.com/advisories/GHSA-x234-r5fg-x52m","title":"Arbitrary system path lookup in h20","description":"In h2oai/h2o-3 version 3.40.0.4, an exposure of sensitive information vulnerability exists due to an arbitrary system path lookup feature. This vulnerability allows any remote user to view full paths in the entire file system where h2o-3 is hosted. Specifically, the issue resides in the Typeahead API call, which when requested with a typeahead lookup of '/', exposes the root filesystem including directories such as /home, /usr, /bin, among others. This vulnerability could allow attackers to explore the entire filesystem, and when combined with a Local File Inclusion (LFI) vulnerability, could make exploitation of the server trivial.","origin":"UNSPECIFIED","severity":"MODERATE","published_at":"2024-06-06T21:30:37.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":5.3,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:N","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-5550","https://huntr.com/bounties/e76372c2-39be-4984-a7c8-7048a75a25dc","https://github.com/advisories/GHSA-x234-r5fg-x52m"],"source_kind":"github","identifiers":["GHSA-x234-r5fg-x52m","CVE-2024-5550"],"repository_url":null,"blast_radius":0.0,"created_at":"2024-06-06T23:05:12.685Z","updated_at":"2026-09-15T18:08:07.370Z","epss_percentage":0.00835,"epss_percentile":0.55533,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS14MjM0LXI1ZmcteDUybc4AA8xY","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS14MjM0LXI1ZmcteDUybc4AA8xY","packages":[{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003c= 3.40.0.4"}],"purl":"pkg:pypi/h2o"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS14MjM0LXI1ZmcteDUybc4AA8xY/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS1ncXJxLWo2cG0tOThjMs4AA3w5","url":"https://github.com/advisories/GHSA-gqrq-j6pm-98c2","title":"External Control of File Name or Path in h2oai/h2o-3","description":"Remote unauthenticated attackers can overwrite arbitrary server files with attacker-controllable data. The data that the attacker can control is not entirely arbitrary. h2o writes a CSV/XLS/etc file to disk, so the attacker data is wrapped in quotations and starts with \"C1\", if they're exporting as CSV.","origin":"UNSPECIFIED","severity":"CRITICAL","published_at":"2023-12-14T15:30:22.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":9.3,"cvss_vector":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:C/C:N/I:L/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2023-6569","https://huntr.com/bounties/a5d003dc-c23e-4c98-8dcf-35ba9252fa3c","https://github.com/h2oai/h2o-3/commit/e8884f5187eb81311877c5f0dd4d6d9c70f33d78","https://github.com/advisories/GHSA-gqrq-j6pm-98c2"],"source_kind":"github","identifiers":["GHSA-gqrq-j6pm-98c2","CVE-2023-6569"],"repository_url":null,"blast_radius":0.0,"created_at":"2023-12-15T04:05:43.479Z","updated_at":"2026-09-25T12:04:25.632Z","epss_percentage":0.00721,"epss_percentile":0.51906,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1ncXJxLWo2cG0tOThjMs4AA3w5","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1ncXJxLWo2cG0tOThjMs4AA3w5","packages":[{"ecosystem":"pypi","package_name":"h2o","versions":[{"first_patched_version":"3.46.0.1","vulnerable_version_range":"\u003c 3.46.0.1"}],"purl":"pkg:pypi/h2o"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1ncXJxLWo2cG0tOThjMs4AA3w5/related_packages","related_advisories":[]}],"docker_usage_url":"https://docker.ecosyste.ms/usage/pypi/h2o","docker_dependents_count":36,"docker_downloads_count":113252,"usage_url":"https://repos.ecosyste.ms/usage/pypi/h2o","dependent_repositories_url":"https://repos.ecosyste.ms/api/v1/usage/pypi/h2o/dependencies","status":null,"funding_links":[],"critical":null,"issue_metadata":{"last_synced_at":"2026-09-26T04:58:09.394Z","issues_count":1062,"pull_requests_count":792,"avg_time_to_close_issue":4311189.996190476,"avg_time_to_close_pull_request":3726513.4716981133,"issues_closed_count":525,"pull_requests_closed_count":636,"pull_request_authors_count":61,"issue_authors_count":120,"avg_comments_per_issue":1.5282485875706215