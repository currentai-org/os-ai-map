dbb15bbb66e50d20dd231fcef","sha256":"1e588a25d13406fc15e56077f7cd749355d721ff96bb47ac4a80413e80fb81dd"},"downloads":-1,"filename":"synthefy_nori-0.11.0.tar.gz","has_sig":false,"md5_digest":"670c65fdbb15bbb66e50d20dd231fcef","packagetype":"sdist","python_version":"source","requires_python":">=3.9","size":280725,"upload_time":"2026-07-14T04:02:57","upload_time_iso_8601":"2026-07-14T04:02:57.347068Z","url":"https://files.pythonhosted.org/packages/42/1f/101f1753ee4b7c1eb2253120279ae8c88c45a6bdd6f93fd825f621e2ad57/synthefy_nori-0.11.0.tar.gz","yanked":false,"yanked_reason":null}],"0.11.1":[{"comment_text":null,"core-metadata":{"sha256":"98553a108c161a40f63ca66a963cdff918babad68a7a16c82d97e2f6e19987cf"},"digests":{"blake2b_256":"3256415eba6526dea7afe9bdd9cde90d304b8ffaf7b1942410f478402cb30536","md5":"cab689ccdcf925ece88db8d5d481d2bf","sha256":"7e2ae0fbed7e34ce8846ffb5285b06f2328b076f99429e5a1193ae5a7af7338f"},"downloads":-1,"filename":"synthefy_nori-0.11.1-py3-none-any.whl","has_sig":false,"md5_digest":"cab689ccdcf925ece88db8d5d481d2bf","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.9","size":276759,"upload_time":"2026-07-16T05:14:42","upload_time_iso_8601":"2026-07-16T05:14:42.317508Z","url":"https://files.pythonhosted.org/packages/32/56/415eba6526dea7afe9bdd9cde90d304b8ffaf7b1942410f478402cb30536/synthefy_nori-0.11.1-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"c3165de2b0972a96d937907ab4e0e5ee0a600cf082ad13ab3680f56a751c9c51","md5":"2ae102c650f5c8b2559f2684f29c682a","sha256":"55e8f646cc1aaaf011635ba2da03bffa830ab577d407875cf181ec3f1ec712c3"},"downloads":-1,"filename":"synthefy_nori-0.11.1.tar.gz","has_sig":false,"md5_digest":"2ae102c650f5c8b2559f2684f29c682a","packagetype":"sdist","python_version":"source","requires_python":">=3.9","size":281401,"upload_time":"2026-07-16T05:14:43","upload_time_iso_8601":"2026-07-16T05:14:43.999160Z","url":"https://files.pythonhosted