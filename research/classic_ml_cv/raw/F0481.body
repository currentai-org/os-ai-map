[{"name":"V1.1.0","uuid":"261026931","tag_name":"V1.1.0","target_commitish":"main","body":"LimiX-2M is officially released. Compared to LimiX-16M, this more lightweight variant features significantly lower GPU memory usage and faster inference speed. Its retrieval mechanism has also been upgraded, further improving model performance while reducing both inference time and memory consumption.","draft":false,"prerelease":false,"immutable":false,"published_at":"2025-11-10T08:04:54.000Z","created_at":"2025-11-10T08:18:33.617Z","author":"limix-ldm","assets":[],"last_synced_at":"2026-09-16T01:08:06.860Z","html_url":"https://github.com/limix-ldm-ai/LimiX/releases/tag/V1.1.0","release_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/limix-ldm-ai%2FLimiX/releases/V1.1.0","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/limix-ldm-ai%2FLimiX/tags/V1.1.0"}]