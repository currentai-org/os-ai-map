[{"name":"v1.0.0","uuid":"306062138","tag_name":"v1.0.0","target_commitish":"main","body":"## What's Changed\r\n* feat: support detection-only 300m model by @lkhphuc in https://github.com/tiiuae/Falcon-Perception/pull/4\r\n* Fix MLX memory leak: cap Metal buffer cache and break lazy evaluation by @emrahnazif in https://github.com/tiiuae/Falcon-Perception/pull/3\r\n\r\n## New Contributors\r\n* @lkhphuc made their first contribution in https://github.com/tiiuae/Falcon-Perception/pull/4\r\n* @emrahnazif made their first contribution in https://github.com/tiiuae/Falcon-Perception/pull/3\r\n\r\n**Full Changelog**: https://github.com/tiiuae/Falcon-Perception/commits/v1.0.0","draft":false,"prerelease":false,"immutable":false,"published_at":"2026-04-07T12:02:39.000Z","created_at":"2026-04-27T09:06:51.195Z","author":"lkhphuc","assets":[],"last_synced_at":"2026-09-08T17:01:54.598Z","html_url":"https://github.com/tiiuae/Falcon-Perception/releases/tag/v1.0.0","release_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/tiiuae%2FFalcon-Perception/releases/v1.0.0","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/tiiuae%2FFalcon-Perception/tags/v1.0.0"}]