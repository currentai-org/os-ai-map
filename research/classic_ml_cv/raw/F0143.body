ories/torchgeo%2Ftorchgeo/tags/v0.3.0/manifests"},{"name":"v0.2.1","sha":"af389759c3e6f0dac9838e5984416d9d52103d38","kind":"commit","published_at":"2022-03-19T20:05:18.000Z","download_url":"https://codeload.github.com/torchgeo/torchgeo/tar.gz/v0.2.1","html_url":"https://github.com/torchgeo/torchgeo/releases/tag/v0.2.1","dependencies_parsed_at":null,"dependency_job_id":null,"purl":"pkg:github/torchgeo/torchgeo@v0.2.1","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/torchgeo%2Ftorchgeo/tags/v0.2.1","manifests_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/torchgeo%2Ftorchgeo/tags/v0.2.1/manifests"},{"name":"v0.2.0","sha":"e1285e6cc6b65080e82bdbf7de9dea3f647d8b3b","kind":"commit","published_at":"2022-01-02T00:58:07.000Z","download_url":"https://codeload.github.com/torchgeo/torchgeo/tar.gz/v0.2.0","html_url":"https://github.com/torchgeo/torchgeo/releases/tag/v0.2.0","dependencies_parsed_at":null,"dependency_job_id":null,"purl":"pkg:github/torchgeo/torchgeo@v0.2.0","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/torchgeo%2Ftorchgeo/tags/v0.2.0","manifests_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/torchgeo%2Ftorchgeo/tags/v0.2.0/manifests"},{"name":"v0.1.1","sha":"c2b56148cd38383727436fd46eb0f33fa1593c04","kind":"commit","published_at":"2021-12-19T22:58:13.000Z","download_url":"https://codeload.github.com/torchgeo/torchgeo/tar.gz/v0.1.1","html_url":"https://github.com/torchgeo/torchgeo/releases/tag/v0.1.1","dependencies_parsed_at":null,"dependency_job_id":null,"purl":"pkg:github/torchgeo/torchgeo@v0.1.1","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/torchgeo%2Ftorchgeo/tags/v0.1.1","manifests_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/torchgeo%2Ftorchgeo/tags/v0.1.1/manifests"},{"name":"v0.1.0","sha":"162b6bf4933661e7ba8bfeb557fa2395ee5c426b","kind":"commit","published_at":"2021-11-08T03:02:43.000Z","download_url":"https://codeload.github.com/torchgeo/torchgeo/tar.gz/v0.1.0","html_url":"https://github.com/torchgeo/torchgeo/releases/tag/v0.1.0","dependencies_parsed_at":null,"dependency_job_id":null,"purl":"pkg:github/torchgeo/torchgeo@v0.1.0","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/torchgeo%2Ftorchgeo/tags/v0.1.0","manifests_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/torchgeo%2Ftorchgeo/tags/v0.1.0/manifests"}]},"repo_metadata_updated_at":"2026-09-26T01:36:31.870Z","dependent_packages_count":6,"downloads":42497,"downloads_period":"last-month","dependent_repos_count":4,"rankings":{"downloads":2.404528120234297,"dependent_repos_count":7.6846269967341865,"dependent_packages_count":3.2713415717121803,"stargazers_count":1.6418184293230904,"forks_count":3.608329798463071,"docker_downloads_count":3.253802517774032,"average":3.6440745723734764},"purl":"pkg:pypi/torchgeo","advisories":[{"uuid":"GSA_kwCzR0hTQS1naHE5LXZjNmYtOHFqZs4ABUhy","url":"https://github.com/advisories/GHSA-ghq9-vc6f-8qjf","title":"TorchGeo Remote Code Execution Vulnerability","description":"### Impact\n\nTorchGeo 0.4–0.6.0 used an [`eval`](https://docs.python.org/3/library/functions.html#eval) statement in its model weight API that could allow an unauthenticated, remote attacker to execute arbitrary commands. All platforms that expose [`torchgeo.models.get_weight()`](https://torchgeo.readthedocs.io/en/v0.6.0/api/models.html#torchgeo.models.get_weight) or [`torchgeo.trainers`](https://torchgeo.readthedocs.io/en/v0.6.0/api/trainers.html) as an external API could be affected.\n\n### Patches\n\nThe `eval` statement was replaced with a fixed enum lookup, preventing arbitrary code injection. All users are encouraged to upgrade to TorchGeo 0.6.1 or newer.\n\n### Workarounds\n\nIn unpatched versions, input validation and sanitization can be used to avoid this vulnerability.\n\n### References\n\n#### Bug history\n\n* Introduced: https://github.com/torchgeo/torchgeo/pull/917\n* Patched: https://github.com/torchgeo/torchgeo/pull/2323\n* Released: [v0.6.1](https://github.com/microsoft/torchgeo/releases/tag/v0.6.1)","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2026-04-01T00:03:56.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":8.1,"cvss_vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","references":["https://github.com/torchgeo/torchgeo/security/advisories/GHSA-ghq9-vc6f-8qjf","https://nvd.nist.gov/vuln/detail/CVE-2024-49048","https://github.com/torchgeo/torchgeo/pull/2323","https://github.com/torchgeo/torchgeo/pull/917","https://github.com/torchgeo/torchgeo/commit/1a980788cb7089a1115f3b786c7daa9dd47d7d7a","https://github.com/microsoft/torchgeo/releases/tag/v0.6.1","https://github.com/pypa/advisory-database/tree/main/vulns/torchgeo/PYSEC-2024-204.yaml","https://msrc.microsoft.com/update-guide/vulnerability/CVE-2024-49048","https://github.com/advisories/GHSA-ghq9-vc6f-8qjf"],"source_kind":"github","identifiers":["GHSA-ghq9-vc6f-8qjf","CVE-2024-49048"],"repository_url":null,"blast_radius":0.0,"created_at":"2026-04-01T01:00:11.361Z","updated_at":"2026-09-23T15:04:20.758Z","epss_percentage":0.01239,"epss_percentile":0.67802,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1naHE5LXZjNmYtOHFqZs4ABUhy","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1naHE5LXZjNmYtOHFqZs4ABUhy","packages":[{"ecosystem":"pypi","package_name":"torchgeo","versions":[{"first_patched_version":"0.6.1","vulnerable_version_range":"\u003e= 0.4, \u003c= 0.6.0"}],"purl":"pkg:pypi/torchgeo"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1naHE5LXZjNmYtOHFqZs4ABUhy/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS1nNXZwLWoyNzgtOHBqaM4ABBOz","url":"https://github.com/advisories/GHSA-g5vp-j278-8pjh","title":"Duplicate Advisory: TorchGeo Remote Code Execution Vulnerability","description":"## Duplicate Advisory\n\nThis advisory has been withdrawn because it is a duplicate of GHSA-ghq9-vc6f-8qjf. This link is maintained to preserve external references.\n\n## Original Description\nTorchGeo Remote Code Execution Vulnerability","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2024-11-12T18:30:59.000Z","withdrawn_at":"2026-04-01T00:03:50.000Z","classification":"GENERAL","cvss_score":8.1,"cvss_vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2024-49048","https://msrc.microsoft.com/update-guide/vulnerability/CVE-2024-49048","https://github.com/microsoft/torchgeo/pull/2323","https://github.com/microsoft/torchgeo/releases/tag/v0.6.1","https://github.com/pypa/advisory-database/tree/main/vulns/torchgeo/PYSEC-2024-204.yaml","https://github.com/advisories/GHSA-g5vp-j278-8pjh"],"source_kind":"github","identifiers":["GHSA-g5vp-j278-8pjh"],"repository_url":"https://github.com/microsoft/torchgeo","blast_radius":0.0,"created_at":"2025-01-21T20:09:07.007Z","updated_at":"2026-08-17T16:10:40.101Z","epss_percentage":null,"epss_percentile":null,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1nNXZwLWoyNzgtOHBqaM4ABBOz","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1nNXZwLWoyNzgtOHBqaM4ABBOz","packages":[{"ecosystem":"pypi","package_name":"torchgeo","versions":[{"first_patched_version":"0.6.1","vulnerable_version_range":"\u003e= 0, \u003c 0.6.1"}],"purl":"pkg:pypi/torchgeo"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1nNXZwLWoyNzgtOHBqaM4ABBOz/related_packages","related_advisories":[]}],"docker_usage_url":"https://docker.ecosyste.ms/usage/pypi/torchgeo","docker_dependents_count":3,"docker_downloads_count":252,"usage_url":"https://repos.ecosyste.ms/usage/pypi/torchgeo","dependent_repositories_url":"https://repos.ecosyste.ms/api/v1/usage/pypi/torchgeo/dependencies","status":null,"funding_links":["https://github.com/sponsors/torchgeo"],"critical":null,"issue_metadata":{"last_synced_at":"2026-09-26T01:32