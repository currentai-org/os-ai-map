ademark\":\"Qualcomm AI Hub Apps\",\"companyName\":\"Qualcomm®\",\"companyNameNoTrademark\":\"Qualcomm\",\"genie\":\"Qualcomm® Gen AI Inference Extensions (Genie)\",\"genieNoTrademark\":\"Gen AI Inference Extensions (Genie)\",\"geniexProductName\":\"Qualcomm® AI Hub GenieX\",\"geniexProductNameNoQualcomm\":\"AI Hub GenieX\",\"geniexProductNameNoTrademark\":\"Qualcomm AI Hub GenieX\",\"geniexQairt\":\"GenieX - QAIRT\",\"geniexLlamaCpp\":\"GenieX - llama.cpp\",\"imsdkFullName\":\"Qualcomm® Intelligent Multimedia SDK\",\"imsdkShortName\":\"IM SDK\",\"modelsProductName\":\"Qualcomm® AI Hub Models\",\"modelsProductNameNoQualcomm\":\"AI Hub Models\",\"modelsProductNameNoTrademark\":\"Qualcomm AI Hub Models\",\"onnx\":\"ONNX\",\"onnxRuntime\":\"ONNX Runtime\",\"productDescription\":\"The platform for on-device AI, with optimized open source and licensed models, or bring your own. Validate performance on real Qualcomm devices.\",\"productName\":\"Qualcomm® AI Hub\",\"productNameNoQualcomm\":\"AI Hub\",\"productNameNoTrademark\":\"Qualcomm AI Hub\",\"qaiEngine\":\"Qualcomm® AI Engine\",\"qaiEngineNoTrademark\":\"Qualcomm AI Engine\",\"qais\":\"Qualcomm® AI Stack\",\"qaisNoTrademark\":\"Qualcomm AI Stack\",\"qnn\":\"Qualcomm® AI Runtime\",\"qnnNoTrademark\":\"Qualcomm AI Runtime\",\"qtiNoTrademark\":\"Qualcomm Technologies\",\"snapdragon\":\"Snapdragon®\",\"snapdragonNoTrademark\":\"Snapdragon\",\"snapdragonXElite\":\"Snapdragon® X Elite\",\"snapdragon8Elite\":\"Snapdragon® 8 Elite\",\"snapdragon8EliteGen5\":\"Snapdragon® 8 Elite Gen 5\",\"tflite\":\"TensorFlow Lite\",\"voice_ai\":\"Qualcomm® Voice AI\",\"workbenchProductName\":\"Qualcomm® AI Hub Workbench\",\"workbenchProductNameNoQualcomm\":\"AI Hub Workbench\",\"workbenchProductNameNoTrademark\":\"Qualcomm AI Hub Workbench\"},\"getStarted\":{\"title\":\"Get Started\",\"tabs\":{\"sectionNavigationLabel\":\"Getting started sections\",\"accountSetup\":\"Account Setup\",\"geniex\":\"GenieX\",\"models\":\"Models\",\"apps\":\"Apps\",\"workbench\":\"Workbench\"},\"introduction\":{\"heading\":\"Start developing with {productName}\",\"leadBanner\":\"On‑Device AI Starts Here\",\"intro1\":\"Qualcomm AI Hub is the place to optimize, validate, and deploy any model in a few lines of code for Qualcomm devices. Our four products can be used independently or together as part of your on-device development workflow.\",\"intro2\":\"Follow the walkthrough that best fits your needs:\",\"workflowImageAlt\":\"Qualcomm AI Hub workflow: Models and your own model go through Workbench and GenieX, then deploy to Apps and your own app on device\",\"items\":{\"geniex\":{\"title\":\"Getting started with {geniexProductName}.\",\"desc\":\"Run frontier language and vision-language models locally on Hexagon NPU, Adreno GPU, or CPU with a few lines of code, using the llama.cpp or QAIRT plugin that best fits your deployment.\"},\"models\":{\"title\":\"Getting started with {modelsProductName}.\",\"desc\":\"Browse and download pre-optimized models covering vision, speech, audio, and text applications, validated on Qualcomm® chipsets.\"},\"apps\":{\"title\":\"Getting started with {appsProductName}.\",\"desc\":\"Download and customize sample application code with a model already bundled, ready to deploy on-device. Browse the catalog from the qai-hub-apps CLI or filter by domain, operating system, and more.\"},\"workbench\":{\"title\":\"Getting started with {workbenchProductName}.\",\"desc\":\"Optimize your custom trained model for a target runtime, run inference, and profile on-device performance with a few lines of code. Target 50+ hosted {companyNameNoTrademark} devices, provisioned within minutes.\"}}},\"accountSetup\":{\"sectionHeading\":\"Account Setup\",\"intro\":\"To use AI Hub Workbench and export certain models from AI Hub Models, you will first need to create a Qualcomm ID and authenticate with your AI Hub API token.\",\"createQid\":{\"heading\":\"Create a Qualcomm ID\",\"intro\":\"If you already have a Qualcomm ID, skip this step and use your credentials to log into AI Hub Workbench. Otherwise, navigate to the \u003csignUpLink\u003eQualcomm ID sign up page\u003c/signUpLink\u003e and follow these steps:\",\"steps\":{\"fillInfo\":\"Fill in your information\",\"verifyEmail\":\"Verify your email address\",\"chooseLocation\":\"Choose your work location\"},\"outro\":\"At this point, you will be signed in and directed to your Qualcomm ID Profile page.\"},\"authenticate\":{\"heading\":\"Authenticate with AI Hub\",\"intro\":\"Navigate to your \u003csettingsLink\u003eWorkbench Account Settings page\u003c/settingsLink\u003e. Open a terminal window to complete the rest of your setup:\",\"steps\":{\"install\":\"Install the qai-hub package via PyPi:\",\"configure\":\"Run the following command with the API token from your Settings page:\",\"verify\":\"Verify your token setup by listing the devices we support:\"},\"outro\":\"Now you're ready to get started!\"}},\"geniex\":{\"sectionHeading\":\"Getting Started with {geniexProductNameNoQualcomm}\",\"intro\":\"{geniexProductName} is an on-device Gen AI inference runtime built for Qualcomm devices. Run frontier language and vision-language models locally on Hexagon NPU, Adreno GPU, or CPU with a few lines of code. Learn more about \u003cgeniexLink\u003eGenieX\u003c/geniexLink\u003e and star the \u003cgithubLink\u003eGitHub repo\u003c/githubLink\u003e.\",\"architectureDiagram\":{\"interfaces\":{\"cli\":\"GenieX\\nCLI\",\"python\":\"GenieX\\nPython API\",\"java\":\"GenieX\\nJava API\",\"docker\":\"GenieX\\nDocker\",\"server\":\"GenieX Server\\n(OpenAI / OpenClaw)\"},\"sdk\":\"GenieX SDK\",\"llamaPlugin\":\"GenieX - llama.cpp Plugin\",\"qairtPlugin\":\"GenieX - QAIRT Plugin\",\"ggmlRuntime\":\"GGML Runtime\",\"ggmlCpuKernels\":\"GGML CPU\\nKernels\",\"ggmlGpuKernels\":\"GGML GPU\\nKernels\",\"ggmlHtpKernels\":\"GGML HTP\\nKernels\",\"qairtSdk\":\"Qualcomm® AI Runtime (QAIRT) SDK\",\"cpu\":\"CPU\",\"gpu\":\"GPU\",\"npu\":\"NPU\"},\"steps\":{\"pickEntryPoint\":{\"heading\":\"Pick an entry point\",\"intro\":\"GenieX exposes five entry points over a single SDK. Pick one that best fits your development, then follow the \u003cdocsLink\u003eGenieX docs\u003c/docsLink\u003e.\",\"items\":{\"cli\":\"\u003clink\u003e\u003cstrong\u003eCLI\u003c/strong\u003e\u003c/link\u003e: run and serve models straight from the terminal.\",\"python\":\"\u003clink\u003e\u003cstrong\u003ePython SDK\u003c/strong\u003e\u003c/link\u003e: embed inference in your apps with the Python SDK.\",\"javaKotlin\":\"\u003clink\u003e\u003cstrong\u003eJava/Kotlin\u003c/strong\u003e\u003c/link\u003e: the Android SDK for on-device mobile apps.\",\"linux\":\"\u003clink\u003e\u003cstrong\u003eLinux (Docker)\u003c/strong\u003e\u003c/link\u003e: a containerized image for reproducible deployments for IoTs.\",\"server\":\"\u003clink\u003e\u003cstrong\u003eOpenAI-compatible local server\u003c/strong\u003e\u003c/link\u003e: a drop-in local server for existing OpenAI clients.\"}},\"selectRuntime\":{\"heading\":\"Select a runtime\",\"intro\":\"GenieX ships with two runtimes so you get both broad model coverage and optimal NPU performance on Qualcomm devices in one stack:\",\"items\":{\"qairt\":\"\u003cqairtStrong\u003eQAIRT plugin\u003c/qairtStrong\u003e — runs pre-compiled bundles from \u003caiHubLink\u003eQualcomm AI Hub\u003c/aiHubLink\u003e via the Qualcomm® AI Runtime (QAIRT) for optimal performance on the NPU.\",\"llama\":\"\u003cllamaStrong\u003ellama.cpp plugin\u003c/llamaStrong\u003e — runs community GGUF models from \u003chuggingFaceLink\u003eHugging Face\u003c/huggingFaceLink\u003e on NPU, GPU, or CPU via llama.cpp.\"}},\"firstInference\":{\"heading\":\"Run a model with the CLI\",\"intro\":\"The fastest way to see GenieX in action is the CLI on a Snapdragon X Elite laptop. The example below uses \u003cmodelLink\u003eQwen2.5-VL-7B-Instruct\u003c/modelLink\u003e, a vision-language model available on both GenieX-QAIRT and GenieX-llama.cpp runtimes.\",\"steps\":{\"install\":{\"heading\":\"Install the CLI\",\"body\":\"Download the \u003cinstallerLink\u003eGenieX CLI installer for Windows ARM64\u003c/installerLink\u003e and run the \u003cexeCode\u003e.exe\u003c/exeCode\u003e. Then verify:\"},\"runQairt\":{\"heading\":\"Run on the NPU with the GenieX-QAIRT\",\"body\":\"Paste into CLI and drag an image into the terminal to chat:\"},\"runLlama\":{\"heading\":\"Run a community GGUF with GenieX-llama.cpp\",\"body\":\"Paste into CLI and drag an image into the terminal to chat:\",\"prompt\":\"Choose \u003cprecisionCode\u003eQ4_0\u003c/precisionCode\u003e when prompted for best NPU performance.\",\"callout\":\"New GGUF Models are released daily on Hugging Face. Try them out on-device by swapping the repo path after \u003ccommandCode\u003egeniex infer\u003c/commandCode\u003e.\"}},\"cliOutputAlt\":\"Terminal screenshot of `geniex infer ai-hub-models/Qwen2.5-VL-7B-Instruct` running on a Snapdragon X laptop, showing the model load line, a user prompt with an image attached, and the streamed model response describing the image.\",\"reference\":\"See \u003creferenceLink\u003eCLI reference\u003c/referenceLink\u003e for flags and option.\"},\"localModel\":{\"heading\":\"Run a local model\",\"intro\":\"Already have a model on disk, or want to self-convert a bundle from Hugging Face? Use \u003cpullCode\u003egeniex pull\u003c/pullCode\u003e with \u003clocalPathCode\u003e--local-path\u003c/localPathCode\u003e to register it, then run it like any other model.\",\"see\":\"See:\",\"items\":{\"qaiBundle\":\"\u003clink\u003e\u003cstrong\u003eRun a local Qualcomm AI Engine Direct bundle\u003c/strong\u003e\u003c/link\u003e — self-converted from Hugging Face, an extracted bundle directory, or an AI Hub \u003czipCode\u003e.zip\u003c/zipCode\u003e.\",\"gguf\":\"\u003clink\u003e\u003cstrong\u003eRun a local GGUF model\u003c/strong\u003e\u003c/link\u003e — a directory containing your \u003cggufCode\u003e.gguf\u003c/ggufCode\u003e file.\"}}}},\"models\":{\"sectionHeading\":\"Getting Started with {modelsProductNameNoQualcomm}\",\"intro1\":\"Download an off-the-shelf ML model that works smoothly on your device. Use AI Hub Models to browse and explore over 150 benchmarked, ready-to-run models that have been optimized for Qualcomm devices. Models come with open-source recipes on \u003cgithubLink\u003eGitHub\u003c/githubLink\u003e and \u003chuggingFaceLink\u003eHugging Face\u003c/huggingFaceLink\u003e.\",\"intro2\":\"This flow walks you through steps on how to find, demo, and download a model. For this example, we're choosing an image classification model for the Samsung Galaxy S25 and looking at LiteRT runtime metrics. LiteRT, recently rebranded from TFLite, is the recommended runtime for Android Developers; references to TFLite in AI Hub will be updated over time. These steps can be followed with any of our AI Hub Models.\",\"steps\":{\"findModel\":{\"heading\":\"Find a model\",\"intro\":\"Open \u003cmodelsPageLink\u003eModels\u003c/modelsPageLink\u003e in a new tab. Use the filters on the left side to narrow down our options:\",\"filters\":{\"domainUseCase\":\"Under Domain/Use Case, choose \u003ccv\u003eComputer Vision\u003c/cv\u003e and then \u003cimageClassification\u003eImage Classification\u003c/imageClassification\u003e\",\"device\":\"Under Device, select \u003cdeviceName\u003eSamsung Galaxy S25\u003c/deviceName\u003e\",\"precision\":\"Under Model Precision, select \u003cquantized\u003eQuantized\u003c/quantized\u003e\",\"model\":\"Select the \u003cmodelName\u003eEfficientNet-B0\u003c/modelName\u003e model\"}},\"reviewMetrics\":{\"heading\":\"Review performance metrics\",\"body\":\"From the EfficientNet-B0 model card, choose \u003cfloat\u003efloat\u003c/float\u003e and \u003ctorchscriptToTflite\u003eTFLite\u003c/torchscriptToTflite\u003e to see the associated metrics for the Samsung Galaxy S25. Benchmarks are run every two weeks to ensure up-to-date model metrics across applicable runtimes.\"},\"demoLocally\":{\"heading\":\"Demo the model locally\",\"intro\":\"Follow the GitHub Model Repository link from the EfficientNet-B0 model card page and scroll down to the \u003cexampleUsage\u003eExample \u0026 Usage\u003c/exampleUsage\u003e section to find these commands to test the model from your CLI:\",\"commands\":{\"install\":\"Install qai-hub-models and the model:\",\"run\":\"Run the demo\",\"checkOutputPrefix\":\"Check the demo output against the default \",\"checkOutputLinkText\":\"test image\",\"checkOutputSuffix\":\".\",\"tryOwnImage\":\"Try running the model against one of your own images by setting \u003cimgPath\u003eIMGPATH\u003c/imgPath\u003e in the command below:\"}},\"demoOnDevice\":{\"heading\":\"(Optional) Demo the model on device\",\"intro\":\"Export the model to auto-optimize it for on-device execution, then run the demo on a device. This step uses Workbench under the hood — if you haven't already, create a Workbench account following the instructions in \u003caccountSetupLink\u003eAccount Setup\u003c/accountSetupLink\u003e before diving in.\",\"steps\":{\"export\":{\"body\":\"\u003cexportStrong\u003eExport the model.\u003c/exportStrong\u003e This automatically runs profile and inference jobs on the model and prints out the results to the CLI. Click the job links in the printout to review full results.\"},\"runOnDevice\":{\"p1\":\"\u003crunStrong\u003eRun on device.\u003c/runStrong\u003e The last line of the previous step prints out a command for running the compiled model on a hosted device on sample data. Copy and paste the command, editing the device name as needed, then submit the job.\",\"p2\":\"Verify the on-device model predictions that are printed out, then follow the inference job URL to see how your model performed on device.\",\"imageAlt\":\"Screenshot of an Inference Job page from AI Hub Workbench.\"},\"demoHelp\":\"To see complete options for the demo script, run:\"}},\"downloadModel\":{\"heading\":\"Download model\",\"body\":\"Happy with the performance? Click \u003cdownloadStrong\u003eDownload Model\u003c/downloadStrong\u003e, select the \u003ctfliteStrong\u003eTFLite\u003c/tfliteStrong\u003e runtime, and download the model.\"}},\"notes\":{\"exportWithAIHub\":\"Export with AI Hub\",\"requiresExport\":\"Some models require exporting the model through AI Hub Workbench. To access models that require \\\"{exportWithAIHub}\\\", make sure that you've finished your \u003caccountSetupLink\u003eAccount Setup\u003c/accountSetupLink\u003e.\",\"extraCredit\":\"Extra Credit: Want to bundle this model into an app to deploy to your Samsung Galaxy S25 device? Keep going with the \u003cappsSectionLink\u003eApps section\u003c/appsSectionLink\u003e!\"}},\"apps\":{\"sectionHeading\":\"Getting Started with {appsProductNameNoQualcomm}\",\"intro1\":\"One of the hardest parts of deploying on device is getting from a model to something that actually runs on the device. {appsProductNameNoQualcomm} bridges that gap with sample application code for a variety of on-device use cases, runtimes, and operating systems.\",\"intro2\":\"The \u003ccliCode\u003eqai-hub-apps\u003c/cliCode\u003e CLI is the fastest way in. Browse the catalog, inspect what an app supports, and download an app with a compatible model already bundled in the right place — all from your terminal.\",\"intro3\":\"This walkthrough deploys the {appName} app to an Android device, so you'll need \u003candroidStudioLink\u003eAndroid Studio\u003c/androidStudioLink\u003e (2023.1.1 or later) and an Android device on hand. Every CLI step below works the same way for any app in the catalog.\",\"steps\":{\"installCli\":{\"heading\":\"Install the CLI\",\"body\":\"The CLI is published on PyPI and needs Python 3.10 or newer. Install it, then confirm it's on your path:\"},\"findApp\":{\"heading\":\"Find an app\",\"intro\":\"Start with the full catalog:\",\"filtersIntro\":\"Filters narrow it down, and mirror the facets on the \u003cappsPageLink\u003eApps\u003c/appsPageLink\u003e page. Different flags are ANDed, values within one flag are ORed, and matching is case-insensitive:\",\"filters\":{\"type\":\"\u003cflag\u003e--type\u003c/flag\u003e — operating system: android, windows, or ubuntu\",\"runtime\":\"\u003cflag\u003e--runtime\u003c/flag\u003e — inference runtime: tflite, onnx, or genie\",\"domainUseCase\":\"\u003cflag\u003e--domain\u003c/flag\u003e and \u003cflag\u003e--use-case\u003c/flag\u003e — for example Computer Vision and Image Classification\",\"language\":\"\u003cflag\u003e--language\u003c/flag\u003e — implementation language: Python, C++, Java, Kotlin, or Go\",\"precision\":\"\u003cflag\u003e--precision\u003c/flag\u003e — model precision: float, w8a8, or w4a16\",\"model\":\"\u003cflag\u003e--model\u003c/flag\u003e — a model the app supports, matched as a substring: mobilenet, whisper, llama\"},\"example\":\"For this walkthrough, narrow the catalog to the Android image classification apps that run on TFLite:\",\"runtimeNote\":{\"prompt\":\"Unsure what runtime to target? We recommend choosing the runtime based on the type of device you're working with:\",\"items\":{\"tflite\":\"{tflite} for Mobile and IoT\",\"onnx\":\"{onnx} for Compute\",\"qnn\":\"{qnn} for Auto\"}}},\"inspectApp\":{\"heading\":\"Inspect the app\",\"body\":\"Before downloading anything, check what the app supports. \u003cinfoCode\u003einfo\u003c/infoCode\u003e prints its runtime, languages, precision, the models it can bundle, the devices it has been tested on, and a link to its source on GitHub:\",\"note\":\"Note the \u003cmodelsField\u003eModels\u003c/modelsField\u003e and \u003cdevicesField\u003eSupported Devices\u003c/devicesField\u003e fields — the \u003cmodelFlag\u003e--model\u003c/modelFlag\u003e and \u003cdeviceFlag\u003e--device\u003c/deviceFlag\u003e values you pass in the next step have to come from those lists.\"},\"fetchApp\":{\"heading\":\"Fetch the app and a model\",\"intro\":\"\u003cfetchCode\u003efetch\u003c/fetchCode\u003e downloads an app's source into a directory named after the app, in the current directory or wherever \u003coutputDirFlag\u003e--output-dir\u003c/outputDirFlag\u003e points. Pass a model as well and the CLI downloads it and places it exactly where the app expects to find it, so there is nothing to copy by hand. The path to the fetched app is printed when it finishes.\",\"steps\":{\"withModel\":\"\u003cwithModelStrong\u003eFetch the app with a model.\u003c/withModelStrong\u003e This bundles the TFLite build of {modelName} into the app for you:\",\"targetDevice\":\"\u003ctargetStrong\u003eTarget a specific device.\u003c/targetStrong\u003e Without a target you get the app's default model build. Pass \u003cdeviceFlag\u003e--device\u003c/deviceFlag\u003e with one of the app's supported devices — or \u003cchipsetFlag\u003e--chipset\u003c/chipsetFlag\u003e with a chipset — to bundle a build compiled for that hardware instead:\",\"localModel\":\"\u003clocalStrong\u003eBundle a model you exported yourself.\u003c/localStrong\u003e Coming from the \u003cmodelsSectionLink\u003eModels\u003c/modelsSectionLink\u003e or \u003cworkbenchSectionLink\u003eWorkbench\u003c/workbenchSectionLink\u003e flows, or working with a model that has to be exported through Workbench? Point \u003cmodelPathFlag\u003e--model-path\u003c/modelPathFlag\u003e at your exported model directory or \u003czipCode\u003e.zip\u003c/zipCode\u003e instead of naming a model ID:\",\"appOnly\":\"\u003cappOnlyStrong\u003eFetch the source on its own.\u003c/appOnlyStrong\u003e Leave the model flags off to get just the app code, and add a model yourself later:\"}},\"buildApp\":{\"heading\":\"Build app\",\"intro\":\"The fetched directory has everything needed to build the Android app, with the model already in place. All that is left is to open it and build:\",\"steps\":{\"sync\":\"\u003csyncStrong\u003eSync.\u003c/syncStrong\u003e Load Android Studio and open the fetched \u003cfolderStrong\u003eimage_classification_android\u003c/folderStrong\u003e folder. Once the folder is fully loaded, run gradle sync (\u003cmenuStrong\u003eFile→Sync Project with Gradle Files\u003c/menuStrong\u003e).\",\"build\":\"\u003cbuildStrong\u003eBuild for target.\u003c/buildStrong\u003e Build the project (\u003cmenuStrong\u003eBuild→Make Project\u003c/menuStrong\u003e) and confirm that it completes without errors.\"}},\"runOnDevice\":{\"heading\":\"Run app on device\",\"body\":\"Follow the \u003candroidDeviceSetupLink\u003eAndroid Studio setup instructions\u003c/androidDeviceSetupLink\u003e for connecting to your Android device, make sure the app's run configuration is selected, and click \u003crunStrong\u003eRun\u003c/runStrong\u003e from the Android Studio toolbar.\"},\"customize\":{\"heading\":\"(Optional) Customize!\",\"body\":\"Every fetched app ships with its own \u003creadmeStrong\u003eREADME.md\u003c/readmeStrong\u003e — also browsable \u003creadmeLink\u003eon GitHub\u003c/readmeLink\u003e — covering what that app's code supports today. Use our code as a starting point and modify as needed to support your use case.\"}},\"extraCredit\":\"{appsProductNameNoQualcomm} are a new addition to AI Hub. We'd love to hear your feedback and ideas on how we can make it easier to deploy on-device — reach out by joining our \u003cslackLink\u003eSlack community\u003c/slackLink\u003e!\"},\"workbench\":{\"sectionHeading\":\"Getting Started with {workbenchProductNameNoQualcomm}\",\"intro1\":\"Optimize a trained model for your device. Bring an open source or custom trained model to Workbench and specify your target device and runtime for automated conversion and translation into a model ready for efficient on-device deployment.\",\"workflowImageAlt\":\"AI Hub Workbench workflow diagram showing the inputs, outputs, and supported formats.\",\"intro2\":\"Workbench can be used to quantize models and run inference on cloud-hosted Qualcomm devices for easy experimentation, allowing you to iteratively validate and profile to reach the ideal balance of speed, accuracy, and memory usage for your use case.\",\"intro3\":\"In this flow, we are optimizing the open source MobileNet model for the Samsung Galaxy S25 (Family), which uses a TFLite runtime. If you haven't already, create a Workbench account following the instructions in \u003caccountSetupLink\u003eAccount Setup\u003c/accountSetupLink\u003e before diving in.\",\"steps\":{\"setupDependencies\":{\"heading\":\"Set up dependencies\",\"body\":\"Open your preferred Python IDE and install any packages needed. For the MobileNet model, you can install the dependencies from AI Hub Models with this line:\"},\"importAndExport\":{\"heading\":\"Import and export model\",\"body\":\"Workbench requires an exported model for compilation. We can load this pre-trained MobileNet model, put it into eval mode, and export it with \u003ctorchExportCode\u003etorch.export.export\u003c/torchExportCode\u003e. If you are bringing a custom trained model that has already been exported, you can skip the export step!\"},\"selectDeviceAndCompile\":{\"heading\":\"Select device and compile\",\"body\":\"Import Workbench, set your target device, and compile the model for TFLite. Behind the scenes, Workbench optimizes the model to work with the Qualcomm AI Stack. Follow the compile job link to access the output model, parameters, logs, and more. All jobs are all saved to your Workbench dashboard for future reference.\"},\"submitInference\":{\"heading\":\"Submit an inference job\",\"body\":\"Test your model on device. We'll set up the input image and run on a real cloud-hosted device — be patient with the provisioning and setup! You can click into the inference job link to see the minimum inference time and estimated peak memory usage through the Workbench web UI.\"},\"validateAccuracy\":{\"heading\":\"Validate model accuracy\",\"body\":\"Post-process the on-device output to check the results against the \u003cinputImageLink\u003einput image\u003c/inputImageLink\u003e.\"},\"profileOnDevice\":{\"heading\":\"Profile on-device\",\"body\":\"The inference predictions seem reasonable, so let's move on to checking how the model performs on the device with a profile job. Follow the profile job link to double check that your model is using the expected compute unit (in this case, the NPU) and explore detailed metrics such as compilation time, first app load time, memory consumption, inference time, per-layer runtime analysis, and more.\",\"imageAlt\":\"Screenshot of a profile job on AI Hub Workbench showing active NPU usage.\",\"note\":\"Unhappy with the model accuracy? Consider trying a different precision, re-training your model, or starting from the beginning, with a different open source model.\"},\"quantizeModel\":{\"heading\":\"(Optional) Quantize your model\",\"intro\":\"Do your profile job results show too much memory consumption? If you're using an open source model, consider quantizing your model to make it smaller.\",\"steps\":{\"compileToOnnx\":{\"body\":\"\u003ccompileStrong\u003eCompile to ONNX.\u003c/compileStrong\u003e Workbench quantize jobs require a compiled ONNX model as an input. Even if your model is already in ONNX format, compiling this way will ensure optimized patterns for quantization.\"},\"loadCalibration\":{\"body\":\"\u003cloadStrong\u003eLoad and pre-process calibration data.\u003c/loadStrong\u003e For this example, we'll use 100 sample images from the PyTorch Imagenette dataset as our calibration data. Generally, we recommend using 500-1000 samples. Before running the code below, first download \u003cimagenetteZipLink\u003eimagenette_samples.zip\u003c/imagenetteZipLink\u003e and unzip it in your local directory.\"},\"submitQuantize\":{\"body\":\"\u003csubmitStrong\u003eSubmit a quantize job.\u003c/submitStrong\u003e Now we’re ready to run the quantize job, in this case quantizing to INT8.\"},\"compileToTarget\":{\"body\":\"\u003ccompileStrong\u003eCompile to your target runtime.\u003c/compileStrong\u003e Quantized models can be compiled to any runtime; compile for TFLite runtime to support your mobile device.\"},\"validate\":{\"p1\":\"\u003cvalidateStrong\u003eValidate accuracy and performance.\u003c/validateStrong\u003e Evaluate this quantized model for accuracy and performance by repeating steps 4-6 (submitting an inference job, checking accuracy, and submitting a profile job) from above.\",\"p2\":\"If the accuracy or performance is not meeting your needs, you can also re-quantize the model at a \u003chigherPrecisionLink\u003ehigher precision\u003c/higherPrecisionLink\u003e. If you are bringing a custom-trained model, we suggest quantizing with your own compute resources using Qualcomm's PyTorch ONNX \u003caimetLink\u003eAI Model Efficiency Toolkit (AIMET)\u003c/aimetLink\u003e prior to running a Workbench compile job to optimize for your device.\"}}},\"downloadOptimized\":{\"heading\":\"Download optimized model\",\"body\":\"If everything looks good, download your freshly optimized model to your machine.\"}},\"notes\":{\"extraCredit\":\"Extra Credit: Want to bundle this model into an app to deploy to your Samsung Galaxy S25 device? Keep going with the \u003cappsSectionLink\u003eApps section\u003c/appsSectionLink\u003e!\",\"llm\":{\"label\":\"Note:\",\"body\":\"Large language models (LLMs) are, by definition, large — meaning that they require extra considerations when being deployed on memory-constrained devices. If you're working with a LLM, we recommend following the \u003cllmTutorialLink\u003eGenieX Docs\u003c/llmTutorialLink\u003e.\"}}},\"deploymentInfographic\":{\"titles\":{\"models\":\"Models\",\"apps\":\"Apps\",\"workbench\":\"Workbench\"},\"verbs\":{\"bundle\":\"Bundle\",\"customize\":\"Customize\",\"deploy\":\"Deploy\",\"deployAdditionalOnDevice\":\"on device\",\"upload\":\"Upload\",\"uploadAdditional\":\"a custom\\ntrained model\",\"download\":\"Download\",\"downloadTrainedAdditional\":\"a trained\\nmodel\",\"downloadOptimizedAdditional\":\"an optimized\\nmodel\",\"cycleCompile\":\"Compile\",\"cycleQuantize\":\"Quantize\",\"cycleValidate\":\"Validate\",\"cycleValidateAdditionalOnDevice\":\"on device\",\"cycleProfile\":\"Profile\",\"cycleProfileAdditionalOnDevice\":\"on device\"}}}},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":\"$L2b\"}]\n"])</script><script>self.__next_f.push([1,"29:[\"$\",\"$L2a\",null,{\"formats\":\"$undefined\",\"locale\":\"en-US\",\"messages\":\"$27:props:messages\",\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":[\"$\",\"$L2c\",null,{\"children\":[[\"$\",\"$L2d\",null,{}],[\"$\",\"$L2e\",null,{}],[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[[\"$\",\"$L6\",null,{}],[\"$\",\"main\",null,{\"className\":\"flex min-h-[60vh] flex-col items-center justify-center px-4 py-24 text-center\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"mb-4 font-brand text-4xl\",\"children\":\"Page Not Found\"}],[\"$\",\"p\",null,{\"className\":\"mb-12 max-w-xl text-lg\",\"children\":[\"The page you're looking for doesn't exist. You can always return to\",\" \",[\"$\",\"$L2f\",null,{\"href\":\"/\",\"className\":\"text-brand hover:underline\",\"analyticsEvent\":{\"event\":\"cta\",\"eventInfo\":{\"action\":\"click\",\"label\":\"Qualcomm® AI Hub\",\"location\":\"/\"}},\"children\":\"Qualcomm® AI Hub\"}],\" \",\"home page to explore our models and apps!\"]}],[\"$\",\"div\",null,{\"className\":\"w-full max-w-4xl\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-8 font-brand text-2xl\",\"children\":\"Popular Entry Points\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-8 md:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-brand text-xl text-primary\",\"children\":\"Model Worlds\"}],[\"$\",\"div\",null,{\"className\":\"flex f