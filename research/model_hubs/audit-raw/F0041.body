    <script type="text/javascript" nonce="c54485498fbc9357b5557a827a650386">
    // SIZE #header-space TO THE REAL HEADER HEIGHT IMMEDIATELY, RATHER THAN WAITING FOR THE
    // window.load EVENT (SALIENT'S headerSpace() DOESN'T RUN UNTIL THEN). THE STATIC 90px
    // DEFAULT IN style.css DOESN'T ACCOUNT FOR THE NOTIFICATIONS BAR, SO WITHOUT THIS THE
    // PAGE VISIBLY JUMPS ONCE ALL ASSETS FINISH LOADING AND SALIENT CORRECTS IT LATE.
    (function () {
        var headerEl = document.getElementById('header-outer');
        var spaceEl = document.getElementById('header-space');
        if (headerEl && spaceEl) {
            spaceEl.style.height = headerEl.clientHeight + 'px';
        }
    })();
    </script>
