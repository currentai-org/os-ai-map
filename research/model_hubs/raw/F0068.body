<script>
  document.addEventListener('DOMContentLoaded', function() {
    const formSearch = htmx.find('#form-input');
    const navSearch = htmx.find('#navbar-input');
    const mobileSortSelect = htmx.find('#mobile-sort-select');
    const desktopSortSelect = htmx.find('#desktop-sort-select');

    if (!formSearch || !navSearch) return;

    [formSearch, navSearch].forEach(input => {
      if (input.value) {
        input.setSelectionRange(input.value.length, input.value.length);
      }
    });

    function updateInputStates() {
      const isDesktop = window.innerWidth >= 1024;
      formSearch.disabled = isDesktop;
      navSearch.disabled = !isDesktop;

      if(isDesktop) {
        navSearch.focus();
      } else {
        formSearch.focus();
      }
    }

    updateInputStates();

    window.addEventListener('resize', updateInputStates);

    
    if (mobileSortSelect && desktopSortSelect) {
      mobileSortSelect.value = desktopSortSelect.value;
    }
  });
</script>

<main class="mx-auto flex w-full max-w-2xl flex-col px-6 py-5 md:py-12 lg:px-8">
