      hx-on::after-swap="
        const title = this.querySelector('[data-seo=title]');
        const description = this.querySelector('[data-seo=description]');

        if (title) {
          document.title = title.textContent;
        }
        if (title && description) {
          document.querySelector('meta[property=\'og:title\']').setAttribute('content', title.textContent);
          document.querySelector('meta[property=\'og:description\']').setAttribute('content', description.textContent);

          document.querySelector('meta[property=\'twitter:title\']').setAttribute('content', title.textContent);
          document.querySelector('meta[property=\'twitter:description\']').setAttribute('content', description.textContent);

          document.querySelector('meta[name=\'description\']').setAttribute('content', description.textContent);
        }
      "
    >
      
