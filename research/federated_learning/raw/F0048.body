%2Fhydrogen","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/OpenMined%2FPySyft/tags/PySyft%2Fhydrogen","manifests_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/OpenMined%2FPySyft/tags/PySyft%2Fhydrogen/manifests"}]},"repo_metadata_updated_at":"2026-09-25T14:35:24.621Z","dependent_packages_count":0,"downloads":4941,"downloads_period":"last-month","dependent_repos_count":56,"rankings":{"downloads":3.7132779853546403,"dependent_repos_count":1.9657485011019566,"dependent_packages_count":7.381897931361508,"stargazers_count":0.26403513622396185,"forks_count":0.34598725913279904,"docker_downloads_count":2.22543900531625,"average":2.649397636415186},"purl":"pkg:pypi/syft","advisories":[{"uuid":"GSA_kwCzR0hTQS1jZnBnLWM5NzQtamZocc4ABWtZ","url":"https://github.com/advisories/GHSA-cfpg-c974-jfhq","title":"PySyft server-side arbitrary Python execution after code approval","description":"PySyft (Syft Datasite/Server) versions 0.9.5 and earlier are vulnerable to remote code execution due to insufficient validation and sandboxing of user-submitted code. The system allows low-privileged users to submit Python functions (via @sy.syft_function()) for remote execution on the server. While a code approval mechanism exists, the submitted code undergoes no security checks for dangerous operations (e.g., file access, command execution). Once approved, the code is executed within the server process using exec() and eval() functions without proper isolation. A remote attacker can leverage this to execute arbitrary Python code on the server, leading to complete compromise of the server environment.","origin":"UNSPECIFIED","severity":"CRITICAL","published_at":"2026-05-12T18:30:38.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":9.8,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","references":["https://nvd.nist.gov/vuln/detail/CVE-2026-31220","https://www.notion.so/CVE-2026-31220-35d1e1393188814186b9e00114a8aba7","https://github.com/advisories/GHSA-cfpg-c974-jfhq"],"source_kind":"github","identifiers":["GHSA-cfpg-c974-jfhq","CVE-2026-31220"],"repository_url":null,"blast_radius":0.0,"created_at":"2026-05-18T21:00:16.632Z","updated_at":"2026-09-25T12:03:35.853Z","epss_percentage":0.01198,"epss_percentile":0.66766,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1jZnBnLWM5NzQtamZocc4ABWtZ","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1jZnBnLWM5NzQtamZocc4ABWtZ","packages":[{"ecosystem":"pypi","package_name":"syft","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003c= 0.9.5"}],"purl":"pkg:pypi/syft"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1jZnBnLWM5NzQtamZocc4ABWtZ/related_packages","related_advisories":[]}],"docker_usage_url":"https://docker.ecosyste.ms/usage/pypi/syft","docker_dependents_count":3,"docker_downloads_count":420,"usage_url":"https://repos.ecosyste.ms/usage/pypi/syft","dependent_repositories_url":"https://repos.ecosyste.ms/api/v1/usage/pypi/syft/dependencies","status":null,"funding_links":["https://github.com/sponsors/openmined","https://github.com/sponsors/OpenMined"],"critical":null,"issue_metadata":{"last_synced_at":"2026-09-24T10:00:26.601Z","issues_count":170,"pull_requests_count":2461,"avg_time_to_close_issue":15226336.9375,"avg_time_to_close_pull_request":1026673.6367384334,"issues_closed_count":128,"pull_requests_closed_count":2183,"pull_request_authors_count":101,"issue_authors_count":100,"avg_comments_per_issue":1.9764705882352942,"avg_comments_per_pull_request":0.7208451848841935,"merged_pull_requests_count":1730,"bot_issues_count":0,"bot_pull_requests_count":70,"past_year_issues_count":7,"past_year_pull_requests_count":111,"past_year_avg_time_to_close_issue":11910886.5,"past_year_avg_time_to_close_pull_request":1470567.1075268816,"past_year_issues_closed_count":2,"past_year_pull_requests_closed_count":93,"past_year_pull_request_authors_count":1