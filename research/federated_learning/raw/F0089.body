pg2-binary>=2.9.10","opentelemetry-api","opentelemetry-sdk","opentelemetry-exporter-otlp"],"requires_python":"<3.13,>=3.9","summary":"Scaleout Federated Learning","version":"0.33.0","yanked":false,"yanked_reason":null},"last_serial":31258255,"ownership":{"organization":null,"roles":[{"role":"Owner","user":"fwrede"},{"role":"Owner","user":"mcapuccini"},{"role":"Owner","user":"morganekmefjord"},{"role":"Owner","user":"stefanhellander"}]},"releases":{"0.10.0":[{"comment_text":"","core-metadata":{"sha256":"13542f1e7fa8116a6a14ce8488e7655a54dfb106670b43835fc9130fc72d9f0e"},"digests":{"blake2b_256":"b3dfcc3a9c85a05c7d9a10b623cb2c2193698ca3f1c26ed76aeed5ab4fc70e02","md5":"54c6ad234ae77bae500342e6d59d8822","sha256":"6d652f025ee52818cfc85c1179689cf93ea8012cd51c060d16ee0d9ea6b02e1a"},"downloads":-1,"filename":"fedn-0.10.0-py3-none-any.whl","has_sig":false,"md5_digest":"54c6ad234ae77bae500342e6d59d8822","packagetype":"bdist_wheel","python_version":"py3","requires_python":"<3.13,>=3.8","size":171490,"upload_time":"2024-06-14T11:39:25","upload_time_iso_8601":"2024-06-14T11:39:25.616284Z","url":"https://files.pythonhosted.org/packages/b3/df/cc3a9c85a05c7d9a10b623cb2c2193698ca3f1c26ed76aeed5ab4fc70e02/fedn-0.10.0-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":"","core-metadata":false,"digests":{"blake2b_256":"8c89e6db357bd68659b0d91c0e40a183aeee8c7dbea10230461bde1df1c95ea0","md5":"49fb7fc53136db32f89adaabcc22f774","sha256":"29bcc99e826dc4ae9ece23c0e4fcadcaab8ed9a7894624cd6c26412338996f55"},"downloads":-1,"filename":"fedn-0.10.0.tar.gz","has_sig":false,"md5_digest":"49fb7fc53136db32f89adaabcc22f774","packagetype":"sdist","python_version":"source","requires_python":"<3.13,>=3.8","size":125342,"upload_time":"2024-06-14T11:39:27","upload_time_iso_8601":"2024-06-14T11:39:27.733125Z","url":"https://files.pythonhosted.org/packages/8c/89/e6db357bd68659b0d91c0e40a183aeee8c7dbea10230461bde1df1c95ea0/fedn-0.10.0.tar.gz","yanked":false,"yanked_reason":null}],"0.11.0":[