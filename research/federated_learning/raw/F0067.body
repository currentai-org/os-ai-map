pkg:github/vantage6/vantage6@version%2F3.3.0rc1","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/vantage6%2Fvantage6/tags/version%2F3.3.0rc1","manifests_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/vantage6%2Fvantage6/tags/version%2F3.3.0rc1/manifests"},{"name":"version/0.0.0b3","sha":"ba32adcb55be36b144006259968b81c79915de3c","kind":"commit","published_at":"2022-05-16T09:16:18.000Z","download_url":"https://codeload.github.com/vantage6/vantage6/tar.gz/version/0.0.0b3","html_url":"https://github.com/vantage6/vantage6/releases/tag/version/0.0.0b3","dependencies_parsed_at":null,"dependency_job_id":null,"purl":"pkg:github/vantage6/vantage6@version%2F0.0.0b3","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/vantage6%2Fvantage6/tags/version%2F0.0.0b3","manifests_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/vantage6%2Fvantage6/tags/version%2F0.0.0b3/manifests"}]},"repo_metadata_updated_at":"2026-09-25T21:16:37.372Z","dependent_packages_count":3,"downloads":4113,"downloads_period":"last-month","dependent_repos_count":9,"rankings":{"downloads":4.900600311131047,"dependent_repos_count":4.859458066486595,"dependent_packages_count":3.1506104021304417,"stargazers_count":14.843177376007818,"forks_count":11.412694897912436,"docker_downloads_count":null,"average":7.833308210733668},"purl":"pkg:pypi/vantage6","advisories":[{"uuid":"GSA_kwCzR0hTQS00N3c2LWd3cDQtdzZ2Y84ABftM","url":"https://github.com/advisories/GHSA-47w6-gwp4-w6vc","title":"vantage6: Algorithm developer can edit another developer's algorithm that is pending / under review","description":"### Impact\nEdit permission lacks ownership check, so another developer could alter metadata that is later trusted by nodes. \n\nWorst they could do is update the image or image tag. If that is not noted, another image is approved than the one actually under review\n\n### Patches\nNo\n\n### Workarounds\nNo","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2026-07-24T21:49:36.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":7.1,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:N/VI:H/VA:N/SC:N/SI:N/SA:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-47w6-gwp4-w6vc","https://github.com/advisories/GHSA-47w6-gwp4-w6vc"],"source_kind":"github","identifiers":["GHSA-47w6-gwp4-w6vc","CVE-2026-73652"],"repository_url":null,"blast_radius":0.0,"created_at":"2026-07-24T22:00:08.726Z","updated_at":"2026-09-25T12:01:30.257Z","epss_percentage":0.00351,"epss_percentile":0.25932,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS00N3c2LWd3cDQtdzZ2Y84ABftM","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS00N3c2LWd3cDQtdzZ2Y84ABftM","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":null,"vulnerable_version_range":"\u003c= 5.0.2"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS00N3c2LWd3cDQtdzZ2Y84ABftM/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS14OWY2LTlydm0tbW1yZ84ABYNS","url":"https://github.com/advisories/GHSA-x9f6-9rvm-mmrg","title":"vantage6 node has an Improper Access Control issue","description":"### Impact\nMalicious algorithms can potentially access other algorithms input and output files.\n\n### Patches\nTodo\n\n### Workarounds\nVerify and restrict the algorithm containers that are allowed to run on your node. See [here](https://docs.vantage6.ai/usage/running-the-node/security) on how to do this.\n\n### References\nhttps://docs.vantage6.ai/usage/running-the-node/security\n\n### For more information\nIf you have any questions or comments about this advisory:\n* Email us at [vantage6@iknl.nl](mailto:vantage6@iknl.nl)","origin":"UNSPECIFIED","severity":"MODERATE","published_at":"2026-06-05T16:45:45.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":6.9,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-x9f6-9rvm-mmrg","https://github.com/vantage6/vantage6/issues/1932","https://nvd.nist.gov/vuln/detail/CVE-2026-54533","https://docs.vantage6.ai/usage/running-the-node/security","https://github.com/vantage6/vantage6/blob/main/docs/release_notes.rst#500","https://github.com/advisories/GHSA-x9f6-9rvm-mmrg"],"source_kind":"github","identifiers":["GHSA-x9f6-9rvm-mmrg","CVE-2026-54533"],"repository_url":null,"blast_radius":0.0,"created_at":"2026-06-05T17:00:08.844Z","updated_at":"2026-09-25T12:02:57.893Z","epss_percentage":0.00496,"epss_percentile":0.39916,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS14OWY2LTlydm0tbW1yZ84ABYNS","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS14OWY2LTlydm0tbW1yZ84ABYNS","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"5.0.0","vulnerable_version_range":"\u003c 5.0.0"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS14OWY2LTlydm0tbW1yZ84ABYNS/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS1mZ21jLTJocWotODZ2NM4ABYNR","url":"https://github.com/advisories/GHSA-fgmc-2hqj-86v4","title":"Vantage6: Set admin user and password from environment or configuration","description":"### Impact\nVantage6 currently provides an initial user with username `root` and password `root`. This is not ideal for the following reasons:\n- Attackers know that almost all vantage6 servers have a user with username `root` that probably has admin rights\n- The initial password is very weak and it is possible that administrators forget to reset it.\n\n### Patches\nNo\n\n### Workarounds\nIt is possible to delete the `root` user after it has been used to create other users\n\n### References\nWe could consider doing this like [mongodb](https://hub.docker.com/_/mongo)\n\n### Additional info\n\nLuis uses the following patch to mitigate it:\n```diff\ndiff --git a/vantage6-server/vantage6/server/__init__.py b/vantage6-server/vantage6/server/__init__.py\nindex ea362c1e..c6dcbbd9 100644\n--- a/vantage6-server/vantage6/server/__init__.py\n+++ b/vantage6-server/vantage6/server/__init__.py\n@@ -618,18 +618,30 @@ class ServerApp:\n             # TODO use constant instead of 'Root' literal\n             root = db.Role.get_by_name(\"Root\")\n \n-            log.warn(\n-                f\"Creating root user: \"\n-                f\"username={SUPER_USER_INFO['username']}, \"\n-                f\"password={SUPER_USER_INFO['password']}\"\n-            )\n+            # Temporary patch\n+            # read initial root password from file (docker secret) if provided\n+            # TODO: This is a workaround so we don't have an insecure vserver\n+            #       at the start. Ideally, we would provide an already hashed\n+            #       password. But as hashing is implemented via @validates on\n+            #       the field 'password', there isn't a nice way around this.\n+            if os.environ.get(\"V6_INITIAL_ROOT_PASSWORD_FILE\"):\n+                with open(\n+                    os.environ.get(\"V6_INITIAL_ROOT_PASSWORD_FILE\")\n+                ) as password_file:\n+                    initial_root_password = password_file.read().strip()\n+                log.info(\n+                    f\"Creating root user with password provided via V6_INITIAL_ROOT_PASSWORD_FILE\"\n+                )\n+            else:\n+                initial_root_password = SUPER_USER_INFO[\"password\"]\n+                log.warn(f\"Creating root user with default credentials!\")\n \n             user = db.User(\n                 username=SUPER_USER_INFO[\"username\"],\n                 roles=[root],\n                 organization=org,\n                 email=\"root@domain.ext\",\n-                password=SUPER_USER_INFO[\"password\"],\n+                password=initial_root_password,\n                 failed_login_attempts=0,\n                 last_login_attempt=None,\n             )\n```","origin":"UNSPECIFIED","severity":"MODERATE","published_at":"2026-06-05T16:45:22.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":6.9,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:L/VI:L/VA:L/SC:N/SI:N/SA:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-fgmc-2hqj-86v4","https://github.com/vantage6/vantage6/issues/1932","https://nvd.nist.gov/vuln/detail/CVE-2026-54445","https://github.com/vantage6/vantage6/blob/main/docs/release_notes.rst#500","https://github.com/advisories/GHSA-fgmc-2hqj-86v4"],"source_kind":"github","identifiers":["GHSA-fgmc-2hqj-86v4","CVE-2026-54445"],"repository_url":null,"blast_radius":0.0,"created_at":"2026-06-05T17:00:08.844Z","updated_at":"2026-09-25T12:03:14.206Z","epss_percentage":0.0048,"epss_percentile":0.38737,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1mZ21jLTJocWotODZ2NM4ABYNR","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1mZ21jLTJocWotODZ2NM4ABYNR","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"5.0.0","vulnerable_version_range":"\u003c= 4.2.3"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1mZ21jLTJocWotODZ2NM4ABYNR/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS00YzVjLTJ2YzMteDV3Ms4ABYMa","url":"https://github.com/advisories/GHSA-4c5c-2vc3-x5w2","title":"Vantage6: 2FA can be circumvented with hacked email access","description":"### Impact\nIf an attacker hacks into a vantage6 user's email account, they can 1) reset the password via email and then 2) reset the 2FA token via email. This way they reduce 2FA to 1FA (email access). \n\nNote that most email providers require 2FA to access email, so this issue is not very likely to cause issues.\n\n### Proposed solution\n\nMany web apps do not provide functionality to reset 2FA token (probably for this reason), but provide recovery codes as well. It would be better to provide these recovery codes to the user 1 time and then delete the option to reset it.\n\nAn alternative may be to only let server administrators reset 2FA token. However, this has as disadvantage that a hacked email account may send messages to the server admin to reset them, which they may fall for.\n\n### Patches\nNo\n\n### Workarounds\nNo","origin":"UNSPECIFIED","severity":"MODERATE","published_at":"2026-06-05T15:24:35.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":5.9,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:H/UI:N/VC:N/VI:H/VA:N/SC:N/SI:N/SA:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-4c5c-2vc3-x5w2","https://github.com/vantage6/vantage6/issues/1932","https://github.com/vantage6/vantage6/blob/main/docs/release_notes.rst#500","https://github.com/advisories/GHSA-4c5c-2vc3-x5w2"],"source_kind":"github","identifiers":["GHSA-4c5c-2vc3-x5w2","CVE-2024-27928"],"repository_url":null,"blast_radius":0.0,"created_at":"2026-06-05T16:00:09.370Z","updated_at":"2026-09-25T12:03:14.222Z","epss_percentage":0.00278,"epss_percentile":0.18029,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS00YzVjLTJ2YzMteDV3Ms4ABYMa","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS00YzVjLTJ2YzMteDV3Ms4ABYMa","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"5.0.0","vulnerable_version_range":"\u003c 5.0.0"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS00YzVjLTJ2YzMteDV3Ms4ABYMa/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS01NTQ5LWM1cTctZmo2Nc4ABYMZ","url":"https://github.com/advisories/GHSA-5549-c5q7-fj65","title":"Vantage6: No limit on emails sent for password/MFA reset","description":"### Impact\nUsers can reset their MFA token via API routes that send them an email. Currently the number of emails that is sent is not limited. This gives attackers the option to flood someones mailbox with a lot of emails, and would have adverse effects on the SMTP server which may be seen as spam sender.\n\nNote resetting the MFA token requires a correct password, so the potential impact for this is very low.\n\n### Patches\nNo\n\n### Workarounds\nNo","origin":"UNSPECIFIED","severity":"LOW","published_at":"2026-06-05T15:21:59.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":2.1,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:H/UI:N/VC:N/VI:L/VA:N/SC:N/SI:N/SA:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-5549-c5q7-fj65","https://github.com/vantage6/vantage6/issues/1932","https://github.com/vantage6/vantage6/blob/main/docs/release_notes.rst#500","https://github.com/advisories/GHSA-5549-c5q7-fj65"],"source_kind":"github","identifiers":["GHSA-5549-c5q7-fj65","CVE-2024-24769"],"repository_url":null,"blast_radius":0.0,"created_at":"2026-06-05T16:00:09.370Z","updated_at":"2026-09-25T12:03:14.222Z","epss_percentage":0.00278,"epss_percentile":0.17987,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS01NTQ5LWM1cTctZmo2Nc4ABYMZ","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS01NTQ5LWM1cTctZmo2Nc4ABYMZ","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"5.0.0","vulnerable_version_range":"\u003c 5.0.0"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS01NTQ5LWM1cTctZmo2Nc4ABYMZ/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS1qNmc1LXA2MngtNThod84ABJA5","url":"https://github.com/advisories/GHSA-j6g5-p62x-58hw","title":"vantage6 lacks brute-force protection on change password functionality","description":"### Impact\nIf attacker gets access to an authenticated session, they can try to brute-force the user password by using the change password functionality: they can call that route infinitely which will return the message that password is wrong until it is correct\n\n### Patches\nThis issue has been patched in version 4.11.0\n\n### Workarounds\nNone","origin":"UNSPECIFIED","severity":"LOW","published_at":"2025-06-12T23:00:41.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":1.7,"cvss_vector":"CVSS:4.0/AV:N/AC:H/AT:N/PR:N/UI:N/VC:L/VI:L/VA:L/SC:N/SI:N/SA:N/E:U","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-j6g5-p62x-58hw","https://nvd.nist.gov/vuln/detail/CVE-2025-43863","https://github.com/vantage6/vantage6/commit/e0f1841b310f6f610e8137db2506cf683ce154d0","https://github.com/pypa/advisory-database/tree/main/vulns/vantage6/PYSEC-2025-220.yaml","https://github.com/advisories/GHSA-j6g5-p62x-58hw"],"source_kind":"github","identifiers":["GHSA-j6g5-p62x-58hw","CVE-2025-43863"],"repository_url":"https://github.com/vantage6/vantage6","blast_radius":1.6222122660468523,"created_at":"2025-06-13T00:08:45.848Z","updated_at":"2026-09-25T12:07:54.617Z","epss_percentage":0.0047,"epss_percentile":0.37931,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1qNmc1LXA2MngtNThod84ABJA5","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1qNmc1LXA2MngtNThod84ABJA5","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"4.11.0","vulnerable_version_range":"\u003c 4.11.0"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1qNmc1LXA2MngtNThod84ABJA5/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS05OXI0LWNqcDQtM2hteM4AA8fs","url":"https://github.com/advisories/GHSA-99r4-cjp4-3hmx","title":"vantage6 collaboration admins can extend their influence by expanding the collaboration","description":"### Impact\nCollaboration administrators can add extra organizations to their collaboration. When doing that, they extend their influence: for instance, for organizations that they include, they can then create new users for which they know the passwords, and use that to read task results of other collaborations that that organization is involved in.\n\nOnly relatively trusted users - with access to manage a collaboration - are able to do this, which reduces the impact.\n\n### Patches\nNo\n\n### Workarounds\nNo\n\n","origin":"UNSPECIFIED","severity":"LOW","published_at":"2024-05-22T15:49:14.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":2.7,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:L/I:N/A:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-99r4-cjp4-3hmx","https://github.com/vantage6/vantage6/commit/27f4ee3fade5f4cbcf3e60899c9a2a91145e0b56","https://nvd.nist.gov/vuln/detail/CVE-2024-32969","https://github.com/advisories/GHSA-99r4-cjp4-3hmx"],"source_kind":"github","identifiers":["GHSA-99r4-cjp4-3hmx","CVE-2024-32969"],"repository_url":"https://github.com/vantage6/vantage6","blast_radius":0.0,"created_at":"2024-05-22T16:05:35.320Z","updated_at":"2026-09-25T12:10:35.230Z","epss_percentage":0.00319,"epss_percentile":0.22131,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS05OXI0LWNqcDQtM2hteM4AA8fs","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS05OXI0LWNqcDQtM2hteM4AA8fs","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"4.5.0rc3","vulnerable_version_range":"\u003c 4.5.0rc3"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS05OXI0LWNqcDQtM2hteM4AA8fs/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS01aDN4LTZnd2YtNzNqbc4AA6B2","url":"https://github.com/advisories/GHSA-5h3x-6gwf-73jm","title":"vantage6 vulnerable to a username timing attack on recover password/MFA token","description":"### Impact\nMuch like https://github.com/vantage6/vantage6/security/advisories/GHSA-45gq-q4xh-cp53, it is possible to find which usernames exist in vantage6 by calling the API routes `/recover/lost` and `/2fa/lost`, which send emails to users if they have lost their password or MFA token. Usernames can be found by assessing response time differences, and additionally, they can be found because the endpoint gives a response \"Failed to login\" if the username exists.\n\n### Patches\nNo\n\n### Workarounds\nNo","origin":"UNSPECIFIED","severity":"MODERATE","published_at":"2024-03-15T16:44:36.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":5.3,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-45gq-q4xh-cp53","https://github.com/vantage6/vantage6/security/advisories/GHSA-5h3x-6gwf-73jm","https://nvd.nist.gov/vuln/detail/CVE-2024-24770","https://github.com/vantage6/vantage6/commit/aecfd6d0e83165a41a60ebd52d2287b0217be26b","https://github.com/advisories/GHSA-5h3x-6gwf-73jm"],"source_kind":"github","identifiers":["GHSA-5h3x-6gwf-73jm","CVE-2024-24770"],"repository_url":"https://github.com/vantage6/vantage6","blast_radius":0.0,"created_at":"2024-03-21T20:04:43.039Z","updated_at":"2026-09-25T12:11:36.296Z","epss_percentage":0.00397,"epss_percentile":0.31083,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS01aDN4LTZnd2YtNzNqbc4AA6B2","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS01aDN4LTZnd2YtNzNqbc4AA6B2","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"4.3.0","vulnerable_version_range":"\u003c= 4.2.2"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS01aDN4LTZnd2YtNzNqbc4AA6B2/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS00OTQ2LTg1cHItZnZ4aM4AA6B1","url":"https://github.com/advisories/GHSA-4946-85pr-fvxh","title":"vantage6's CORS settings overly permissive","description":"### Impact\nThe vantage6 server has no restrictions on CORS settings. It should be possible for people to set the allowed origins of the server. \n\nThe impact is limited because v6 does not use session cookies\n\n### Patches\nNo\n\n### Workarounds\nNo","origin":"UNSPECIFIED","severity":"MODERATE","published_at":"2024-03-15T16:42:55.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":4.2,"cvss_vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:L/I:L/A:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-4946-85pr-fvxh","https://nvd.nist.gov/vuln/detail/CVE-2024-23823","https://github.com/vantage6/vantage6/commit/70bb4e1d889230a841eb364d6c03accd7dd01a41","https://github.com/advisories/GHSA-4946-85pr-fvxh"],"source_kind":"github","identifiers":["GHSA-4946-85pr-fvxh","CVE-2024-23823"],"repository_url":"https://github.com/vantage6/vantage6","blast_radius":0.0,"created_at":"2024-03-21T20:04:43.067Z","updated_at":"2026-09-25T12:11:36.297Z","epss_percentage":0.00314,"epss_percentile":0.21595,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS00OTQ2LTg1cHItZnZ4aM4AA6B1","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS00OTQ2LTg1cHItZnZ4aM4AA6B1","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"4.3.0","vulnerable_version_range":"\u003c= 4.2.2"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS00OTQ2LTg1cHItZnZ4aM4AA6B1/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS1yam12LTUybXAtZ2pycs4AA480","url":"https://github.com/advisories/GHSA-rjmv-52mp-gjrr","title":"vantage6 may create unencrypted tasks in encrypted collaboration","description":"### Impact\nThere are no checks on whether the input is encrypted if a task is created in an encrypted collaboration. Therefore, a user may accidentally create a task with sensitive input data that will then be stored unencrypted in a database.\n\n### Workarounds\nThis is not an issue with the normal workflow, only if e.g. a user with the python client sets encryption to the wrong value.","origin":"UNSPECIFIED","severity":"LOW","published_at":"2024-01-30T20:56:50.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":3.5,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:R/S:U/C:L/I:N/A:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-rjmv-52mp-gjrr","https://nvd.nist.gov/vuln/detail/CVE-2024-22193","https://github.com/vantage6/vantage6/commit/6383283733b81abfcacfec7538dc4dc882e98074","https://github.com/pypa/advisory-database/tree/main/vulns/vantage6/PYSEC-2024-32.yaml","https://github.com/advisories/GHSA-rjmv-52mp-gjrr"],"source_kind":"github","identifiers":["GHSA-rjmv-52mp-gjrr","CVE-2024-22193"],"repository_url":"https://github.com/vantage6/vantage6","blast_radius":0.0,"created_at":"2024-01-30T21:04:50.705Z","updated_at":"2026-09-26T19:09:38.859Z","epss_percentage":0.00257,"epss_percentile":0.15417,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1yam12LTUybXAtZ2pycs4AA480","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1yam12LTUybXAtZ2pycs4AA480","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"4.2.0","vulnerable_version_range":"\u003c 4.2.0"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1yam12LTUybXAtZ2pycs4AA480/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS0yd2djLTQ4ZzItY2o1d84AA48z","url":"https://github.com/advisories/GHSA-2wgc-48g2-cj5w","title":"vantage6 has insecure SSH configuration for node and server containers","description":"### Impact\nNodes and servers get a ssh config by default that permits root login with password authentication. In a proper deployment, the SSH service is not exposed so there is no risk, but not all deployments are ideal. The default should therefore be less permissive.\n\nWe will probably opt to completely remove the ssh option as it is only used for debugging. Later, we can add a debug mode where we can activate it if necessary.\n\n### Workarounds\nRemove the ssh part from the docker file and build your own docker image","origin":"UNSPECIFIED","severity":"MODERATE","published_at":"2024-01-30T20:56:46.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":6.5,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:L/A:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-2wgc-48g2-cj5w","https://nvd.nist.gov/vuln/detail/CVE-2024-21653","https://github.com/vantage6/vantage6/commit/3fcc6e6a8bd1142fd7a558d8fdd2b246e55c8841","https://github.com/pypa/advisory-database/tree/main/vulns/vantage6-server/PYSEC-2024-34.yaml","https://github.com/advisories/GHSA-2wgc-48g2-cj5w"],"source_kind":"github","identifiers":["GHSA-2wgc-48g2-cj5w","CVE-2024-21653"],"repository_url":"https://github.com/vantage6/vantage6","blast_radius":0.0,"created_at":"2024-01-30T21:04:50.743Z","updated_at":"2026-09-26T19:09:38.859Z","epss_percentage":0.0047,"epss_percentile":0.37943,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS0yd2djLTQ4ZzItY2o1d84AA48z","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS0yd2djLTQ4ZzItY2o1d84AA48z","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"4.2.0","vulnerable_version_range":"\u003c 4.2.0"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS0yd2djLTQ4ZzItY2o1d84AA48z/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS13OWgyLXB4ODctNzR2eM4AA48x","url":"https://github.com/advisories/GHSA-w9h2-px87-74vx","title":"vantage6 remote code execution vulnerability","description":"### Impact\nAuthenticated users could inject code into algorithm environment variables\n\n### Workarounds\nNo ","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2024-01-30T20:56:45.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":8.8,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:H/I:H/A:H","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-w9h2-px87-74vx","https://nvd.nist.gov/vuln/detail/CVE-2024-21649","https://github.com/vantage6/vantage6/commit/eac19db737145d3ca987adf037a454fae0790ddd","https://github.com/pypa/advisory-database/tree/main/vulns/vantage6/PYSEC-2024-30.yaml","https://github.com/advisories/GHSA-w9h2-px87-74vx"],"source_kind":"github","identifiers":["GHSA-w9h2-px87-74vx","CVE-2024-21649"],"repository_url":"https://github.com/vantage6/vantage6","blast_radius":0.0,"created_at":"2024-01-30T21:04:50.820Z","updated_at":"2026-09-26T19:09:38.860Z","epss_percentage":0.01266,"epss_percentile":0.685,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS13OWgyLXB4ODctNzR2eM4AA48x","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS13OWgyLXB4ODctNzR2eM4AA48x","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"4.2.0","vulnerable_version_range":"\u003c 4.2.0"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS13OWgyLXB4ODctNzR2eM4AA48x/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS1yZjU0LTdxcnItOTZqNs4AA2ea","url":"https://github.com/advisories/GHSA-rf54-7qrr-96j6","title":"vantage6 does not properly delete linked resources when deleting a collaboration","description":"When a collaboration is deleted in vantage6, the linked resources (such as tasks from that collaboration) are not properly deleted.\n\nThis is partly to manage data properly, but also to prevent a potential (but unlikely) side-effect, where if a collaboration with id=10 is deleted, and subsequently a new collaboration is created with id=10, the authenticated users in that collaboration could potentially see results of the deleted collaboration in some cases, resulting in information disclosure.","origin":"UNSPECIFIED","severity":"LOW","published_at":"2023-10-16T14:31:39.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":1.0,"cvss_vector":"CVSS:4.0/AV:L/AC:L/AT:P/PR:H/UI:P/VC:N/VI:N/VA:N/SC:L/SI:L/SA:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-rf54-7qrr-96j6","https://nvd.nist.gov/vuln/detail/CVE-2023-41881","https://github.com/vantage6/vantage6/pull/748","https://github.com/vantage6/vantage6/blob/0682c4288f43fee5bcc72dc448cdd99bd7e57f76/docs/release_notes.rst#400","https://github.com/vantage6/vantage6/commit/cce9538f8b70e814c080dd0ae43b297f3af8a732","https://github.com/pypa/advisory-database/tree/main/vulns/vantage6/PYSEC-2023-200.yaml","https://github.com/advisories/GHSA-rf54-7qrr-96j6"],"source_kind":"github","identifiers":["GHSA-rf54-7qrr-96j6","CVE-2023-41881"],"repository_url":"https://github.com/vantage6/vantage6","blast_radius":0.9542425094393249,"created_at":"2023-10-16T15:06:30.057Z","updated_at":"2026-09-26T19:10:40.610Z","epss_percentage":0.00319,"epss_percentile":0.22113,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1yZjU0LTdxcnItOTZqNs4AA2ea","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1yZjU0LTdxcnItOTZqNs4AA2ea","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"4.0.0","vulnerable_version_range":"\u003c 4.0.0"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1yZjU0LTdxcnItOTZqNs4AA2ea/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS03eDk0LTZnMm0tM2hwMs4AA2cP","url":"https://github.com/advisories/GHSA-7x94-6g2m-3hp2","title":"Defining resource name as integer may give unintended access in vantage6","description":"### Impact\nMalicious users may try to get access to resources they are not allowed to see, by creating resources with integers as names.\n\nOne example where this is a risk, is when users define which users are allowed to run algorithms on their node. This may be defined by username or user id. Now, for example, if user id 13 is allowed to run tasks, and an attacker creates a username with username '13', they would be wrongly allowed to run an algorithm.\n\nThere may also be other places in the code where such a mixup of resource ID or name leads to issues. The best solution we see is therefore to check when resources are created or modified, that the resource name always starts with a character.\n\n### Patches\nTo be done, probably in v3.9\n\n### Workarounds\nNone\n","origin":"UNSPECIFIED","severity":"MODERATE","published_at":"2023-10-13T19:30:40.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":5.3,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:L/VA:N/SC:N/SI:N/SA:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-7x94-6g2m-3hp2","https://nvd.nist.gov/vuln/detail/CVE-2023-28635","https://github.com/vantage6/vantage6/pull/744","https://github.com/vantage6/vantage6/blob/0682c4288f43fee5bcc72dc448cdd99bd7e57f76/docs/release_notes.rst#400","https://github.com/vantage6/vantage6/commit/aacfc24548cbf168579d2e13b2ddaf8ded715d36","https://github.com/pypa/advisory-database/tree/main/vulns/vantage6-node/PYSEC-2023-198.yaml","https://github.com/advisories/GHSA-7x94-6g2m-3hp2"],"source_kind":"github","identifiers":["GHSA-7x94-6g2m-3hp2","CVE-2023-28635"],"repository_url":"https://github.com/vantage6/vantage6","blast_radius":5.0574853000284214,"created_at":"2023-10-13T20:05:53.965Z","updated_at":"2026-09-26T19:10:39.180Z","epss_percentage":0.00406,"epss_percentile":0.32037,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS03eDk0LTZnMm0tM2hwMs4AA2cP","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS03eDk0LTZnMm0tM2hwMs4AA2cP","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"4.0.0","vulnerable_version_range":"\u003c 4.0.0"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS03eDk0LTZnMm0tM2hwMs4AA2cP/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS1nYzU3LXhoaDUtbTk0cs4AA2cO","url":"https://github.com/advisories/GHSA-gc57-xhh5-m94r","title":"Improper Access Control in vantage6","description":"### Impact\nThe endpoint /api/collaboration/{id}/task is used to collect all tasks from a certain collaboration. To get such tasks, a user should have permission to view the collaboration and to view the tasks in it. However, currently it is only checked if the user has permission to view the collaboration.\n\n### Patches\nNo\n\n### Workarounds\nNone\n\n### References\nNone \n\n### For more information\nIf you have any questions or comments about this advisory:\n* Email us at [vantage6@iknl.nl](mailto:vantage6@iknl.nl)\n","origin":"UNSPECIFIED","severity":"MODERATE","published_at":"2023-10-13T19:29:13.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":5.3,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:L/VI:L/VA:N/SC:N/SI:N/SA:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-gc57-xhh5-m94r","https://nvd.nist.gov/vuln/detail/CVE-2023-41882","https://github.com/vantage6/vantage6/pull/711","https://github.com/vantage6/vantage6/blob/0682c4288f43fee5bcc72dc448cdd99bd7e57f76/docs/release_notes.rst#400","https://github.com/vantage6/vantage6/commit/86564e103cbac5238ce2fe392e3357e0e8c20220","https://github.com/pypa/advisory-database/tree/main/vulns/vantage6/PYSEC-2023-201.yaml","https://github.com/advisories/GHSA-gc57-xhh5-m94r"],"source_kind":"github","identifiers":["GHSA-gc57-xhh5-m94r","CVE-2023-41882"],"repository_url":"https://github.com/vantage6/vantage6","blast_radius":5.0574853000284214,"created_at":"2023-10-13T20:05:53.990Z","updated_at":"2026-09-26T19:10:39.180Z","epss_percentage":0.004,"epss_percentile":0.31503,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1nYzU3LXhoaDUtbTk0cs4AA2cO","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1nYzU3LXhoaDUtbTk0cs4AA2cO","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"4.0.0","vulnerable_version_range":"\u003c 4.0.0"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1nYzU3LXhoaDUtbTk0cs4AA2cO/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS01bTIyLWNmcTktODZ4Ns4AA2cN","url":"https://github.com/advisories/GHSA-5m22-cfq9-86x6","title":"Pickle serialization vulnerable to Deserialization of Untrusted Data","description":"### What\nWe are using pickle as default serialization module but that has known security issues (see e.g. https://medium.com/ochrona/python-pickle-is-notoriously-insecure-d6651f1974c9). \n\nIn summary, it is not advisable to open Pickles that you create yourself locally. In vantage6, algorithms use pickles to send aggregated data around and to pack algorithm input or output. All of the Python algorithms that use the wrappers with default serialization are therefore vulnerable to this issue.\n\nSolution: we should use JSON instead\n\n### Impact\nAll users of vantage6 that post tasks with algorithms that use the default serialization. The default serialization is used by default with all algorithm wrappers.\n\n### Patches\nNot yet\n\n### Workarounds\nSpecify JSON serialization\n\n","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2023-10-13T19:25:39.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":8.6,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:H/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-5m22-cfq9-86x6","https://nvd.nist.gov/vuln/detail/CVE-2023-23930","https://github.com/vantage6/vantage6/commit/e62f03bacf2247bd59eed217e2e7338c3a01a5f0","https://github.com/vantage6/vantage6/blob/0682c4288f43fee5bcc72dc448cdd99bd7e57f76/docs/release_notes.rst#400","https://medium.com/ochrona/python-pickle-is-notoriously-insecure-d6651f1974c9","https://github.com/pypa/advisory-database/tree/main/vulns/vantage6/PYSEC-2023-196.yaml","https://github.com/advisories/GHSA-5m22-cfq9-86x6"],"source_kind":"github","identifiers":["GHSA-5m22-cfq9-86x6","CVE-2023-23930"],"repository_url":"https://github.com/vantage6/vantage6","blast_radius":8.206485581178194,"created_at":"2023-10-13T20:05:54.004Z","updated_at":"2026-09-24T15:12:12.629Z","epss_percentage":0.00892,"epss_percentile":0.57904,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS01bTIyLWNmcTktODZ4Ns4AA2cN","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS01bTIyLWNmcTktODZ4Ns4AA2cN","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"4.0.2","vulnerable_version_range":"\u003c 4.0.2"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS01bTIyLWNmcTktODZ4Ns4AA2cN/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS00dzU5LWMzZ2MtcnJocM4AAx3q","url":"https://github.com/advisories/GHSA-4w59-c3gc-rrhp","title":"vantage6 refresh tokens do not expire","description":"From issue: \n\nProblem description\nCurrently, the refresh token is valid indefinitely. This is bad security practice.\n\nDesired solution\nThe refresh token should get a validity of 24-48 hours.\n\nAdditional context\n\nWhen implementing this, also check that the refresh token returns a new refresh token\nWhen implementing this, also adapt the UI so that it logs out if refresh token is no longer valid.\nWhen implementing this, ensure that nodes refresh their token periodically so that they do not have to be restarted manually.\n\n\n### Impact\n### Patches\nNone available \n\n### Workarounds\nNone available\n\n","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2023-02-28T23:20:05.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":8.7,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-4w59-c3gc-rrhp","https://github.com/vantage6/vantage6/commit/48ebfca42359e9a6743e9598684585e2522cdce8","https://nvd.nist.gov/vuln/detail/CVE-2023-23929","https://github.com/pypa/advisory-database/tree/main/vulns/vantage6/PYSEC-2023-54.yaml","https://github.com/advisories/GHSA-4w59-c3gc-rrhp"],"source_kind":"github","identifiers":["GHSA-4w59-c3gc-rrhp","CVE-2023-23929"],"repository_url":"https://github.com/vantage6/vantage6","blast_radius":8.301909832122126,"created_at":"2023-03-01T00:03:05.594Z","updated_at":"2026-09-26T19:12:26.318Z","epss_percentage":0.00571,"epss_percentile":0.44846,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS00dzU5LWMzZ2MtcnJocM4AAx3q","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS00dzU5LWMzZ2MtcnJocM4AAx3q","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"3.8.0","vulnerable_version_range":"\u003c 3.8.0"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS00dzU5LWMzZ2MtcnJocM4AAx3q/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS12dmp2LTk3ajgtOTR4aM4AAx3p","url":"https://github.com/advisories/GHSA-vvjv-97j8-94xh","title":"vantage6 vulnerable to Improper Preservation of Permissions","description":"### Impact\nAssigning existing users to a different organization is currently possible. It may lead to unintended access: if a user from organization A is accidentally assigned to organization B, they will retain their permissions and therefore might be able to access stuff they should not be allowed to access.\n\n### Patches\nUpdate to 3.8.0\n\n### Workarounds\nNone\n\n### References\nNone\n\n### For more information\nIf you have any questions or comments about this advisory:\n* Email us at [vantage6@iknl.nl](mailto:vantage6@iknl.nl)\n","origin":"UNSPECIFIED","severity":"HIGH","published_at":"2023-02-28T23:19:24.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":7.1,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-vvjv-97j8-94xh","https://github.com/vantage6/vantage6/commit/798aca1de142a4eca175ef51112e2235642f4f24","https://nvd.nist.gov/vuln/detail/CVE-2023-22738","https://github.com/pypa/advisory-database/tree/main/vulns/vantage6/PYSEC-2023-53.yaml","https://github.com/advisories/GHSA-vvjv-97j8-94xh"],"source_kind":"github","identifiers":["GHSA-vvjv-97j8-94xh","CVE-2023-22738"],"repository_url":"https://github.com/vantage6/vantage6","blast_radius":6.7751218170192065,"created_at":"2023-03-01T00:03:05.604Z","updated_at":"2026-09-26T19:12:26.319Z","epss_percentage":0.00375,"epss_percentile":0.28675,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS12dmp2LTk3ajgtOTR4aM4AAx3p","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS12dmp2LTk3ajgtOTR4aM4AAx3p","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"3.8.0","vulnerable_version_range":"\u003c 3.8.0"}],"purl":"pkg:pypi/vantage6"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS12dmp2LTk3ajgtOTR4aM4AAx3p/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS0zNmd4LTlxNmgtZzQyOc4AAx3o","url":"https://github.com/advisories/GHSA-36gx-9q6h-g429","title":"vantage6 vulnerable to Observable Response Discrepancy","description":"### Impact\nWe are incorporating the password policies listed in https://github.com/vantage6/vantage6/issues/59. One measure is that we don't let the user know in case of wrong username/password combination if the username actually exists, to prevent that bots can guess usernames. However, if a wrong password is entered a number of times, the user account is blocked temporarily. This way you could still find out which usernames exist.\n\n### Patches\nUpdate to 3.8.0+\n\n### Workarounds\nNo\n\n### References\nhttps://github.com/vantage6/vantage6/issues/59\n\n### For more information\nIf you have any questions or comments about this advisory:\n* Email us at [vantage6@iknl.nl](mailto:vantage6@iknl.nl)","origin":"UNSPECIFIED","severity":"MODERATE","published_at":"2023-02-28T23:18:37.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":6.9,"cvss_vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:L/VI:N/VA:L/SC:N/SI:N/SA:N","references":["https://github.com/vantage6/vantage6/security/advisories/GHSA-36gx-9q6h-g429","https://github.com/vantage6/vantage6/issues/59","https://github.com/vantage6/vantage6/pull/281","https://github.com/vantage6/vantage6/commit/ab4381c35d24add06f75d5a8a284321f7a340bd2","https://nvd.nist.gov/vuln/detail/CVE-2022-39228","https://github.com/pypa/advisory-database/tree/main/vulns/vantage6/PYSEC-2023-52.yaml","https://github.com/pypa/advisory-database/tree/main/vulns/vantage6/PYSEC-2023-313.yaml","https://github.com/advisories/GHSA-36gx-9q6h-g429"],"source_kind":"github","identifiers":["GHSA-36gx-9q6h-g429","CVE-2022-39228"],"repository_url":"https://github.com/vantage6/vantage6","blast_radius":6.584273315131342,"created_at":"2023-03-01T00:03:05.614Z","updated_at":"2026-09-26T19:12:26.319Z","epss_percentage":0.00596,"epss_percentile":0.46142,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS0zNmd4LTlxNmgtZzQyOc4AAx3o","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS0zNmd4LTlxNmgtZzQyOc4AAx3o","packages":[{"ecosystem":"pypi","package_name":"vantage6","versions":[{"first_patched_version":"3.8.0","vulnerable_version_range":"\u003c 3.8.0"}],"purl":"pkg:pypi/vantage6"}],"related_packag