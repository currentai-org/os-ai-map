{"info":{"author":null,"author_email":null,"bugtrack_url":null,"classifiers":[],"description":"# Plato: A Research Framework for Federated Learning\n\nWelcome to *Plato*, a software framework to facilitate scalable, reproducible, and extensible federated learning research. Please refer to the documentation website, available at the [Plato documentation website](https://platodocs.netlify.app/), for more details on installing, running, configuring, extending, and deploying Plato.\n","description_content_type":"text/markdown","docs_url":null,"download_url":null,"downloads":{"last_day":-1,"last_month":-1,"last_week":-1},"dynamic":null,"home_page":null,"keywords":null,"license":null,"license_expression":"Apache-2.0","license_files":["LICENSE"],"maintainer":null,"maintainer_email":null,"name":"plato-learn","package_url":"https://pypi.org/project/plato-learn/","platform":null,"project_url":"https://pypi.org/project/plato-learn/","project_urls":{"Documentation":"https://platodocs.netlify.app/","Homepage":"https://github.com/TL-System/plato","Repository":"https://github.com/TL-System/plato"},"provides_extra":null,"release_url":"https://pypi.org/project/plato-learn/1.41/","requires_dist":["accelerate","aiohttp","boto3","datasets","evaluate","gymnasium","kazoo","lightly","munch","numpy","opacus","peft","python-socketio","requests","tenseal","timm","torch","torch-optimizer","torchvision","transformers","zstd"],"requires_python":">=3.13","summary":"Plato: a research framework for federated learning","version":"1.41","yanked":false,"yanked_reason":null},"last_serial":32010249,"ownership":{"organization":null,"roles":[{"role":"Owner","user":"baochunli"}]},"releases":{"0.1.0":[{"comment_text":"","core-metadata":{"sha256":"1898eb6c29677131e986ea078ce250ba80de5222e25785eee4b2d933cfdcdd16"},"digests":{"blake2b_256":"db685f6183e19fd6001afc15fb73fde04ea3a97c58bb361f3ba9d73d814b89d8","md5":"9a782938a18273c53dc455d258813257","sha256":"f66e8cd8742329b573b25c093696fe97a1805a59e490e685fb07d8