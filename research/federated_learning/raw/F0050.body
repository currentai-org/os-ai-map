18:02:11.061Z","epss_percentage":0.00573,"epss_percentile":0.4495,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1qcXAzLXFyZ2gtNDg0Ns4ABV4O","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1qcXAzLXFyZ2gtNDg0Ns4ABV4O","packages":[{"ecosystem":"pypi","package_name":"nvflare","versions":[{"first_patched_version":"2.7.2","vulnerable_version_range":"\u003c 2.7.2"}],"purl":"pkg:pypi/nvflare"}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1qcXAzLXFyZ2gtNDg0Ns4ABV4O/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS02cXY2LXE3N2ctN3FtNs4AAujz","url":"https://github.com/advisories/GHSA-6qv6-q77g-7qm6","title":"NVFLARE unsafe deserialization due to Pickle","description":"### Impact\nNVFLARE contains a vulnerability where deserialization of Untrusted Data due to Pickle usage may allow an unprivileged network attacker to cause Remote Code Execution, Denial Of Service, and Impact to both Confidentiality and Integrity. \n\nAll versions before 2.1.4 are affected. \n\nCVSS Score = 9.8 \n \n[AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H](https://nvd.nist.gov/vuln-metrics/cvss/v3-calculator?vector=AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H) \n\n\n### Patches\n \nThe patch is included in nvflare==2.1.4 \nThis new version uses MessagePack instead of Pickle to do serialization and deserialization.  \n\nSome object serializations supported by Pickle are not supported by MessagePack. We have provided out of box support for some built-in NVFLARE objects. For object serializations unsupported by MessagePack, the user will need to convert the objects to numpy or bytes before sending over to remote machines.  The list of supported object types are listed in https://github.com/NVIDIA/NVFlare/blob/2.1/nvflare/fuel/utils/fobs/README.rst \n\n \n### Workarounds\n\nNo workarounds available. \n \n### Additional information \nIssue Found by: Oliver Sellwood (Nintorac) and Elias Hohl\n\n","origin":"UNSPECIFIED","severity":"CRITICAL","published_at":"2022-08-31T22:29:27.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":9.8,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","references":["https://github.com/NVIDIA/NVFlare/security/advisories/GHSA-6qv6-q77g-7qm6","https://nvd.nist.gov/vuln/detail/CVE-2022-34668","https://github.com/NVIDIA/NVFlare/commit/6cde16f3f4711583ae4d896dfcc125d25c7d5b0d","https://github.com/pypa/advisory-database/tree/main/vulns/nvflare/PYSEC-2022-257.yaml","http://packetstormsecurity.com/files/171483/NVFLARE-Unsafe-Deserialization.html","https://github.com/advisories/GHSA-6qv6-q77g-7qm6"],"source_kind":"github","identifiers":["GHSA-6qv6-q77g-7qm6","CVE-2022-34668"],"repository_url":"https://github.com/NVIDIA/NVFlare","blast_radius":0.0,"created_at":"2022-12-21T16:12:00.249Z","updated_at":"2026-09-26T17:11:15.730Z","epss_percentage":0.10903,"epss_percentile":0.95535,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS02cXY2LXE3N2ctN3FtNs4AAujz","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS02cXY2LXE3N2ctN3FtNs4AAujz","packages":[{"ecosystem":"pypi","package_name":"nvflare","versions":[{"first_patched_version":"2.1.4","vulnerable_version_range":"\u003c 2.1.4"}],"purl":"pkg:pypi/nvflare","statistics":{"dependent_packages_count":2,"dependent_repos_count":43,"downloads":25980,"downloads_period":"last-month"},"affected_versions":["0.1.3","0.9.0","1.0.0","1.0.1","1.0.2","1.1.0","1.1.1","2.0.0","2.0.1","2.0.2","2.0.3","2.0.4","2.0.5","2.0.6","2.0.7","2.0.8","2.0.9","2.0.10","2.0.11","2.0.12","2.0.13","2.0.14","2.0.15","2.0.16","2.0.18","2.0.19","2.1.0","2.1.1","2.1.2","2.1.3"],"unaffected_versions":["2.1.4","2.2.0","2.2.0rc1","2.2.1","2.2.1rc1","2.2.1rc4","2.2.1rc5","2.2.1rc6","2.2.1rc7","2.2.1rc8","2.2.1rc9","2.2.2","2.2.3","2.2.4","2.2.5","2.2.6","2.3.0","2.3.0rc1","2.3.0rc2","2.3.0rc3","2.3.0rc4","2.3.0rc5","2.3.0rc6","2.3.0rc7","2.3.0rc8","2.3.1","2.3.2","2.3.3","2.3.4","2.3.5","2.3.6","2.3.7","2.3.8","2.3.9","2.3.10","2.3.11","2.3.12","2.4.0","2.4.0rc1","2.4.0rc2","2.4.0rc3","2.4.0rc4","2.4.0rc5","2.4.0rc6","2.4.0rc7","2.4.0rc8","2.4.0rc9","2.4.1","2.4.1rc1","2.4.1rc2","2.4.1rc3","2.4.1rc4","2.4.1rc5","2.4.1rc6","2.4.1rc7","2.4.1rc8","2.4.2","2.4.2rc3","2.5.0","2.5.0rc1","2.5.0rc2","2.5.0rc3","2.5.0rc4","2.5.0rc5","2.5.0rc6","2.5.0rc7","2.5.0rc8","2.5.0rc9","2.5.0rc10","2.5.0rc11","2.5.0rc12","2.5.1","2.5.1rc1","2.5.1rc2","2.5.2","2.6.0","2.6.0rc1","2.6.0rc2","2.6.0rc3","2.6.0rc4","2.6.0rc5","2.6.1","2.6.2","2.6.3","2.7.0","2.7.0rc1","2.7.0rc2","2.7.0rc3","2.7.0rc4","2.7.0rc5","2.7.0rc6","2.7.0rc7","2.7.0rc8","2.7.0rc9","2.7.0rc10","2.7.1","2.7.1rc1","2.7.1rc2","2.7.2","2.7.2rc1","2.7.2rc2","2.7.2rc3","2.7.2rc4","2.7.2rc5","2.7.2rc6","2.7.2rc7","2.7.2rc8","2.7.2rc9","2.7.2rc10","2.7.2rc11","2.7.2rc12","2.7.2rc13","2.7.2rc14","2.7.2rc15","2.7.2rc16","2.7.2rc17","2.7.2rc18","2.7.2rc19","2.7.2rc20","2.7.3","2.8.0","2.8.0rc1","2.8.0rc2","2.8.0rc3","2.8.0rc4","2.8.0rc5","2.8.0rc6","2.8.0rc7","2.8.1","2.8.2","2.9.0","2.9.0rc1","2.9.0rc2","2.9.0rc3","2.9.1rc1"]}],"related_packages_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS02cXY2LXE3N2ctN3FtNs4AAujz/related_packages","related_advisories":[]},{"uuid":"GSA_kwCzR0hTQS1ocmYzLTYyMnEtODM2Ns4AAs62","url":"https://github.com/advisories/GHSA-hrf3-622q-8366","title":"Unsafe yaml deserialization in NVFlare","description":"### Impact\nNVFLARE contains a vulnerability in its utils module, where YAML files are loaded via yaml.load() instead of yaml.safe_load(). The deserialization of Untrusted Data, may allow an unprivileged network attacker to cause Remote Code Execution, Denial Of Service, and Impact to both Confidentiality and Integrity.\n\nAll versions before 2.1.2 are affected.\nCVSS Score = 9.8\n[AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H](https://nam11.safelinks.protection.outlook.com/?url=https%3A%2F%2Fnvd.nist.gov%2Fvuln-metrics%2Fcvss%2Fv3-calculator%3Fvector%3DAV%3AN%2FAC%3AL%2FPR%3AN%2FUI%3AN%2FS%3AU%2FC%3AH%2FI%3AH%2FA%3AH\u0026data=05%7C01%7Cchesterc%40nvidia.com%7Ce9600bde16854b0b380008da4fc544f7%7C43083d15727340c1b7db39efd9ccc17a%7C0%7C0%7C637910005925574215%7CUnknown%7CTWFpbGZsb3d8eyJWIjoiMC4wLjAwMDAiLCJQIjoiV2luMzIiLCJBTiI6Ik1haWwiLCJXVCI6Mn0%3D%7C3000%7C%7C%7C\u0026sdata=5kBrXEmAbqp8R31JCH%2FG95MUly72UPVihnBwiRFmvBY%3D\u0026reserved=0)\n\n\n### Patches\n\nThe patch will be included in nvflare==2.1.2\n\n\n### Workarounds\nChange yaml.load() to yaml.safe_load()\n\n### Additional information\nIssue Found by: Oliver Sellwood (@Nintorac)\n\n","origin":"UNSPECIFIED","severity":"CRITICAL","published_at":"2022-06-22T21:22:46.000Z","withdrawn_at":null,"classification":"GENERAL","cvss_score":9.8,"cvss_vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","references":["https://github.com/NVIDIA/NVFlare/security/advisories/GHSA-hrf3-622q-8366","https://nvd.nist.gov/vuln/detail/CVE-2022-31605","https://github.com/pypa/advisory-database/tree/main/vulns/nvflare/PYSEC-2022-232.yaml","https://github.com/NVIDIA/NVFlare/commit/4de9782697ecb12f39bcae83221bd8d3498959be","https://github.com/advisories/GHSA-hrf3-622q-8366"],"source_kind":"github","identifiers":["GHSA-hrf3-622q-8366","CVE-2022-31605"],"repository_url":"https://github.com/NVIDIA/NVFlare","blast_radius":0.0,"created_at":"2022-12-21T16:12:10.095Z","updated_at":"2026-09-26T17:11:15.727Z","epss_percentage":0.02079,"epss_percentile":0.80662,"api_url":"https://advisories.ecosyste.ms/api/v1/advisories/GSA_kwCzR0hTQS1ocmYzLTYyMnEtODM2Ns4AAs62","html_url":"https://advisories.ecosyste.ms/advisories/GSA_kwCzR0hTQS1ocmYzLTYyMnEtODM2Ns4AAs62","packages":[{"ecosystem":"pypi","package_name":"nvflare","versions":[{"first_patched_version":"2.1.2","vulnerable_version_range":"\u003c 2.1.2"}],"purl":"pkg:pypi/nvflare","statistics":{"dependent_packages_count":2,"dependent_repos_count":43,"downloads":25980,"downloads_period":"last-month"},"affected_versions":["0.1.3","0.9.0","1.0.0","1.0.1","1.0.2","1.1.0","1.1.1","2.0.0",