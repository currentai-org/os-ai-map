{"info":{"author":"Vantage6 Team","author_email":null,"bugtrack_url":null,"classifiers":[],"description":"<h1 align=\"center\">\n  <br>\n  <a href=\"https://vantage6.ai\"><img src=\"https://github.com/IKNL/guidelines/blob/master/resources/logos/vantage6.png?raw=true\" alt=\"vantage6\" width=\"350\"></a>\n</h1>\n\n<h3 align=center> A Privacy Enhancing Technology (PET) Operations platform</h3>\n\n---\n\n# Vantage6 CLI\n\nThis package provides the command-line interface (CLI) for managing vantage6\ninfrastructure instances, such as HQs and nodes.\n\n## Documentation\n\nFor complete documentation, installation instructions, and usage examples, please see\nthe **[main Vantage6 README](https://github.com/vantage6/vantage6/blob/main/README.md)**\n.\n\n## About Vantage6\n\nVantage6 is a Privacy Enhancing Technology (PET) Operations platform that enables\nfederated learning and multi-party computation. For more information, visit\n[vantage6.ai](https://vantage6.ai) or view our\n[documentation](https://docs.vantage6.ai).","description_content_type":"text/markdown","docs_url":null,"download_url":null,"downloads":{"last_day":-1,"last_month":-1,"last_week":-1},"dynamic":null,"home_page":null,"keywords":null,"license":"MIT","license_expression":null,"license_files":null,"maintainer":null,"maintainer_email":"Frank Martin <f.martin@iknl.nl>, Bart van Beusekom <b.vanbeusekom@iknl.nl>","name":"vantage6","package_url":"https://pypi.org/project/vantage6/","platform":null,"project_url":"https://pypi.org/project/vantage6/","project_urls":null,"provides_extra":["dev"],"release_url":"https://pypi.org/project/vantage6/5.0.3/","requires_dist":["appdirs==1.4.4","click==8.1.3","colorama==0.4.6","copier==9.18.2","docker==7.1.0","ipython==8.10.0","jinja2==3.1.6","kubernetes==36.0.2","marshmallow==3.26.2","pandas>=2.2.3","questionary==2.1.1","rich==13.5.2","schema==0.7.5","sqlalchemy==2.0.37","vantage6-algorithm-tools==5.0.3","vantage6-client==5.0.3","vantage6-common==5.0.3","black; extra == \"dev\"","coverage==7.10.2; extra == \"dev\"","pre-commit; extra == \"dev\""],"requires_python":">=3.13","summary":"vantage6 command line interface","version":"5.0.3","yanked":false,"yanked_reason":null},"last_serial":41323395,"ownership":{"organization":null,"roles":[{"role":"Owner","user":"bartvb91"},{"role":"Owner","user":"mellesies"},{"role":"Owner","user":"s102099"}]},"releases":{"0.0.0":[{"comment_text":"","core-metadata":{"sha256":"d1031e95929ee107afdb77ac98e7777ed80c4e5447c333e06a7376d39689ebbb"},"digests":{"blake2b_256":"9e3f252778ff5f5ede8a6f4e686ec97f76d4cbfbe35c683b68b775cd47794006","md5":"8ad11e6e5b347274660e88000eac2c55","sha256":"b2ebecbefa8d4cca204b51002f64be9707c7624e2dfa34695bea0c078407efc7"},"downloads":-1,"filename":"vantage6-0.0.0-py3-none-any.whl","has_sig":false,"md5_digest":"8ad11e6e5b347274660e88000eac2c55","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.6","size":33774,"upload_time":"2022-11-02T11:11:02","upload_time_iso_8601":"2022-11-02T11:11:02.557770Z","url":"https://files.pythonhosted.org/packages/9e/3f/252778ff5f5ede8a6f4e686ec97f76d4cbfbe35c683b68b775cd47794006/vantage6-0.0.0-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":"","core-metadata":false,"digests":{"blake2b_256":"7be6a2da27a91500ec0ed241b0ba05cb65ad541a136b7521f624082f0ca12cf0","md5":"2c68c5d16f514011be5e470ef1113723","sha256":"f4b0b90141f54e449a2ecdc2fbe5f4ec514e48f996ae25d4f6d6dee6ebd05c05"},"downloads":-1,"filename":"vantage6-0.0.0.tar.gz","has_sig":false,"md5_digest":"2c68c5d16f514011be5e470ef1113723","packagetype":"sdist","python_version":"source","requires_python":">=3.6","size":29008,"upload_time":"2022-11-02T11:11:04","upload_time_iso_8601":"2022-11-02T11:11:04.441980Z","url":"https://files.pythonhosted.org/packages/7b/e6/a2da27a91500ec0ed241b0ba05cb65ad541a136b7521f624082f0ca12cf0/vantage6-0.0.0.tar.gz","yanked":false,"yanked_reason":null}],"0.0.0b0":[{"comment_text":"","core-metadata":{"sha256":"bd72f6e9d249a07d4eea5187