[{"name":"v6.2.1: Make ONNX Runtime optional","uuid":"289753531","tag_name":"v6.2.1","target_commitish":"master","body":"- onnxruntime is now an optional dependency instead of required.\r\n\r\nYou now need to install ONNX Runtime explicitly:\r\n`pip install onnxruntime`      # for CPU\r\n`pip install onnxruntime-gpu`  # for GPU","draft":false,"prerelease":false,"immutable":false,"published_at":"2026-02-24T08:41:19.000Z","created_at":"2026-02-24T10:33:45.353Z","author":"adamnsandle","assets":[],"last_synced_at":"2026-08-27T06:43:19.447Z","html_url":"https://github.com/snakers4/silero-vad/releases/tag/v6.2.1","release_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/snakers4%2Fsilero-vad/releases/v6.2.1","tag_url":"https://repos.ecosyste.ms/api/v1/hosts/GitHub/repositories/snakers4%2Fsilero-vad/tags/v6.2.1"}]