":[{"comment_text":"","core-metadata":false,"digests":{"blake2b_256":"6346b5f9d697b138ef9885dd3e8a08c6475c1cbd747f2dfc14a437fe3b02b58e","md5":"07076346da647af9b74329d18753230e","sha256":"9d1de7fa1e766b9adf8be4bfa7fb11e2bdf8d2b0bf77b90478cf4d75e0e58d19"},"downloads":-1,"filename":"openai-whisper-20231106.tar.gz","has_sig":false,"md5_digest":"07076346da647af9b74329d18753230e","packagetype":"sdist","python_version":"source","requires_python":">=3.8","size":798577,"upload_time":"2023-11-06T18:16:21","upload_time_iso_8601":"2023-11-06T18:16:21.951232Z","url":"https://files.pythonhosted.org/packages/63/46/b5f9d697b138ef9885dd3e8a08c6475c1cbd747f2dfc14a437fe3b02b58e/openai-whisper-20231106.tar.gz","yanked":false,"yanked_reason":null}],"20231117":[{"comment_text":"","core-metadata":false,"digests":{"blake2b_256":"d26e50ace2bf704e5ffc786d20d96403ab0d57c5d6ab8729de7fed8c436687df","md5":"9df9549bc62ad7b4f9fd7c8e6eadf81d","sha256":"7af424181436f1800cc0b7d75cf40ede34e9ddf1ba4983a910832fcf4aade4a4"},"downloads":-1,"filename":"openai-whisper-20231117.tar.gz","has_sig":false,"md5_digest":"9df9549bc62ad7b4f9fd7c8e6eadf81d","packagetype":"sdist","python_version":"source","requires_python":">=3.8","size":798593,"upload_time":"2023-11-17T19:59:56","upload_time_iso_8601":"2023-11-17T19:59:56.498672Z","url":"https://files.pythonhosted.org/packages/d2/6e/50ace2bf704e5ffc786d20d96403ab0d57c5d6ab8729de7fed8c436687df/openai-whisper-20231117.tar.gz","yanked":false,"yanked_reason":null}],"20240927":[{"comment_text":"","core-metadata":false,"digests":{"blake2b_256":"eda981f65f3443778a1e1088e80089fc970f1f160abec2bfc3d71abfed8cbc34","md5":"7ef22dad8547e79344cfca7519558268","sha256":"5b322442b03704e245e3d6d3a577d7a3845f884e50edbf15990cb26a134dffff"},"downloads":-1,"filename":"openai-whisper-20240927.tar.gz","has_sig":false,"md5_digest":"7ef22dad8547e79344cfca7519558268","packagetype":"sdist","python_version":"source","requires_python":">=3.8","size":800031,"upload_time":"2024-09-27T23:44:30","upload_time_iso_8601":"2024-09-27T23:44:30.054606Z","url":"https://files.pythonhosted.org/packages/ed/a9/81f65f3443778a1e1088e80089fc970f1f160abec2bfc3d71abfed8cbc34/openai-whisper-20240927.tar.gz","yanked":false,"yanked_reason":null}],"20240930":[{"comment_text":"","core-metadata":false,"digests":{"blake2b_256":"f577952ca71515f81919bd8a6a4a3f89a27b09e73880cebf90957eda8f2f8545","md5":"aab53b4c78af150af9a071f55472b7ca","sha256":"b7178e9c1615576807a300024f4daa6353f7e1a815dac5e38c33f1ef055dd2d2"},"downloads":-1,"filename":"openai-whisper-20240930.tar.gz","has_sig":false,"md5_digest":"aab53b4c78af150af9a071f55472b7ca","packagetype":"sdist","python_version":"source","requires_python":">=3.8","size":800544,"upload_time":"2024-09-30T18:21:22","upload_time_iso_8601":"2024-09-30T18:21:22.596154Z","url":"https://files.pythonhosted.org/packages/f5/77/952ca71515f81919bd8a6a4a3f89a27b09e73880cebf90957eda8f2f8545/openai-whisper-20240930.tar.gz","yanked":false,"yanked_reason":null}],"20250625":[{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"358ed36f8880bcf18ec026a55807d02fe4c7357da9f25aebd92f85178000c0dc","md5":"211abcbefc01a804ee00bcbc8352da99","sha256":"37a91a3921809d9f44748ffc73c0a55c9f366c85a3ef5c2ae0cc09540432eb96"},"downloads":-1,"filename":"openai_whisper-20250625.tar.gz","has_sig":false,"md5_digest":"211abcbefc01a804ee00bcbc8352da99","packagetype":"sdist","python_version":"source","requires_python":">=3.8","size":803191,"upload_time":"2025-06-26T01:06:13","upload_time_iso_8601":"2025-06-26T01:06:13.340846Z","url":"https://files.pythonhosted.org/packages/35/8e/d36f8880bcf18ec026a55807d02fe4c7357da9f25aebd92f85178000c0dc/openai_whisper-20250625.tar.gz","yanked":false,"yanked_reason":null}]},"urls":[{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"358ed36f8880bcf18ec026a55807d02fe4c7357da9f25aebd92f85178000c0dc","md5":"211abcbefc01a804ee00bcbc8352da99","sha256":"37a91a3921809d9f44748ffc73c0a55c9f366c85a3ef5c2ae0cc09540432eb96"},"downloads":-1,"filename":"openai_whisper-20250625.tar.gz","has_sig":false,"md5_digest":"211abcbefc01a804ee00bcbc8352da99","packagetype":"sdist","python_version":"source","requires_python":">=3.8","size":803191,"upload_time":"2025-06-26T01:06:13","upload_time_iso_8601":"2025-06-26T01:06:13.340846Z","url":"https://files.pythonhosted.org/packages/35/8e/d36f8880bcf18ec026a55807d02fe4c7357da9f25aebd92f85178000c0dc/openai_whisper-20250625.tar.gz","yanked":false,"yanked_reason":null}],"vulnerabilities":[]}
