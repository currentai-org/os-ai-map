sha256":"6d574d6844aafff15d6908da24c22f0dbe16bbc6876adfeb4694b7c8c94ca82a"},"downloads":-1,"filename":"codecarbon-1.0.0-py3-none-any.whl","has_sig":false,"md5_digest":"e4facdd54542131d83913478f6bc19ac","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.6","size":49057,"upload_time":"2020-12-01T15:15:25","upload_time_iso_8601":"2020-12-01T15:15:25.195751Z","url":"https://files.pythonhosted.org/packages/1d/78/0f6f06250558ca5dc21abb28660fecb78f09b4d5258d8e634393a780d1a6/codecarbon-1.0.0-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":"","core-metadata":false,"digests":{"blake2b_256":"efbbbf5606669d78d81a5298033eca9ed2de249f698ac25f6077517b333a0593","md5":"91ae394be4e1147e1b93f8ebc5274c04","sha256":"f4eb1fc5e1fdc3bb35be5e782ece55a0f475cac1403a95af4c5ed68c5c7a7e96"},"downloads":-1,"filename":"codecarbon-1.0.0.tar.gz","has_sig":false,"md5_digest":"91ae394be4e1147e1b93f8ebc5274c04","packagetype":"sdist","python_version":"source","requires_python":">=3.6","size":48431,"upload_time":"2020-12-01T15:15:26","upload_time_iso_8601":"2020-12-01T15:15:26.880781Z","url":"https://files.pythonhosted.org/packages/ef/bb/bf5606669d78d81a5298033eca9ed2de249f698ac25f6077517b333a0593/codecarbon-1.0.0.tar.gz","yanked":false,"yanked_reason":null}],"1.1.0":[{"comment_text":"","core-metadata":{"sha256":"1c91cb24ebb34192ebce62b02b6fc67c45966dc4c8c0683d78f950d781e84a26"},"digests":{"blake2b_256":"cd4a016a2d51ba20f0b897bd533bc164cab73dc768ebc8b176de6a6e51d2ccaa","md5":"eeb452d06d8cd979e0fc8bf440985999","sha256":"ac0331a18a9c9ac5112b9a14f2b482559906726e290ade8f1c50cf3bc03a95bb"},"downloads":-1,"filename":"codecarbon-1.1.0-py3-none-any.whl","has_sig":false,"md5_digest":"eeb452d06d8cd979e0fc8bf440985999","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.6","size":126532,"upload_time":"2021-03-11T18:00:00","upload_time_iso_8601":"2021-03-11T18:00:00.673135Z","url":"https://files.pythonhosted.org/packages/cd/4a/016a2d51ba20f0b897bd53