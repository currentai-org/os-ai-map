<div id="aem-widget-all-demo-component-10509ab5-5075-3d2f-a04c-c1e720dd8b38" data-localecode></div>

<script type="text/javascript">
  (() => {
    var i18n = {};

    var aemProps = {
      "aemModalForms": "false",
      "aemFormContainer1": "",
      "aemFormContainer2": "",
      "aemFormContainer3": "",
      "demoType": "figma",
      "demoUrl": "https:\/\/www.figma.com\/proto\/UCmg1O8uoBFs1jkoEpG3q7\/gov-Click-Thru-Demo?client-id=VWdl1XaYYCpP8Yv94XsrKS&content-scaling=fixed&embed_host=share&hide-ui=1&kind=proto&node-id=278-537441&page-id=0%3A1&scaling=min-zoom&t=6XgNtDc1RWRBhJQ2-1&viewport=229%2C466%2C0.06",
      "demoTitle": "watsonx-governance-demo",
      "ibmProduct": "watsonx-governance",
      "demoAspectRatio": "16\/11",
      "demoFrameHeight": "",
      "demoFrameMarginBottom": "",
      "ctaList": [{"adcCtaText":"Book a live demo ","ctaType":"url","ctaTarget":"https://www.ibm.com/forms/mkt-demo-dataaiwatsonxgov","ctaIcon":"ArrowRight16","ctaLinkTarget":"_blank","ctaStyle":"primary"}]
    };

    var widgetId = 'aem\u002Dwidget\u002Dall\u002Ddemo\u002Dcomponent\u002D10509ab5\u002D5075\u002D3d2f\u002Da04c\u002Dc1e720dd8b38';
    var widgetRenderFunction = 'renderAEMWidgetAllDemoComponent';

    var widgetLanguageCode = document.querySelector('meta[name="languageCode"]').getAttribute('content');
    var widgetCountryCode = document.querySelector('meta[name="countryCode"]').getAttribute('content');
    var lcCc = widgetLanguageCode + "-" + widgetCountryCode;
    var widgetElement = document.getElementById(widgetId);

    if (!widgetElement) {
      console.error('All Demo Component mount element not found:', widgetId);
      return;
    }

    widgetElement.setAttribute("data-localecode", lcCc);

    try {
      document.loadAEMWidget({
        renderFunctionName: widgetRenderFunction,
        instanceId: widgetId,
        language: lcCc,
        onRenderFinish: (renderedElement) => { },
        i18n,
        aemProps
      });
    } catch (e) {
      console.error(e);
    }
  })();
</script>
